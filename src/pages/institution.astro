          switchTableView('enrolled');
          showFeedbackBanner(
            `<div><strong>Student Registered in Roster:</strong> <span class="font-mono font-bold">${fullName}</span> (APAAR: <span class="font-mono">${apaar}</span>) verified within cap (<strong>${nextEnrolled} / ${capUiVal}</strong>).</div>`,
