          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            institutionId: instId,
            action: 'normalize_intake',
          }),
        });
        const data = await res.json().catch(() => null);
        if (data && typeof data.new_enrollment === 'number') {
          targetVal = data.new_enrollment;
        }
        if (data && typeof data.sanctioned_intake === 'number') {
          cap = data.sanctioned_intake;
        }
      } catch {
        // Fallback to local UI normalization
      } finally {
        normalizeIntakeBtn.disabled = false;
      }

      const selectedOpt = collegeSelect?.selectedOptions?.[0];
