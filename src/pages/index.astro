---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution } from '../lib/types';

const db = getDB(Astro.locals);
const instRes = await db.prepare('SELECT * FROM institutions ORDER BY name ASC').bind().all<Institution>();
const institutions = instRes.results || [];
const user = Astro.locals.user;

const portals = [
  {
    role: 'institution',
    title: '1. Approved Institution Portal',
    code: 'INST-01',
    description: 'Statutory student roster submission channel. Features In-Browser Client-Side Memory Triage (Zero PII Cloud Leakage) to isolate valid, missing, and malformed 12-digit APAAR IDs in-browser. Complies with AICTE Approval Process Handbook (2024–2027) Dynamic Intake Caps (60/120/180/240 divisions).',
    path: '/institution',
    stats: 'Dynamic Intake Cap Compliance',
    statsType: 'neutral',
    isPublic: false,
  },
  {
    role: 'aicte',
    title: '2. AICTE Regulatory Oversight',
    code: 'REG-02',
    description: 'National surveillance and audit dashboard. Automatically flags institutions exceeding approved program intake limits under AICTE Approval Process Handbook (2024–2027) Dynamic Intake Caps (60/120/180/240 divisions) and identifies concurrent cross-campus duplicate enrollments.',
    path: '/aicte',
    stats: 'National Surveillance Engine',
    statsType: 'warning',
    isPublic: false,
  },
  {
    role: 'university',
    title: '3. Affiliating University Ledger',
    code: 'UNIV-03',
    description: 'State and central affiliating universities verify affiliated college rosters, issue tamper-evident academic degrees anchored to student APAAR IDs, and maintain an immutable ledger for disciplinary or fraudulent credential revocations.',
    path: '/university',
    stats: 'Cryptographic Degree Ledger',
    statsType: 'neutral',
    isPublic: false,
  },
  {
    role: 'student',
    title: '4. Student Consent Authority (DPDP)',
    code: 'STU-04',
    description: 'Statutory student portal compliant with Section 6 of the Digital Personal Data Protection (DPDP) Act, 2023. Enables students to manage explicit digital consent and authorize employer background checks using W3C WebAuthn biometric Passkeys.',
    path: '/student',
    stats: 'Hardware Biometric Binding',
    statsType: 'success',
    isPublic: false,
  },
  {
    role: 'verifier',
    title: '5. Credential Verification Terminal',
    code: 'VRF-05',
    description: 'Authorized verification gateway for public sector recruiters, corporate employers, and higher education admissions. Enables instantaneous 12-digit APAAR credential checks with sub-5-second verified response times upon student authorization.',
    path: '/verifier',
    stats: '< 50ms Edge Response Time',
    statsType: 'highlight',
    isPublic: true,
  },
];
---

<Layout title="SIH 2026 | National Student Data Management & Verification Portal" activeRole="overview">
  <!-- Official Notice / Banner -->
  <div class="bg-blue-50 border-l-4 border-[#1E40AF] p-4 mb-6 rounded-r shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
    <div>
      <div class="font-bold text-[#1E3A8A] text-sm">
        Statutory Compliance Notice: AICTE Approval Process Handbook (2024–2027)
      </div>
      <p class="text-slate-700 mt-0.5">
        Mandatory APAAR ID integration and sanctioned dynamic intake cap enforcement for all technical and professional institutions across India.
      </p>
    </div>
    <div class="shrink-0 bg-white border border-blue-200 px-3 py-1.5 rounded font-mono text-blue-900 font-bold">
      PS ID: SIH26263
    </div>
  </div>

  <!-- Evaluator Quick Access & RBAC Gateway Alert -->
  <div class="bg-gradient-to-r from-[#0F2942] to-slate-800 text-white p-4 mb-6 rounded-lg shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4 text-xs">
    <div class="flex items-start gap-3">
      <div class="bg-[#FF9933] text-black font-black text-[10px] uppercase px-2 py-1 rounded shrink-0 tracking-wider">
        RBAC Active
      </div>
      <div>
        <div class="font-bold text-sm text-white">Production Role-Based Access Control & Tenant Isolation</div>
        <p class="text-slate-300 mt-0.5">
          Portal nodes are strictly protected by Web Crypto PBKDF2 authentication, Cloudflare D1 sessions, and tenant isolation. Public verification remains open to all verifiers.
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2 self-start md:self-auto shrink-0">
      <a
        href="/login"
        class="bg-[#FF9933] hover:bg-[#F28500] text-black font-bold px-3.5 py-2 rounded transition-colors flex items-center gap-1.5 shadow-sm text-xs"
      >
        <span>Officer Sign In & Evaluator 1-Click Switcher</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <!-- Key Metrics Header Card: National Regulatory Benchmarks -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded border border-slate-200 shadow-sm">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Approved Technical Institutions</div>
      <div class="text-2xl font-bold text-[#0F2942] mt-1">8,500+ Nationally Monitored</div>
      <div class="text-[11px] text-slate-500 mt-1">AICTE approved institutions across India</div>
    </div>

    <div class="bg-white p-5 rounded border border-slate-200 shadow-sm">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Sanctioned Capacity</div>
      <div class="text-2xl font-bold text-[#0F2942] mt-1">3.2M+ Annual Technical Intake</div>
      <div class="text-[11px] text-slate-500 mt-1">Dynamic intake caps (60/120/180/240 divisions)</div>
    </div>

    <div class="bg-white p-5 rounded border border-slate-200 shadow-sm">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">APAAR Integration</div>
      <div class="text-2xl font-bold text-[#0F2942] mt-1">100% NEP 2020 Compliance Mandate</div>
      <div class="text-[11px] text-slate-500 mt-1">Automated 12-digit registry & biometric binding</div>
    </div>

    <div class="bg-white p-5 rounded border border-slate-200 shadow-sm">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Regulatory Surveillance</div>
      <div class="text-2xl font-bold text-[#0F2942] mt-1">Automated Quota & Duplicate Engine</div>
      <div class="text-[11px] text-slate-500 mt-1">Dynamic overrun & cross-campus detection</div>
    </div>
  </div>

  <!-- Quick Public Institution Search & Verification Section -->
  <section class="bg-white rounded-lg border border-slate-200 shadow-sm p-5 sm:p-6 mb-8" id="institution-search">
    <div class="border-b border-slate-200 pb-4 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Public Directory & Verification Gateway</span>
        </div>
        <h2 class="text-lg font-bold text-[#0F2942] mt-0.5">Approved Technical Institutions & Credential Verification</h2>
        <p class="text-xs text-slate-600">Search technical institutions across India by name, code, or state, or directly verify student academic credentials.</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/verifier"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded bg-[#138808] hover:bg-[#0E6506] text-white text-xs font-bold shadow-sm transition-colors"
        >
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Open Public Verifier Terminal &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Quick APAAR Verification Bar -->
    <div class="bg-slate-50 border border-slate-200 rounded p-4 mb-5">
      <form action="/verifier" method="GET" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 text-xs">
        <div class="flex-1">
          <label for="quickApaarInput" class="block font-bold text-slate-800 uppercase tracking-wider mb-1">
            Quick Student Credential Verification (12-Digit APAAR ID):
          </label>
          <div class="relative">
            <input
              type="text"
              id="quickApaarInput"
              name="apaar"
              pattern="[0-9]{12}"
              placeholder="Enter 12-digit APAAR ID (e.g. 412398471029)"
              class="w-full bg-white border border-slate-300 rounded px-3 py-2 font-mono text-slate-900 text-xs tracking-wider focus:outline-none focus:ring-1 focus:ring-blue-600"
            />
          </div>
        </div>
        <div class="sm:self-end">
          <button
            type="submit"
            class="w-full sm:w-auto px-4 py-2 bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold rounded text-xs transition-colors shadow-sm"
          >
            Verify Credential &rarr;
          </button>
        </div>
      </form>
    </div>

    <!-- Search & Filter Controls for Directory -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-4">
      <div class="md:col-span-8 relative">
        <label for="instSearchInput" class="sr-only">Search Institutions</label>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="instSearchInput"
          placeholder="Filter institutions by name, code, district, or state..."
          class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-300 rounded text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-blue-600"
        />
      </div>

      <div class="md:col-span-4">
        <label for="stateFilterSelect" class="sr-only">Filter by State</label>
        <select
          id="stateFilterSelect"
          class="w-full py-2 px-3 bg-slate-50 border border-slate-300 rounded text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-blue-600"
        >
          <option value="">All States / UTs</option>
          {Array.from(new Set(institutions.map(i => i.state).filter(Boolean))).sort().map(st => (
            <option value={st}>{st}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Interactive Directory Table -->
    <div class="overflow-x-auto border border-slate-200 rounded">
      <table class="w-full text-left text-xs" id="institutionsTable">
        <thead class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200 uppercase tracking-wider text-[11px]">
          <tr>
            <th class="py-2.5 px-3">Institution Code & Name</th>
            <th class="py-2.5 px-3">State / District</th>
            <th class="py-2.5 px-3">Sanctioned Intake</th>
            <th class="py-2.5 px-3">Current Active</th>
            <th class="py-2.5 px-3">Regulatory Status</th>
            <th class="py-2.5 px-3 text-right">Verification</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 font-medium text-slate-700" id="instTableBody">
          {institutions.map(inst => (
            <tr
              class="hover:bg-slate-50 transition-colors inst-row"
              data-name={inst.name.toLowerCase()}
              data-code={inst.code.toLowerCase()}
              data-id={inst.id.toLowerCase()}
              data-state={inst.state.toLowerCase()}
              data-district={inst.district.toLowerCase()}
            >
              <td class="py-3 px-3">
                <div class="font-bold text-[#0F2942]">{inst.name}</div>
                <div class="text-[11px] font-mono text-slate-500 mt-0.5">Code: {inst.code} &bull; ID: {inst.id}</div>
              </td>
              <td class="py-3 px-3">
                <div>{inst.district}</div>
                <div class="text-[11px] text-slate-500">{inst.state}</div>
              </td>
              <td class="py-3 px-3">
                <span class="font-bold text-slate-900">{inst.sanctioned_intake}</span>
                <span class="text-[10px] text-slate-500 ml-1">Dynamic Seats</span>
              </td>
              <td class="py-3 px-3">
                <span class="font-mono font-semibold">{inst.current_enrollment} Verified</span>
              </td>
              <td class="py-3 px-3">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  AICTE Approved
                </span>
              </td>
              <td class="py-3 px-3 text-right">
                <a
                  href="/verifier"
                  class="inline-flex items-center gap-1 text-[11px] font-bold text-blue-700 hover:text-blue-900 hover:underline"
                >
                  <span>Verify Student</span>
                  <span>&rarr;</span>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <div id="noResultsMsg" class="hidden p-6 text-center text-xs text-slate-500">
        No institutions found matching the search criteria.
      </div>
    </div>
  </section>

  <!-- 5 Stakeholder Portals Grid -->
  <div class="mb-8">
    <div class="border-b border-slate-200 pb-3 mb-5 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold text-[#0F2942]">Stakeholder Portals & Operational Modules</h2>
        <p class="text-xs text-slate-600">Select an operational authority to access specialized data management functions or public verification.</p>
      </div>
      <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded border border-slate-300">
        5 Integrated Nodes
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {portals.map((p) => {
        const isPublic = p.isPublic;
        const targetUrl = user 
          ? p.path 
          : (isPublic ? '/verifier' : `/login?redirect=${encodeURIComponent(p.path)}`);
        const actionText = user 
          ? 'Enter Portal →' 
          : (isPublic ? 'Launch Verification Terminal →' : 'Officer Login →');

        return (
          <div class={`bg-white rounded border shadow-sm flex flex-col justify-between transition-all ${
            isPublic
              ? 'border-emerald-500 ring-2 ring-emerald-500/20 hover:border-emerald-600 shadow-md'
              : 'border-slate-200 hover:border-blue-400'
          }`}>
            <div class="p-5">
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-[11px] font-mono font-bold bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200">
                  {p.code}
                </span>
                {isPublic ? (
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-300 uppercase tracking-wide">
                    PUBLIC VERIFICATION GATEWAY
                  </span>
                ) : (
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 uppercase tracking-wide">
                    OFFICER AUTHENTICATION REQUIRED
                  </span>
                )}
              </div>

              {isPublic && (
                <div class="mb-3 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded text-[11px] text-emerald-900 font-bold flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span>PUBLIC VERIFICATION GATEWAY - OPEN TO ALL VERIFIERS</span>
                </div>
              )}

              <h3 class="text-sm font-bold text-[#0F2942] mb-2 leading-tight">
                {p.title}
              </h3>

              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                {p.description}
              </p>

              <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                <span class="text-slate-500 font-medium">Compliance Node:</span>
                <span class="font-semibold text-slate-700">{p.stats}</span>
              </div>
            </div>

            <div class={`p-4 border-t mt-auto ${isPublic ? 'bg-emerald-50/50 border-emerald-100' : 'bg-slate-50 border-slate-100'}`}>
              <a
                href={targetUrl}
                class={`block w-full text-center text-xs font-bold py-2.5 px-4 rounded transition-colors shadow-sm ${
                  isPublic
                    ? 'bg-[#138808] hover:bg-[#0E6506] text-white'
                    : 'bg-[#0F2942] hover:bg-[#1E3A8A] text-white'
                }`}
              >
                {actionText}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Statutory Architecture & Audit Baseline -->
  <div class="bg-white rounded border border-slate-200 p-6 shadow-sm" id="aicte-mandate">
    <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-4">
      <div>
        <h3 class="text-sm font-bold text-[#0F2942]">AICTE Approval Process Handbook (2024–2027) Regulatory Framework</h3>
        <p class="text-xs text-slate-600 mt-0.5">
          Statutory mandate establishing an automated student verification bridge between institutional rosters, affiliating university degree ledgers, and third-party credential verifiers.
        </p>
      </div>
      <span class="hidden sm:inline-block text-[11px] font-mono bg-blue-50 text-blue-900 border border-blue-200 px-2.5 py-1 rounded font-bold">
        Mandate Ref: APH-2024-27
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
      <div class="p-4 bg-slate-50 rounded border border-slate-200">
        <div class="font-bold text-[#0F2942] mb-1.5 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>1. In-Browser Memory Triage</span>
        </div>
        <div class="text-slate-600 text-[11px] leading-relaxed">
          In-Browser Client-Side Memory Triage (Zero PII Cloud Leakage) executes Parquet and CSV roster validation directly within client browser memory, preventing unverified student records from reaching external cloud infrastructure.
        </div>
      </div>

      <div class="p-4 bg-slate-50 rounded border border-slate-200">
        <div class="font-bold text-[#0F2942] mb-1.5 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>2. Dynamic Intake Cap Locks</span>
        </div>
        <div class="text-slate-600 text-[11px] leading-relaxed">
          Cloudflare D1 enforces strict relational row-level constraints conforming to AICTE Approval Process Handbook (2024–2027) Dynamic Intake Caps (60/120/180/240 divisions), immediately detecting and flagging quota overruns.
        </div>
      </div>

      <div class="p-4 bg-slate-50 rounded border border-slate-200">
        <div class="font-bold text-[#0F2942] mb-1.5 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>3. Biometric Passkey Consent</span>
        </div>
        <div class="text-slate-600 text-[11px] leading-relaxed">
          W3C WebAuthn hardware-bound passkeys implement mandatory explicit consent under Section 6 of the DPDP Act 2023 before any academic credential record release to prospective employers.
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // Client-side instant filter for institutions directory
    const searchInput = document.getElementById('instSearchInput');
    const stateFilter = document.getElementById('stateFilterSelect');
    const rows = document.querySelectorAll('.inst-row');
    const noResults = document.getElementById('noResultsMsg');

    function filterInstitutions() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const state = (stateFilter?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      rows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        const code = row.getAttribute('data-code') || '';
        const id = row.getAttribute('data-id') || '';
        const rowState = row.getAttribute('data-state') || '';
        const district = row.getAttribute('data-district') || '';

        const matchesQuery = !q || name.includes(q) || code.includes(q) || id.includes(q) || district.includes(q);
        const matchesState = !state || rowState === state;

        if (matchesQuery && matchesState) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    searchInput?.addEventListener('input', filterInstitutions);
    stateFilter?.addEventListener('change', filterInstitutions);
  </script>
</Layout>
