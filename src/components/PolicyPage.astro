---
import Layout from '../layouts/Layout.astro';

export interface PolicySection {
  heading: string;
  paragraphs?: string[];
  items?: string[];
}

interface Props {
  title: string;
  lang?: 'en' | 'hi';
  updated: string;
  intro: string;
  sections: PolicySection[];
}

const { title, lang = 'en', updated, intro, sections } = Astro.props;
const isHindi = lang === 'hi';
const updatedLabel = isHindi ? 'अंतिम अद्यतन' : 'Last updated';
const badgeLabel = isHindi ? 'आधिकारिक वैधानिक दस्तावेज़ • GIGW 3.0' : 'Official Statutory Document • GIGW 3.0';
const backHomeLabel = isHindi ? '← मुख्य पृष्ठ पर वापस जाएँ' : '← Back to National Portal';
const backHomeHref = isHindi ? '/hi' : '/';
---

<Layout
  title={`${title} | National Student Registry & Verification Portal`}
  activeRole="policy"
  breadcrumb={title}
  lang={lang}
>
  <article class="bg-white rounded-lg border border-slate-200 border-t-4 border-t-[#0F2942] shadow-xs max-w-4xl mx-auto overflow-hidden">
    <!-- UX4G Card Header -->
    <header class="bg-slate-50 border-b border-slate-200 px-6 py-6 sm:px-10">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-blue-50 text-[#0F2942] border border-blue-200 text-xs font-bold uppercase tracking-wider">
          <svg class="w-3.5 h-3.5 text-blue-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>{badgeLabel}</span>
        </span>
        <span class="text-xs font-medium text-slate-500">
          {updatedLabel}: <strong class="text-slate-700">{updated}</strong>
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#0F2942] tracking-tight">{title}</h1>
    </header>

    <!-- Document Body -->
    <div class="p-6 sm:p-10">
      <p class="text-sm sm:text-base leading-relaxed text-slate-700 mb-8 pb-6 border-b border-slate-200">
        {intro}
      </p>

      <div class="space-y-8">
        {sections.map((s, i) => (
          <section aria-labelledby={`sec-${i}`}>
            <h2 id={`sec-${i}`} class="text-base sm:text-lg font-bold text-[#0F2942] mb-2.5 flex items-baseline gap-2">
              <span class="text-xs font-mono font-bold bg-slate-100 text-[#0F2942] border border-slate-300 px-2 py-0.5 rounded">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{s.heading}</span>
            </h2>
            {s.paragraphs?.map((p) => (
              <p class="text-sm sm:text-base leading-relaxed text-slate-700 mb-3">{p}</p>
            ))}
            {s.items && (
              <ul class="list-disc pl-6 space-y-2 text-sm sm:text-base text-slate-700 leading-relaxed mt-2">
                {s.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <footer class="mt-10 pt-6 border-t border-slate-200 flex items-center justify-between text-xs sm:text-sm">
        <a href={backHomeHref} class="font-bold text-[#0F2942] hover:text-blue-800 hover:underline">
          {backHomeLabel}
        </a>
        <span class="text-slate-500">
          {isHindi ? 'अखिल भारतीय तकनीकी शिक्षा परिषद (AICTE)' : 'All India Council for Technical Education (AICTE)'}
        </span>
      </footer>
    </div>
  </article>
</Layout>
