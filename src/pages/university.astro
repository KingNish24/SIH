---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution, Degree, Student } from '../lib/types';
import { maskApaar, maskName } from '../lib/types';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const t = getUIDictionary(lang);

const db = getDB(Astro.locals);

const instRes = await db.prepare('SELECT * FROM institutions').bind().all<Institution>();
const institutions = instRes.results || [];

const degRes = await db.prepare('SELECT * FROM degrees ORDER BY issued_at DESC').bind().all<Degree & { signing_key_id?: string }>();
const rawDegrees = degRes.results || [];

const stuRes = await db.prepare('SELECT * FROM students').bind().all<Student>();
const students = stuRes.results || [];

const degrees = rawDegrees.map((d) => {
  const st = students.find((s) => s.apaar_id === d.apaar_id);
  const inst = institutions.find((i) => i.id === d.institution_id);
  const instCodePrefix = (inst?.code || d.institution_id || 'TCA').split('-')[0];
  const entryBatch = (Number(d.year_of_passing) || 2024) - 4;
  const student_roll_id = `STU-${instCodePrefix}-${entryBatch}-${d.apaar_id.slice(-4)}`;
  return {
    ...d,
    student_roll_id,
    student_name: st?.full_name ? maskName(st.full_name) : 'Candidate ' + d.apaar_id.slice(-4),
    institution_name: inst?.name || d.institution_id,
  };
});

interface UnivAbcLedgerRow {
  apaar_id: string;
  student_name: string;
  program: string;
  accumulated_credits: number;
  nep_threshold_badge: string;
  entry_mode: string;
  prior_diploma_board: string;
  transferred_credits: number;
  verification_status: 'VERIFIED_ANCHORED' | 'STANDARD_DIRECT' | 'FRAUD_REVOKED';
}

const univAbcLedger: UnivAbcLedgerRow[] = [
  {
    apaar_id: '412398471029',
    student_name: maskName('Sneha Sundaram'),
    program: 'B.Tech Computer Science & Engineering',
    accumulated_credits: 160,
    nep_threshold_badge: '160 Cr — 4-Yr B.Tech Honours (Exit Year 4)',
    entry_mode: '1st-Year Regular (10+2 PCM)',
    prior_diploma_board: 'N/A (All 8 Semesters Earned at INST-001)',
    transferred_credits: 0,
    verification_status: 'STANDARD_DIRECT',
  },
  {
    apaar_id: '739284019283',
    student_name: maskName('Rahul Sharma'),
    program: 'B.Tech Computer Science & Engineering',
    accumulated_credits: 120,
    nep_threshold_badge: "120 Cr — 3-Yr Bachelor's Eligible (Exit Year 3)",
    entry_mode: '2nd-Year Lateral Entry (Sem 3 Direct)',
    prior_diploma_board: 'MSBTE State Polytechnic Diploma (80 ABC Credits Anchored)',
    transferred_credits: 80,
    verification_status: 'VERIFIED_ANCHORED',
  },
  {
    apaar_id: '582910384729',
    student_name: maskName('Priya Verma'),
    program: 'B.Tech Electronics & Comm.',
    accumulated_credits: 80,
    nep_threshold_badge: '80 Cr — UG Diploma / Lateral Entry Eligible (Exit Year 2)',
    entry_mode: '2nd-Year Lateral Entry (Sem 3 Direct)',
    prior_diploma_board: 'DTE Karnataka Polytechnic Diploma (80 ABC Credits Anchored)',
    transferred_credits: 80,
    verification_status: 'VERIFIED_ANCHORED',
  },
  {
    apaar_id: '901238471920',
    student_name: maskName('Aaditya Patel'),
    program: 'B.Tech Mechanical Engineering',
    accumulated_credits: 40,
    nep_threshold_badge: '40 Cr — UG Certificate Eligible (Exit Year 1)',
    entry_mode: '1st-Year Regular (10+2 PCM)',
    prior_diploma_board: 'N/A (Semesters 1–2 Completed at INST-001)',
    transferred_credits: 0,
    verification_status: 'STANDARD_DIRECT',
  },
  {
    apaar_id: '601928374819',
    student_name: maskName('Vikram Malhotra'),
    program: 'B.Tech Civil Engineering',
    accumulated_credits: 120,
    nep_threshold_badge: 'REVOKED — Unverified Lateral Entry Credit Transfer',
    entry_mode: '2nd-Year Lateral Entry (Disputed)',
    prior_diploma_board: 'Unverified Private Diploma (Missing APAAR / ABC Anchor)',
    transferred_credits: 80,
    verification_status: 'FRAUD_REVOKED',
  },
];

// Example candidate presets (Form inputs stay empty until clicked)
const candidateExamples = [
  {
    apaar: '901238471920',
    label: 'Aaditya P. (901238471920)',
    inst: institutions[0]?.id || 'INST-001',
    degree: 'Bachelor of Technology',
    spec: 'Mechanical Engineering',
    cgpa: '8.85',
    year: '2026',
  },
  {
    apaar: '582910384729',
    label: 'Priya V. (582910384729)',
    inst: institutions[1]?.id || institutions[0]?.id || 'INST-001',
    degree: 'Bachelor of Technology',
    spec: 'Electronics & Telecommunication',
    cgpa: '9.12',
    year: '2026',
  },
  {
    apaar: '412398471029',
    label: 'Sneha D. (412398471029)',
    inst: institutions[0]?.id || 'INST-001',
    degree: 'Bachelor of Technology (Honours)',
    spec: 'Computer Science & Engineering',
    cgpa: '9.40',
    year: '2026',
  },
];
---

<Layout title={`SIH 2026 | ${t.univ_page_title}`} activeRole="university" lang={lang} breadcrumb={t.crumb_university}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-slate-200 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="text-xs font-bold text-[#1E40AF] uppercase tracking-wider mb-1">
          {t.crumb_university}
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942]">
          {t.univ_page_title}
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          {t.univ_subtitle}
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="#issueDegreeSection"
          class="h-10 px-4 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white text-xs sm:text-sm font-semibold transition-colors inline-flex items-center gap-2 shadow-sm"
        >
          <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>{t.univ_issue_heading}</span>
        </a>
      </div>
    </div>

    <!-- Affiliated Institutions Status -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {institutions.map((i) => (
        <div class="bg-white border border-slate-200 rounded p-4 sm:p-5 shadow-sm">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-xs font-mono font-bold text-slate-700">{i.code}</span>
            <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded border ${i.current_enrollment > i.sanctioned_intake ? 'bg-red-100 text-red-800 border-red-200' : 'bg-emerald-100 text-emerald-800 border-emerald-200'}`}>
              {i.current_enrollment > i.sanctioned_intake ? t.statusOverrun : t.statusCompliant}
            </span>
          </div>
          <h3 class="text-xs sm:text-sm font-bold text-slate-900 truncate">{i.name}</h3>
          <div class="mt-2.5 flex items-center justify-between text-xs text-slate-500 font-mono">
            <span>{t.aicte_col_actual}: <strong class="text-slate-800">{i.current_enrollment} / {i.sanctioned_intake}</strong></span>
            <span>Risk: <strong class="text-slate-800">{i.risk_score}%</strong></span>
          </div>
        </div>
      ))}
    </div>

    <!-- Degrees Ledger Table -->
    <div class="bg-white border border-slate-200 rounded shadow-sm">
      <div class="p-4 sm:p-5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-xs sm:text-sm font-bold text-[#0F2942] uppercase tracking-wider">
            1. {t.univ_ledger_heading} ({degrees.length})
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            {t.univ_issue_sub}
          </p>
        </div>
        <span class="text-xs font-mono font-semibold bg-blue-50 text-blue-800 border border-blue-200 px-2.5 py-1 rounded">
          Ed25519 + SHA-256
        </span>
      </div>

      <div class="overflow-x-auto" role="region" aria-label={t.univ_ledger_heading} tabindex="0">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <caption class="sr-only">{t.univ_ledger_heading}</caption>
          <thead class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th scope="col" class="py-3 px-4">ID</th>
              <th scope="col" class="py-3 px-4">{t.univ_student_name} &bull; {t.univ_apaar_id}</th>
              <th scope="col" class="py-3 px-4">{t.univ_degree_name} &bull; {t.univ_specialization}</th>
              <th scope="col" class="py-3 px-4">{t.univ_cgpa} / {t.univ_year}</th>
              <th scope="col" class="py-3 px-4">{t.aicte_col_status}</th>
              <th scope="col" class="py-3 px-4">Ed25519 + SHA-256</th>
              <th scope="col" class="py-3 px-4 text-right">{t.univ_revocation_heading}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-800">
            {degrees.map((d) => (
              <tr class="hover:bg-slate-50">
                <td class="py-3.5 px-4 font-mono font-bold text-slate-900">{d.id}</td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-900">{d.student_name}</div>
                  <div class="text-xs font-mono text-slate-700 mt-0.5">APAAR: <span class="font-bold text-[#0F2942]">{maskApaar(d.apaar_id)}</span></div>
                  <div class="text-[11px] font-mono text-blue-800 bg-blue-50 border border-blue-200 inline-block px-1.5 py-0.5 rounded mt-1">
                    {d.student_roll_id}
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-900">{d.degree_name}</div>
                  <div class="text-xs text-slate-500">{d.specialization}</div>
                </td>
                <td class="py-3.5 px-4 font-mono">
                  <div class="font-semibold text-slate-800">{t.univ_cgpa}: {d.cgpa}</div>
                  <div class="text-xs text-slate-500">{t.univ_year}: {d.year_of_passing}</div>
                </td>
                <td class="py-3.5 px-4">
                  {d.status === 'ISSUED' ? (
                    <span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded text-xs border border-emerald-200">
                      ISSUED (VALID)
                    </span>
                  ) : (
                    <div>
                      <span class="bg-red-100 text-red-800 font-bold px-2.5 py-0.5 rounded text-xs border border-red-200">
                        REVOKED
                      </span>
                      {d.revocation_reason && (
                        <div class="text-[11px] text-red-700 font-medium mt-1 max-w-xs leading-tight">
                          {d.revocation_reason}
                        </div>
                      )}
                    </div>
                  )}
                </td>
                <td class="py-3.5 px-4 max-w-xs">
                  <div class="flex items-center gap-1.5 mb-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-indigo-50 text-indigo-800 border border-indigo-200">
                      {d.signing_key_id || 'Ed25519 Signed'}
                    </span>
                  </div>
                  <div class="font-mono text-[11px] text-slate-500 truncate" title={d.digital_signature_hash}>
                    {d.digital_signature_hash.slice(0, 24)}...
                  </div>
                </td>
                <td class="py-3.5 px-4 text-right">
                  {d.status === 'ISSUED' ? (
                    <button
                      type="button"
                      data-revoke-id={d.id}
                      data-student-name={d.student_name}
                      data-degree-name={d.degree_name}
                      class="px-3 py-1.5 rounded bg-red-50 hover:bg-red-100 border border-red-300 text-red-700 font-semibold text-xs transition-colors cursor-pointer"
                    >
                      Revoke
                    </button>
                  ) : (
                    <button
                      type="button"
                      data-reinstate-id={d.id}
                      data-student-name={d.student_name}
                      data-degree-name={d.degree_name}
                      class="px-3 py-1.5 rounded bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-700 font-semibold text-xs transition-colors cursor-pointer"
                    >
                      Reinstate
                    </button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FEATURE #3: NEP 2020 Academic Bank of Credits (ABC) & Multiple Entry/Exit Ledger -->
    <div class="bg-white border border-slate-200 border-t-4 border-t-[#138808] rounded shadow-sm">
      <div class="p-4 sm:p-5 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded">
              <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>NEP 2020 &amp; Academic Bank of Credits (ABC)</span>
            </span>
          </div>
          <h2 class="text-sm sm:text-base font-bold text-[#0F2942]">
            2. NEP 2020 Academic Bank of Credits (ABC) &amp; Multiple Entry/Exit Ledger
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            {t.s16_body || '0 to 160 Credits mapped against NEP 2020 awards and lateral-entry polytechnic credit provenance.'}
          </p>
        </div>

        <!-- NEP 2020 4 Threshold Pills -->
        <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-mono font-bold shrink-0">
          <span class="px-2.5 py-1 rounded bg-slate-100 text-slate-800 border border-slate-300">40 Cr: UG Cert (Yr 1)</span>
          <span class="px-2.5 py-1 rounded bg-blue-50 text-blue-900 border border-blue-200">80 Cr: UG Diploma (Yr 2)</span>
          <span class="px-2.5 py-1 rounded bg-indigo-50 text-indigo-900 border border-indigo-200">120 Cr: Degree (Yr 3)</span>
          <span class="px-2.5 py-1 rounded bg-emerald-50 text-emerald-900 border border-emerald-200">160 Cr: Honours (Yr 4)</span>
        </div>
      </div>

      <div class="overflow-x-auto" role="region" aria-label="NEP 2020 ABC Ledger" tabindex="0">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <caption class="sr-only">NEP 2020 Academic Bank of Credits Ledger</caption>
          <thead class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th scope="col" class="py-3 px-4">{t.univ_student_name} &bull; {t.univ_apaar_id}</th>
              <th scope="col" class="py-3 px-4">ABC Credits (0–160 Cr)</th>
              <th scope="col" class="py-3 px-4">NEP 2020 Award / Exit</th>
              <th scope="col" class="py-3 px-4">Lateral-Entry Credit Provenance</th>
              <th scope="col" class="py-3 px-4 text-right">{t.aicte_col_status}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-800">
            {univAbcLedger.map((row) => {
              const pct = Math.min(100, Math.round((row.accumulated_credits / 160) * 100));
              const isFraud = row.verification_status === 'FRAUD_REVOKED';
              const isLateralVerified = row.verification_status === 'VERIFIED_ANCHORED';
              return (
                <tr class={isFraud ? 'bg-red-50/40 hover:bg-red-50/70' : 'hover:bg-slate-50'}>
                  <td class="py-3.5 px-4">
                    <div class="font-bold text-slate-900">{row.student_name}</div>
                    <div class="text-xs font-mono text-slate-500">{maskApaar(row.apaar_id)} &bull; {row.program}</div>
                  </td>
                  <td class="py-3.5 px-4 min-w-[200px]">
                    <div class="flex justify-between text-xs font-mono mb-1">
                      <span class="font-bold text-[#0F2942]">{row.accumulated_credits} / 160 Cr</span>
                      <span class="text-slate-500">{pct}%</span>
                    </div>
                    <div
                      class="w-full bg-slate-200 rounded-full h-2.5 border border-slate-300 overflow-hidden"
                      role="progressbar"
                      aria-label={`${row.student_name} ABC Credits`}
                      aria-valuenow={row.accumulated_credits}
                      aria-valuemin={0}
                      aria-valuemax={160}
                    >
                      <div
                        class={`h-full ${isFraud ? 'bg-red-600' : 'bg-emerald-600'}`}
                        style={`width: ${pct}%;`}
                      ></div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class={`inline-block font-mono font-bold text-xs px-2.5 py-1 rounded border ${
                      isFraud
                        ? 'bg-red-100 text-red-900 border-red-200'
                        : 'bg-slate-100 text-[#0F2942] border-slate-300'
                    }`}>
                      {row.nep_threshold_badge}
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="font-semibold text-slate-900">{row.entry_mode}</div>
                    <div class="text-xs text-slate-600 mt-0.5">
                      {row.prior_diploma_board}
                      {row.transferred_credits > 0 && (
                        <span class="ml-1 font-mono font-bold text-[#0F2942]">
                          ({row.transferred_credits} Cr)
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    {isLateralVerified ? (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-emerald-100 text-emerald-900 border border-emerald-200 font-bold text-xs">
                        <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Verified</span>
                      </span>
                    ) : isFraud ? (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-red-100 text-red-900 border border-red-200 font-bold text-xs">
                        <svg class="w-3.5 h-3.5 text-red-700 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        <span>Blocked</span>
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-blue-50 text-blue-900 border border-blue-200 font-bold text-xs">
                        <span>Direct Entry</span>
                      </span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FEATURE #5: Section 63 BSA Cryptographic Hash-Chain & Merkle Audit Verifier -->
    <div class="bg-white border border-slate-200 border-t-4 border-t-[#0F2942] rounded p-5 sm:p-6 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-200 pb-4 mb-4">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider bg-indigo-50 text-indigo-900 border border-indigo-200 px-2.5 py-0.5 rounded">
              <svg class="w-3.5 h-3.5 text-indigo-700 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Bharatiya Sakshya Adhiniyam (BSA) 2023 Sec. 63</span>
            </span>
          </div>
          <h2 class="text-sm sm:text-base font-bold text-[#0F2942]">
            3. {t.s13_title} &bull; SHA-256 Merkle Audit Verifier
          </h2>
          <p class="text-xs text-slate-600 mt-0.5">
            {t.s13_body} (<code class="font-mono text-[11px] bg-slate-100 px-1 py-0.5 rounded">SHA256(prev_hash + ":" + canonical_payload)</code>)
          </p>
        </div>

        <button
          type="button"
          id="verifyMerkleBtnUniv"
          class="shrink-0 h-10 px-4 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold text-xs sm:text-sm transition-colors inline-flex items-center gap-2 shadow-xs cursor-pointer"
        >
          <svg class="w-4 h-4 text-emerald-300 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{t.s13_try}</span>
        </button>
      </div>

      <!-- Summary Status Strip -->
      <div
        id="merkleSummaryStripUniv"
        role="status"
        aria-live="polite"
        class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 text-xs"
      >
        <div class="p-3.5 bg-slate-50 rounded border border-slate-200">
          <div class="text-[10px] font-bold uppercase text-slate-500">{t.aicte_col_status}</div>
          <div id="merkleStatusTextUniv" class="font-bold text-slate-800 mt-1 flex items-center gap-1.5">
            <span>{t.s13_try}</span>
          </div>
        </div>
        <div class="p-3.5 bg-slate-50 rounded border border-slate-200">
          <div class="text-[10px] font-bold uppercase text-slate-500">Merkle Root (SHA-256)</div>
          <div id="merkleRootTextUniv" class="font-mono font-bold text-[#0F2942] mt-1 truncate">
            --
          </div>
        </div>
        <div class="p-3.5 bg-slate-50 rounded border border-slate-200">
          <div class="text-[10px] font-bold uppercase text-slate-500">Ledger Blocks</div>
          <div id="merkleBlockCountUniv" class="font-mono font-bold text-emerald-700 mt-1">
            --
          </div>
        </div>
      </div>

      <!-- Individual Block Links Table -->
      <div id="merkleBlocksContainerUniv" class="hidden border border-slate-200 rounded overflow-hidden">
        <div class="bg-slate-100 px-4 py-2.5 border-b border-slate-200 flex items-center justify-between text-xs font-bold text-slate-700">
          <span>SHA-256 Block Chain Links (prev_hash &rarr; block_hash)</span>
          <span class="font-mono text-[11px] text-emerald-800">crypto.subtle.digest('SHA-256')</span>
        </div>
        <div class="max-h-64 overflow-y-auto divide-y divide-slate-200 text-xs font-mono" id="merkleBlocksListUniv"></div>
      </div>
    </div>

    <!-- Issue Degree Section (No Prefilled Inputs; Clickable Example Candidates Provided) -->
    <div id="issueDegreeSection" class="bg-white border border-slate-200 rounded p-6 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-4 mb-5 border-b border-slate-200">
        <div>
          <h2 class="text-xs sm:text-sm font-bold text-[#0F2942] uppercase tracking-wider mb-1">
            4. {t.univ_issue_heading}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600">
            {t.univ_issue_sub}
          </p>
        </div>

        <!-- Clickable Example Candidate Pills (No Prefilling) -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="text-slate-500 font-semibold">Examples:</span>
          {candidateExamples.map((ex) => (
            <button
              type="button"
              data-example-apaar={ex.apaar}
              data-example-inst={ex.inst}
              data-example-degree={ex.degree}
              data-example-spec={ex.spec}
              data-example-cgpa={ex.cgpa}
              data-example-year={ex.year}
              class="font-mono font-bold text-[#0F2942] bg-slate-100 hover:bg-blue-50 hover:text-blue-800 border border-slate-300 px-2.5 py-1 rounded transition-colors cursor-pointer"
            >
              {ex.label}
            </button>
          ))}
        </div>
      </div>

      <form id="issueDegreeForm" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-xs sm:text-sm">
        <div>
          <label for="degApaar" class="block font-semibold text-slate-700 mb-1.5">{t.univ_apaar_id}:</label>
          <input
            type="text"
            id="degApaar"
            required
            inputmode="numeric"
            pattern="[0-9]{12}"
            maxlength="12"
            placeholder="901238471920"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 font-mono text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div>
          <label for="degInst" class="block font-semibold text-slate-700 mb-1.5">{t.univ_institution}:</label>
          <select id="degInst" class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600">
            {institutions.map((i) => (
              <option value={i.id}>{i.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="degName" class="block font-semibold text-slate-700 mb-1.5">{t.univ_degree_name}:</label>
          <input
            type="text"
            id="degName"
            required
            placeholder="Bachelor of Technology"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div>
          <label for="degSpec" class="block font-semibold text-slate-700 mb-1.5">{t.univ_specialization}:</label>
          <input
            type="text"
            id="degSpec"
            required
            placeholder="Computer Science & Engineering"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div>
          <label for="degCgpa" class="block font-semibold text-slate-700 mb-1.5">{t.univ_cgpa}:</label>
          <input
            type="number"
            id="degCgpa"
            required
            step="0.01"
            min="0"
            max="10"
            placeholder="8.85"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 font-mono text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div>
          <label for="degYear" class="block font-semibold text-slate-700 mb-1.5">{t.univ_year}:</label>
          <input
            type="number"
            id="degYear"
            required
            min="2000"
            max="2035"
            placeholder="2026"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 font-mono text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div class="sm:col-span-2 md:col-span-3 pt-2 flex flex-wrap items-center gap-3">
          <button
            type="submit"
            id="issueSubmitBtn"
            class="h-10 px-5 rounded bg-[#0F2942] hover:bg-[#1E3A8A] disabled:bg-slate-300 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm cursor-pointer"
          >
            {t.univ_sign_btn}
          </button>
          <button
            type="button"
            id="batchSignBtn"
            class="h-10 px-4 rounded bg-slate-100 hover:bg-slate-200 disabled:bg-slate-200 border border-slate-300 text-slate-700 font-semibold text-xs sm:text-sm transition-colors cursor-pointer"
          >
            {t.univ_batch_sign_btn}
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Accessible In-Page Modal Dialog for Statutory Degree Revocation -->
  <div
    id="revokeModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="revokeModalTitle"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4"
  >
    <div class="bg-white border border-slate-200 rounded-md shadow-xl max-w-lg w-full overflow-hidden">
      <div class="bg-red-50 border-b border-red-200 px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span>
          <h3 id="revokeModalTitle" class="text-sm sm:text-base font-bold text-red-950">
            {t.univ_revocation_heading}
          </h3>
        </div>
        <button
          type="button"
          id="closeRevokeModalBtn"
          aria-label={t.ui_close}
          class="text-slate-500 hover:text-slate-800 text-lg font-bold px-1 cursor-pointer"
        >
          &times;
        </button>
      </div>

      <div class="p-5 space-y-4 text-xs sm:text-sm">
        <div class="bg-slate-50 border border-slate-200 rounded p-3 font-mono text-xs text-slate-700">
          <div>ID: <strong id="revokeTargetId" class="text-slate-900">--</strong></div>
          <div class="mt-0.5">{t.univ_student_name}: <strong id="revokeTargetCandidate" class="text-slate-900">--</strong></div>
        </div>

        <div>
          <label for="revokeReasonSelect" class="block font-semibold text-slate-700 mb-1.5">
            Select Preset Reason (or enter custom below):
          </label>
          <select
            id="revokeReasonSelect"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-600"
          >
            <option value="">-- Select Statutory Revocation Preset --</option>
            <option value="Academic Integrity Violation detected during AICTE quota inspection.">
              AICTE Quota Overrun / Unapproved Seat Admission
            </option>
            <option value="Concurrent dual-institution enrollment violation under UGC/AICTE norms.">
              Concurrent Dual-Institution Enrollment Anomaly
            </option>
            <option value="Fraudulent admission credentials or forged qualifying mark sheets.">
              Forged Qualifying Credentials / Discrepancy
            </option>
            <option value="University Executive Council disciplinary revocation order.">
              University Executive Council Disciplinary Order
            </option>
          </select>
