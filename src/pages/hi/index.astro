    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5">
      {portals.map((p, index) => {
        const isPublic = p.isPublic;
        const targetUrl = user
          ? p.path
          : isPublic
          ? '/verifier'
          : `/login?redirect=${encodeURIComponent(p.path)}`;
        const actionText = user
          ? 'पोर्टल खोलें →'
          : isPublic
          ? 'सत्यापन टर्मिनल खोलें →'
          : 'अधिकारी लॉगिन →';

        const colSpanClass = index < 3 ? 'lg:col-span-2' : 'lg:col-span-3';

        return (
          <div
            class={`${colSpanClass} bg-white rounded-lg border shadow-xs flex flex-col justify-between transition-all ${
              isPublic
                ? 'border-emerald-600 ring-1 ring-emerald-500/30 hover:border-emerald-700'
                : 'border-slate-200 hover:border-[#0F2942]'
            }`}
          >
            <div class="p-5 sm:p-6">
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono font-bold bg-slate-100 text-[#0F2942] px-2.5 py-0.5 rounded border border-slate-300">
                  {p.code}
                </span>
                {isPublic ? (
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200">
                    सार्वजनिक खुला एक्सेस
                  </span>
                ) : (
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-amber-50 text-amber-900 border border-amber-200">
                    अधिकारी प्रमाणीकरण आवश्यक
                  </span>
                )}
              </div>

              <h3 class="text-base font-bold text-[#0F2942] mb-2 leading-snug">
                {p.title}
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                {p.description}
              </p>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500 font-medium">वैधानिक क्षमता:</span>
                <span class="font-bold text-slate-800">{p.stats}</span>
              </div>
            </div>

            <div class={`p-4 border-t mt-auto ${isPublic ? 'bg-emerald-50/50 border-emerald-100' : 'bg-slate-50 border-slate-100'}`}>
              <a
                href={targetUrl}
                class={`block w-full text-center text-xs sm:text-sm font-bold py-2.5 px-4 rounded transition-colors shadow-xs ${
                  isPublic
                    ? 'bg-[#138808] hover:bg-[#0E6506] text-white'
                    : 'bg-[#0F2942] hover:bg-[#1E3A8A] text-white'
                }`}
              >
                {actionText}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 5. Statutory Architecture & Audit Baseline in Hindi -->
