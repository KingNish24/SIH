              <h3 class="text-base font-bold text-[#0F2942] mb-2 leading-snug">
                {p.title}
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                {p.description}
              </p>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
