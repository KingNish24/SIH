                          {isOverrun ? (
                            <button
                              type="button"
                              data-action-notice={i.code}
                              data-action-name={`${i.name} (${i.code})`}
                              class={`px-3 py-1.5 rounded-lg border font-semibold text-xs transition-colors cursor-pointer whitespace-nowrap ${
                                i.status === 'SHOW_CAUSE_ISSUED'
                                  ? 'bg-red-900 text-white border-red-950'
                                  : 'bg-red-50 hover:bg-red-100 border-red-300 text-red-800'
                              }`}
                            >
                              {i.status === 'SHOW_CAUSE_ISSUED' ? 'Notice Issued ✓' : 'Issue Notice'}
                            </button>
                          ) : (
                            <button
                              type="button"
                              data-prefill-notice-code={i.code}
                              data-prefill-notice-name={i.name}
                              data-action-docket={`${i.name} (${i.code}) — ${i.current_enrollment}/${i.sanctioned_intake}`}
                              class="px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 border border-slate-300 text-[#0B1E48] font-semibold text-xs transition-colors cursor-pointer whitespace-nowrap"
                            >
                              Issue Notice
                            </button>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
