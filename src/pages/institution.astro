---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import { maskApaar, type Institution, type Student, type Admission } from '../lib/types';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = getUIDictionary(lang);

const db = getDB(Astro.locals);
const user = Astro.locals.user;

const isTenantLocked = user?.role === 'INSTITUTE_ADMIN' && !!user?.institution_id;
const targetInstId = isTenantLocked ? user.institution_id : null;

const allInstRes = await db.prepare('SELECT * FROM institutions ORDER BY id ASC').bind().all<Institution>();
const allInstitutions = allInstRes.results || [];

let institutions: Institution[] = [];
if (targetInstId) {
  const instRes = await db.prepare('SELECT * FROM institutions WHERE id = ?').bind(targetInstId).all<Institution>();
  institutions = instRes.results || [];
} else {
  institutions = allInstitutions;
}

const collegeA = institutions.find((i) => i.id === (targetInstId || 'INST-001')) || institutions[0] || {
  id: targetInstId || 'INST-001',
  name: 'Technical Institute of Engineering, Pune',
  code: 'TCA-1049',
  sanctioned_intake: 180,
  current_enrollment: 187,
  status: 'OVERRUN_RISK',
  risk_score: 94.2,
  state: 'Maharashtra',
  district: 'Pune',
};

// Fetch live enrolled students for collegeA and cross-college admissions
const instAdmissionsRes = await db
  .prepare('SELECT * FROM admissions WHERE institution_id = ?')
  .bind(collegeA.id)
  .all<Admission>();
const rawInstAdmissions = instAdmissionsRes.results || [];

const allStudentsRes = await db.prepare('SELECT * FROM students').bind().all<Student>();
const allStudents = allStudentsRes.results || [];
const studentByApaar = new Map<string, Student>(allStudents.map((s) => [s.apaar_id, s]));

const allAdmissionsRes = await db.prepare('SELECT * FROM admissions').bind().all<Admission>();
const allAdmissions = allAdmissionsRes.results || [];
const instMap = new Map<string, Institution>(allInstitutions.map((i) => [i.id, i]));

const initialAdmissions = rawInstAdmissions.map((adm, idx) => {
  const st = studentByApaar.get(adm.apaar_id);
  const otherColleges = allAdmissions
    .filter((other) => other.apaar_id === adm.apaar_id && other.institution_id !== adm.institution_id)
    .map((other) => {
      const otherInst = instMap.get(other.institution_id);
      return otherInst ? `${otherInst.name.split('(')[0].trim()} (${other.institution_id})` : other.institution_id;
    });
  const isCrossDuplicate = Boolean(adm.is_duplicate) || adm.status === 'FLAGGED_DUPLICATE' || otherColleges.length > 0;
  const branchShort = (adm.program || 'CSE').includes('Mechanical')
    ? 'MECH'
    : (adm.program || 'CSE').includes('Information')
      ? 'IT'
      : (adm.program || 'CSE').includes('Electronics')
        ? 'ENTC'
        : 'CSE';
  const rollId = adm.id?.startsWith('ADM-')
    ? `${collegeA.id}-${adm.batch_year || 2024}-${branchShort}-${String(idx + 1).padStart(3, '0')}`
    : adm.id || `${collegeA.id}-${adm.batch_year || 2024}-CSE-${String(idx + 1).padStart(3, '0')}`;

  return {
    id: adm.id,
    apaar_id: adm.apaar_id,
    masked_apaar: maskApaar(adm.apaar_id),
    roll_id: rollId,
    full_name: st?.full_name || adm.student_name || `Student ${idx + 1}`,
    email: st?.email || `${adm.apaar_id.slice(-4)}@college.edu.in`,
    dpdp_consent_status: st?.dpdp_consent_status || 'GRANTED',
    program: adm.program || 'B.Tech Computer Science',
    batch_year: adm.batch_year || 2024,
    enrollment_date: adm.enrollment_date || '2024-07-15',
    status: isCrossDuplicate ? 'FLAGGED_DUPLICATE' : adm.status || 'ENROLLED',
    is_duplicate: isCrossDuplicate,
    other_colleges: otherColleges,
    quota_label: idx % 3 === 1 ? 'Supernumerary (TFW/EWS)' : 'Approved Intake',
  };
});

const duplicateCount = initialAdmissions.filter((a) => a.is_duplicate).length;

const initialDiff = collegeA.current_enrollment - collegeA.sanctioned_intake;
const initialIsOverrun = initialDiff > 0;
const initialPct = ((collegeA.current_enrollment / Math.max(1, collegeA.sanctioned_intake)) * 100).toFixed(1);
const initialBarWidth = Math.min(100, (collegeA.current_enrollment / Math.max(1, collegeA.sanctioned_intake)) * 100).toFixed(1);

// Deterministic statutory category breakdown per institution (AICTE APH 2024-27 Norms)
function computeCategoryBreakdown(sanctioned: number, current: number) {
  const supernumerary = Math.round(sanctioned * 0.15); // 15% TFW / EWS / PMSSS
  const nri = Math.round(sanctioned * 0.05); // 5% NRI quota
  const oci = Math.max(1, Math.round(sanctioned * 0.02)); // 2% OCI status
  const fn = Math.max(1, Math.round(sanctioned * 0.03)); // 3% Foreign National (FN)
  return {
    approvedIntake: sanctioned,
    actualEnrolment: current,
    supernumerary,
    nri,
    oci,
    fn,
  };
}

const initialCat = computeCategoryBreakdown(collegeA.sanctioned_intake, collegeA.current_enrollment);

const clientI18n = {
  langPrefix,
  statusCompliant: t.inst_status_compliant,
  statusOverrun: t.inst_status_overrun,
  kpiSanctioned: t.inst_kpi_sanctioned,
  validApaar: t.inst_triage_valid,
  missingApaar: t.inst_triage_missing,
  malformedApaar: t.inst_triage_malformed,
  syncBtn: t.inst_sync_btn,
  catSupernumerary: t.inst_cat_supernumerary,
  catNri: t.inst_cat_nri,
  catOci: t.inst_cat_oci,
  catFn: t.inst_cat_fn,
};
---

<Layout title={`SIH 2026 | ${t.inst_page_title}`} activeRole="institution" lang={lang} breadcrumb={t.crumb_institution}>
  <div
    class="space-y-6"
    id="instPageRoot"
    data-i18n-client={JSON.stringify(clientI18n)}
    data-initial-admissions={JSON.stringify(initialAdmissions)}
    data-college-id={collegeA.id}
  >
    <!-- 1. CLEAN CIVIC HEADER ROW (No eyebrow above H1, No redundant second lock banner) -->
    <div class="pb-4 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B1E48] tracking-[-0.02em]">
          {t.inst_page_title}
        </h1>
        <p class="text-xs sm:text-sm text-[#334155] mt-1 max-w-[68ch]">
          {t.inst_subtitle}
        </p>
      </div>

      <!-- Right Controls: Active Institution Pill, Nodal Scope Lock, and 1-Click Evaluator Cap Reset -->
      <div class="flex flex-wrap lg:flex-nowrap items-center gap-2 shrink-0">
        <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 text-xs">
          <label for="activeCollege" class="font-bold text-slate-600 whitespace-nowrap">
            {t.inst_select_label}
          </label>
          {isTenantLocked ? (
            <div class="flex items-center gap-2">
              <select
                id="activeCollege"
                data-institution-id={collegeA.id}
                class="h-8 max-w-[18rem] bg-slate-100 border border-slate-300 rounded-lg px-2.5 text-[#0B1E48] font-bold focus:outline-none text-xs truncate"
              >
                <option
                  value={collegeA.id}
                  data-name={collegeA.name}
                  data-sanctioned={collegeA.sanctioned_intake}
                  data-current={collegeA.current_enrollment}
                  data-code={collegeA.code}
                  data-state={collegeA.state}
                  data-district={collegeA.district}
                  selected
                >
                  {collegeA.name} ({collegeA.current_enrollment}/{collegeA.sanctioned_intake})
                </option>
              </select>
              <span
                class="inline-flex items-center gap-1 bg-[#EEF4FF] text-[#0B4EA2] border border-blue-200 px-2 py-1 rounded-lg text-[11px] font-bold whitespace-nowrap"
                title={`Authenticated Nodal Officer: ${user?.username || 'principal.pune'}`}
              >
                <svg class="w-3.5 h-3.5 text-[#0B4EA2] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span>{collegeA.id}</span>
              </span>
            </div>
          ) : (
            <select
              id="activeCollege"
              data-institution-id={collegeA.id}
              class="h-8 max-w-[20rem] bg-slate-50 border border-slate-300 rounded-lg px-2.5 text-[#0B1E48] font-bold focus:outline-none focus:ring-2 focus:ring-[#0B4EA2] text-xs"
            >
              {institutions.map((i) => (
                <option
                  value={i.id}
                  data-name={i.name}
                  data-sanctioned={i.sanctioned_intake}
                  data-current={i.current_enrollment}
                  data-code={i.code}
                  data-state={i.state}
                  data-district={i.district}
                  selected={i.id === collegeA.id}
                >
                  {i.name} ({i.current_enrollment}/{i.sanctioned_intake})
                </option>
              ))}
            </select>
          )}
        </div>

        <button
          type="button"
          id="normalizeIntakeBtn"
          class="inline-flex items-center gap-1.5 h-9 px-3 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-950 border border-amber-300 text-xs font-extrabold transition-colors cursor-pointer whitespace-nowrap"
          title="Reset demo seat count to 172/180 so you can test live within-cap student registration"
        >
          <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Reset Cap (172/180)</span>
        </button>
      </div>
    </div>

    <!-- Dynamic Regulatory Error / Duplicate Alert Banner (Hidden by default, shown on 409 Overrun or Duplicate Detection) -->
    <div id="syncFeedbackAlert" class="hidden rounded-xl border p-4 text-xs sm:text-sm" role="alert" aria-live="assertive"></div>

    <!-- 2. UNIFIED SEAT CAPACITY & QUOTA STRIP CARD -->
    <section class="rounded-2xl bg-white border border-slate-200 overflow-hidden">
      <!-- Top Royal Blue Header Strip -->
      <div class="bg-gradient-to-r from-[#0B1E48] via-[#1E40AF] to-[#0A2760] text-white px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex flex-wrap items-center gap-2.5">
            <h2 id="meterCollegeName" class="text-base sm:text-lg font-extrabold text-white tracking-tight">
              {collegeA.name}
            </h2>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/15 text-blue-100 text-[11px] font-mono font-semibold">
              <span>{t.aicte_col_code}:</span>
              <strong id="meterCollegeCode" class="text-white">{collegeA.code}</strong>
            </span>
          </div>
          <p class="text-xs text-blue-100 flex flex-wrap items-center gap-2">
            <span id="meterLocationText">{collegeA.state} · {collegeA.district}</span>
            <span aria-hidden="true">·</span>
            <span>
              {t.inst_kpi_sanctioned}: <strong id="meterCap" class="font-mono text-white">{collegeA.sanctioned_intake}</strong>
            </span>
            {user && (
              <>
                <span aria-hidden="true">·</span>
                <span>Nodal Officer: <strong class="font-mono text-white">{user.username}</strong></span>
              </>
            )}
          </p>
        </div>

        <div class="flex items-center gap-2.5 self-start sm:self-center">
          <span
            id="meterBadge"
            role="status"
            aria-live="polite"
            class={`text-xs font-extrabold px-3 py-1 rounded-full border ${
              initialIsOverrun
                ? 'bg-red-100 text-red-900 border-red-200'
                : 'bg-emerald-100 text-emerald-900 border-emerald-200'
            }`}
          >
            {initialIsOverrun
              ? `${t.inst_status_overrun} (+${initialDiff})`
              : `${t.inst_status_compliant} (${collegeA.sanctioned_intake - collegeA.current_enrollment} Left)`}
          </span>
        </div>
      </div>

      <!-- Card Body: Seat Utilization Bar & Integrated 6-Segment Quota Breakdown -->
      <div class="p-6">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="space-y-1 max-w-md">
            <h3 class="text-sm font-extrabold text-[#0B1E48]">
              {t.inst_kpi_utilization} &amp; Statutory Intake Ceiling
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Admissions above the AICTE sanctioned ceiling (<span class="font-mono font-semibold text-slate-800">{collegeA.sanctioned_intake}</span> seats) are automatically blocked with HTTP 409 before ledger commit.
            </p>
          </div>

          <div class="flex-1 max-w-2xl">
            <div class="flex justify-between items-baseline mb-2 text-xs sm:text-sm">
              <span class="font-bold text-slate-700">{t.inst_kpi_utilization}</span>
              <div class="text-right">
                <span
                  id="meterEnrolled"
                  class={`text-xl font-extrabold font-mono ${initialIsOverrun ? 'text-red-600' : 'text-emerald-700'}`}
                >
                  {collegeA.current_enrollment}
                </span>
                <span class="text-slate-400 font-mono"> / </span>
                <span id="meterSanctioned" class="text-sm font-bold font-mono text-slate-700">{collegeA.sanctioned_intake}</span>
                <span
                  id="meterExcessText"
                  class={`ml-2 font-bold font-mono ${initialIsOverrun ? 'text-red-600' : 'text-emerald-700'}`}
                >
                  {initialIsOverrun ? `(+${initialDiff})` : `(${initialDiff})`}
                </span>
              </div>
            </div>

            <!-- Accessible Progress Bar (WCAG 2.1 AA) -->
            <div class="w-full bg-slate-100 rounded-full h-3.5 border border-slate-200 overflow-hidden relative">
              <div
                id="meterProgressBar"
                role="progressbar"
                aria-label={t.inst_kpi_utilization}
                aria-valuenow={Number(initialPct)}
                aria-valuemin={0}
                aria-valuemax={100}
                class={`h-full transition-all duration-300 ${initialIsOverrun ? 'bg-red-600' : 'bg-emerald-600'}`}
                style={`width: ${initialBarWidth}%;`}
              ></div>
            </div>

            <div class="flex justify-between text-[11px] sm:text-xs text-slate-600 mt-1.5 font-mono">
              <span>0 Seats</span>
              <span id="meterSanctionedLabel" class="font-semibold text-slate-700">
                {t.inst_kpi_sanctioned}: {collegeA.sanctioned_intake}
              </span>
              <span
                id="meterPercent"
                class={`font-bold ${initialIsOverrun ? 'text-red-700' : 'text-emerald-700'}`}
              >
                {initialPct}% ({initialIsOverrun ? t.inst_status_overrun : t.inst_status_compliant})
              </span>
            </div>
          </div>
        </div>

        <!-- Integrated AICTE APH 2024–27 Quota Breakdown Row -->
        <div class="mt-6 pt-5 border-t border-slate-200/90">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="text-xs font-bold text-[#0B1E48] flex items-center gap-2">
              <svg class="w-4 h-4 text-[#1E40AF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>{t.inst_cat_heading} (AICTE Approval Process Handbook 2024–27)</span>
            </div>
            <span class="text-[11px] font-mono font-semibold bg-slate-100 text-slate-700 border border-slate-200 px-2.5 py-0.5 rounded-md">
              APH Chapter II &amp; VII Norms
            </span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 divide-y sm:divide-y-0 sm:divide-x divide-slate-200 bg-slate-50/70 rounded-xl border border-slate-200/90 overflow-hidden">
            <div class="p-3.5">
              <div class="text-xs font-semibold text-slate-600">Approved Intake</div>
              <div id="catApprovedIntake" class="text-lg font-extrabold font-mono text-[#0B1E48] mt-1">
                {initialCat.approvedIntake}
              </div>
              <div class="text-[11px] text-slate-500 mt-0.5">Sanctioned Cap</div>
            </div>

            <div class="p-3.5">
              <div class="text-xs font-semibold text-slate-600">Students Admitted</div>
              <div
                id="catActualEnrolment"
                class={`text-lg font-extrabold font-mono mt-1 ${initialIsOverrun ? 'text-red-600' : 'text-emerald-700'}`}
              >
                {initialCat.actualEnrolment}
              </div>
              <div class="text-[11px] text-slate-500 mt-0.5">APAAR Anchored</div>
            </div>

            <div class="p-3.5">
              <div class="text-xs font-semibold text-slate-600">Supernumerary (15%)</div>
              <div id="catSupernumerary" class="text-lg font-extrabold font-mono text-[#0B4EA2] mt-1">
                {initialCat.supernumerary}
              </div>
              <div class="text-[11px] text-slate-500 mt-0.5">TFW / EWS / PMSSS</div>
            </div>

            <div class="p-3.5">
              <div class="text-xs font-semibold text-slate-600">NRI Quota (5%)</div>
              <div id="catNri" class="text-lg font-extrabold font-mono text-amber-800 mt-1">
                {initialCat.nri}
              </div>
              <div class="text-[11px] text-slate-500 mt-0.5">Max 5% Ceiling</div>
            </div>

            <div class="p-3.5">
              <div class="text-xs font-semibold text-slate-600">OCI Quota (2%)</div>
              <div id="catOci" class="text-lg font-extrabold font-mono text-indigo-800 mt-1">
                {initialCat.oci}
              </div>
              <div class="text-[11px] text-slate-500 mt-0.5">Max 2% Ceiling</div>
            </div>

            <div class="p-3.5">
              <div class="text-xs font-semibold text-slate-600">Foreign Nationals (3%)</div>
              <div id="catFn" class="text-lg font-extrabold font-mono text-emerald-800 mt-1">
                {initialCat.fn}
              </div>
              <div class="text-[11px] text-slate-500 mt-0.5">PIO / FN Quota</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. 12-COLUMN OPERATIONAL WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left 4 Columns: Unified Student Registration & Batch Upload Card -->
      <div class="lg:col-span-4">
        <div class="rounded-2xl bg-white border border-slate-200 overflow-hidden">
          <!-- 2-Tab Segmented Control -->
          <div class="p-3 bg-slate-50 border-b border-slate-200">
            <div class="grid grid-cols-2 gap-1 p-1 bg-slate-200/75 rounded-xl" role="tablist" aria-label="Student Admission Ingestion Mode">
              <button
                type="button"
                id="tabSingleEntryBtn"
                role="tab"
                aria-selected="true"
                aria-controls="panelSingleEntry"
                class="py-2 px-3 rounded-lg text-xs font-extrabold transition-all bg-white text-[#0B1E48] shadow-2xs cursor-pointer flex items-center justify-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 text-[#0B4EA2] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
                <span>Single Student</span>
              </button>
              <button
                type="button"
                id="tabBulkCsvBtn"
                role="tab"
                aria-selected="false"
                aria-controls="panelBulkCsv"
                class="py-2 px-3 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center justify-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <span>Bulk CSV &amp; Demo</span>
              </button>
            </div>
          </div>

          <!-- TAB 1: Single Student Entry Form -->
          <div id="panelSingleEntry" role="tabpanel" class="p-5 space-y-4">
            <div>
              <h3 class="text-sm font-extrabold text-[#0B1E48]">
                Register Admitted Student by APAAR ID
              </h3>
              <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">
                Verify and commit an individual student admission directly into the college roster.
              </p>
            </div>

            <form id="singleStudentForm" class="space-y-3.5">
              <div>
                <div class="flex items-center justify-between gap-2 mb-1">
                  <label for="singleApaarInput" class="block text-xs font-bold text-slate-800">
                    12-Digit APAAR ID
                  </label>
                  <button
                    type="button"
                    id="btnGenSingleApaar"
                    class="inline-flex items-center gap-1 text-[11px] font-extrabold text-[#0B4EA2] hover:underline cursor-pointer"
                  >
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span>Generate Sample ID</span>
                  </button>
                </div>
                <input
                  type="text"
                  id="singleApaarInput"
                  name="apaar_id"
                  required
                  pattern="\d{12}"
                  maxlength="12"
                  inputmode="numeric"
                  placeholder="849201394812"
                  class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 font-mono text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                />
              </div>

              <div>
                <label for="singleNameInput" class="block text-xs font-bold text-slate-800 mb-1">
                  Student Full Name
                </label>
                <input
                  type="text"
                  id="singleNameInput"
                  name="full_name"
                  required
                  placeholder="e.g. Siddharth Kulkarni"
                  class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                />
              </div>

              <div>
                <label for="singleProgramSelect" class="block text-xs font-bold text-slate-800 mb-1">
                  Program / Branch
                </label>
                <select
                  id="singleProgramSelect"
                  name="program"
                  class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                >
                  <option value="B.Tech Computer Science & Engineering">B.Tech CSE</option>
                  <option value="B.Tech Information Technology">B.Tech IT</option>
                  <option value="B.Tech Electronics & Telecommunication">B.Tech E&amp;TC</option>
                  <option value="B.Tech Artificial Intelligence & Data Science">B.Tech AI &amp; DS</option>
                  <option value="B.Tech Mechanical Engineering">B.Tech Mechanical</option>
                </select>
              </div>

              <div>
                <label for="singleQuotaSelect" class="block text-xs font-bold text-slate-800 mb-1">
                  Admission Quota
                </label>
                <select
                  id="singleQuotaSelect"
                  name="admission_category"
                  class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                >
                  <option value="APPROVED_INTAKE">APPROVED_INTAKE (Regular Cap)</option>
                  <option value="SUPERNUMERARY">SUPERNUMERARY (TFW / EWS 15%)</option>
                  <option value="NRI">NRI (Non-Resident Indian 5%)</option>
                  <option value="OCI">OCI (Overseas Citizen 2%)</option>
                  <option value="FN">FN (Foreign National 3%)</option>
                </select>
              </div>

              <button
                type="submit"
                id="singleSubmitBtn"
                class="w-full h-11 rounded-xl bg-[#0B4EA2] hover:bg-[#093A82] text-white font-extrabold text-xs sm:text-sm transition-colors flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Register Student in Roster</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
                </svg>
              </button>
            </form>
          </div>

          <!-- TAB 2: Bulk CSV Upload & Evaluator Demo Batches -->
          <div id="panelBulkCsv" role="tabpanel" class="hidden p-5 space-y-4">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <h3 class="text-sm font-extrabold text-[#0B1E48]">
                  {t.inst_upload_heading}
                </h3>
                <span class="text-[11px] font-mono font-semibold bg-blue-50 text-[#0B4EA2] border border-blue-200 px-2 py-0.5 rounded-md">
                  CSV Batch
                </span>
              </div>
              <p class="text-xs text-slate-600 mb-3 leading-relaxed">
                {t.inst_upload_sub}
              </p>

              <label
                for="csvFileInput"
                tabindex="0"
                aria-describedby="csvSchemaHint"
                class="border-2 border-dashed border-slate-300 hover:border-[#0B4EA2] hover:bg-blue-50/40 rounded-xl p-4 text-center cursor-pointer flex flex-col items-center justify-center bg-slate-50 transition-all group"
              >
                <div class="w-9 h-9 rounded-full bg-white border border-slate-200 flex items-center justify-center mb-2 group-hover:border-blue-300">
                  <svg class="w-4 h-4 text-[#0B1E48] group-hover:text-[#0B4EA2] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                  </svg>
                </div>
                <span class="text-xs font-bold text-[#0B1E48] group-hover:text-[#0B4EA2]">{t.inst_upload_dropzone}</span>
                <span id="csvSchemaHint" class="text-[11px] font-mono text-slate-500 mt-1">
                  apaar_id, student_roll_id, full_name, program, batch_year, admission_category
                </span>
                <input type="file" id="csvFileInput" accept=".csv" class="hidden" />
              </label>

              <div class="mt-2.5 flex items-center justify-between">
                <span class="text-[11px] text-slate-500 font-mono">aicte_roster_v1.csv</span>
                <button
                  type="button"
                  id="downloadSampleCsvBtn"
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0B4EA2] hover:text-[#0B1E48] underline underline-offset-2 transition-colors cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  <span>CSV Template (5 Rows)</span>
                </button>
              </div>
            </div>

            <!-- 1-Click Evaluator Sample Batches -->
            <div class="pt-3 border-t border-slate-200/80 space-y-2">
              <div class="text-xs font-extrabold text-[#0B1E48]">
                1-Click Evaluator Test Batches
              </div>
              <button
                type="button"
                id="loadOverrunSampleBtn"
                class="w-full text-left px-3.5 py-2.5 rounded-xl bg-red-50/70 hover:bg-red-50 border border-red-200 transition-colors flex items-center justify-between group cursor-pointer"
              >
                <div>
                  <div class="text-xs font-extrabold text-red-900">{t.s7_try}</div>
                  <div class="text-[11px] text-red-800/80 mt-0.5 font-mono">187 Students / 180 Seat Limit (+7 Over Cap)</div>
                </div>
                <span class="text-[11px] font-mono font-bold bg-red-100 text-red-900 px-2 py-0.5 rounded-md border border-red-200 shrink-0">
                  187
                </span>
              </button>

              <button
                type="button"
                id="loadCompliantSampleBtn"
                class="w-full text-left px-3.5 py-2.5 rounded-xl bg-emerald-50/70 hover:bg-emerald-50 border border-emerald-200 transition-colors flex items-center justify-between group cursor-pointer"
              >
                <div>
                  <div class="text-xs font-extrabold text-emerald-900">Load 15-Student Within-Limit Batch</div>
                  <div class="text-[11px] text-emerald-800/80 mt-0.5 font-mono">15 Valid 12-Digit APAAR Records</div>
                </div>
                <span class="text-[11px] font-mono font-bold bg-emerald-100 text-emerald-900 px-2 py-0.5 rounded-md border border-emerald-200 shrink-0">
                  15
                </span>
              </button>
            </div>
          </div>

          <!-- Collapsible REST API Spec cleanly tucked at bottom of Left Card -->
          <div class="p-4 bg-slate-50 border-t border-slate-200">
            <details class="group">
              <summary class="text-xs font-bold text-[#0B1E48] cursor-pointer flex items-center justify-between select-none">
                <span class="flex items-center gap-2">
                  <span class="font-mono text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-md">
                    POST /api/roster/sync
                  </span>
                  <span>{t.inst_api_tab_title}</span>
                </span>
                <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="text-[11px] text-slate-600 mt-2 mb-2 leading-relaxed">
                {t.inst_api_tab_sub}
              </p>
              <div class="p-3 bg-slate-950 text-emerald-300 font-mono text-[10px] leading-relaxed overflow-x-auto rounded-xl">
<pre>{`POST /api/roster/sync HTTP/1.1
Content-Type: application/json

{
  "institutionId": "${collegeA.id}",
  "students": [
    {
      "apaar_id": "901238471920",
      "student_roll_id": "INST-2024-CSE-001",
      "full_name": "Aarav Sharma",
      "program": "B.Tech Computer Science",
      "batch_year": 2024,
      "admission_category": "APPROVED_INTAKE"
    }
  ]
}`}</pre>
              </div>
            </details>
          </div>
        </div>
      </div>

      <!-- Right 8 Columns: Live Enrolled Roster & Staged Batch Triage Table Card -->
      <div class="lg:col-span-8">
        <div class="rounded-2xl bg-white border border-slate-200 overflow-hidden">
          <!-- Card Header with View Switcher (Enrolled Roster vs Staged Batch Triage) -->
          <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between gap-3">
            <div class="inline-flex items-center p-1 rounded-xl bg-slate-100" role="tablist" aria-label="Roster Table View">
              <button
                type="button"
                id="viewEnrolledTabBtn"
                role="tab"
                aria-selected="true"
                class="px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition-all bg-[#0B1E48] text-white cursor-pointer flex items-center gap-2"
              >
                <span>Current Enrolled Roster</span>
                <span
                  id="enrolledCountPill"
                  class="px-2 py-0.5 rounded-full bg-white/20 text-white font-mono text-[11px]"
                >
                  {initialAdmissions.length}
                </span>
              </button>

              <button
                type="button"
                id="viewTriageTabBtn"
                role="tab"
                aria-selected="false"
                class="px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center gap-2"
              >
                <span>Staged Batch Triage</span>
                <span
                  id="stagedCountPill"
                  class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-800 font-mono text-[11px]"
                >
                  0
                </span>
              </button>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              {duplicateCount > 0 && (
                <span
                  id="duplicateAlertPill"
                  class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-amber-50 text-amber-900 border border-amber-200 text-xs font-bold whitespace-nowrap"
                >
                  <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span>{duplicateCount} Duplicate Alert{duplicateCount > 1 ? 's' : ''}</span>
                </span>
              )}

              <button
                type="button"
                id="commitSyncBtn"
                disabled
                class="hidden h-9 px-3.5 rounded-xl bg-[#0B4EA2] hover:bg-[#093A82] disabled:bg-slate-200 disabled:text-slate-500 disabled:cursor-not-allowed text-white text-xs font-extrabold transition-colors cursor-pointer items-center gap-1.5 whitespace-nowrap"
              >
                <span>{t.inst_sync_btn}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Triage Summary Strip (Shown in Staged Batch Triage view) -->
          <div
            id="triageSummaryStrip"
            class="hidden grid-cols-3 divide-x divide-slate-200 border-b border-slate-200 text-center py-2.5 bg-slate-50 text-xs"
            role="status"
            aria-live="polite"
          >
            <div>
              <span class="text-slate-600 font-semibold">{t.inst_triage_valid}:</span>
              <strong id="countValid" class="ml-1.5 text-emerald-700 font-mono text-sm">
                {initialAdmissions.length}
              </strong>
            </div>
            <div>
              <span class="text-slate-600 font-semibold">{t.inst_triage_malformed}:</span>
              <strong id="countMalformed" class="ml-1.5 text-red-700 font-mono text-sm">0</strong>
            </div>
            <div>
              <span class="text-slate-600 font-semibold">{t.inst_triage_missing}:</span>
              <strong id="countMissing" class="ml-1.5 text-amber-700 font-mono text-sm">0</strong>
            </div>
          </div>

          <!-- VIEW 1: Current Enrolled Roster (Visible by default on page load so table is never empty) -->
          <div
            id="enrolledRosterPanel"
            class="overflow-x-auto max-h-[30rem]"
            role="region"
            aria-label="Current Enrolled Student Roster"
            tabindex="0"
          >
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead class="bg-slate-100/90 text-slate-700 font-bold sticky top-0 border-b border-slate-200">
                <tr>
                  <th class="py-3 px-4">#</th>
                  <th class="py-3 px-4">{t.univ_apaar_id} &amp; Roll No.</th>
                  <th class="py-3 px-4">{t.univ_student_name}</th>
                  <th class="py-3 px-4">{t.univ_specialization}</th>
                  <th class="py-3 px-4">Batch &amp; Quota</th>
                  <th class="py-3 px-4">{t.aicte_col_status}</th>
                </tr>
              </thead>
              <tbody id="enrolledTableBody" class="divide-y divide-slate-200 text-slate-800">
                {initialAdmissions.map((adm, idx) => (
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="py-3.5 px-4 font-mono text-slate-500">{idx + 1}</td>
                    <td class="py-3.5 px-4">
                      <div class="font-mono font-bold text-[#0B1E48]">{adm.apaar_id}</div>
                      <div class="font-mono text-[11px] text-slate-500 mt-0.5">{adm.roll_id}</div>
                    </td>
                    <td class="py-3.5 px-4">
                      <div class="font-bold text-slate-900">{adm.full_name}</div>
                      <div class="text-[11px] text-slate-500 mt-0.5">
                        DPDP Consent: <span class="font-semibold text-slate-700">{adm.dpdp_consent_status}</span>
                      </div>
                    </td>
                    <td class="py-3.5 px-4 font-medium text-slate-700">{adm.program}</td>
                    <td class="py-3.5 px-4">
                      <div class="font-mono font-semibold text-slate-800">Batch {adm.batch_year}</div>
                      <div class="text-[11px] text-slate-500 mt-0.5">{adm.quota_label}</div>
                    </td>
                    <td class="py-3.5 px-4">
                      {adm.is_duplicate ? (
                        <div class="space-y-1">
                          <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 px-2.5 py-0.5 rounded-md border border-amber-300 font-bold text-[11px]">
                            <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <span>Cross-College Duplicate</span>
                          </span>
                          {adm.other_colleges.length > 0 && (
                            <div class="text-[11px] text-amber-800 font-medium">
                              Also enrolled in: {adm.other_colleges.join(', ')}
                            </div>
                          )}
                        </div>
                      ) : (
                        <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-800 px-2.5 py-0.5 rounded-md border border-emerald-200 font-bold text-[11px]">
                          <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>Verified Within Cap</span>
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- VIEW 2: Staged Batch Triage Panel (Activates when CSV or Demo Batch is loaded) -->
          <div
            id="triagePanel"
            class="hidden overflow-x-auto max-h-[30rem]"
            role="region"
            aria-label={t.inst_triage_heading}
            tabindex="0"
          >
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead class="bg-slate-100/90 text-slate-700 font-bold sticky top-0 border-b border-slate-200">
                <tr>
                  <th class="py-3 px-4">#</th>
                  <th class="py-3 px-4">{t.univ_apaar_id}</th>
                  <th class="py-3 px-4">{t.univ_student_name}</th>
                  <th class="py-3 px-4">{t.univ_specialization}</th>
                  <th class="py-3 px-4">{t.inst_cat_heading.split('(')[0].trim()}</th>
                  <th class="py-3 px-4">{t.aicte_col_status}</th>
                </tr>
              </thead>
              <tbody id="triageTableBody" class="divide-y divide-slate-200 text-slate-800">
                <tr>
                  <td colspan="6" class="py-10 px-4 text-center text-slate-500 text-xs sm:text-sm">
                    Select a CSV file or click one of the 1-click test batches on the left to stage records for triage.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentTriageData: any[] = [];

    const rootEl = document.getElementById('instPageRoot');
    const i18nClient = JSON.parse(rootEl?.getAttribute('data-i18n-client') || '{}');
    let enrolledList: any[] = JSON.parse(rootEl?.getAttribute('data-initial-admissions') || '[]');

    const collegeSelect = document.getElementById('activeCollege') as HTMLSelectElement;
    const csvFileInput = document.getElementById('csvFileInput') as HTMLInputElement;
    const downloadSampleCsvBtn = document.getElementById('downloadSampleCsvBtn');
    const loadOverrunBtn = document.getElementById('loadOverrunSampleBtn');
    const loadCompliantBtn = document.getElementById('loadCompliantSampleBtn');
    const commitBtn = document.getElementById('commitSyncBtn') as HTMLButtonElement;
    const tableBody = document.getElementById('triageTableBody')!;
    const enrolledTableBody = document.getElementById('enrolledTableBody')!;
    const feedbackAlert = document.getElementById('syncFeedbackAlert');

    // Left Card Tabs (Single Student vs Bulk CSV)
    const tabSingleEntryBtn = document.getElementById('tabSingleEntryBtn');
    const tabBulkCsvBtn = document.getElementById('tabBulkCsvBtn');
    const panelSingleEntry = document.getElementById('panelSingleEntry');
    const panelBulkCsv = document.getElementById('panelBulkCsv');

    function switchLeftMode(mode: 'single' | 'bulk') {
      if (!tabSingleEntryBtn || !tabBulkCsvBtn || !panelSingleEntry || !panelBulkCsv) return;
      if (mode === 'single') {
        tabSingleEntryBtn.setAttribute('aria-selected', 'true');
        tabBulkCsvBtn.setAttribute('aria-selected', 'false');
        tabSingleEntryBtn.className =
          'py-2 px-3 rounded-lg text-xs font-extrabold transition-all bg-white text-[#0B1E48] shadow-2xs cursor-pointer flex items-center justify-center gap-1.5';
        tabBulkCsvBtn.className =
          'py-2 px-3 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center justify-center gap-1.5';
        panelSingleEntry.classList.remove('hidden');
        panelBulkCsv.classList.add('hidden');
      } else {
        tabSingleEntryBtn.setAttribute('aria-selected', 'false');
        tabBulkCsvBtn.setAttribute('aria-selected', 'true');
        tabBulkCsvBtn.className =
          'py-2 px-3 rounded-lg text-xs font-extrabold transition-all bg-white text-[#0B1E48] shadow-2xs cursor-pointer flex items-center justify-center gap-1.5';
        tabSingleEntryBtn.className =
          'py-2 px-3 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center justify-center gap-1.5';
        panelSingleEntry.classList.add('hidden');
        panelBulkCsv.classList.remove('hidden');
      }
    }

    tabSingleEntryBtn?.addEventListener('click', () => switchLeftMode('single'));
    tabBulkCsvBtn?.addEventListener('click', () => switchLeftMode('bulk'));

    // Right Table View Switcher (Enrolled Roster vs Staged Batch Triage)
    const viewEnrolledTabBtn = document.getElementById('viewEnrolledTabBtn');
    const viewTriageTabBtn = document.getElementById('viewTriageTabBtn');
    const enrolledRosterPanel = document.getElementById('enrolledRosterPanel');
    const triagePanel = document.getElementById('triagePanel');
    const triageSummaryStrip = document.getElementById('triageSummaryStrip');
    const enrolledCountPill = document.getElementById('enrolledCountPill');
    const stagedCountPill = document.getElementById('stagedCountPill');

    function switchTableView(view: 'enrolled' | 'triage') {
      if (!viewEnrolledTabBtn || !viewTriageTabBtn || !enrolledRosterPanel || !triagePanel) return;
      if (view === 'enrolled') {
        viewEnrolledTabBtn.setAttribute('aria-selected', 'true');
        viewTriageTabBtn.setAttribute('aria-selected', 'false');
        viewEnrolledTabBtn.className =
          'px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition-all bg-[#0B1E48] text-white cursor-pointer flex items-center gap-2';
        viewTriageTabBtn.className =
          'px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center gap-2';
        enrolledRosterPanel.classList.remove('hidden');
        triagePanel.classList.add('hidden');
        triageSummaryStrip?.classList.add('hidden');
        triageSummaryStrip?.classList.remove('grid');
        commitBtn?.classList.add('hidden');
        commitBtn?.classList.remove('inline-flex');
      } else {
        viewEnrolledTabBtn.setAttribute('aria-selected', 'false');
        viewTriageTabBtn.setAttribute('aria-selected', 'true');
        viewTriageTabBtn.className =
          'px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition-all bg-[#0B1E48] text-white cursor-pointer flex items-center gap-2';
        viewEnrolledTabBtn.className =
          'px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center gap-2';
        triagePanel.classList.remove('hidden');
        enrolledRosterPanel.classList.add('hidden');
        triageSummaryStrip?.classList.remove('hidden');
        triageSummaryStrip?.classList.add('grid');
        commitBtn?.classList.remove('hidden');
        commitBtn?.classList.add('inline-flex');
      }
    }

    viewEnrolledTabBtn?.addEventListener('click', () => switchTableView('enrolled'));
    viewTriageTabBtn?.addEventListener('click', () => switchTableView('triage'));

    function showFeedbackBanner(html: string, tone: 'error' | 'warning' | 'success') {
      if (!feedbackAlert) return;
      feedbackAlert.classList.remove(
        'hidden',
        'bg-red-50',
        'border-red-300',
        'text-red-900',
        'bg-amber-50',
        'border-amber-300',
        'text-amber-900',
        'bg-emerald-50',
        'border-emerald-300',
        'text-emerald-900'
      );
      if (tone === 'error') {
        feedbackAlert.classList.add('bg-red-50', 'border-red-300', 'text-red-900');
      } else if (tone === 'warning') {
        feedbackAlert.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-900');
      } else {
        feedbackAlert.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-900');
      }
      feedbackAlert.innerHTML = html;
    }

    function updateCollegeMeter() {
      const opt = collegeSelect?.selectedOptions?.[0];
      if (!opt) return;

      const name = opt.getAttribute('data-name') || opt.textContent?.split(' (')[0] || '';
      const code = opt.getAttribute('data-code') || 'TCA-1049';
      const sanctioned = parseInt(opt.getAttribute('data-sanctioned') || '180', 10);
      const current = parseInt(opt.getAttribute('data-current') || '0', 10);
      const diff = current - sanctioned;
      const isOverrun = diff > 0;
      const pct = ((current / Math.max(1, sanctioned)) * 100).toFixed(1);
      const barWidth = Math.min(100, (current / Math.max(1, sanctioned)) * 100).toFixed(1);

      const badgeEl = document.getElementById('meterBadge');
      const nameEl = document.getElementById('meterCollegeName');
      const codeEl = document.getElementById('meterCollegeCode');
      const capEl = document.getElementById('meterCap');
      const enrolledEl = document.getElementById('meterEnrolled');
      const sanctionedEl = document.getElementById('meterSanctioned');
      const excessTextEl = document.getElementById('meterExcessText');
      const barEl = document.getElementById('meterProgressBar');
      const limitLabelEl = document.getElementById('meterSanctionedLabel');
      const pctEl = document.getElementById('meterPercent');

      if (nameEl) nameEl.textContent = name;
      if (codeEl) codeEl.textContent = code;
      if (capEl) capEl.textContent = String(sanctioned);
      if (enrolledEl) {
        enrolledEl.textContent = String(current);
        enrolledEl.className = `text-xl font-extrabold font-mono ${isOverrun ? 'text-red-600' : 'text-emerald-700'}`;
      }
      if (sanctionedEl) sanctionedEl.textContent = String(sanctioned);
      if (excessTextEl) {
        excessTextEl.textContent = isOverrun ? `(+${diff})` : `(${diff})`;
        excessTextEl.className = `ml-2 font-bold font-mono ${isOverrun ? 'text-red-600' : 'text-emerald-700'}`;
      }
      if (badgeEl) {
        badgeEl.textContent = isOverrun
          ? `${i18nClient.statusOverrun || 'Above Limit'} (+${diff})`
          : `${i18nClient.statusCompliant || 'Within Limit'} (${sanctioned - current} Left)`;
        badgeEl.className = `text-xs font-extrabold px-3 py-1 rounded-full border ${
          isOverrun
            ? 'bg-red-100 text-red-900 border-red-200'
            : 'bg-emerald-100 text-emerald-900 border-emerald-200'
        }`;
      }
      if (barEl) {
        barEl.style.width = `${barWidth}%`;
        barEl.setAttribute('aria-valuenow', String(pct));
        barEl.className = `h-full transition-all duration-300 ${isOverrun ? 'bg-red-600' : 'bg-emerald-600'}`;
      }
      if (limitLabelEl) limitLabelEl.textContent = `${i18nClient.kpiSanctioned || 'Approved Seat Limit'}: ${sanctioned}`;
      if (pctEl) {
        pctEl.textContent = `${pct}% (${isOverrun ? (i18nClient.statusOverrun || 'Above Limit') : (i18nClient.statusCompliant || 'Within Limit')})`;
        pctEl.className = `font-bold ${isOverrun ? 'text-red-700' : 'text-emerald-700'}`;
      }

      const catApprovedEl = document.getElementById('catApprovedIntake');
      const catActualEl = document.getElementById('catActualEnrolment');
      const catSuperEl = document.getElementById('catSupernumerary');
      const catNriEl = document.getElementById('catNri');
      const catOciEl = document.getElementById('catOci');
      const catFnEl = document.getElementById('catFn');

      if (catApprovedEl) catApprovedEl.textContent = String(sanctioned);
      if (catActualEl) {
        catActualEl.textContent = String(current);
        catActualEl.className = `text-lg font-extrabold font-mono mt-1 ${isOverrun ? 'text-red-600' : 'text-emerald-700'}`;
      }
      if (catSuperEl) catSuperEl.textContent = String(Math.round(sanctioned * 0.15));
      if (catNriEl) catNriEl.textContent = String(Math.round(sanctioned * 0.05));
      if (catOciEl) catOciEl.textContent = String(Math.max(1, Math.round(sanctioned * 0.02)));
      if (catFnEl) catFnEl.textContent = String(Math.max(1, Math.round(sanctioned * 0.03)));
    }

