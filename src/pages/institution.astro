                    class="flex-1 h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 font-mono text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                  />
                  <button
                    type="button"
                    id="btnVerifyApaar"
                    class="h-10 px-3.5 rounded-xl bg-[#0B1E48] hover:bg-[#1E3A8A] text-white font-extrabold text-xs transition-colors inline-flex items-center gap-1.5 shrink-0 cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span>Verify NDEAR</span>
                  </button>
                </div>

                <p class="text-[11px] text-slate-500 leading-relaxed">
