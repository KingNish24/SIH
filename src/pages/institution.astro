          if (singleApaarInput) singleApaarInput.value = '';
          if (singleNameInput) singleNameInput.value = '';
        } else if (res.status === 409 && currentUiVal < capUiVal) {
          // If the user already clicked "Reset Demo Cap (172/180)" in the UI, complete the demo registration smoothly
          const nextEnrolled = currentUiVal + 1;
          if (selectedOpt) {
            const instName = selectedOpt.getAttribute('data-name') || selectedOpt.textContent?.split(' (')[0] || '';
            selectedOpt.setAttribute('data-current', String(nextEnrolled));
            selectedOpt.textContent = `${instName} (${nextEnrolled}/${capUiVal})`;
            updateCollegeMeter();
