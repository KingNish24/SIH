{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sih",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vidya-db",
      "database_id": "f269a392-27ec-478c-9db1-0d88e077ab4c"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CHALLENGES",
      "id": "f5b1ba688be84ec3aef7a89bca85117b"
    },
    {
      "binding": "SESSION",
      "id": "f5b1ba688be84ec3aef7a89bca85117b"
    }
  ],
  // Workers Rate Limiting API (period must be 10 or 60 seconds; namespace_id is any account-unique integer string)
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "24001", "simple": { "limit": 5, "period": 60 } },
    { "name": "VERIFY_LIMITER", "namespace_id": "24002", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "24003", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  }
}
