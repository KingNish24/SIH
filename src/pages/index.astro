---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution } from '../lib/types';
import {
  EIGHTH_SCHEDULE_LANGUAGES,
  getLanguageInfo,
  getUIDictionary,
  isSupportedLang,
  type LangCode,
} from '../lib/i18n';

const resolvedLang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langInfo = getLanguageInfo(resolvedLang);
const t = getUIDictionary(resolvedLang);
const isIndic = resolvedLang !== 'en';
const langPrefix = resolvedLang === 'en' ? '' : `/${resolvedLang}`;

const db = getDB(Astro.locals);
const instRes = await db.prepare('SELECT * FROM institutions ORDER BY name ASC').bind().all<Institution>();
const institutions = instRes.results || [];
const user = Astro.locals.user;

const totalMonitored = institutions.length;
const overrunCount = institutions.filter((i) => i.current_enrollment > i.sanctioned_intake).length;
const compliantCount = totalMonitored - overrunCount;
const totalSanctioned = institutions.reduce((sum, i) => sum + (i.sanctioned_intake || 0), 0);
const totalEnrollment = institutions.reduce((sum, i) => sum + (i.current_enrollment || 0), 0);
const compliancePct = totalMonitored > 0 ? ((compliantCount / totalMonitored) * 100).toFixed(1) : '100.0';

const portals = [
  {
    role: 'institution',
    title: t.portal1Title,
    code: 'INST-01',
    description: t.portal1Desc,
    path: `${langPrefix}/institution`,
    badge: isIndic ? 'संस्थान प्रशासन' : 'Institution Portal',
    accent: 'border-t-[#0F766E]',
    btnClass: 'bg-[#0F2942] hover:bg-[#1E3A8A] text-white',
    isPublic: false,
  },
  {
    role: 'aicte',
    title: t.portal2Title,
    code: 'REG-02',
    description: t.portal2Desc,
    path: `${langPrefix}/aicte`,
    badge: isIndic ? 'नियामक निगरानी' : 'AICTE Surveillance',
    accent: 'border-t-[#D97706]',
    btnClass: 'bg-[#0F2942] hover:bg-[#1E3A8A] text-white',
    isPublic: false,
  },
  {
    role: 'university',
    title: t.portal3Title,
    code: 'UNIV-03',
    description: t.portal3Desc,
    path: `${langPrefix}/university`,
    badge: isIndic ? 'विश्वविद्यालय लेजर' : 'University Ledger',
    accent: 'border-t-[#1D4ED8]',
    btnClass: 'bg-[#0F2942] hover:bg-[#1E3A8A] text-white',
    isPublic: false,
  },
  {
    role: 'student',
    title: t.portal4Title,
    code: 'STU-04',
    description: t.portal4Desc,
    path: `${langPrefix}/student`,
    badge: isIndic ? 'छात्र DPDP तिजोरी' : 'Student DPDP Vault',
    accent: 'border-t-[#7C3AED]',
    btnClass: 'bg-[#0F2942] hover:bg-[#1E3A8A] text-white',
    isPublic: false,
  },
  {
    role: 'verifier',
    title: t.portal5Title,
    code: 'VRF-05',
    description: t.portal5Desc,
    path: `${langPrefix}/verifier`,
    badge: isIndic ? 'सार्वजनिक सत्यापन' : 'Public Verifier',
    accent: 'border-t-[#15803D]',
    btnClass: 'bg-[#15803D] hover:bg-[#166534] text-white',
    isPublic: true,
  },
];
---

<Layout
  title={`${t.portalTitle} (${langInfo.nativeName}) | AICTE | Ministry of Education`}
  activeRole="overview"
  breadcrumb={t.portalTitle}
  lang={resolvedLang}
>
  <!-- 1. Authentic APAAR.education.gov.in Style Hero Banner -->
  <section class="relative rounded-2xl bg-gradient-to-br from-[#E6F7F2] via-[#F0FDF9] to-[#FEF9EC] border border-emerald-200/80 p-6 sm:p-10 mb-6 overflow-hidden shadow-xs">
    <!-- Floating National Registration Counter Pill (Like apaar.education.gov.in '33.74 cr APAAR ID Registered') -->
    <div class="hidden xl:flex items-center gap-3 bg-white/95 backdrop-blur border border-emerald-200 shadow-md rounded-xl px-4 py-2.5 absolute top-5 right-6 z-10">
      <div class="text-right">
        <div class="inline-block bg-[#6366F1] text-white font-extrabold text-xs px-2.5 py-0.5 rounded-full">
          {totalEnrollment} / {totalSanctioned} Seats
        </div>
        <div class="text-[11px] font-bold text-slate-700 mt-0.5">
          {isIndic ? 'सत्यापित छात्र नामांकन' : 'APAAR Verified Admissions'}
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left Column (7 cols): Headline + Official APAAR Digital Card Specimen -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-[#0F766E]">
          <span class="w-2 h-2 rounded-full bg-[#0F766E]"></span>
          <span data-i18n="heroBadge">AUTOMATED PERMANENT ACADEMIC ACCOUNT REGISTRY &bull; {t.heroBadge}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-black text-[#0F2942] tracking-tight leading-[1.15]" data-i18n="heroTitle">
          {t.heroTitle}
        </h1>

        <p class="text-sm sm:text-base text-slate-700 leading-relaxed max-w-2xl" data-i18n="heroSubtitle">
          {t.heroSubtitle}
        </p>

        <!-- Visual APAAR Credential Card Specimen (Inspired directly by apaar.education.gov.in) -->
        <div class="pt-1">
          <div class="bg-white rounded-xl border border-slate-200/90 shadow-md p-4 sm:p-5 max-w-xl relative overflow-hidden">
            <!-- Tricolor Top Accent inside Card -->
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-3.5">
              <div class="flex items-center gap-2">
                <img src="/emblem.svg" alt="Emblem" class="h-7 w-auto" width="18" height="28" />
                <div class="leading-none">
                  <div class="text-[9px] font-bold text-slate-600">शिक्षा मंत्रालय</div>
                  <div class="text-[10px] font-black text-slate-900">MINISTRY OF EDUCATION</div>
                </div>
              </div>
              <div class="text-center">
                <div class="w-20 h-1.5 rounded-full bg-gradient-to-r from-[#FF9933] via-slate-200 to-[#138808] mx-auto mb-0.5"></div>
                <span class="text-[9px] font-extrabold uppercase tracking-widest text-slate-700">भारत सरकार &bull; Govt. of India</span>
              </div>
              <div class="text-right">
                <span class="font-black text-sm text-[#0F766E] tracking-tight block leading-none">APAAR</span>
                <span class="text-[8px] font-bold text-slate-500 uppercase">Ed25519 Signed</span>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-3.5">
                <!-- Student Avatar Illustration -->
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-teal-600 to-emerald-800 text-white flex items-center justify-center font-black text-lg shrink-0 ring-2 ring-emerald-200">
                  SD
                </div>
                <div class="space-y-0.5 text-xs">
                  <div class="font-bold text-slate-900 text-sm">Sneha Deshmukh</div>
                  <div class="text-slate-600 text-[11px]">B.Tech Computer Engineering &bull; Batch 2026</div>
                  <div class="text-emerald-700 font-semibold text-[11px] flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                    <span>DPDP Sec. 6 Consent Active &bull; CGPA 9.14</span>
                  </div>
                  <div class="font-mono font-black text-sm text-[#0F2942] tracking-widest pt-1">
                    4123 9847 1029
                  </div>
                </div>
              </div>

              <!-- Stylistic QR Code & Quick Action -->
              <div class="flex sm:flex-col items-center justify-between sm:justify-center gap-2 border-t sm:border-t-0 sm:border-l border-slate-100 pt-2.5 sm:pt-0 sm:pl-4">
                <svg class="w-14 h-14 text-slate-900 shrink-0" viewBox="0 0 36 36" fill="currentColor" aria-label="Sample Verifiable Credential QR">
                  <path d="M2 2h10v10H2V2zm2 2v6h6V4H4zm2 2h2v2H6V6zm18-4h10v10H24V2zm2 2v6h6V4h-6zm2 2h2v2h-2V6zM2 24h10v10H2V24zm2 2v6h6v-6H4zm2 2h2v2H6v-2zm10-24h4v4h-4V4zm4 4h2v4h-2V8zm-4 4h4v2h-4v-2zm-2 4h6v2h-6v-2zm8-2h4v4h-4v-4zm6 4h4v2h-4v-2zm-10 4h4v4h-4v-4zm6 2h4v6h-4v-6zm4 4h4v4h-4v-4zm-12 2h4v4h-4v-4z" />
                </svg>
                <a
                  href={`${langPrefix}/verifier?apaar=412398471029`}
                  class="text-[11px] font-bold text-[#0F766E] hover:underline whitespace-nowrap"
                >
                  {isIndic ? 'यह कार्ड सत्यापित करें →' : 'Verify Specimen →'}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column (5 cols): Clean Citizen Verification Card -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-xl border border-slate-200/90 shadow-lg p-6">
          <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-slate-100">
            <div>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-[#0F766E] block">
                {t.navVerifier}
              </span>
              <h2 class="text-lg font-extrabold text-[#0F2942] mt-0.5" data-i18n="quickVerifyTitle">
                {t.quickVerifyTitle}
              </h2>
            </div>
            <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold px-2.5 py-1 rounded-full">
              Instant Check
            </span>
          </div>

          <form action={`${langPrefix}/verifier`} method="GET" class="space-y-4" id="quickVerifyForm">
            <div>
              <label for="quickApaarInputLang" class="block text-xs font-bold text-slate-700 mb-1.5" data-i18n="quickVerifyLabel">
                {t.quickVerifyLabel}
              </label>
              <input
                type="text"
                id="quickApaarInputLang"
                name="apaar"
                inputmode="numeric"
                pattern="[0-9]{12}"
                maxlength="12"
                required
                placeholder="412398471029"
                class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-3 font-mono text-base font-bold text-slate-900 tracking-widest focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F766E]"
              />
            </div>

            <button
              type="submit"
              class="w-full py-3 px-5 bg-[#0F766E] hover:bg-[#115E59] text-white font-bold rounded-lg text-sm transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span data-i18n="quickVerifyBtn">{t.quickVerifyBtn}</span>
            </button>
          </form>

          <!-- One-Click Sample Chips -->
          <div class="mt-4 pt-4 border-t border-slate-100">
            <div class="text-xs font-semibold text-slate-500 mb-2 flex items-center justify-between">
              <span>{isIndic ? 'नमूना अपार आईडी (क्लिक करें):' : 'Try Sample APAAR Records:'}</span>
              <a href={`${langPrefix}/verifier`} class="text-[#0F766E] hover:underline font-bold">
                {isIndic ? 'क्यूआर स्कैनर' : 'QR Scanner'} &rarr;
              </a>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                data-sample-apaar="412398471029"
                class="text-left p-2.5 bg-slate-50 hover:bg-emerald-50 border border-slate-200 hover:border-emerald-400 rounded-lg transition-colors cursor-pointer"
              >
                <div class="font-mono font-bold text-xs text-[#0F2942]">412398471029</div>
                <div class="text-[11px] text-emerald-700 font-medium truncate">Sneha Deshmukh</div>
              </button>
              <button
                type="button"
                data-sample-apaar="102938475610"
                class="text-left p-2.5 bg-slate-50 hover:bg-emerald-50 border border-slate-200 hover:border-emerald-400 rounded-lg transition-colors cursor-pointer"
              >
                <div class="font-mono font-bold text-xs text-[#0F2942]">102938475610</div>
                <div class="text-[11px] text-slate-600 font-medium truncate">Aarav Kulkarni</div>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Floating National Ecosystem & Live Telemetry Strip (Inspired by abc.gov.in partner pill) -->
  <section aria-label={t.portalTitle} class="bg-white rounded-xl border border-slate-200 shadow-sm px-6 py-5 mb-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 divide-y sm:divide-y-0 sm:divide-x divide-slate-100">
      <div class="pt-2 sm:pt-0 sm:px-4 first:pl-0">
        <div class="text-xs font-semibold text-slate-500" data-i18n="kpi1Label">{t.kpi1Label}</div>
        <div class="flex items-baseline gap-2 mt-1">
          <span class="text-2xl sm:text-3xl font-black text-[#0F2942]">{totalMonitored}</span>
          <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
            {compliantCount} {isIndic ? 'अनुपालित' : 'Compliant'}
          </span>
        </div>
      </div>

      <div class="pt-2 sm:pt-0 sm:px-4">
        <div class="text-xs font-semibold text-slate-500" data-i18n="kpi2Label">{t.kpi2Label}</div>
        <div class="flex items-baseline gap-2 mt-1">
          <span class="text-2xl sm:text-3xl font-black text-[#0F2942]">{totalEnrollment}</span>
          <span class="text-xs font-semibold text-slate-500">/ {totalSanctioned} Seats</span>
        </div>
      </div>

      <div class="pt-2 sm:pt-0 sm:px-4">
        <div class="text-xs font-semibold text-slate-500" data-i18n="kpi3Label">{t.kpi3Label}</div>
        <div class="flex items-baseline gap-2 mt-1">
          <span class="text-2xl sm:text-3xl font-black text-[#0F766E]">{compliancePct}%</span>
          <span class="text-xs font-semibold text-slate-600">DPDP Sec. 6</span>
        </div>
      </div>

      <div class="pt-2 sm:pt-0 sm:px-4">
        <div class="text-xs font-semibold text-slate-500" data-i18n="kpi4Label">{t.kpi4Label}</div>
        <div class="flex items-baseline gap-2 mt-1">
          <span class="text-2xl sm:text-3xl font-black text-[#0F2942]">Ed25519</span>
          <span class="text-xs font-bold text-blue-800 bg-blue-50 px-2 py-0.5 rounded-full">W3C + ZKP</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What's New / Stakeholder Operational Portals (Clean Card Grid like abc.gov.in) -->
  <section class="mb-10" aria-labelledby="portals-heading">
    <div class="flex flex-wrap items-end justify-between gap-2 mb-5">
      <div>
        <span class="text-xs font-extrabold uppercase tracking-wider text-[#0F766E]">
          {isIndic ? 'राष्ट्रीय शैक्षणिक सेवाएँ' : 'National Digital Education Services'}
        </span>
        <h2 id="portals-heading" class="text-xl sm:text-2xl font-black text-[#0F2942] mt-0.5" data-i18n="portalsHeading">
          {t.portalsHeading}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5" data-i18n="portalsSub">
          {t.portalsSub}
        </p>
      </div>
      <a
        href={`${langPrefix}/login`}
        class="text-xs sm:text-sm font-bold text-[#0F766E] hover:underline inline-flex items-center gap-1"
      >
        <span>{t.signIn} (Parichay SSO)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5">
      {portals.map((p, index) => {
        const isPublic = p.isPublic;
        const targetUrl = user
          ? p.path
          : isPublic
          ? `${langPrefix}/verifier`
          : `${langPrefix}/login?redirect=${encodeURIComponent(p.path)}`;
        const actionText = user
          ? `${t.navOverview}`
          : isPublic
          ? `${t.verifyCta}`
          : `${t.signIn}`;
        const colSpanClass = index < 3 ? 'lg:col-span-2' : 'lg:col-span-3';

        return (
          <div class={`${colSpanClass} bg-white rounded-xl border border-slate-200 border-t-4 ${p.accent} shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between p-5 sm:p-6`}>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-800">
                  {p.badge}
                </span>
                <span class="text-[11px] font-mono font-semibold text-slate-400">
                  {p.code}
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-extrabold text-[#0F2942] mb-2">
                {p.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-5">
                {p.description}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-medium text-slate-500">
                {isPublic ? (isIndic ? 'नागरिकों के लिए खुला' : 'Open Public Access') : 'Parichay SSO'}
              </span>
              <a
                href={targetUrl}
                class={`inline-flex items-center gap-1.5 text-xs font-bold py-2 px-4 rounded-lg transition-colors ${p.btnClass}`}
              >
                <span>{actionText}</span>
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 4. Public Institution Directory & Live Intake Table -->
  <section class="bg-white rounded-xl border border-slate-200 shadow-xs p-5 sm:p-6 mb-8" id="institution-search">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-4 mb-5 border-b border-slate-200">
      <div>
        <span class="text-xs font-extrabold text-[#0F766E] uppercase tracking-wider">{t.heroBadge}</span>
        <h2 class="text-lg sm:text-xl font-black text-[#0F2942] mt-0.5" data-i18n="dirHeading">
          {t.dirHeading}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5" data-i18n="dirSub">
          {t.dirSub}
        </p>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <span id="dirCountBadge" class="text-xs font-mono font-bold bg-slate-100 text-[#0F2942] border border-slate-300 px-3 py-1.5 rounded-lg">
          {totalMonitored} / {totalMonitored}
        </span>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-4">
      <div class="md:col-span-6 relative">
        <label for="instSearchInput" class="sr-only">{t.dirHeading}</label>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="instSearchInput"
          placeholder={t.aicte_search_placeholder || t.dirSub}
          class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F766E]"
        />
      </div>

      <div class="md:col-span-3">
        <label for="stateFilterSelect" class="sr-only">{t.aicte_col_state}</label>
        <select
          id="stateFilterSelect"
          class="w-full py-2.5 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F766E]"
        >
          <option value="">{t.aicte_all_states}</option>
          {Array.from(new Set(institutions.map((i) => i.state).filter(Boolean))).sort().map((st) => (
            <option value={st.toLowerCase()}>{st}</option>
          ))}
        </select>
      </div>

      <div class="md:col-span-3">
        <label for="statusFilterSelect" class="sr-only">{t.aicte_col_status}</label>
        <select
          id="statusFilterSelect"
          class="w-full py-2.5 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F766E]"
        >
          <option value="">{t.aicte_all_statuses}</option>
          <option value="compliant">{t.statusCompliant} ({compliantCount})</option>
          <option value="overrun">{t.statusOverrun} ({overrunCount})</option>
        </select>
      </div>
    </div>

    <!-- Interactive Directory Table -->
    <div class="overflow-x-auto border border-slate-200 rounded-lg">
      <table class="w-full text-left text-xs sm:text-sm" id="institutionsTable">
        <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200 uppercase tracking-wider text-xs">
          <tr>
            <th class="py-3 px-4">{t.aicte_col_inst}</th>
            <th class="py-3 px-4">{t.aicte_col_state}</th>
            <th class="py-3 px-4">{t.aicte_col_sanctioned}</th>
            <th class="py-3 px-4">{t.aicte_col_actual}</th>
            <th class="py-3 px-4">{t.aicte_col_status}</th>
            <th class="py-3 px-4 text-right">{t.verifyRecordsBtn}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 font-medium text-slate-800" id="instTableBody">
          {institutions.map((inst) => {
            const isOverrun = inst.current_enrollment > inst.sanctioned_intake;
            const excessSeats = inst.current_enrollment - inst.sanctioned_intake;

            return (
              <tr
                class={`transition-colors inst-row ${isOverrun ? 'bg-red-50/30 hover:bg-red-50/60' : 'hover:bg-slate-50'}`}
                data-name={inst.name.toLowerCase()}
                data-code={inst.code.toLowerCase()}
                data-id={inst.id.toLowerCase()}
                data-state={inst.state.toLowerCase()}
                data-district={inst.district.toLowerCase()}
                data-status={isOverrun ? 'overrun' : 'compliant'}
              >
                <td class="py-3.5 px-4">
                  <div class="font-bold text-[#0F2942] text-sm">{inst.name}</div>
                  <div class="text-xs font-mono text-slate-500 mt-0.5">
                    {t.aicte_col_code}: {inst.code} &bull; ID: {inst.id}
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-900">{inst.district}</div>
                  <div class="text-xs text-slate-500">{inst.state}</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-bold text-slate-900 font-mono">{inst.sanctioned_intake}</span>
                </td>
                <td class="py-3.5 px-4">
                  {isOverrun ? (
                    <span class="font-mono font-bold text-red-700">
                      {inst.current_enrollment} / {inst.sanctioned_intake}
                    </span>
                  ) : (
                    <span class="font-mono font-semibold text-slate-800">
                      {inst.current_enrollment} / {inst.sanctioned_intake}
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4">
                  {isOverrun ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-red-50 text-red-800 border border-red-200">
                      <span class="w-2 h-2 rounded-full bg-red-600"></span>
                      <span data-i18n="statusOverrun">{t.statusOverrun} (+{excessSeats})</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                      <span data-i18n="statusCompliant">{t.statusCompliant}</span>
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href={`${langPrefix}/verifier?institution=${encodeURIComponent(inst.id)}&code=${encodeURIComponent(inst.code)}`}
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-[#0F766E] text-[#0F2942] hover:text-white border border-slate-300 text-xs font-bold transition-colors"
                  >
                    <span data-i18n="verifyRecordsBtn">{t.verifyRecordsBtn}</span>
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div id="noResultsMsg" class="hidden p-6 text-center text-sm text-slate-500">
        0 / {totalMonitored} — {t.dirHeading}
      </div>
    </div>
  </section>

  <!-- 5. 22 Eighth Schedule Languages Strip -->
  <section class="bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-xs" id="aicte-mandate">
    <div class="text-xs font-bold text-[#0F2942] uppercase tracking-wider mb-3 flex items-center gap-1.5">
      <svg class="w-4 h-4 text-[#0F766E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
      </svg>
      <span>संविधान की 8वीं अनुसूची की सभी 22 भारतीय भाषाएँ + अंग्रेज़ी (22 Official Indian Languages):</span>
    </div>
    <div class="flex flex-wrap gap-1.5">
      {EIGHTH_SCHEDULE_LANGUAGES.map((l) => (
        <a
          href={l.code === 'en' ? '/' : `/${l.code}`}
          hreflang={l.code}
          class={`px-2.5 py-1 rounded-md text-xs font-medium transition-colors border ${
            l.code === resolvedLang
              ? 'bg-[#0F766E] text-white border-[#0F766E] font-bold'
              : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-[#0F766E] hover:text-[#0F766E]'
          }`}
        >
          {l.nativeName}
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
    const searchInput = document.getElementById('instSearchInput');
    const stateFilter = document.getElementById('stateFilterSelect');
    const statusFilter = document.getElementById('statusFilterSelect');
    const rows = document.querySelectorAll('.inst-row');
    const noResults = document.getElementById('noResultsMsg');
    const countBadge = document.getElementById('dirCountBadge');
    const quickApaarInput = document.getElementById('quickApaarInputLang');

    function filterInstitutions() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const state = (stateFilter?.value || '').toLowerCase().trim();
      const status = (statusFilter?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      rows.forEach((row) => {
        const name = row.getAttribute('data-name') || '';
        const code = row.getAttribute('data-code') || '';
        const id = row.getAttribute('data-id') || '';
        const rowState = row.getAttribute('data-state') || '';
        const district = row.getAttribute('data-district') || '';
        const rowStatus = row.getAttribute('data-status') || '';

        const matchesQuery =
          !q || name.includes(q) || code.includes(q) || id.includes(q) || district.includes(q);
        const matchesState = !state || rowState === state;
        const matchesStatus = !status || rowStatus === status;

        if (matchesQuery && matchesState && matchesStatus) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
      if (countBadge) {
        countBadge.textContent = `${visibleCount} / ${rows.length}`;
      }
    }

    searchInput?.addEventListener('input', filterInstitutions);
    stateFilter?.addEventListener('change', filterInstitutions);
    statusFilter?.addEventListener('change', filterInstitutions);

    quickApaarInput?.addEventListener('input', () => {
      quickApaarInput.value = quickApaarInput.value.replace(/\D/g, '').slice(0, 12);
    });

    document.querySelectorAll('[data-sample-apaar]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sampleId = btn.getAttribute('data-sample-apaar') || '';
        if (quickApaarInput && sampleId) {
          quickApaarInput.value = sampleId;
          quickApaarInput.focus();
        }
      });
    });
  </script>
</Layout>
