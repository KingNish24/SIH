---
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db';
import type { Institution } from '../../lib/types';

const db = getDB(Astro.locals);
const instRes = await db.prepare('SELECT * FROM institutions ORDER BY name ASC').bind().all<Institution>();
const institutions = instRes.results || [];
const user = Astro.locals.user;

const portals = [
  {
    role: 'institution',
    title: '1. अनुमोदित संस्थान पोर्टल',
    code: 'INST-01',
    description:
      'वैधानिक छात्र रोस्टर जमा करने का चैनल। अपलोड से पहले ब्राउज़र में ही डेटा की जाँच (Zero PII Cloud Leakage) करता है ताकि वैध, अनुपलब्ध और त्रुटिपूर्ण 12-अंकीय अपार (APAAR) आईडी को अलग किया जा सके। एआईसीटीई अनुमोदन प्रक्रिया पुस्तिका (2024–2027) की गतिशील प्रवेश सीमा (60 / 120 / 180 / 240 सीटें) का अनुपालन करता है।',
    path: '/institution',
    stats: 'गतिशील प्रवेश सीमा अनुपालन',
    isPublic: false,
  },
  {
    role: 'aicte',
    title: '2. एआईसीटीई नियामक निगरानी',
    code: 'REG-02',
    description:
      'राष्ट्रीय निगरानी और ऑडिट डैशबोर्ड। एआईसीटीई मानदंडों (60 / 120 / 180 / 240 सीटें) के तहत स्वीकृत प्रवेश सीमा से अधिक नामांकन करने वाले संस्थानों और एक से अधिक परिसरों में समवर्ती दोहरे नामांकन को स्वचालित रूप से चिह्नित करता है।',
    path: '/aicte',
    stats: 'राष्ट्रीय कोटा एवं डुप्लीकेट ऑडिट',
    isPublic: false,
  },
  {
    role: 'university',
    title: '3. संबद्धता विश्वविद्यालय लेजर',
    code: 'UNIV-03',
    description:
      'राज्य और केंद्रीय संबद्धता विश्वविद्यालय संबद्ध कॉलेजों के रोस्टर को सत्यापित करते हैं, छात्र की अपार आईडी से जुड़ी Ed25519 क्रिप्टोग्राफ़िक रूप से हस्ताक्षरित डिग्री जारी करते हैं, और डिग्री निरस्तीकरण का अपरिवर्तनीय रिकॉर्ड रखते हैं।',
    path: '/university',
    stats: 'Ed25519 हस्ताक्षरित डिग्री लेजर',
    isPublic: false,
  },
  {
    role: 'student',
    title: '4. छात्र सहमति प्राधिकरण (DPDP)',
    code: 'STU-04',
    description:
      'डिजिटल व्यक्तिगत डेटा संरक्षण (DPDP) अधिनियम, 2023 की धारा 6 के अनुरूप वैधानिक छात्र पोर्टल। छात्रों को W3C WebAuthn बायोमेट्रिक पासकी का उपयोग करके अपनी शैक्षणिक डिग्री के सत्यापन हेतु समय-सीमित डिजिटल सहमति देने या वापस लेने में सक्षम बनाता है।',
    path: '/student',
    stats: 'धारा 6 DPDP एवं बायोमेट्रिक पासकी',
    isPublic: false,
  },
  {
    role: 'verifier',
    title: '5. सार्वजनिक प्रमाणपत्र सत्यापन टर्मिनल',
    code: 'VRF-05',
    description:
      'सरकारी भर्तीकर्ताओं, नियोक्ताओं और उच्च शिक्षा प्रवेश के लिए खुला सार्वजनिक सत्यापन गेटवे। बिना किसी लॉगिन बाधा के 12-अंकीय अपार आईडी और क्रिप्टोग्राफ़िक हस्ताक्षर के माध्यम से तत्काल शैक्षणिक सत्यापन प्रदान करता है।',
    path: '/verifier',
    stats: '< 50 ms एज सत्यापन समय',
    isPublic: true,
  },
];
---

<Layout
  title="राष्ट्रीय छात्र रजिस्ट्री एवं सत्यापन पोर्टल | AICTE • शिक्षा मंत्रालय"
  activeRole="overview"
  breadcrumb="राष्ट्रीय अवलोकन एवं संस्थान निर्देशिका"
  lang="hi"
>
  <!-- 1. Authoritative UX4G Hero / Statutory Header Card (Hindi) -->
  <section class="bg-gradient-to-br from-[#0F2942] via-[#133251] to-[#0B1E32] text-white rounded-lg border-t-4 border-[#FF9933] shadow-md p-6 sm:p-8 mb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
      <!-- Left Column: Statutory Mandate & Primary CTAs -->
      <div class="lg:col-span-7 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="bg-[#FF9933] text-slate-950 font-bold text-xs uppercase px-2.5 py-0.5 rounded tracking-wide">
            AICTE APH 2024–2027 अधिदेश
          </span>
          <span class="bg-white/10 border border-white/20 text-slate-100 text-xs font-medium px-2.5 py-0.5 rounded">
            NEP 2020 • APAAR एवं ABC रजिस्ट्री
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white leading-tight">
          राष्ट्रीय छात्र रजिस्ट्री एवं क्रिप्टोग्राफ़िक प्रमाणपत्र सत्यापन पोर्टल
        </h1>

        <p class="text-sm text-slate-200 leading-relaxed">
          एआईसीटीई-अनुमोदित तकनीकी संस्थानों, संबद्धता विश्वविद्यालयों और सार्वजनिक सत्यापनकर्ताओं के बीच एकल प्रामाणिक रजिस्ट्री स्थापित करने वाला आधिकारिक सरकारी पोर्टल। स्वीकृत गतिशील प्रवेश सीमा (<strong class="text-white">60 / 120 / 180 / 240 सीटें</strong>), 12-अंकीय अपार पहचान और <strong class="text-white">DPDP अधिनियम, 2023</strong> के अंतर्गत छात्र सहमति को लागू करता है।
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="/verifier"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[#138808] hover:bg-[#0E6506] text-white text-xs sm:text-sm font-bold shadow-xs transition-colors"
          >
            <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>प्रमाणपत्र सत्यापित करें</span>
          </a>
          <a
            href="/login"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[#FF9933] hover:bg-[#F28500] text-slate-950 text-xs sm:text-sm font-bold shadow-xs transition-colors"
          >
            <span>अधिकारी लॉगिन</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="#institution-search"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded bg-white/10 hover:bg-white/20 text-white border border-white/20 text-xs sm:text-sm font-semibold transition-colors"
          >
            <span>अनुमोदित संस्थान देखें</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Quick Inline 12-Digit APAAR Verification Card -->
      <div class="lg:col-span-5">
        <div class="bg-white text-slate-900 rounded-lg p-5 shadow-lg border border-slate-200">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-4">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 block">
                तत्काल सार्वजनिक सत्यापन
              </span>
              <h2 class="text-base font-bold text-[#0F2942]">
                12-अंकीय अपार (APAAR) आईडी जाँच
              </h2>
            </div>
            <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold px-2.5 py-0.5 rounded">
              निःशुल्क खुला गेटवे
            </span>
          </div>

          <form action="/verifier" method="GET" class="space-y-3">
            <div>
              <label for="quickApaarInputHi" class="block text-xs font-bold text-slate-700 mb-1.5">
                छात्र अपार / एबीसी आईडी (12 अंक) दर्ज करें
              </label>
              <input
                type="text"
                id="quickApaarInputHi"
                name="apaar"
                pattern="[0-9]{12}"
                maxlength="12"
                placeholder="उदा. 412398471029"
                class="w-full bg-slate-50 border border-slate-300 rounded px-3.5 py-2.5 font-mono text-sm text-slate-900 tracking-wider focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
              />
            </div>
            <button
              type="submit"
              class="w-full py-2.5 px-4 bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold rounded text-xs sm:text-sm transition-colors shadow-xs flex items-center justify-center gap-2"
            >
              <span>शैक्षणिक रिकॉर्ड सत्यापित करें</span>
              <span aria-hidden="true">&rarr;</span>
            </button>
          </form>

          <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>उदाहरण आईडी: <code class="font-mono font-bold text-slate-700">102938475610</code></span>
            <a href="/verifier" class="text-blue-700 hover:underline font-semibold">विस्तृत खोज &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 4 KPI Benchmark Cards in Hindi -->
  <section aria-label="राष्ट्रीय नियामक मानक" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#0F2942] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">अनुमोदित तकनीकी संस्थान</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5">8,500+</div>
      <div class="text-xs text-slate-600 mt-1">एआईसीटीई के अंतर्गत राष्ट्रीय स्तर पर निगरानी</div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#FF9933] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">स्वीकृत वार्षिक प्रवेश क्षमता</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5">3.2M+</div>
      <div class="text-xs text-slate-600 mt-1">गतिशील सीमा: 60 / 120 / 180 / 240 सीटें</div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#138808] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">APAAR एवं DPDP अनुपालन</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5">100%</div>
      <div class="text-xs text-slate-600 mt-1">12-अंकीय आईडी एवं WebAuthn पासकी सहमति</div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-blue-600 shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">क्रिप्टोग्राफ़िक डिग्री सत्यापन</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5">&lt; 50 ms</div>
      <div class="text-xs text-slate-600 mt-1">Ed25519 हस्ताक्षरित एज लेजर</div>
    </div>
  </section>

  <!-- 3. Public Institution Directory & Regulatory Compliance Table (Hindi) -->
  <section class="bg-white rounded-lg border border-slate-200 shadow-xs p-5 sm:p-6 mb-8" id="institution-search">
    <div class="border-b border-slate-200 pb-4 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">सार्वजनिक निर्देशिका एवं प्रवेश निगरानी</span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold text-[#0F2942] mt-0.5">
          एआईसीटीई अनुमोदित तकनीकी संस्थान एवं नामांकन स्थिति
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          स्वीकृत प्रवेश सीमा की जाँच करने या छात्रों के शैक्षणिक रिकॉर्ड सत्यापित करने के लिए नाम, कोड, जिले या राज्य के आधार पर संस्थान खोजें।
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/verifier"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white text-xs font-bold shadow-xs transition-colors"
        >
          <span>सत्यापन टर्मिनल खोलें</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Search & Filter Controls for Directory -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-4">
      <div class="md:col-span-8 relative">
        <label for="instSearchInput" class="sr-only">संस्थान खोजें</label>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="instSearchInput"
          placeholder="संस्थान का नाम, एआईसीटीई कोड, जिला या राज्य से खोजें..."
          class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-300 rounded text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600"
        />
      </div>

      <div class="md:col-span-4">
        <label for="stateFilterSelect" class="sr-only">राज्य चुनें</label>
        <select
          id="stateFilterSelect"
          class="w-full py-2 px-3 bg-slate-50 border border-slate-300 rounded text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600"
        >
          <option value="">सभी राज्य / केंद्र शासित प्रदेश</option>
          {Array.from(new Set(institutions.map((i) => i.state).filter(Boolean))).sort().map((st) => (
            <option value={st}>{st}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Interactive Directory Table -->
    <div class="overflow-x-auto border border-slate-200 rounded-lg">
      <table class="w-full text-left text-xs sm:text-sm" id="institutionsTable">
        <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200 uppercase tracking-wider text-xs">
          <tr>
            <th class="py-3 px-4">संस्थान कोड एवं नाम</th>
            <th class="py-3 px-4">राज्य / जिला</th>
            <th class="py-3 px-4">स्वीकृत प्रवेश सीमा</th>
            <th class="py-3 px-4">वर्तमान नामांकन</th>
            <th class="py-3 px-4">नियामक स्थिति</th>
            <th class="py-3 px-4 text-right">सत्यापन</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 font-medium text-slate-700" id="instTableBody">
          {institutions.map((inst) => {
            const isOverrun = inst.current_enrollment > inst.sanctioned_intake;
            const excessSeats = inst.current_enrollment - inst.sanctioned_intake;

            return (
              <tr
                class={`transition-colors inst-row ${isOverrun ? 'bg-red-50/30 hover:bg-red-50/60' : 'hover:bg-slate-50'}`}
                data-name={inst.name.toLowerCase()}
                data-code={inst.code.toLowerCase()}
                data-id={inst.id.toLowerCase()}
                data-state={inst.state.toLowerCase()}
                data-district={inst.district.toLowerCase()}
              >
                <td class="py-3.5 px-4">
                  <div class="font-bold text-[#0F2942] text-sm">{inst.name}</div>
                  <div class="text-xs font-mono text-slate-500 mt-0.5">
                    कोड: {inst.code} &bull; आईडी: {inst.id}
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-800">{inst.district}</div>
                  <div class="text-xs text-slate-500">{inst.state}</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-bold text-slate-900 font-mono">{inst.sanctioned_intake}</span>
                  <span class="text-xs text-slate-500 ml-1">स्वीकृत सीटें</span>
                </td>
                <td class="py-3.5 px-4">
                  {isOverrun ? (
                    <span class="font-mono font-bold text-red-700">
                      {inst.current_enrollment} / {inst.sanctioned_intake}
                    </span>
                  ) : (
                    <span class="font-mono font-semibold text-slate-800">
                      {inst.current_enrollment} / {inst.sanctioned_intake}
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4">
                  {isOverrun ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold bg-red-50 text-red-800 border border-red-200">
                      <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
                      <span>सीमा से अधिक (+{excessSeats} अतिरिक्त)</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                      <span>अनुपालित (AICTE अनुमोदित)</span>
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href={`/verifier?institution=${encodeURIComponent(inst.id)}&code=${encodeURIComponent(inst.code)}`}
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-slate-100 hover:bg-[#0F2942] text-[#0F2942] hover:text-white border border-slate-300 text-xs font-bold transition-colors"
                  >
                    <span>रिकॉर्ड सत्यापित करें</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div id="noResultsMsg" class="hidden p-6 text-center text-sm text-slate-500">
        चयनित खोज मानदंडों से मेल खाने वाला कोई संस्थान नहीं मिला।
      </div>
    </div>
  </section>

  <!-- 4. 5 Stakeholder Portals Grid in Hindi (Balanced 6-Col Layout) -->
  <section class="mb-8" aria-labelledby="portals-heading">
    <div class="border-b border-slate-200 pb-3 mb-5 flex flex-wrap items-center justify-between gap-2">
