    <!-- Compact 1-Row Check All Degree Signatures Verification Bar -->
    <div id="merkleSummaryStripAicte" role="status" aria-live="polite" class="bg-white border border-slate-200 rounded px-4 py-3 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
      <div class="flex flex-wrap items-center gap-3">
        <span class="font-bold text-[#0F2942] text-xs sm:text-sm">Check All Degree Signatures</span>
        <span class="text-slate-400">&bull;</span>
        <span id="merkleStatusTextAicte" class="font-semibold text-slate-700">{t.s13_try}</span>
        <span class="text-slate-400 hidden sm:inline">&bull;</span>
        <span class="font-mono text-slate-500">Root: <strong id="merkleRootTextAicte" class="text-[#0F2942]">--</strong></span>
        <span class="font-mono text-emerald-700 font-bold" id="merkleBlockCountAicte"></span>
      </div>
      <button
        type="button"
        id="verifyMerkleBtnAicte"
        class="shrink-0 h-9 px-3.5 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-semibold text-xs transition-colors inline-flex items-center gap-1.5 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-emerald-300 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Check All Degree Signatures</span>
      </button>
      <div id="merkleBlocksContainerAicte" class="hidden"><div id="merkleBlocksListAicte"></div></div>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('aicteSearchInput') as HTMLInputElement | null;
    const stateSelect = document.getElementById('stateFilter') as HTMLSelectElement | null;
    const statusSelect = document.getElementById('statusFilter') as HTMLSelectElement | null;
    const instRows = document.querySelectorAll<HTMLTableRowElement>('.institution-row');
    const countBadge = document.getElementById('aicteCountBadge');
    const emptyRow = document.getElementById('aicteEmptyRow');

    function filterInstTable() {
      const q = searchInput?.value.toLowerCase().trim() || '';
      const st = stateSelect?.value || '';
      const stat = statusSelect?.value || '';
      let visible = 0;

      instRows.forEach((r) => {
        const text = r.textContent?.toLowerCase() || '';
        const rowState = r.getAttribute('data-state') || '';
        const rowStatus = r.getAttribute('data-status') || '';
        const matchesQ = !q || text.includes(q);
        const matchesState = !st || rowState === st;
        const matchesStatus = !stat || rowStatus === stat;
        const show = matchesQ && matchesState && matchesStatus;
        r.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (countBadge) {
        countBadge.textContent = `${visible} / ${instRows.length}`;
      }
      if (emptyRow) {
        emptyRow.classList.toggle('hidden', visible > 0);
      }
    }

    searchInput?.addEventListener('input', filterInstTable);
    stateSelect?.addEventListener('change', filterInstTable);
    statusSelect?.addEventListener('change', filterInstTable);

    // One-click sample institution code chips
    document.querySelectorAll<HTMLButtonElement>('[data-sample-aicte-code]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-sample-aicte-code') || '';
        if (searchInput) {
          searchInput.value = code;
          filterInstTable();
          searchInput.focus();
        }
      });
    });

    // Action buttons for Show-Cause Notice, Docket Inspection, and PFMS Freeze (Persisted in D1 via POST /api/aicte/anomalies)
    async function issueShowCauseNotice(code: string, label: string, btnEl?: HTMLButtonElement | null) {
      if (!code) return;
      if (btnEl) btnEl.disabled = true;
      try {
        const res = await fetch('/api/aicte/anomalies', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'ISSUE_SHOW_CAUSE', code }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (btnEl) {
            btnEl.textContent = 'Notice Issued ✓';
            btnEl.className = 'px-3 py-1.5 rounded bg-red-900 text-white border border-red-950 font-semibold text-xs transition-colors cursor-pointer';
          }
          (window as any).showToast?.(data.message || `Show-Cause Notice persisted in D1 for ${label}.`, 'warning');
        } else {
          throw new Error(data.error || 'Failed to issue Show-Cause Notice');
        }
      } catch (err: any) {
        (window as any).showToast?.(err.message || 'Error issuing Show-Cause Notice', 'error');
        if (btnEl) btnEl.disabled = false;
      }
    }

    document.getElementById('topShowCauseBtn')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const code = btn.getAttribute('data-notice-code') || '';
      issueShowCauseNotice(code, code, btn);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-action-notice]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-action-notice') || '';
        const name = btn.getAttribute('data-action-name') || code;
        issueShowCauseNotice(code, name, btn);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-action-docket]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-action-docket') || '';
        (window as any).showToast?.(`Compliance Docket verified: ${target}`, 'info');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-freeze-apaar]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const apaar = btn.getAttribute('data-freeze-apaar') || '';
        if (!apaar) return;
        btn.disabled = true;
        try {
          const res = await fetch('/api/aicte/anomalies', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'FREEZE_DUPLICATE_SEAT', apaar_id: apaar }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            btn.textContent = 'PFMS Hold Active ✓';
            btn.className = 'px-3 py-1.5 rounded bg-red-900 text-white border border-red-950 font-semibold text-xs inline-flex items-center gap-1.5 transition-colors';
            (window as any).showToast?.(data.message || `PFMS / NSP Scholarship Hold applied for APAAR ${apaar}.`, 'warning');
          } else {
            throw new Error(data.error || 'Failed to apply PFMS hold');
          }
        } catch (err: any) {
          (window as any).showToast?.(err.message || 'Error applying PFMS hold', 'error');
          btn.disabled = false;
        }
      });
    });

    // Live API sync button wired to /api/aicte/anomalies
    const refreshBtn = document.getElementById('refreshBtn') as HTMLButtonElement | null;
    refreshBtn?.addEventListener('click', async () => {
      refreshBtn.disabled = true;
      try {
        const res = await fetch('/api/aicte/anomalies');
        const json = await res.json();
        if (json.success && json.data?.summary) {
          const s = json.data.summary;
          const totalEl = document.getElementById('kpiTotalInst');
          const overrunEl = document.getElementById('kpiOverrunCount');
          const dupEl = document.getElementById('kpiDuplicateCount');
          if (totalEl) totalEl.textContent = String(s.totalInstitutions);
          if (overrunEl) overrunEl.textContent = String(s.overrunCount);
          if (dupEl) dupEl.textContent = String(s.duplicateStudentsCount);
          (window as any).showToast?.(
            `Live D1 Scan Complete: ${s.totalInstitutions} institutions, ${s.overrunCount} overrun, ${s.duplicateStudentsCount} duplicate(s).`,
            'success'
          );
        } else {
          throw new Error(json.error || 'Failed to scan D1 anomalies');
        }
      } catch (err: any) {
        (window as any).showToast?.(err.message || 'Error scanning anomalies', 'error');
      } finally {
        refreshBtn.disabled = false;
      }
    });

    // Filter buttons for Cross-Council & NSP Anomalies (Fixed DUAL vs NSP vs ALL logic + aria-pressed)
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.anomaly-filter-btn');
    const anomalyCards = document.querySelectorAll<HTMLElement>('.anomaly-card-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-anomaly-filter') || 'ALL';
        filterBtns.forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
          b.className =
            'anomaly-filter-btn px-3 py-1.5 rounded bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 text-xs font-semibold inline-flex items-center gap-1.5 transition-colors cursor-pointer';
        });
        btn.setAttribute('aria-pressed', 'true');
        btn.className =
          'anomaly-filter-btn px-3 py-1.5 rounded bg-[#0F2942] text-white border border-[#0F2942] text-xs font-bold inline-flex items-center gap-1.5 transition-colors cursor-pointer';

        anomalyCards.forEach((card) => {
          const hasNsp = card.getAttribute('data-has-nsp') === 'true';
          if (mode === 'NSP') {
            card.classList.toggle('hidden', !hasNsp);
          } else if (mode === 'DUAL') {
            card.classList.toggle('hidden', hasNsp);
          } else {
            card.classList.remove('hidden');
          }
        });
      });
    });

    // Hardened CSV Export (UTF-8 BOM + CSV formula injection protection + full field quoting)
    function escapeCsvCell(val: unknown): string {
      let str = String(val ?? '').replace(/"/g, '""');
      if (/^[=+\-@]/.test(str)) {
        str = "'" + str;
      }
      return `"${str}"`;
    }

    const downloadPolicyCsvBtn = document.getElementById('downloadPolicyCsvBtn');
    downloadPolicyCsvBtn?.addEventListener('click', () => {
      const sectionEl = document.getElementById('policyAccreditationSection');
      const rawJson = sectionEl?.getAttribute('data-policy-rows') || '[]';
      let rows: any[] = [];
      try {
        rows = JSON.parse(rawJson);
      } catch {
        rows = [];
      }

      const headers = [
        'institution_id',
        'aicte_code',
        'institution_name',
        'state',
        'district',
        'approved_intake',
        'actual_enrolment',
        'supernumerary_seats_tfw_ews',
        'nri_category',
        'oci_status',
        'foreign_national_fn',
        'nba_naac_accreditation_status',
        'compliance_status',
      ];

      const csvLines = [headers.join(',')];
      rows.forEach((r) => {
        csvLines.push(
          [
            escapeCsvCell(r.id),
            escapeCsvCell(r.code),
            escapeCsvCell(r.name),
            escapeCsvCell(r.state),
            escapeCsvCell(r.district),
            r.approved_intake,
            r.actual_enrolment,
            r.supernumerary_seats,
            r.nri_category,
            r.oci_status,
            r.fn_status,
            escapeCsvCell(r.nba_naac_status),
            escapeCsvCell(r.compliance_status),
          ].join(',')
        );
      });

      const blob = new Blob(['\uFEFF' + csvLines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'aicte_policy_nba_naac_accreditation_report_2026.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      (window as any).showToast?.('aicte_policy_nba_naac_accreditation_report_2026.csv downloaded.', 'success');
    });

    // Browser SHA-256 helper for Section 63 BSA Merkle Audit Verifier
    async function sha256Browser(text: string): Promise<string> {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }

    async function computeMerkleRootBrowser(hashes: string[]): Promise<string> {
      if (hashes.length === 0) return sha256Browser('VIDYA-EMPTY-LEDGER');
      let level = [...hashes];
      while (level.length > 1) {
        const next: string[] = [];
        for (let i = 0; i < level.length; i += 2) {
          const left = level[i];
          const right = i + 1 < level.length ? level[i + 1] : left;
          next.push(await sha256Browser(`${left}:${right}`));
        }
        level = next;
      }
      return level[0];
    }

    const verifyBtn = document.getElementById('verifyMerkleBtnAicte') as HTMLButtonElement | null;
    verifyBtn?.addEventListener('click', async () => {
      verifyBtn.disabled = true;
      const stripEl = document.getElementById('merkleSummaryStripAicte');
      const statusEl = document.getElementById('merkleStatusTextAicte');
      const rootEl = document.getElementById('merkleRootTextAicte');
      const countEl = document.getElementById('merkleBlockCountAicte');
      const containerEl = document.getElementById('merkleBlocksContainerAicte');
      const listEl = document.getElementById('merkleBlocksListAicte');

      stripEl?.setAttribute('aria-busy', 'true');
      if (statusEl) statusEl.textContent = 'SHA-256...';

      try {
        const res = await fetch('/api/ledger/merkle');
        const data = await res.json();
        if (!data.success || !Array.isArray(data.blocks)) {
          throw new Error(data.error || 'Failed to load ledger blocks');
        }

        let prev = data.genesis_prev_hash;
        let allValid = true;
        const computedHashes: string[] = [];
        let rowsHtml = '';

        for (const blk of data.blocks) {
          const expectedHash = await sha256Browser(`${prev}:${blk.canonical_payload}`);
          const linkMatches = expectedHash === blk.block_hash && prev === blk.prev_hash;
          if (!linkMatches) allValid = false;
          computedHashes.push(expectedHash);

          rowsHtml += `
            <div class="p-3 bg-white hover:bg-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-[#0F2942] font-bold border border-slate-300">#${blk.index} ${blk.block_type}</span>
                  <span class="font-sans font-semibold text-slate-800">${blk.summary}</span>
                </div>
                <div class="text-[11px] text-slate-500 mt-1">
                  prev: <span class="text-slate-700">${blk.prev_hash.slice(0, 16)}...</span> &rarr;
                  hash: <span class="text-[#0F2942] font-bold">${expectedHash.slice(0, 20)}...</span>
                </div>
              </div>
              <span class="px-2.5 py-0.5 rounded text-[10px] font-bold border shrink-0 ${
                linkMatches
                  ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
                  : 'bg-red-100 text-red-800 border-red-200'
              }">
                ${linkMatches ? 'SHA-256 VERIFIED' : 'TAMPER DETECTED'}
              </span>
            </div>
          `;
          prev = expectedHash;
        }

        const browserMerkleRoot = await computeMerkleRootBrowser(computedHashes);
        const rootMatches = browserMerkleRoot === data.merkle_root;

        if (statusEl) {
          statusEl.innerHTML =
            allValid && rootMatches
              ? `<span class="text-emerald-800">VERIFIED (BSA Sec. 63)</span>`
              : `<span class="text-red-700">HASH DISCREPANCY</span>`;
        }
        if (rootEl) {
          rootEl.textContent = browserMerkleRoot;
          rootEl.title = browserMerkleRoot;
        }
        if (countEl) {
          countEl.textContent = `${data.blocks.length} (${data.counts.institutions} Inst, ${data.counts.admissions} Adm, ${data.counts.degrees} Deg)`;
        }
        if (listEl && containerEl) {
          listEl.innerHTML = rowsHtml;
          containerEl.classList.remove('hidden');
        }
        (window as any).showToast?.(
          `Verified ${data.blocks.length} blocks. Root: ${browserMerkleRoot.slice(0, 16)}...`,
          'success'
        );
      } catch (err: any) {
        if (statusEl) statusEl.textContent = err?.message || 'Error';
        (window as any).showToast?.('Error verifying Merkle ledger', 'error');
      } finally {
        stripEl?.setAttribute('aria-busy', 'false');
        verifyBtn.disabled = false;
      }
    });
  </script>
</Layout>
