---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution } from '../lib/types';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const t = getUIDictionary(lang);

const db = getDB(Astro.locals);
const user = Astro.locals.user;

const isTenantLocked = user?.role === 'INSTITUTE_ADMIN' && !!user?.institution_id;
const targetInstId = isTenantLocked ? user.institution_id : null;

let institutions: Institution[] = [];
if (targetInstId) {
  const instRes = await db.prepare('SELECT * FROM institutions WHERE id = ?').bind(targetInstId).all<Institution>();
  institutions = instRes.results || [];
} else {
  const instRes = await db.prepare('SELECT * FROM institutions ORDER BY id ASC').bind().all<Institution>();
  institutions = instRes.results || [];
}

const collegeA = institutions.find(i => i.id === (targetInstId || 'INST-001')) || institutions[0] || {
  id: targetInstId || 'INST-001',
  name: 'Technical Institute of Engineering, Pune',
  code: 'TCA-1049',
  sanctioned_intake: 180,
  current_enrollment: 189,
  status: 'OVERRUN_RISK',
  risk_score: 94.2,
  state: 'Maharashtra',
  district: 'Pune',
};

const initialDiff = collegeA.current_enrollment - collegeA.sanctioned_intake;
const initialIsOverrun = initialDiff > 0;
const initialPct = ((collegeA.current_enrollment / Math.max(1, collegeA.sanctioned_intake)) * 100).toFixed(1);
const initialBarWidth = Math.min(100, (collegeA.current_enrollment / Math.max(1, collegeA.sanctioned_intake)) * 100).toFixed(1);

// Deterministic statutory category breakdown per institution (AICTE APH 2024-27 Norms)
function computeCategoryBreakdown(sanctioned: number, current: number) {
  const supernumerary = Math.round(sanctioned * 0.15); // 15% TFW / EWS / PMSSS
  const nri = Math.round(sanctioned * 0.05); // 5% NRI quota
  const oci = Math.max(1, Math.round(sanctioned * 0.02)); // 2% OCI status
  const fn = Math.max(1, Math.round(sanctioned * 0.03)); // 3% Foreign National (FN)
  return {
    approvedIntake: sanctioned,
    actualEnrolment: current,
    supernumerary,
    nri,
    oci,
    fn,
  };
}

const initialCat = computeCategoryBreakdown(collegeA.sanctioned_intake, collegeA.current_enrollment);

const clientI18n = {
  statusCompliant: t.inst_status_compliant,
  statusOverrun: t.inst_status_overrun,
  kpiSanctioned: t.inst_kpi_sanctioned,
  validApaar: t.inst_triage_valid,
  missingApaar: t.inst_triage_missing,
  malformedApaar: t.inst_triage_malformed,
  syncBtn: t.inst_sync_btn,
  catSupernumerary: t.inst_cat_supernumerary,
  catNri: t.inst_cat_nri,
  catOci: t.inst_cat_oci,
  catFn: t.inst_cat_fn,
};
---

<Layout title={`SIH 2026 | ${t.inst_page_title}`} activeRole="institution" lang={lang} breadcrumb={t.crumb_institution}>
  <div class="space-y-6" id="instPageRoot" data-i18n-client={JSON.stringify(clientI18n)}>
    <!-- Breadcrumb & Page Header -->
    <div class="border-b border-slate-200 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="text-xs font-bold text-[#1E40AF] uppercase tracking-wider mb-1">
          {t.crumb_institution} &bull; {t.inst_statutory_badge}
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942]">
          {t.inst_page_title}
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          {t.inst_subtitle}
        </p>
      </div>

      <!-- Institution Selector with Tenant Isolation -->
      <div class="flex items-center gap-2.5 bg-white px-3.5 py-2 rounded border border-slate-200 shadow-sm text-xs sm:text-sm">
        <label for="activeCollege" class="font-semibold text-slate-700 whitespace-nowrap">{t.inst_select_label}</label>
        {isTenantLocked ? (
          <div class="flex items-center gap-2">
            <select
              id="activeCollege"
              data-institution-id={collegeA.id}
              class="h-9 bg-slate-100 border border-slate-300 rounded px-2.5 text-slate-800 font-bold focus:outline-none text-xs sm:text-sm"
            >
              <option value={collegeA.id} data-name={collegeA.name} data-sanctioned={collegeA.sanctioned_intake} data-current={collegeA.current_enrollment} data-code={collegeA.code} selected>
                {collegeA.name} ({collegeA.current_enrollment}/{collegeA.sanctioned_intake})
              </option>
            </select>
            <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 border border-amber-300 px-2.5 py-1 rounded text-[11px] font-bold whitespace-nowrap">
              <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span>{t.inst_tenant_locked}</span>
            </span>
          </div>
        ) : (
          <select id="activeCollege" class="h-9 bg-slate-50 border border-slate-300 rounded px-2.5 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-600 text-xs sm:text-sm">
            {institutions.map((i) => (
              <option value={i.id} data-name={i.name} data-sanctioned={i.sanctioned_intake} data-current={i.current_enrollment} data-code={i.code} selected={i.id === collegeA.id}>
                {i.name} ({i.current_enrollment}/{i.sanctioned_intake})
              </option>
            ))}
          </select>
        )}
      </div>
    </div>

    <!-- Tenant Isolation Information Banner -->
    {isTenantLocked && (
      <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded text-xs sm:text-sm text-amber-900 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm">
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <div>
            <div class="font-bold">{t.inst_tenant_locked}</div>
            <div class="text-amber-800 mt-0.5 text-xs">
              <strong class="font-mono">{user?.username}</strong> &rarr; <strong class="underline">{collegeA.name} ({collegeA.id})</strong>
            </div>
          </div>
        </div>
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider bg-amber-200/90 text-amber-900 border border-amber-300 px-2.5 py-1 rounded self-start sm:self-auto shrink-0">
          RBAC: {collegeA.id}
        </span>
      </div>
    )}

    <!-- Dynamic Regulatory Error / Duplicate Alert Banner (Hidden by default, shown on 409 Overrun or Duplicate Detection) -->
    <div id="syncFeedbackAlert" class="hidden rounded border p-4 shadow-sm text-xs sm:text-sm" role="alert" aria-live="assertive"></div>

    <!-- Official Sanctioned Capacity Compliance Card -->
    <div class="bg-white border border-slate-200 rounded p-5 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2.5">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{t.inst_kpi_status}</span>
            <span
              id="meterBadge"
              role="status"
              aria-live="polite"
              class={`text-[11px] font-bold px-2.5 py-0.5 rounded border ${
                initialIsOverrun
                  ? 'bg-red-100 text-red-800 border-red-200'
                  : 'bg-emerald-100 text-emerald-800 border-emerald-200'
              }`}
            >
              {initialIsOverrun
                ? `${t.inst_status_overrun} (+${initialDiff})`
                : `${t.inst_status_compliant} (${collegeA.sanctioned_intake - collegeA.current_enrollment})`}
            </span>
          </div>
          <h2 id="meterCollegeName" class="text-base sm:text-lg font-bold text-[#0F2942]">
            {collegeA.name}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600">
            {t.aicte_col_code}: <span id="meterCollegeCode" class="font-mono font-semibold text-slate-800">{collegeA.code}</span> &bull; 
            {t.inst_kpi_sanctioned}: <span id="meterCap" class="font-bold text-slate-900 font-mono">{collegeA.sanctioned_intake}</span>
          </p>
        </div>

        <div class="flex-1 max-w-xl">
          <div class="flex justify-between items-baseline mb-2 text-xs sm:text-sm">
            <span class="font-semibold text-slate-700">{t.inst_kpi_utilization}</span>
            <div class="text-right">
              <span
                id="meterEnrolled"
                class={`text-xl font-bold font-mono ${initialIsOverrun ? 'text-red-600' : 'text-emerald-700'}`}
              >
                {collegeA.current_enrollment}
              </span>
              <span class="text-slate-400 font-mono"> / </span>
              <span id="meterSanctioned" class="text-sm font-bold font-mono text-slate-700">{collegeA.sanctioned_intake}</span>
              <span
                id="meterExcessText"
                class={`ml-2 font-bold font-mono ${initialIsOverrun ? 'text-red-600' : 'text-emerald-700'}`}
              >
                {initialIsOverrun ? `(+${initialDiff})` : `(${initialDiff})`}
              </span>
            </div>
          </div>

          <!-- Accessible Progress Bar (WCAG 2.1 AA) -->
          <div class="w-full bg-slate-100 rounded h-4 border border-slate-200 overflow-hidden relative">
            <div
              id="meterProgressBar"
              role="progressbar"
              aria-label={t.inst_kpi_utilization}
              aria-valuenow={Number(initialPct)}
              aria-valuemin={0}
              aria-valuemax={100}
              class={`h-full transition-all duration-300 ${initialIsOverrun ? 'bg-red-600' : 'bg-emerald-600'}`}
              style={`width: ${initialBarWidth}%;`}
            ></div>
          </div>

          <div class="flex justify-between text-[11px] sm:text-xs text-slate-500 mt-1.5 font-mono">
            <span>0</span>
            <span id="meterSanctionedLabel" class="font-semibold text-slate-700">{t.inst_kpi_sanctioned}: {collegeA.sanctioned_intake}</span>
            <span
              id="meterPercent"
              class={`font-bold ${initialIsOverrun ? 'text-red-700' : 'text-emerald-700'}`}
            >
              {initialPct}% ({initialIsOverrun ? t.inst_status_overrun : t.inst_status_compliant})
            </span>
          </div>
        </div>
      </div>

      <!-- Statutory Seat & Admission Category Breakdown (AICTE APH Norms) — 6-Column Strip -->
      <div class="mt-5 pt-4 border-t border-slate-200">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div class="text-xs font-bold uppercase tracking-wider text-[#0F2942] flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#1E40AF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>{t.inst_cat_heading}</span>
          </div>
          <span class="text-[11px] font-mono font-semibold bg-slate-100 text-slate-700 border border-slate-200 px-2.5 py-0.5 rounded">
            APH 2024–27 Chapter II &amp; VII
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs">
          <div class="p-3 rounded bg-slate-50 border border-slate-200">
            <div class="text-[10px] font-bold uppercase text-slate-500 tracking-wider">{t.inst_kpi_sanctioned}</div>
            <div id="catApprovedIntake" class="text-base sm:text-lg font-bold font-mono text-[#0F2942] mt-1">{initialCat.approvedIntake}</div>
            <div class="text-[10px] text-slate-500 mt-0.5">60 / 120 / 180 / 240</div>
          </div>

          <div class="p-3 rounded bg-slate-50 border border-slate-200">
            <div class="text-[10px] font-bold uppercase text-slate-500 tracking-wider">{t.inst_kpi_actual}</div>
            <div id="catActualEnrolment" class={`text-base sm:text-lg font-bold font-mono mt-1 ${initialIsOverrun ? 'text-red-600' : 'text-emerald-700'}`}>{initialCat.actualEnrolment}</div>
            <div class="text-[10px] text-slate-500 mt-0.5">APAAR Verified</div>
          </div>

          <div class="p-3 rounded bg-blue-50/50 border border-blue-200">
            <div class="text-[10px] font-bold uppercase text-blue-800 tracking-wider">{t.inst_cat_supernumerary}</div>
            <div id="catSupernumerary" class="text-base sm:text-lg font-bold font-mono text-blue-900 mt-1">{initialCat.supernumerary}</div>
            <div class="text-[10px] text-blue-700 mt-0.5">TFW (5%) / EWS (10%)</div>
          </div>

          <div class="p-3 rounded bg-amber-50/50 border border-amber-200">
            <div class="text-[10px] font-bold uppercase text-amber-900 tracking-wider">{t.inst_cat_nri}</div>
            <div id="catNri" class="text-base sm:text-lg font-bold font-mono text-amber-900 mt-1">{initialCat.nri}</div>
            <div class="text-[10px] text-amber-800 mt-0.5">Max 5% Cap</div>
          </div>

          <div class="p-3 rounded bg-indigo-50/50 border border-indigo-200">
            <div class="text-[10px] font-bold uppercase text-indigo-900 tracking-wider">{t.inst_cat_oci}</div>
            <div id="catOci" class="text-base sm:text-lg font-bold font-mono text-indigo-900 mt-1">{initialCat.oci}</div>
            <div class="text-[10px] text-indigo-800 mt-0.5">Max 2% Cap</div>
          </div>

          <div class="p-3 rounded bg-emerald-50/50 border border-emerald-200">
            <div class="text-[10px] font-bold uppercase text-emerald-900 tracking-wider">{t.inst_cat_fn}</div>
            <div id="catFn" class="text-base sm:text-lg font-bold font-mono text-emerald-900 mt-1">{initialCat.fn}</div>
            <div class="text-[10px] text-emerald-800 mt-0.5">PIO / FN (3%)</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Workspace Grid: File Ingestion & Triage -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Ingestion Options -->
      <div class="lg:col-span-4 space-y-5">
        <div class="bg-white border border-slate-200 rounded p-5 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-xs sm:text-sm font-bold text-[#0F2942] uppercase tracking-wider">
              {t.inst_upload_heading}
            </h3>
            <span class="text-[10px] font-mono font-semibold bg-blue-50 text-blue-800 border border-blue-200 px-2 py-0.5 rounded">
              CSV
            </span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 mb-4 leading-relaxed">
            {t.inst_upload_sub}
          </p>

          <label
            for="csvFileInput"
            tabindex="0"
            aria-describedby="csvSchemaHint"
            class="border-2 border-dashed border-slate-300 hover:border-blue-600 hover:bg-blue-50/40 rounded-md p-5 text-center cursor-pointer flex flex-col items-center justify-center bg-slate-50 transition-all group"
          >
            <div class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center mb-2.5 shadow-sm group-hover:border-blue-300">
              <svg class="w-5 h-5 text-[#0F2942] group-hover:text-blue-700 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
            </div>
            <span class="text-xs sm:text-sm font-bold text-[#0F2942] group-hover:text-blue-800">{t.inst_upload_dropzone}</span>
            <span id="csvSchemaHint" class="text-[11px] font-mono text-slate-500 mt-1">apaar_id, student_roll_id, full_name, program, batch_year, admission_category</span>
            <input type="file" id="csvFileInput" accept=".csv" class="hidden" />
          </label>

          <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] text-slate-500 font-mono">aicte_roster_v1.csv</span>
            <button
              type="button"
              id="downloadSampleCsvBtn"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1E40AF] hover:text-[#0F2942] underline underline-offset-2 transition-colors cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>CSV Template (5 Rows)</span>
            </button>
          </div>
        </div>

        <!-- Example Datasets (Not pre-filled; loaded only when clicked) -->
        <div class="bg-white border border-slate-200 rounded p-5 shadow-sm">
          <h3 class="text-xs sm:text-sm font-bold text-[#0F2942] uppercase tracking-wider mb-1.5">
            {t.inst_upload_demo_btn}
          </h3>
          <p class="text-xs text-slate-600 mb-3.5 leading-relaxed">
            {t.s7_body}
          </p>
          <div class="space-y-2.5">
            <button
              type="button"
              id="loadOverrunSampleBtn"
              class="w-full text-left px-3.5 py-3 rounded bg-red-50/50 hover:bg-red-50 border border-red-200 transition-colors flex items-center justify-between group cursor-pointer"
            >
              <div>
                <div class="text-xs sm:text-sm font-bold text-red-800 group-hover:text-red-900">{t.s7_try}</div>
                <div class="text-[11px] text-slate-600 mt-0.5 font-mono">187 Rows / 180 Cap (+7 Overrun &amp; Malformed IDs)</div>
              </div>
              <span class="text-[10px] font-mono font-bold bg-red-100 text-red-800 px-2 py-0.5 rounded border border-red-200 shrink-0">
                187
              </span>
            </button>
            <button
              type="button"
              id="loadCompliantSampleBtn"
              class="w-full text-left px-3.5 py-3 rounded bg-emerald-50/50 hover:bg-emerald-50 border border-emerald-200 transition-colors flex items-center justify-between group cursor-pointer"
            >
              <div>
                <div class="text-xs sm:text-sm font-bold text-emerald-800 group-hover:text-emerald-900">{t.inst_status_compliant}</div>
                <div class="text-[11px] text-slate-600 mt-0.5 font-mono">15 Rows (100% Valid 12-Digit APAAR IDs)</div>
              </div>
              <span class="text-[10px] font-mono font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded border border-emerald-200 shrink-0">
                15
              </span>
            </button>
          </div>
        </div>

        <!-- ERP & AICTE Portal REST API Integration Card -->
        <div class="bg-white border border-slate-200 rounded p-5 shadow-sm">
          <div class="flex items-center justify-between mb-1.5">
            <h3 class="text-xs sm:text-sm font-bold text-[#0F2942] uppercase tracking-wider">
              {t.inst_api_tab_title}
            </h3>
            <span class="text-[10px] font-mono font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded">
              POST /api/roster/sync
            </span>
          </div>
          <p class="text-xs text-slate-600 mb-3 leading-relaxed">
            {t.inst_api_tab_sub}
          </p>
          <details class="group border border-slate-200 rounded bg-slate-50">
            <summary class="px-3 py-2 text-xs font-bold text-[#0F2942] cursor-pointer flex items-center justify-between select-none">
              <span>{t.s8_try}</span>
              <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="p-3 border-t border-slate-200 bg-slate-950 text-emerald-300 font-mono text-[10px] leading-relaxed overflow-x-auto rounded-b">
<pre>{`POST /api/roster/sync HTTP/1.1
Content-Type: application/json

{
  "institutionId": "${collegeA.id}",
  "students": [
    {
      "apaar_id": "901238471920",
      "student_roll_id": "INST-2024-CSE-001",
      "full_name": "Aarav Sharma",
      "program": "B.Tech Computer Science",
      "batch_year": 2024,
      "admission_category": "APPROVED_INTAKE"
    }
  ]
}`}</pre>
            </div>
          </details>
        </div>
      </div>

      <!-- Right Column: Verification & Audit Log Table -->
      <div class="lg:col-span-8">
        <div class="bg-white border border-slate-200 rounded shadow-sm">
          <div class="p-4 sm:p-5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-xs sm:text-sm font-bold text-[#0F2942] uppercase tracking-wider">
                {t.inst_triage_heading}
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">
                {t.inst_upload_sub}
              </p>
            </div>
            <button
              type="button"
              id="commitSyncBtn"
              disabled
              class="h-10 px-4 rounded bg-[#0F2942] hover:bg-[#1E3A8A] disabled:bg-slate-200 disabled:text-slate-500 disabled:cursor-not-allowed text-white text-xs sm:text-sm font-semibold transition-colors shadow-sm cursor-pointer"
            >
              {t.inst_sync_btn}
            </button>
          </div>

          <!-- Triage Summary Pill Strip -->
          <div
            class="grid grid-cols-3 divide-x divide-slate-200 border-b border-slate-200 text-center py-3 bg-slate-50 text-xs sm:text-sm"
            role="status"
            aria-live="polite"
          >
            <div>
              <span class="text-slate-600 font-medium">{t.inst_triage_valid}:</span>
              <strong id="countValid" class="ml-1.5 text-emerald-700 font-mono text-sm sm:text-base">0</strong>
            </div>
            <div>
              <span class="text-slate-600 font-medium">{t.inst_triage_malformed}:</span>
              <strong id="countMalformed" class="ml-1.5 text-red-700 font-mono text-sm sm:text-base">0</strong>
            </div>
            <div>
              <span class="text-slate-600 font-medium">{t.inst_triage_missing}:</span>
              <strong id="countMissing" class="ml-1.5 text-amber-700 font-mono text-sm sm:text-base">0</strong>
            </div>
          </div>

          <!-- Accessible Table Container (Empty until user uploads CSV or clicks an example dataset) -->
          <div
            class="overflow-x-auto max-h-[26rem]"
            role="region"
            aria-label={t.inst_triage_heading}
            tabindex="0"
          >
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead class="bg-slate-100 text-slate-700 font-semibold sticky top-0 border-b border-slate-200">
                <tr>
                  <th class="py-3 px-4">#</th>
                  <th class="py-3 px-4">{t.univ_apaar_id}</th>
                  <th class="py-3 px-4">{t.univ_student_name}</th>
                  <th class="py-3 px-4">{t.univ_specialization}</th>
                  <th class="py-3 px-4">{t.inst_cat_heading.split('(')[0].trim()}</th>
                  <th class="py-3 px-4">{t.aicte_col_status}</th>
                </tr>
              </thead>
              <tbody id="triageTableBody" class="divide-y divide-slate-200 text-slate-800">
                <tr>
                  <td colspan="6" class="py-10 px-4 text-center text-slate-500 text-xs sm:text-sm">
                    {t.inst_upload_dropzone}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentTriageData: any[] = [];

    const rootEl = document.getElementById('instPageRoot');
    const i18nClient = JSON.parse(rootEl?.getAttribute('data-i18n-client') || '{}');

    const collegeSelect = document.getElementById('activeCollege') as HTMLSelectElement;
    const csvFileInput = document.getElementById('csvFileInput') as HTMLInputElement;
    const downloadSampleCsvBtn = document.getElementById('downloadSampleCsvBtn');
    const loadOverrunBtn = document.getElementById('loadOverrunSampleBtn');
    const loadCompliantBtn = document.getElementById('loadCompliantSampleBtn');
    const commitBtn = document.getElementById('commitSyncBtn') as HTMLButtonElement;
    const tableBody = document.getElementById('triageTableBody')!;
    const feedbackAlert = document.getElementById('syncFeedbackAlert');

    function showFeedbackBanner(html: string, tone: 'error' | 'warning' | 'success') {
      if (!feedbackAlert) return;
      feedbackAlert.classList.remove(
        'hidden',
        'bg-red-50',
        'border-red-300',
        'text-red-900',
        'bg-amber-50',
        'border-amber-300',
        'text-amber-900',
        'bg-emerald-50',
        'border-emerald-300',
        'text-emerald-900'
      );
      if (tone === 'error') {
        feedbackAlert.classList.add('bg-red-50', 'border-red-300', 'text-red-900');
      } else if (tone === 'warning') {
        feedbackAlert.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-900');
      } else {
        feedbackAlert.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-900');
      }
      feedbackAlert.innerHTML = html;
    }

    function updateCollegeMeter() {
      const opt = collegeSelect?.selectedOptions?.[0];
      if (!opt) return;

      const name = opt.getAttribute('data-name') || opt.textContent?.split(' (')[0] || '';
      const code = opt.getAttribute('data-code') || 'TCA-1049';
      const sanctioned = parseInt(opt.getAttribute('data-sanctioned') || '180', 10);
      const current = parseInt(opt.getAttribute('data-current') || '0', 10);
      const diff = current - sanctioned;
      const isOverrun = diff > 0;
      const pct = ((current / Math.max(1, sanctioned)) * 100).toFixed(1);
      const barWidth = Math.min(100, (current / Math.max(1, sanctioned)) * 100).toFixed(1);

      const badgeEl = document.getElementById('meterBadge');
      const nameEl = document.getElementById('meterCollegeName');
      const codeEl = document.getElementById('meterCollegeCode');
      const capEl = document.getElementById('meterCap');
      const enrolledEl = document.getElementById('meterEnrolled');
      const sanctionedEl = document.getElementById('meterSanctioned');
      const excessTextEl = document.getElementById('meterExcessText');
      const barEl = document.getElementById('meterProgressBar');
      const limitLabelEl = document.getElementById('meterSanctionedLabel');
      const pctEl = document.getElementById('meterPercent');

      if (nameEl) nameEl.textContent = name;
      if (codeEl) codeEl.textContent = code;
      if (capEl) capEl.textContent = String(sanctioned);
      if (enrolledEl) {
        enrolledEl.textContent = String(current);
        enrolledEl.className = `text-xl font-bold font-mono ${isOverrun ? 'text-red-600' : 'text-emerald-700'}`;
      }
      if (sanctionedEl) sanctionedEl.textContent = String(sanctioned);
      if (excessTextEl) {
        excessTextEl.textContent = isOverrun ? `(+${diff})` : `(${diff})`;
        excessTextEl.className = `ml-2 font-bold font-mono ${isOverrun ? 'text-red-600' : 'text-emerald-700'}`;
      }
      if (badgeEl) {
        badgeEl.textContent = isOverrun
          ? `${i18nClient.statusOverrun || 'OVERRUN'} (+${diff})`
          : `${i18nClient.statusCompliant || 'COMPLIANT'} (${sanctioned - current})`;
        badgeEl.className = `text-[11px] font-bold px-2.5 py-0.5 rounded border ${
          isOverrun
            ? 'bg-red-100 text-red-800 border-red-200'
            : 'bg-emerald-100 text-emerald-800 border-emerald-200'
        }`;
      }
      if (barEl) {
        barEl.style.width = `${barWidth}%`;
        barEl.setAttribute('aria-valuenow', String(pct));
        barEl.className = `h-full transition-all duration-300 ${isOverrun ? 'bg-red-600' : 'bg-emerald-600'}`;
      }
      if (limitLabelEl) limitLabelEl.textContent = `${i18nClient.kpiSanctioned || 'Sanctioned'}: ${sanctioned}`;
      if (pctEl) {
        pctEl.textContent = `${pct}% (${isOverrun ? (i18nClient.statusOverrun || 'Non-Compliant') : (i18nClient.statusCompliant || 'Compliant')})`;
        pctEl.className = `font-bold ${isOverrun ? 'text-red-700' : 'text-emerald-700'}`;
      }

      const catApprovedEl = document.getElementById('catApprovedIntake');
      const catActualEl = document.getElementById('catActualEnrolment');
      const catSuperEl = document.getElementById('catSupernumerary');
      const catNriEl = document.getElementById('catNri');
      const catOciEl = document.getElementById('catOci');
      const catFnEl = document.getElementById('catFn');

      if (catApprovedEl) catApprovedEl.textContent = String(sanctioned);
      if (catActualEl) {
        catActualEl.textContent = String(current);
        catActualEl.className = `text-base sm:text-lg font-bold font-mono mt-1 ${isOverrun ? 'text-red-600' : 'text-emerald-700'}`;
      }
      if (catSuperEl) catSuperEl.textContent = String(Math.round(sanctioned * 0.15));
      if (catNriEl) catNriEl.textContent = String(Math.round(sanctioned * 0.05));
      if (catOciEl) catOciEl.textContent = String(Math.max(1, Math.round(sanctioned * 0.02)));
      if (catFnEl) catFnEl.textContent = String(Math.max(1, Math.round(sanctioned * 0.03)));
    }

    collegeSelect?.addEventListener('change', updateCollegeMeter);

    // Keyboard support for dropzone label
    const dropzoneLabel = document.querySelector('label[for="csvFileInput"]') as HTMLElement | null;
    dropzoneLabel?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        csvFileInput?.click();
      }
    });

    // Download 5-row valid sample CSV template
    downloadSampleCsvBtn?.addEventListener('click', () => {
      const csvContent = [
        'apaar_id,student_roll_id,full_name,program,batch_year,admission_category',
        '901238471920,INST-2024-CSE-001,Aarav Sharma,B.Tech Computer Science & Engineering,2024,APPROVED_INTAKE',
        '812349582031,INST-2024-IT-002,Priya Nair,B.Tech Information Technology,2024,SUPERNUMERARY',
        '723450693142,INST-2024-ENTC-003,Rohan Deshmukh,B.Tech Electronics & Telecommunication,2024,NRI',
        '634561704253,INST-2024-AIDS-004,Ananya Kulkarni,B.Tech Artificial Intelligence & Data Science,2024,OCI',
        '545672815364,INST-2024-CSE-005,Vikramaditya Joshi,B.Tech Computer Science & Engineering,2024,FN',
      ].join('\n');

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'aicte_admission_roster_sample.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      (window as any).showToast?.('aicte_admission_roster_sample.csv (5 rows) downloaded.', 'info');
    });

    function maskApaarClient(val: string): string {
      if (!val || val.length !== 12) return 'INVALID';
      return `XXXX-XXXX-${val.slice(-4)}`;
    }

    function maskNameClient(val: string): string {
      if (!val) return 'Candidate';
      const parts = val.split(' ');
      return parts.length > 1 ? `${parts[0]} ${parts[1][0]}.` : val;
    }

    function renderCategoryBadge(cat: string): string {
      const c = (cat || 'APPROVED_INTAKE').toUpperCase();
      if (c.includes('SUPERNUMERARY') || c.includes('TFW') || c.includes('EWS')) {
        return `<span class="bg-blue-50 text-blue-800 px-2 py-0.5 rounded border border-blue-200 font-semibold text-[11px]">${i18nClient.catSupernumerary || 'Supernumerary'}</span>`;
      }
      if (c.includes('NRI')) {
        return `<span class="bg-amber-50 text-amber-800 px-2 py-0.5 rounded border border-amber-200 font-semibold text-[11px]">${i18nClient.catNri || 'NRI'}</span>`;
      }
      if (c.includes('OCI')) {
        return `<span class="bg-indigo-50 text-indigo-800 px-2 py-0.5 rounded border border-indigo-200 font-semibold text-[11px]">${i18nClient.catOci || 'OCI'}</span>`;
      }
      if (c.includes('FOREIGN') || c === 'FN') {
        return `<span class="bg-purple-50 text-purple-800 px-2 py-0.5 rounded border border-purple-200 font-semibold text-[11px]">${i18nClient.catFn || 'FN'}</span>`;
      }
      return `<span class="bg-slate-100 text-slate-800 px-2 py-0.5 rounded border border-slate-200 font-semibold text-[11px]">${i18nClient.kpiSanctioned || 'Approved Intake'}</span>`;
    }

    function renderTriageRows(rows: any[]) {
      currentTriageData = rows;
      if (!rows.length) {
        tableBody.innerHTML = `<tr><td colspan="6" class="py-10 px-4 text-center text-slate-500">0</td></tr>`;
        commitBtn.disabled = true;
        return;
      }

      let valid = 0, malformed = 0, missing = 0;
      let html = '';

      rows.forEach((r, idx) => {
        const is12 = /^[0-9]{12}$/.test(r.apaar_id || '');
        const isMissing = !r.apaar_id || r.apaar_id.trim() === '';
        const rollId = r.student_roll_id || `INST-2024-CSE-${String(idx + 1).padStart(3, '0')}`;
        
        let statusTag = '';
        if (is12) {
          valid++;
          statusTag = `<span class="bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded border border-emerald-200 font-semibold text-xs">${i18nClient.validApaar || 'Valid APAAR'}</span>`;
        } else if (isMissing) {
          missing++;
          statusTag = `<span class="bg-amber-50 text-amber-700 px-2.5 py-0.5 rounded border border-amber-200 font-semibold text-xs">${i18nClient.missingApaar || 'Missing APAAR'}</span>`;
        } else {
          malformed++;
          statusTag = `<span class="bg-red-50 text-red-700 px-2.5 py-0.5 rounded border border-red-200 font-semibold text-xs">${i18nClient.malformedApaar || 'Format Error'}</span>`;
        }

        html += `
          <tr class="hover:bg-slate-50">
            <td class="py-3 px-4 font-mono text-slate-500">${idx + 1}</td>
            <td class="py-3 px-4">
              <div class="font-mono font-semibold text-slate-900">${maskApaarClient(r.apaar_id)}</div>
              <div class="font-mono text-[11px] text-slate-500">${rollId}</div>
            </td>
            <td class="py-3 px-4 text-slate-800 font-medium">${maskNameClient(r.name || r.full_name)}</td>
            <td class="py-3 px-4 text-slate-600">${r.program || 'B.Tech Computer Science'}</td>
            <td class="py-3 px-4">${renderCategoryBadge(r.admission_category)}</td>
            <td class="py-3 px-4">${statusTag}</td>
          </tr>
        `;
      });

      tableBody.innerHTML = html;
      document.getElementById('countValid')!.textContent = String(valid);
      document.getElementById('countMalformed')!.textContent = String(malformed);
      document.getElementById('countMissing')!.textContent = String(missing);
      commitBtn.disabled = valid === 0;
    }

    csvFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const text = evt.target?.result as string;
          if (!text) return;

          const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
          if (lines.length === 0) return;

          const parseCols = (line: string) => {
            return line.split(',').map(c => c.trim().replace(/^["']|["']$/g, ''));
          };

          const headerCols = parseCols(lines[0]).map(h => h.toLowerCase());
          const apaarIdx = headerCols.findIndex(h => h.includes('apaar'));
          const rollIdx = headerCols.findIndex(h => h.includes('roll') || h.includes('student_id'));
          const nameIdx = headerCols.findIndex(h => h.includes('name'));
          const progIdx = headerCols.findIndex(h => h.includes('prog'));
          const batchIdx = headerCols.findIndex(h => h.includes('batch') || h.includes('year'));
          const catIdx = headerCols.findIndex(h => h.includes('cat') || h.includes('quota'));

          const hasHeader = apaarIdx !== -1 || nameIdx !== -1;
          const startIdx = hasHeader ? 1 : 0;
          const parsedRows: any[] = [];

          for (let i = startIdx; i < lines.length; i++) {
            const cols = parseCols(lines[i]);
            if (!cols || cols.length === 0 || (cols.length === 1 && !cols[0])) continue;

            const apaar = apaarIdx !== -1 ? cols[apaarIdx] : cols[0];
            const rollId = rollIdx !== -1 ? cols[rollIdx] : `INST-2024-CSE-${String(i).padStart(3, '0')}`;
            const name = nameIdx !== -1 ? cols[nameIdx] : (cols[1] || `Candidate ${i}`);
            const prog = progIdx !== -1 ? cols[progIdx] : (cols[2] || 'B.Tech Computer Science');
            const batchRaw = batchIdx !== -1 ? cols[batchIdx] : cols[3];
            const batchYear = parseInt(batchRaw, 10) || 2024;
            const admCat = catIdx !== -1 ? cols[catIdx] : 'APPROVED_INTAKE';

            parsedRows.push({
              apaar_id: (apaar || '').trim(),
              student_roll_id: (rollId || `INST-2024-CSE-${String(i).padStart(3, '0')}`).trim(),
              name: (name || 'Candidate').trim(),
              full_name: (name || 'Candidate').trim(),
              program: (prog || 'B.Tech Computer Science').trim(),
              batch_year: batchYear,
              admission_category: (admCat || 'APPROVED_INTAKE').trim(),
            });
          }

          if (parsedRows.length > 0) {
            renderTriageRows(parsedRows);
            (window as any).showToast(`CSV: ${parsedRows.length} records loaded.`, 'info');
          } else {
            (window as any).showToast('0 valid records in CSV.', 'warning');
          }
        } catch (err: any) {
          (window as any).showToast('CSV Error: ' + err.message, 'error');
        } finally {
          (e.target as HTMLInputElement).value = '';
        }
      };
      reader.readAsText(file);
    });

    const SAMPLE_CATEGORIES = [
      'APPROVED_INTAKE',
      'APPROVED_INTAKE',
      'APPROVED_INTAKE',
      'SUPERNUMERARY',
      'NRI',
      'OCI',
      'FN',
    ];

    loadOverrunBtn?.addEventListener('click', () => {
      const sampleRows: any[] = [];
      for (let i = 1; i <= 187; i++) {
        const apaarNum = 739284000000 + i;
        sampleRows.push({
          apaar_id: String(apaarNum),
          student_roll_id: `INST-2024-CSE-${String(i).padStart(3, '0')}`,
          name: `Candidate ${i}`,
          program: 'B.Tech Computer Science & Engineering',
          batch_year: 2024,
          admission_category: SAMPLE_CATEGORIES[i % SAMPLE_CATEGORIES.length],
        });
      }
      sampleRows[5].apaar_id = '999888'; // malformed
      sampleRows[12].apaar_id = ''; // missing
      renderTriageRows(sampleRows);
    });

    loadCompliantBtn?.addEventListener('click', () => {
      const sampleRows: any[] = [];
      for (let i = 1; i <= 15; i++) {
        const apaarNum = 849201000000 + i;
        sampleRows.push({
          apaar_id: String(apaarNum),
          student_roll_id: `INST-2024-IT-${String(i).padStart(3, '0')}`,
          name: `Candidate ${i}`,
          program: 'B.Tech Information Technology',
          batch_year: 2024,
          admission_category: SAMPLE_CATEGORIES[i % SAMPLE_CATEGORIES.length],
        });
      }
      renderTriageRows(sampleRows);
    });

    commitBtn?.addEventListener('click', async () => {
      commitBtn.disabled = true;
      commitBtn.textContent = '...';

      try {
        const res = await fetch('/api/roster/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            institutionId: collegeSelect.value || collegeSelect.getAttribute('data-institution-id'),
            students: currentTriageData.filter(s => /^[0-9]{12}$/.test(s.apaar_id)).map((s, idx) => ({
              apaar_id: s.apaar_id,
              student_roll_id: s.student_roll_id || `INST-2024-CSE-${String(idx + 1).padStart(3, '0')}`,
              full_name: s.name || s.full_name || 'Candidate',
              program: s.program,
              batch_year: s.batch_year,
              admission_category: s.admission_category || 'APPROVED_INTAKE',
            })),
          }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          const inserted = data.inserted ?? 0;
          const dupes = data.duplicates_flagged ?? 0;
          const skipped = data.skipped ?? 0;
          const newEnrolled = data.new_enrollment ?? 0;
          const cap = data.sanctioned_intake ?? 180;

          if (dupes > 0) {
            showFeedbackBanner(
              `<strong>AICTE Concurrent Duplicate Alert:</strong> Synced <strong>${inserted}</strong> records (${newEnrolled}/${cap} seats), but flagged <strong>${dupes}</strong> cross-campus duplicate APAAR enrollment(s) for regulatory inspection.`,
              'warning'
            );
          } else {
            showFeedbackBanner(
              `<strong>D1 Registry Synchronized:</strong> Inserted <strong>${inserted}</strong> verified records (Skipped: ${skipped}). Updated intake: <strong>${newEnrolled} / ${cap}</strong>.`,
              'success'
            );
          }
          (window as any).showToast(`D1 Sync Complete: ${inserted} inserted, ${dupes} duplicate alerts.`, 'success');
          setTimeout(() => window.location.reload(), 1600);
        } else {
          const errMsg = data.error || 'Server rejected roster';
          showFeedbackBanner(
            `<strong>Statutory Cap / Validation Rejection (HTTP ${res.status}):</strong> ${errMsg}`,
            'error'
          );
          (window as any).showToast(errMsg, 'error');
        }
      } catch (err: any) {
        (window as any).showToast('Network synchronization error.', 'error');
      } finally {
        commitBtn.disabled = false;
        commitBtn.textContent = i18nClient.syncBtn || 'Commit & Synchronize';
      }
    });
  </script>
</Layout>
