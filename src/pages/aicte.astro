              <div class="lg:col-span-7 flex flex-wrap items-center gap-2 font-mono text-xs">
                {ds.colleges.map((c) => (
                  <span class="bg-white text-slate-800 px-3 py-1.5 rounded border border-slate-300 shadow-2xs inline-flex items-center gap-1.5">
                    <span class="text-[10px] font-bold bg-slate-100 text-[#0F2942] px-1.5 py-0.5 rounded border border-slate-200">
                      {c.council_tag}
                    </span>
                    <strong class="text-[#0F2942]">{c.name}</strong> ({c.program}, {c.batch})
                  </span>
                ))}
              </div>
              <div class="lg:col-span-5 bg-white px-3 py-2 rounded border border-slate-200 flex items-center justify-between text-xs">
                <div class="truncate pr-2">
                  <span class="text-[10px] font-bold uppercase text-slate-400 block">NSP / State DBT</span>
                  <span class="font-semibold text-slate-800">{ds.nsp_scheme_name}</span>
