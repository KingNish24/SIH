    function maskApaarClient(val: string): string {
      if (!val || val.length !== 12) return 'INVALID';
      return `XXXX-XXXX-${val.slice(-4)}`;
    }

    function maskNameClient(val: string): string {
      if (!val) return 'Candidate';
      const parts = val.split(' ');
      return parts.length > 1 ? `${parts[0]} ${parts[1][0]}.` : val;
    }

    function renderCategoryBadge(cat: string): string {
      const c = (cat || 'APPROVED_INTAKE').toUpperCase();
      if (c.includes('SUPERNUMERARY') || c.includes('TFW') || c.includes('EWS')) {
        return `<span class="bg-blue-50 text-blue-800 px-2 py-0.5 rounded-md border border-blue-200 font-semibold text-[11px]">${i18nClient.catSupernumerary || 'Supernumerary'}</span>`;
      }
      if (c.includes('NRI')) {
        return `<span class="bg-amber-50 text-amber-800 px-2 py-0.5 rounded-md border border-amber-200 font-semibold text-[11px]">${i18nClient.catNri || 'NRI'}</span>`;
      }
      if (c.includes('OCI')) {
        return `<span class="bg-indigo-50 text-indigo-800 px-2 py-0.5 rounded-md border border-indigo-200 font-semibold text-[11px]">${i18nClient.catOci || 'OCI'}</span>`;
      }
      if (c.includes('FOREIGN') || c === 'FN') {
        return `<span class="bg-purple-50 text-purple-800 px-2 py-0.5 rounded-md border border-purple-200 font-semibold text-[11px]">${i18nClient.catFn || 'FN'}</span>`;
      }
      return `<span class="bg-slate-100 text-slate-800 px-2 py-0.5 rounded-md border border-slate-200 font-semibold text-[11px]">${i18nClient.kpiSanctioned || 'Approved Intake'}</span>`;
    }

    function renderTriageRows(rows: any[]) {
      currentTriageData = rows;
      if (stagedCountPill) stagedCountPill.textContent = String(rows.length);
      switchTableView('triage');

      if (!rows.length) {
        tableBody.innerHTML = `<tr><td colspan="6" class="py-10 px-4 text-center text-slate-500">0</td></tr>`;
