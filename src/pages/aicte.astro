                          {i.status === 'SHOW_CAUSE_ISSUED' ? 'Notice Issued ✓' : 'Show-Cause Notice'}
                        </button>
                      </div>
                    ) : (
                      <button
                        type="button"
                        data-action-docket={`${i.name} (${i.code}) — ${i.current_enrollment}/${i.sanctioned_intake}`}
                        class="px-3 py-1.5 rounded bg-slate-50 hover:bg-slate-100 border border-slate-300 text-slate-700 font-semibold text-xs transition-colors cursor-pointer"
                      >
                        {t.verifyRecordsBtn}
                      </button>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div id="aicteEmptyRow" class="hidden py-8 text-center text-xs sm:text-sm text-slate-500">
          0 / {institutions.length} — {t.aicte_surveillance_heading}
        </div>
      </div>
    </div>

    <!-- FEATURE #4: Cross-Council & National Scholarship (NSP) Duplicate Surveillance -->
    <div class="bg-white border border-slate-200 border-t-4 border-t-amber-600 rounded shadow-sm">
      <div class="p-4 sm:p-5 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider bg-amber-50 text-amber-900 border border-amber-300 px-2.5 py-0.5 rounded">
              <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>PFMS &amp; DBT Anti-Fraud</span>
            </span>
          </div>
          <h2 class="text-sm sm:text-base font-bold text-[#0F2942]">
            {t.aicte_duplicate_heading}
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            {t.aicte_duplicate_sub}
          </p>
        </div>

        <!-- Accessible Filter Buttons with aria-pressed -->
        <div class="flex flex-wrap items-center gap-2 shrink-0" role="group" aria-label={t.aicte_duplicate_heading}>
          <button
            type="button"
            data-anomaly-filter="ALL"
            aria-pressed="true"
            class="anomaly-filter-btn px-3 py-1.5 rounded bg-[#0F2942] text-white border border-[#0F2942] text-xs font-bold inline-flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <span>All ({duplicateStudents.length})</span>
          </button>
          <button
            type="button"
            data-anomaly-filter="DUAL"
            aria-pressed="false"
            class="anomaly-filter-btn px-3 py-1.5 rounded bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 text-xs font-semibold inline-flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <span>Seat Lock Only ({duplicateStudents.filter((d) => !d.has_nsp_overlap).length})</span>
          </button>
          <button
            type="button"
            data-anomaly-filter="NSP"
            aria-pressed="false"
            class="anomaly-filter-btn px-3 py-1.5 rounded bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 text-xs font-semibold inline-flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <span>NSP DBT Overlap ({duplicateStudents.filter((d) => d.has_nsp_overlap).length})</span>
          </button>
        </div>
      </div>

      <div class="p-4 sm:p-5 space-y-3" id="anomalyCardsContainer" role="region" aria-live="polite">
        {duplicateStudents.map((ds) => (
          <div
            data-has-nsp={ds.has_nsp_overlap ? 'true' : 'false'}
            class="anomaly-card-item p-4 bg-slate-50 rounded border border-slate-200 flex flex-col gap-3 text-xs sm:text-sm"
          >
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono font-bold text-slate-900 text-sm">
                    APAAR: {maskApaar(ds.apaar_id)}
                  </span>
                  <span class="text-slate-400">&bull;</span>
                  <span class="font-semibold text-slate-800">
                    {maskName(ds.name)}
                  </span>
                  <span class="text-[11px] bg-red-100 text-red-800 font-bold px-2.5 py-0.5 rounded border border-red-200">
                    DUAL ADMISSION ({ds.colleges.length} Campuses)
                  </span>
                  {ds.has_nsp_overlap ? (
                    <span class="inline-flex items-center gap-1 text-[11px] bg-red-900 text-white font-bold px-2.5 py-0.5 rounded shadow-2xs">
                      <span>{ds.nsp_disbursement_status}</span>
                    </span>
                  ) : (
                    <span class="text-[11px] bg-amber-100 text-amber-900 font-bold px-2.5 py-0.5 rounded border border-amber-300">
                      {ds.nsp_disbursement_status}
                    </span>
                  )}
                </div>
                <div class="text-xs text-slate-500 flex flex-wrap items-center gap-2">
                  <span>Email: <strong class="font-mono text-slate-700">{maskEmail(ds.email)}</strong></span>
                  <span>&bull;</span>
                  {ds.councils.map((c) => (
                    <span class="font-mono text-[10px] font-bold bg-blue-50 text-blue-900 border border-blue-200 px-2 py-0.5 rounded">
                      {c}
