---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution } from '../lib/types';

const db = getDB(Astro.locals);
const user = Astro.locals.user;

const isTenantLocked = user?.role === 'INSTITUTE_ADMIN' && !!user?.institution_id;
const targetInstId = isTenantLocked ? user.institution_id : null;

let institutions: Institution[] = [];
if (targetInstId) {
  const instRes = await db.prepare('SELECT * FROM institutions WHERE id = ?').bind(targetInstId).all<Institution>();
  institutions = instRes.results || [];
} else {
  const instRes = await db.prepare('SELECT * FROM institutions ORDER BY id ASC').bind().all<Institution>();
  institutions = instRes.results || [];
}

const collegeA = institutions.find(i => i.id === (targetInstId || 'INST-001')) || institutions[0] || {
  id: targetInstId || 'INST-001',
  name: 'Technical Institute of Engineering, Pune',
  code: 'TCA-1049',
  sanctioned_intake: 180,
  current_enrollment: 187,
  status: 'OVERRUN_RISK',
  risk_score: 94.2,
  state: 'Maharashtra',
  district: 'Pune',
};
---

<Layout title="SIH 2026 | Approved Institution Portal" activeRole="institution">
  <div class="space-y-6">
    <!-- Breadcrumb & Page Header -->
    <div class="border-b border-slate-200 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div>
        <div class="text-xs font-semibold text-[#1E40AF] uppercase tracking-wider mb-1">
          Institution Administrative Module &bull; Code INST-01
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942]">
          Student Admission Roster & Quota Compliance
        </h1>
        <p class="text-xs text-slate-600 mt-0.5">
          Statutory student-level APAAR verification under AICTE Approval Process Handbook (2024–2027).
        </p>
      </div>

      <!-- Institution Selector with Tenant Isolation -->
      <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded border border-slate-200 shadow-sm text-xs">
        <label for="activeCollege" class="font-semibold text-slate-700">Institution:</label>
        {isTenantLocked ? (
          <div class="flex items-center gap-2">
            <select
              id="activeCollege"
              data-institution-id={collegeA.id}
              class="bg-slate-100 border border-slate-300 rounded px-2.5 py-1 text-slate-800 font-bold focus:outline-none"
            >
              <option value={collegeA.id} data-sanctioned={collegeA.sanctioned_intake} data-current={collegeA.current_enrollment} data-code={collegeA.code} selected>
                {collegeA.name} ({collegeA.current_enrollment}/{collegeA.sanctioned_intake} Seats)
              </option>
            </select>
            <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 rounded text-[10px] font-bold">
              <svg class="w-3 h-3 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              Tenant Isolated ({collegeA.id})
            </span>
          </div>
        ) : (
          <select id="activeCollege" class="bg-slate-50 border border-slate-300 rounded px-2.5 py-1 text-slate-800 font-medium focus:outline-none focus:ring-1 focus:ring-blue-600">
            {institutions.map((i) => (
              <option value={i.id} data-sanctioned={i.sanctioned_intake} data-current={i.current_enrollment} data-code={i.code}>
                {i.name} ({i.current_enrollment}/{i.sanctioned_intake} Seats)
              </option>
            ))}
          </select>
        )}
      </div>
    </div>

    <!-- Tenant Isolation Information Banner -->
    {isTenantLocked && (
      <div class="bg-amber-50 border-l-4 border-amber-500 p-3.5 rounded text-xs text-amber-900 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm">
        <div class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <div>
            <div class="font-bold">Statutory Tenant Isolation Active</div>
            <div class="text-amber-800 mt-0.5">
              Principal credentials for <strong class="font-mono">{user?.username}</strong> are locked to approved institution <strong class="underline">{collegeA.name} ({collegeA.id})</strong>. You cannot access or synchronize student data for other institutions.
            </div>
          </div>
        </div>
        <span class="text-[10px] font-mono font-bold uppercase tracking-wider bg-amber-200/90 text-amber-900 border border-amber-300 px-2 py-0.5 rounded self-start sm:self-auto shrink-0">
          Strict Row-Level Segregation
        </span>
      </div>
    )}

    <!-- Official Sanctioned Capacity Compliance Card -->
    <div class="bg-white border border-slate-200 rounded p-5 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Sanctioned Intake Capacity</span>
            <span id="meterBadge" class="text-[11px] font-bold px-2 py-0.5 rounded bg-red-100 text-red-800 border border-red-200">
              OVERRUN DETECTED (+7 EXCESS)
            </span>
          </div>
          <h2 id="meterCollegeName" class="text-base font-bold text-[#0F2942]">
            {collegeA.name}
          </h2>
          <p class="text-xs text-slate-600">
            AICTE Code: <span id="meterCollegeCode" class="font-mono font-semibold text-slate-800">{collegeA.code}</span> &bull; 
            Sanctioned Cap: <span id="meterCap" class="font-bold text-slate-900">{collegeA.sanctioned_intake} Seats</span>
          </p>
        </div>

        <div class="flex-1 max-w-xl">
          <div class="flex justify-between items-baseline mb-1.5 text-xs">
            <span class="font-medium text-slate-600">Enrollment Utilization</span>
            <div class="text-right">
              <span id="meterEnrolled" class="text-xl font-bold font-mono text-red-600">{collegeA.current_enrollment}</span>
              <span class="text-slate-400 font-mono"> / </span>
              <span id="meterSanctioned" class="text-sm font-bold font-mono text-slate-700">{collegeA.sanctioned_intake}</span>
              <span id="meterExcessText" class="ml-2 font-bold text-red-600">(+7 Overrun)</span>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="w-full bg-slate-100 rounded h-3.5 border border-slate-200 overflow-hidden relative">
            <div
              id="meterProgressBar"
              class="h-full bg-red-600 transition-all duration-300"
              style="width: 100%;"
            ></div>
          </div>

          <div class="flex justify-between text-[11px] text-slate-500 mt-1 font-mono">
            <span>0 Seats</span>
            <span class="font-semibold text-slate-700">Sanctioned Limit: 180</span>
            <span id="meterPercent" class="font-bold text-red-700">103.9% (Non-Compliant)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Workspace Grid: File Ingestion & Triage -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Ingestion Options -->
      <div class="lg:col-span-4 space-y-4">
        <div class="bg-white border border-slate-200 rounded p-4 shadow-sm">
          <h3 class="text-xs font-bold text-[#0F2942] uppercase tracking-wider mb-2">
            1. Roster File Ingestion
          </h3>
          <p class="text-xs text-slate-600 mb-3">
            Upload institutional student admission register in CSV format. Pre-upload client triage enforces DPDP data masking.
          </p>

          <label
            for="csvFileInput"
            class="border-2 border-dashed border-slate-300 hover:border-blue-500 rounded p-4 text-center cursor-pointer flex flex-col items-center justify-center bg-slate-50 transition-colors"
          >
            <svg class="w-6 h-6 text-slate-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <span class="text-xs font-semibold text-[#0F2942]">Select CSV Roster File</span>
            <span class="text-[11px] text-slate-500 mt-0.5">Columns: apaar_id, full_name, program, batch_year</span>
            <input type="file" id="csvFileInput" accept=".csv" class="hidden" />
          </label>
        </div>

        <div class="bg-white border border-slate-200 rounded p-4 shadow-sm">
          <h3 class="text-xs font-bold text-[#0F2942] uppercase tracking-wider mb-2">
            Regulatory Test Samples
          </h3>
          <p class="text-xs text-slate-600 mb-3">
            Load official regulatory test datasets to evaluate statutory intake cap constraints.
          </p>
          <div class="space-y-2">
            <button
              type="button"
              id="loadOverrunSampleBtn"
              class="w-full text-left px-3 py-2 rounded bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-medium text-slate-800 transition-colors"
            >
              <div class="font-bold text-red-700">Sample A: 187 Candidates (Overrun)</div>
              <div class="text-[11px] text-slate-500">+7 above 180 capacity; includes duplicate IDs</div>
            </button>
            <button
              type="button"
              id="loadCompliantSampleBtn"
              class="w-full text-left px-3 py-2 rounded bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-medium text-slate-800 transition-colors"
            >
              <div class="font-bold text-emerald-700">Sample B: 115 Candidates (Compliant)</div>
              <div class="text-[11px] text-slate-500">Fully within 120 sanctioned capacity limit</div>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Verification & Audit Log Table -->
      <div class="lg:col-span-8">
        <div class="bg-white border border-slate-200 rounded shadow-sm">
          <div class="p-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-xs font-bold text-[#0F2942] uppercase tracking-wider">
                2. In-Browser Roster Verification (Zero PII Leakage)
              </h3>
              <p class="text-[11px] text-slate-500 mt-0.5">
                Validated in client memory before committing to Central Registry.
              </p>
            </div>
            <button
              type="button"
              id="commitSyncBtn"
              disabled
              class="px-4 py-2 rounded bg-[#0F2942] hover:bg-[#1E3A8A] disabled:bg-slate-300 disabled:cursor-not-allowed text-white text-xs font-semibold transition-colors"
            >
              Commit Verified Roster to Central D1
            </button>
          </div>

          <!-- Triage Summary Pill Strip -->
          <div class="grid grid-cols-3 divide-x divide-slate-200 border-b border-slate-200 text-center py-2.5 bg-slate-50 text-xs">
            <div>
              <span class="text-slate-500">Valid Records:</span>
              <strong id="countValid" class="ml-1 text-emerald-700 font-mono">0</strong>
            </div>
            <div>
              <span class="text-slate-500">Malformed APAAR:</span>
              <strong id="countMalformed" class="ml-1 text-red-700 font-mono">0</strong>
            </div>
            <div>
              <span class="text-slate-500">Missing APAAR:</span>
              <strong id="countMissing" class="ml-1 text-amber-700 font-mono">0</strong>
            </div>
          </div>

          <!-- Table Container -->
          <div class="overflow-x-auto max-h-96">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-100 text-slate-700 font-semibold sticky top-0 border-b border-slate-200">
                <tr>
                  <th class="p-2.5">S.No</th>
                  <th class="p-2.5">Masked APAAR ID</th>
                  <th class="p-2.5">Candidate (Masked)</th>
                  <th class="p-2.5">Academic Program</th>
                  <th class="p-2.5">Validation Status</th>
                </tr>
              </thead>
              <tbody id="triageTableBody" class="divide-y divide-slate-200 text-slate-800">
                <tr>
                  <td colspan="5" class="p-8 text-center text-slate-500">
                    No roster uploaded. Select a CSV file or load regulatory test samples.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Client-side local triage with strict data masking
    let currentTriageData: any[] = [];

    const collegeSelect = document.getElementById('activeCollege') as HTMLSelectElement;
    const csvFileInput = document.getElementById('csvFileInput') as HTMLInputElement;
    const loadOverrunBtn = document.getElementById('loadOverrunSampleBtn');
    const loadCompliantBtn = document.getElementById('loadCompliantSampleBtn');
    const commitBtn = document.getElementById('commitSyncBtn') as HTMLButtonElement;
    const tableBody = document.getElementById('triageTableBody')!;

    // Masking helpers for client side
    function maskApaarClient(val: string): string {
      if (!val || val.length !== 12) return 'INVALID FORMAT';
      return `XXXX-XXXX-${val.slice(-4)}`;
    }

    function maskNameClient(val: string): string {
      if (!val) return 'Candidate';
      const parts = val.split(' ');
      return parts.length > 1 ? `${parts[0]} ${parts[1][0]}.` : val;
    }

    function renderTriageRows(rows: any[]) {
      currentTriageData = rows;
      if (!rows.length) {
        tableBody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-slate-500">No records found.</td></tr>`;
        commitBtn.disabled = true;
        return;
      }

      let valid = 0, malformed = 0, missing = 0;
      let html = '';

      rows.forEach((r, idx) => {
        const is12 = /^[0-9]{12}$/.test(r.apaar_id || '');
        const isMissing = !r.apaar_id || r.apaar_id.trim() === '';
        
        let statusTag = '';
        if (is12) {
          valid++;
          statusTag = `<span class="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded border border-emerald-200 font-medium">Valid APAAR</span>`;
        } else if (isMissing) {
          missing++;
          statusTag = `<span class="bg-amber-50 text-amber-700 px-2 py-0.5 rounded border border-amber-200 font-medium">Missing APAAR</span>`;
        } else {
          malformed++;
          statusTag = `<span class="bg-red-50 text-red-700 px-2 py-0.5 rounded border border-red-200 font-medium">Format Error</span>`;
        }

        html += `
          <tr class="hover:bg-slate-50">
            <td class="p-2.5 font-mono text-slate-500">${idx + 1}</td>
            <td class="p-2.5 font-mono font-semibold text-slate-900">${maskApaarClient(r.apaar_id)}</td>
            <td class="p-2.5 text-slate-800 font-medium">${maskNameClient(r.name || r.full_name)}</td>
            <td class="p-2.5 text-slate-600">${r.program || 'B.Tech Computer Science'}</td>
            <td class="p-2.5">${statusTag}</td>
          </tr>
        `;
      });

      tableBody.innerHTML = html;
      document.getElementById('countValid')!.textContent = String(valid);
      document.getElementById('countMalformed')!.textContent = String(malformed);
      document.getElementById('countMissing')!.textContent = String(missing);
      commitBtn.disabled = valid === 0;
    }

    // Real CSV File Parsing
    csvFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const text = evt.target?.result as string;
          if (!text) return;

          const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
          if (lines.length === 0) return;

          const parseCols = (line: string) => {
            return line.split(',').map(c => c.trim().replace(/^["']|["']$/g, ''));
          };

          const headerCols = parseCols(lines[0]).map(h => h.toLowerCase());
          const apaarIdx = headerCols.findIndex(h => h.includes('apaar'));
          const nameIdx = headerCols.findIndex(h => h.includes('name'));
          const progIdx = headerCols.findIndex(h => h.includes('prog'));
          const batchIdx = headerCols.findIndex(h => h.includes('batch') || h.includes('year'));

          const hasHeader = apaarIdx !== -1 || nameIdx !== -1;
          const startIdx = hasHeader ? 1 : 0;
          const parsedRows: any[] = [];

          for (let i = startIdx; i < lines.length; i++) {
            const cols = parseCols(lines[i]);
            if (!cols || cols.length === 0 || (cols.length === 1 && !cols[0])) continue;

            const apaar = apaarIdx !== -1 ? cols[apaarIdx] : cols[0];
            const name = nameIdx !== -1 ? cols[nameIdx] : (cols[1] || `Candidate ${i}`);
            const prog = progIdx !== -1 ? cols[progIdx] : (cols[2] || 'B.Tech Computer Science');
            const batchRaw = batchIdx !== -1 ? cols[batchIdx] : cols[3];
            const batchYear = parseInt(batchRaw, 10) || 2024;

            parsedRows.push({
              apaar_id: (apaar || '').trim(),
              name: (name || 'Candidate').trim(),
              full_name: (name || 'Candidate').trim(),
              program: (prog || 'B.Tech Computer Science').trim(),
              batch_year: batchYear,
            });
          }

          if (parsedRows.length > 0) {
            renderTriageRows(parsedRows);
            (window as any).showToast(`Successfully parsed ${parsedRows.length} student records from CSV.`, 'info');
          } else {
            (window as any).showToast('No valid records found in CSV file.', 'warning');
          }
        } catch (err: any) {
          (window as any).showToast('Error parsing CSV file: ' + err.message, 'error');
        } finally {
          (e.target as HTMLInputElement).value = '';
        }
      };
      reader.readAsText(file);
    });

    loadOverrunBtn?.addEventListener('click', () => {
      const sampleRows: any[] = [];
      for (let i = 1; i <= 187; i++) {
        const apaarNum = 739284000000 + i;
        sampleRows.push({
          apaar_id: String(apaarNum),
          name: `Candidate ${i}`,
          program: 'B.Tech Computer Science & Engineering',
          batch_year: 2024,
        });
      }
      // Inject 3 malformed and 2 missing
      sampleRows[5].apaar_id = '999888'; // malformed
      sampleRows[12].apaar_id = ''; // missing
      renderTriageRows(sampleRows);
    });

    loadCompliantBtn?.addEventListener('click', () => {
      const sampleRows: any[] = [];
      for (let i = 1; i <= 115; i++) {
        const apaarNum = 849201000000 + i;
        sampleRows.push({
          apaar_id: String(apaarNum),
          name: `Candidate ${i}`,
          program: 'B.Tech Information Technology',
          batch_year: 2024,
        });
      }
      renderTriageRows(sampleRows);
    });

    commitBtn?.addEventListener('click', async () => {
      commitBtn.disabled = true;
      commitBtn.textContent = 'Committing to Central D1...';

      try {
        const res = await fetch('/api/roster/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            institutionId: collegeSelect.value || collegeSelect.getAttribute('data-institution-id') || collegeA.id,
            students: currentTriageData.filter(s => /^[0-9]{12}$/.test(s.apaar_id)).map(s => ({
              apaar_id: s.apaar_id,
              full_name: s.name || s.full_name || 'Candidate',
              program: s.program,
              batch_year: s.batch_year,
            })),
          }),
        });

        const data = await res.json();
        if (data.success) {
          (window as any).showToast(`Roster committed to Central D1 Registry. Total verified records: ${data.data?.syncedCount || data.data?.insertedCount || currentTriageData.length}`, 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          (window as any).showToast('Sync alert: ' + (data.error || 'Server rejected roster'), 'error');
        }
      } catch (err: any) {
        (window as any).showToast('Network synchronization error.', 'error');
      } finally {
        commitBtn.disabled = false;
        commitBtn.textContent = 'Commit Verified Roster to Central D1';
      }
    });
  </script>
</Layout>
