            `<div><strong>Student Enrolled in Registry:</strong> <span class="font-mono font-bold">${fullName}</span> (APAAR: <span class="font-mono">${apaar}</span>) verified within cap (<strong>${nextEnrolled} / ${capUiVal}</strong>).</div>`,
            'success'
          );
          (window as any).showToast?.(`Enrolled ${fullName} (${nextEnrolled}/${capUiVal}).`, 'success');
          if (singleApaarInput) singleApaarInput.value = '';
          if (singleNameInput) singleNameInput.value = '';
          apaarVerifyCard?.classList.add('hidden');
        } else {
          const errMsg = data.error || 'Sanctioned intake ceiling reached';
          showFeedbackBanner(
            `<div><strong>Statutory Cap Exceeded (HTTP ${res.status}):</strong> ${errMsg} Use <strong>"Sync Baseline (172/180)"</strong> below the submit button or in CSV Batch Import to reconcile open seats.</div>`,
