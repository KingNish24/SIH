---
import {
  EIGHTH_SCHEDULE_LANGUAGES,
  getLanguageInfo,
  getUIDictionary,
  isSupportedLang,
  type LangCode,
} from '../lib/i18n';
import ReviewerTour from '../components/ReviewerTour.astro';

interface Props {
  title?: string;
  activeRole?: 'overview' | 'institution' | 'aicte' | 'university' | 'student' | 'verifier' | 'mandate' | 'login' | 'policy' | 'none';
  breadcrumb?: string;
  lang?: LangCode | string;
  fullBleed?: boolean;
}

const {
  title = 'SIH 2026 | National Student Data Management & Verification Portal',
  activeRole = 'none',
  breadcrumb,
  lang,
  fullBleed = false,
} = Astro.props;
const user = Astro.locals.user;

const resolvedLang: LangCode = isSupportedLang(lang)
  ? lang
  : (isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en');
const langInfo = getLanguageInfo(resolvedLang);
const t = getUIDictionary(resolvedLang);
const isIndic = resolvedLang !== 'en';
const isHindi = resolvedLang === 'hi';

// Universal Language routing: supports all pages
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathSegments = currentPath.split('/').filter(Boolean);
const hasLangPrefix = pathSegments.length > 0 && isSupportedLang(pathSegments[0]) && pathSegments[0] !== 'en';
const cleanBasePath = hasLangPrefix ? '/' + pathSegments.slice(1).join('/') : currentPath;

function getLangHref(targetCode: LangCode): string {
  if (targetCode === 'en') {
    return cleanBasePath === '' ? '/' : cleanBasePath;
  }
  const base = cleanBasePath === '/' ? '' : cleanBasePath;
  return `/${targetCode}${base}`;
}

const hiHref = getLangHref('hi');
const enHref = getLangHref('en');
const policyBase = isIndic ? `/${resolvedLang}` : '';
const homeHref = isIndic ? `/${resolvedLang}` : '/';
const verifierHref = isIndic ? `/${resolvedLang}/verifier` : '/verifier';
const loginHref = isIndic ? `/${resolvedLang}/login` : '/login';

const roleLabels: Record<string, string> = {
  AICTE_ADMIN: t.nav_aicte || 'AICTE Regulatory Council',
  INSTITUTE_ADMIN: t.nav_institution || 'Institute Admin',
  UNIVERSITY_ADMIN: t.nav_university || 'Affiliating University',
  STUDENT: t.nav_student || 'Student (DPDP Vault)',
  VERIFIER: t.nav_verifier || 'Verification Officer',
};

interface NavItem {
  id: string;
  label: string;
  path: string;
}

const rolePortalMap: Record<string, NavItem> = {
  AICTE_ADMIN: { id: 'aicte', label: t.nav_aicte || 'AICTE Regulatory Council', path: `${policyBase}/aicte` },
  INSTITUTE_ADMIN: { id: 'institution', label: t.nav_institution || 'Institution Portal', path: `${policyBase}/institution` },
  UNIVERSITY_ADMIN: { id: 'university', label: t.nav_university || 'Affiliating University', path: `${policyBase}/university` },
  STUDENT: { id: 'student', label: t.nav_student || 'Student Consent (DPDP)', path: `${policyBase}/student` },
  VERIFIER: { id: 'verifier', label: t.navVerifier, path: verifierHref },
};

let navItems: NavItem[] = [];

if (!user) {
  navItems = [
    { id: 'overview', label: t.navOverview, path: homeHref },
    { id: 'verifier', label: t.navVerifier, path: verifierHref },
    { id: 'mandate', label: t.navMandate, path: `${homeHref}#how-it-works` },
  ];
} else {
  const userPortal = rolePortalMap[user.role];
  navItems = [
    { id: 'overview', label: t.navOverview, path: homeHref },
    ...(userPortal ? [userPortal] : []),
    ...(user.role !== 'VERIFIER'
      ? [{ id: 'verifier', label: t.navVerifier, path: verifierHref }]
      : []),
  ];
}

const defaultBreadcrumbs: Record<string, string> = {
  overview: t.crumb_overview || t.portalTitle,
  institution: t.crumb_institution || 'Approved Institution Roster Portal (INST-01)',
  aicte: t.crumb_aicte || 'AICTE National Surveillance & Audit Dashboard (REG-02)',
  university: t.crumb_university || 'Affiliating University Degree Ledger (UNIV-03)',
  student: t.crumb_student || 'Student Consent Authority & DPDP Vault (STU-04)',
  verifier: t.crumb_verifier || 'Public Credential Verification Terminal (VRF-05)',
  login: t.crumb_login || 'Single Sign-On (Parichay Officer Gateway)',
  policy: t.crumb_policy || 'Statutory Policy & Official Guidelines',
  mandate: t.heroBadge || 'AICTE Approval Process Handbook (2024–2027)',
  none: t.portalTitle,
};

const resolvedBreadcrumb =
  breadcrumb ||
  (cleanBasePath === '/login' ? defaultBreadcrumbs.login : defaultBreadcrumbs[activeRole] || defaultBreadcrumbs.none);

const scriptFontFamilyMap: Record<string, string> = {
  bn: 'Noto+Sans+Bengali:wght@400;500;600;700',
  as: 'Noto+Sans+Bengali:wght@400;500;600;700',
  mni: 'Noto+Sans+Bengali:wght@400;500;600;700',
  te: 'Noto+Sans+Telugu:wght@400;500;600;700',
  ta: 'Noto+Sans+Tamil:wght@400;500;600;700',
  ur: 'Noto+Nastaliq+Urdu:wght@400;600;700',
  gu: 'Noto+Sans+Gujarati:wght@400;500;600;700',
  kn: 'Noto+Sans+Kannada:wght@400;500;600;700',
  ml: 'Noto+Sans+Malayalam:wght@400;500;600;700',
  or: 'Noto+Sans+Oriya:wght@400;500;600;700',
  pa: 'Noto+Sans+Gurmukhi:wght@400;500;600;700',
  sat: 'Noto+Sans+Ol+Chiki:wght@400;500;600;700',
};
const extraScriptFont = scriptFontFamilyMap[resolvedLang];
const googleFontsHref = `https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700${extraScriptFont ? `&family=${extraScriptFont}` : ''}&display=swap`;
---

<!doctype html>
<html lang={resolvedLang} dir={langInfo.dir || 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/emblem.svg" />
    <title>{title}</title>
    <!-- Standard Official Typography (Inter + Noto Sans Indic Scripts for UX4G / GIGW 3.0) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={googleFontsHref}
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Inter', 'Noto Sans Devanagari', 'Noto Sans Bengali', 'Noto Sans Telugu', 'Noto Sans Tamil', 'Noto Sans Gujarati', 'Noto Sans Kannada', 'Noto Sans Malayalam', 'Noto Sans Oriya', 'Noto Sans Gurmukhi', 'Noto Sans Ol Chiki', 'Noto Nastaliq Urdu', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      /* High contrast focus ring for GIGW accessibility */
      a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible {
        outline: 2px solid #FF9933 !important;
        outline-offset: 2px !important;
      }
    </style>
  </head>
  <body class="bg-[#F8FAFC] text-[#0F172A] min-h-screen flex flex-col antialiased">
    <!-- GIGW Screen Reader Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-[#0F2942] focus:text-white focus:px-4 focus:py-2.5 focus:rounded focus:shadow-2xl focus:border-2 focus:border-[#FF9933] text-xs font-bold uppercase tracking-wider"
    >
      {t.ui_skip_main}
    </a>

    <!-- 1. Top GoI Dark Navy Utility Strip (Exact NAD / APAAR / ABC Pattern) -->
    <div class="bg-[#0B1E48] text-white py-1.5 px-4 sm:px-8 text-xs">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
        <!-- Left: Indian Flag + Government of India -->
        <div class="flex items-center gap-2.5">
          <span class="inline-flex flex-col w-4 h-3 rounded-[1px] overflow-hidden shrink-0 border border-white/20" aria-hidden="true">
            <span class="h-1 bg-[#FF9933] block"></span>
            <span class="h-1 bg-white block"></span>
            <span class="h-1 bg-[#138808] block"></span>
          </span>
          <span class="font-semibold tracking-wide text-[11px] sm:text-xs text-white" data-i18n="govTitle">
            {t.govTitle}
          </span>
        </div>

        <!-- Right: Skip to Main Content | -A A A+ | Language | Helpline -->
        <div class="flex items-center flex-wrap gap-3 text-[11px] sm:text-xs text-slate-200">
          <a
            href="#main-content"
            class="hidden md:inline-flex items-center text-slate-200 hover:text-white font-medium transition-colors"
          >
            <span>{t.ui_skip_main}</span>
          </a>
          <span class="hidden md:inline-block text-white/25" aria-hidden="true">|</span>

          <!-- Font Size Controls (-A A A+) -->
          <div class="flex items-center gap-1 font-semibold" role="group" aria-label="Text Size Controls">
            <button
              type="button"
              id="btn-font-decrease"
              class="px-1.5 py-0.5 rounded hover:bg-white/15 focus:outline-none transition-colors text-[11px] cursor-pointer"
              title="Decrease Font Size (-A)"
              aria-label="Decrease Font Size"
            >
              -A
            </button>
            <button
              type="button"
              id="btn-font-reset"
              class="px-1.5 py-0.5 rounded bg-white/15 text-white focus:outline-none transition-colors text-[11px] cursor-pointer"
              title="Reset Font Size (A)"
              aria-label="Reset Font Size"
            >
              A
            </button>
            <button
              type="button"
              id="btn-font-increase"
              class="px-1.5 py-0.5 rounded hover:bg-white/15 focus:outline-none transition-colors text-[11px] cursor-pointer"
              title="Increase Font Size (A+)"
              aria-label="Increase Font Size"
            >
              A+
            </button>
          </div>

          <span class="text-white/25" aria-hidden="true">|</span>

          <!-- 22 Official Indian Languages Selector -->
          <nav class="flex items-center" aria-label="Language / 22 भारतीय भाषाएँ">
            <label for="gov-lang-select" class="sr-only">
              Select from 22 Official Indian Languages (8th Schedule)
            </label>
            <div class="relative inline-flex items-center">
              <svg
                class="w-3.5 h-3.5 text-amber-300 absolute ltr:left-2 rtl:right-2 pointer-events-none shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
                />
              </svg>
              <select
                id="gov-lang-select"
                aria-label="22 Official Indian Languages (Eighth Schedule)"
                class="appearance-none bg-white/10 hover:bg-white/20 text-white font-semibold text-[11px] sm:text-xs rounded border border-white/20 ltr:pl-7 ltr:pr-6 rtl:pr-7 rtl:pl-6 py-0.5 focus:outline-none focus:ring-1 focus:ring-[#FF9933] cursor-pointer transition-colors"
              >
                {EIGHTH_SCHEDULE_LANGUAGES.map((l) => (
                  <option
                    value={l.code}
                    data-href={getLangHref(l.code)}
                    selected={l.code === resolvedLang}
                    class="text-slate-900 bg-white"
                  >
                    {l.nativeName}
                  </option>
                ))}
              </select>
              <svg
                class="w-3 h-3 text-slate-300 absolute ltr:right-1.5 rtl:left-1.5 pointer-events-none shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </nav>

          <span class="hidden sm:inline-block text-white/25" aria-hidden="true">|</span>
          <span class="hidden sm:inline-flex items-center gap-1 text-slate-200 font-medium">
            <svg class="w-3.5 h-3.5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>1800-889-3511</span>
          </span>
        </div>
      </div>
    </div>

    <!-- 2. Clean White Main Header (Exact NAD / UIDAI / APAAR Style) -->
    <header class="bg-white text-slate-900 border-b border-slate-200/90 shadow-2xs sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="flex items-center justify-between h-16 sm:h-[72px] gap-4">
          <!-- Left: Ashoka Emblem + Divider + AICTE APAAR Brand -->
          <a href={homeHref} class="flex items-center gap-3 group">
            <img
              src="/emblem.svg"
              alt="State Emblem of India"
              class="h-10 sm:h-11 w-auto object-contain shrink-0"
              width="28"
              height="44"
            />
            <div class="h-8 w-px bg-slate-300" aria-hidden="true"></div>
            <img
              src="/aicte.png"
              alt="AICTE Emblem"
              class="h-9 sm:h-10 w-auto object-contain shrink-0"
              width="38"
              height="38"
            />
            <div>
              <div class="flex items-center gap-1.5">
                <span class="font-extrabold text-base sm:text-lg tracking-tight text-[#0B1E48] leading-none">
                  AICTE
                </span>
                <span class="font-extrabold text-base sm:text-lg tracking-tight text-[#138808] leading-none">
                  APAAR
                </span>
              </div>
              <p class="text-[11px] text-slate-500 font-medium leading-tight mt-0.5" data-i18n="portalTitle">
                {t.portalTitle}
              </p>
            </div>
          </a>

          <!-- Right: Clean Uppercase Links + Sliding Bottom Blue Line + Auto-Open Hover Dropdown -->
          <div class="hidden lg:flex items-center gap-6 shrink-0">
            <nav id="gov-sliding-nav" class="relative flex items-center gap-6 py-1" aria-label="Portal Navigation">
              <!-- Smooth Sliding Bottom Blue Line -->
              <span
                id="gov-nav-pill"
                class="absolute bottom-0 left-0 h-0.5 bg-[#0B4EA2] rounded-full transition-all duration-200 ease-out pointer-events-none opacity-0"
                aria-hidden="true"
              ></span>

              <a
                href={homeHref}
                data-nav-item
                data-active={activeRole === 'overview' ? 'true' : undefined}
                class={`relative z-10 py-1.5 text-xs font-bold uppercase tracking-wider transition-colors ${
                  activeRole === 'overview' ? 'text-[#0B4EA2]' : 'text-slate-600 hover:text-[#0B1E48]'
                }`}
              >
                {t.navOverview}
              </a>

              <a
                href={verifierHref}
                data-nav-item
                data-active={activeRole === 'verifier' ? 'true' : undefined}
                class={`relative z-10 py-1.5 text-xs font-bold uppercase tracking-wider transition-colors ${
                  activeRole === 'verifier' ? 'text-[#0B4EA2]' : 'text-slate-600 hover:text-[#0B1E48]'
                }`}
              >
                {t.navVerifier}
              </a>

              <a
                href={`${homeHref}#how-it-works`}
                data-nav-item
                class="relative z-10 py-1.5 text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-[#0B1E48] transition-colors"
              >
                {t.navMandate}
              </a>

              <!-- Auto-Open Hover Dropdown (No 01/02/03 Numbering) -->
              <div class="relative group" data-nav-item data-active={['institution', 'aicte', 'university', 'student'].includes(activeRole) ? 'true' : undefined}>
                <button
                  type="button"
                  class={`relative z-10 py-1.5 text-xs font-bold uppercase tracking-wider inline-flex items-center gap-1.5 cursor-pointer transition-colors ${
                    ['institution', 'aicte', 'university', 'student'].includes(activeRole)
                      ? 'text-[#0B4EA2]'
                      : 'text-slate-600 group-hover:text-[#0B1E48]'
                  }`}
                  aria-expanded="false"
                >
                  <span data-i18n="ui_portals_menu">{t.ui_portals_menu}</span>
                  <svg class="w-3.5 h-3.5 text-[#0B4EA2] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>

                <!-- Hover Bridge + Clean Dropdown Menu -->
                <div class="absolute ltr:right-0 rtl:left-0 top-full pt-2 w-56 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 focus-within:opacity-100 focus-within:visible focus-within:translate-y-0 transition-all duration-150 ease-out z-50">
                  <div class="bg-white text-slate-900 rounded-xl shadow-lg border border-slate-200/90 py-1.5 overflow-hidden">
                    <a href={`${policyBase}/institution`} class="block px-4 py-2.5 hover:bg-[#F3F5FB] transition-colors">
                      <div class="text-xs font-bold text-[#0B1E48]" data-i18n="portal1Title">{t.portal1Title}</div>
                      <div class="text-[11px] text-slate-500 mt-0.5" data-i18n="ui_menu_college_sub">{t.ui_menu_college_sub}</div>
                    </a>
                    <a href={`${policyBase}/aicte`} class="block px-4 py-2.5 hover:bg-[#F3F5FB] transition-colors">
                      <div class="text-xs font-bold text-[#0B1E48]" data-i18n="portal2Title">{t.portal2Title}</div>
                      <div class="text-[11px] text-slate-500 mt-0.5" data-i18n="ui_menu_aicte_sub">{t.ui_menu_aicte_sub}</div>
                    </a>
                    <a href={`${policyBase}/university`} class="block px-4 py-2.5 hover:bg-[#F3F5FB] transition-colors">
                      <div class="text-xs font-bold text-[#0B1E48]" data-i18n="nav_university">{t.nav_university}</div>
                      <div class="text-[11px] text-slate-500 mt-0.5" data-i18n="ui_menu_univ_sub">{t.ui_menu_univ_sub}</div>
                    </a>
                    <a href={`${policyBase}/student`} class="block px-4 py-2.5 hover:bg-[#F3F5FB] transition-colors">
                      <div class="text-xs font-bold text-[#0B1E48]" data-i18n="portal4Title">{t.portal4Title}</div>
                      <div class="text-[11px] text-slate-500 mt-0.5" data-i18n="ui_menu_student_sub">{t.ui_menu_student_sub}</div>
                    </a>
                  </div>
                </div>
              </div>
            </nav>

            {user ? (
              <div class="flex items-center gap-2.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-full text-xs">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="font-bold text-slate-800 font-mono text-xs">{user.username}</span>
                <a
                  href="/api/auth/logout"
                  class="ml-1 px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded-full text-xs font-bold transition-colors"
                  title={t.signOut}
                >
                  <span data-i18n="signOut">{t.signOut}</span>
                </a>
              </div>
            ) : (
              <a
                href={loginHref}
                class="px-5 py-1.5 font-bold rounded-full text-xs border-2 border-[#0B4EA2] text-[#0B4EA2] hover:bg-[#0B4EA2] hover:text-white transition-all"
              >
                <span data-i18n="signIn">{t.signIn}</span>
              </a>
            )}
          </div>

          <!-- Mobile Navigation -->
          <div class="lg:hidden flex items-center gap-2">
            <label for="mobile-portal-select" class="sr-only">
              {t.portalsHeading}
            </label>
            <select
              id="mobile-portal-select"
              class="bg-slate-50 text-slate-900 text-xs rounded-lg border border-slate-300 px-2.5 py-1.5"
              onchange="window.location.href=this.value"
            >
              <option value={homeHref} selected={activeRole === 'overview'}>{t.navOverview}</option>
              <option value={`${policyBase}/institution`} selected={activeRole === 'institution'}>{t.portal1Title}</option>
              <option value={`${policyBase}/aicte`} selected={activeRole === 'aicte'}>AICTE</option>
              <option value={`${policyBase}/university`} selected={activeRole === 'university'}>{t.nav_university}</option>
              <option value={`${policyBase}/student`} selected={activeRole === 'student'}>{t.portal4Title}</option>
              <option value={verifierHref} selected={activeRole === 'verifier'}>{t.navVerifier}</option>
            </select>
            {user ? (
              <a href="/api/auth/logout" class="px-3 py-1.5 bg-red-600 text-white rounded-full text-xs font-bold">
                {t.signOut}
              </a>
            ) : (
              <a href={loginHref} class="px-3.5 py-1.5 border border-[#0B4EA2] text-[#0B4EA2] font-bold rounded-full text-xs">
                {t.signIn}
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Secondary Sub-Bar: Official Breadcrumb Trail (Hidden on Home Page) -->
      {activeRole !== 'overview' && (
        <div class="bg-slate-50 border-t border-slate-200 px-4 sm:px-8 py-2 text-xs text-slate-600">
          <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
            <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs">
              <a href={homeHref} class="text-slate-500 hover:text-[#0B1E48] font-medium flex items-center gap-1 transition-colors">
                <svg class="w-3.5 h-3.5 text-[#0B4EA2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span>{t.navOverview}</span>
              </a>
              <span class="text-slate-400" aria-hidden="true">/</span>
              <span class="font-semibold text-[#0B1E48]" aria-current="page">{resolvedBreadcrumb}</span>
            </nav>
          </div>
        </div>
      )}
    </header>

    <!-- 4. Main Page Content Container -->
    <main
      id="main-content"
      class={fullBleed ? 'flex-1 w-full focus:outline-none' : 'flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-6 focus:outline-none'}
    >
      <slot />
    </main>

    <!-- 5. Clean Government of India Footer (NAD / UIDAI Style) -->
    <footer class="bg-[#0B1E48] text-slate-300 text-xs border-t border-slate-800 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 py-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 mb-6 border-b border-white/10 leading-relaxed">
          <div class="md:col-span-2 space-y-3">
            <div class="flex items-center gap-3">
              <div class="bg-white rounded px-2.5 py-1 flex items-center">
                <img
                  src="/digital_india.svg"
                  alt="Digital India"
                  class="h-7 w-auto object-contain"
                  width="95"
                  height="28"
                />
              </div>
              <div class="bg-white rounded p-1 flex items-center">
                <img
                  src="/aicte.png"
                  alt="AICTE"
                  class="h-7 w-auto object-contain"
                  width="28"
                  height="28"
                />
              </div>
            </div>
            <p class="text-slate-300 max-w-md" data-i18n="footerOversight">
              {t.footerOversight}
            </p>
          </div>

          <div>
            <div class="font-bold text-white text-xs mb-3 uppercase tracking-wider">
              {t.footer_ecosystem_heading}
            </div>
            <ul class="space-y-2 text-slate-300">
              <li>
                <a href={`${policyBase}/institution`} class="hover:text-white transition-colors">
                  {t.portal1Title}
                </a>
              </li>
              <li>
                <a href={`${policyBase}/aicte`} class="hover:text-white transition-colors">
                  {t.portal2Title}
                </a>
              </li>
              <li>
                <a href={`${policyBase}/university`} class="hover:text-white transition-colors">
                  {t.nav_university}
                </a>
              </li>
              <li>
                <a href={`${policyBase}/student`} class="hover:text-white transition-colors">
                  {t.portal4Title}
                </a>
              </li>
              <li>
                <a href={verifierHref} class="text-emerald-300 font-semibold hover:underline">
                  {t.navVerifier}
                </a>
              </li>
            </ul>
          </div>

          <div>
            <div class="font-bold text-white text-xs mb-3 uppercase tracking-wider">
              {t.footer_statutory_heading}
            </div>
            <ul class="space-y-2 text-slate-300">
              <li><a href={`${policyBase}/privacy`} class="hover:text-white hover:underline" data-i18n="footerPrivacy">{t.footerPrivacy}</a></li>
              <li><a href={`${policyBase}/terms`} class="hover:text-white hover:underline" data-i18n="footerTerms">{t.footerTerms}</a></li>
              <li><a href={`${policyBase}/accessibility`} class="hover:text-white hover:underline" data-i18n="footerAccessibility">{t.footerAccessibility}</a></li>
              <li><a href={`${policyBase}/hyperlinking-policy`} class="hover:text-white hover:underline" data-i18n="footerHyperlink">{t.footerHyperlink}</a></li>
              <li><a href="/sitemap.xml" class="hover:text-white hover:underline" data-i18n="footerSitemap">{t.footerSitemap}</a></li>
            </ul>
