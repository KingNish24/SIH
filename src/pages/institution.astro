    // Inline Editing of 12-Digit APAAR ID inside Preview Table
    function handleTriageInlineEdit(e: Event) {
      const inputEl = (e.target as HTMLElement).closest<HTMLInputElement>('input[data-edit-triage-idx]');
      if (!inputEl) return;
      const idx = parseInt(inputEl.getAttribute('data-edit-triage-idx') || '-1', 10);
      if (idx < 0 || idx >= currentTriageData.length) return;
      const newVal = inputEl.value.trim();
      if (currentTriageData[idx].apaar_id === newVal && e.type === 'change') return;
      currentTriageData[idx].apaar_id = newVal;
      renderTriageRows(currentTriageData, {
        focusIdx: e.type === 'input' ? idx : undefined,
        selectionStart: inputEl.selectionStart,
        selectionEnd: inputEl.selectionEnd,
      });
    }

    tableBody.addEventListener('input', handleTriageInlineEdit);
    tableBody.addEventListener('change', handleTriageInlineEdit);
    tableBody.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Enter' && e.key !== 'Escape') return;
      const inputEl = (e.target as HTMLElement).closest<HTMLInputElement>('input[data-edit-triage-idx]');
      if (!inputEl) return;
      e.preventDefault();
      const idx = parseInt(inputEl.getAttribute('data-edit-triage-idx') || '-1', 10);
      if (idx < 0 || idx >= currentTriageData.length) return;
      currentTriageData[idx].apaar_id = inputEl.value.trim();
      currentTriageData[idx]._editing = false;
      renderTriageRows(currentTriageData, { keepTab: true });
    });

    // Toggle Edit / Remove Single Row from Preview Table
    tableBody.addEventListener('click', (e: MouseEvent) => {
      const editBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-toggle-edit-triage-idx]');
      if (editBtn) {
        const idx = parseInt(editBtn.getAttribute('data-toggle-edit-triage-idx') || '-1', 10);
        if (idx >= 0 && idx < currentTriageData.length) {
          currentTriageData[idx]._editing = !currentTriageData[idx]._editing;
          renderTriageRows(currentTriageData, {
            focusIdx: currentTriageData[idx]._editing ? idx : undefined,
            keepTab: true,
          });
        }
        return;
      }

      const removeBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-remove-triage-idx]');
      if (!removeBtn) return;
      const idx = parseInt(removeBtn.getAttribute('data-remove-triage-idx') || '-1', 10);
      if (idx < 0 || idx >= currentTriageData.length) return;
      currentTriageData.splice(idx, 1);
      renderTriageRows(currentTriageData);
    });

    function processCsvFile(file: File) {
      if (!file) return;
      if (dropzoneTitle) {
        dropzoneTitle.textContent = `Loaded File: ${file.name}`;
      }

      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const text = evt.target?.result as string;
          if (!text) return;

          const parsedRows = parseRawTextToRows(text);

          if (parsedRows.length > 0) {
            renderTriageRows(parsedRows);
            (window as any).showToast?.(`Loaded ${parsedRows.length} rows from ${file.name}. Click "Save Valid Students" to finish.`, 'info');
          } else {
            (window as any).showToast?.('No valid rows found in CSV file.', 'warning');
          }
        } catch (err: any) {
          (window as any).showToast?.('CSV Error: ' + err.message, 'error');
        } finally {
          if (csvFileInput) csvFileInput.value = '';
        }
      };
      reader.readAsText(file);
    }

    csvFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        processCsvFile(file);
      }
    });

    // Also allow dropping anywhere inside #panelBulkCsv without browser navigating away
    panelBulkCsv?.addEventListener('dragover', (e) => {
      e.preventDefault();
    });
    panelBulkCsv?.addEventListener('drop', (e: DragEvent) => {
      e.preventDefault();
      setDropzoneActive(false);
      const droppedFile = e.dataTransfer?.files?.[0];
      if (droppedFile) {
        processCsvFile(droppedFile);
      }
    });

    commitBtn?.addEventListener('click', async () => {
      if (!commitBtn) return;
      commitBtn.disabled = true;
      const instId = activeCollegeEl?.value || 'INST-001';
      const capUiVal = parseInt(activeCollegeEl?.getAttribute('data-sanctioned') || '180', 10);

      try {
        const validPayload = currentTriageData
          .filter((s) => /^[0-9]{12}$/.test(s.apaar_id))
          .map((s, idx) => {
            const branch = normalizeBranchClient(s.program);
            const branchMeta = BRANCH_CONFIG.find((b) => b.branch === branch) || BRANCH_CONFIG[0];
            return {
              apaar_id: s.apaar_id,
              roll_number: `TCA26${branchMeta.short}${String(enrolledList.length + idx + 1).padStart(3, '0')}`,
              full_name: s.full_name || s.name || 'Candidate',
              program: branch,
              batch_year: s.batch_year || 2026,
              admission_quota: normalizeQuotaClient(s.admission_quota),
              allotment_ref: s.allotment_ref || `CET-2026-MH-${88500 + idx}`,
            };
          });

        const res = await fetch('/api/roster/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            institutionId: instId,
            students: validPayload,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          const inserted = data.inserted ?? validPayload.length;
          const dupes = data.duplicates_flagged ?? 0;

          validPayload.forEach((st, idx) => {
            const createdMatch = Array.isArray(data.created_admissions) ? data.created_admissions[idx] : null;
            appendToEnrolledTable({
              id: createdMatch?.id,
              apaar_id: st.apaar_id,
              roll_id: st.roll_number,
              full_name: st.full_name,
              program: st.program,
              batch_year: st.batch_year,
              admission_quota: st.admission_quota,
              allotment_ref: st.allotment_ref,
              is_duplicate: Boolean(createdMatch?.is_duplicate) || createdMatch?.status === 'FLAGGED_DUPLICATE',
            });
          });

          renderTriageRows([], { keepTab: true });
          switchWorkspaceTab('enrolled');
          showFeedbackBanner(
            `<div><strong>Bulk CSV Upload Saved:</strong> Added <strong>${inserted}</strong> students (${dupes} duplicate alerts). Total Admitted: <strong>${enrolledList.length} / ${capUiVal}</strong>.</div>`,
            dupes > 0 ? 'warning' : 'success'
          );
          (window as any).showToast?.(`Saved ${inserted} students (${enrolledList.length}/${capUiVal}).`, 'success');
        } else {
          const errMsg = data.error || 'Could not save uploaded CSV students';
          showFeedbackBanner(
            `<div><strong>CSV Upload Error:</strong> ${errMsg}</div>`,
            'error'
          );
          (window as any).showToast?.(errMsg, 'error');
        }
      } catch {
        (window as any).showToast?.('Network error while saving CSV students.', 'error');
      } finally {
        commitBtn.disabled = false;
      }
    });
  </script>
</Layout>
