---
interface Props {
  title?: string;
  activeRole?: 'overview' | 'institution' | 'aicte' | 'university' | 'student' | 'verifier' | 'mandate' | 'login' | 'policy' | 'none';
  breadcrumb?: string;
  lang?: 'en' | 'hi';
}

const {
  title = 'SIH 2026 | National Student Data Management & Verification Portal',
  activeRole = 'none',
  breadcrumb,
  lang = 'en',
} = Astro.props;
const user = Astro.locals.user;

// Language switcher: pages that have a Hindi version under /hi
const BILINGUAL_PATHS = ['/', '/privacy', '/terms', '/accessibility', '/hyperlinking-policy'];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHindi = lang === 'hi';
const enPath = isHindi ? (currentPath.replace(/^\/hi/, '') || '/') : currentPath;
const hasHindi = BILINGUAL_PATHS.includes(enPath);
const hiHref = hasHindi ? (enPath === '/' ? '/hi' : `/hi${enPath}`) : '/hi';
const enHref = hasHindi ? enPath : '/';
const policyBase = isHindi ? '/hi' : '';

const roleLabels: Record<string, string> = isHindi
  ? {
      AICTE_ADMIN: 'एआईसीटीई नियामक परिषद',
      INSTITUTE_ADMIN: 'संस्थान प्रशासक',
      UNIVERSITY_ADMIN: 'संबद्धता विश्वविद्यालय',
      STUDENT: 'छात्र (डीपीडीपी वॉल्ट)',
      VERIFIER: 'सत्यापन अधिकारी',
    }
  : {
      AICTE_ADMIN: 'AICTE Regulatory Council',
      INSTITUTE_ADMIN: 'Institute Admin',
      UNIVERSITY_ADMIN: 'Affiliating University',
      STUDENT: 'Student (DPDP Vault)',
      VERIFIER: 'Verification Officer',
    };

interface NavItem {
  id: string;
  label: string;
  path: string;
}

const rolePortalMap: Record<string, NavItem> = isHindi
  ? {
      AICTE_ADMIN: { id: 'aicte', label: 'एआईसीटीई नियामक परिषद', path: '/aicte' },
      INSTITUTE_ADMIN: { id: 'institution', label: 'संस्थान पोर्टल', path: '/institution' },
      UNIVERSITY_ADMIN: { id: 'university', label: 'संबद्धता विश्वविद्यालय', path: '/university' },
      STUDENT: { id: 'student', label: 'छात्र सहमति (डीपीडीपी)', path: '/student' },
      VERIFIER: { id: 'verifier', label: 'सार्वजनिक सत्यापन', path: '/verifier' },
    }
  : {
      AICTE_ADMIN: { id: 'aicte', label: 'AICTE Regulatory Council', path: '/aicte' },
      INSTITUTE_ADMIN: { id: 'institution', label: 'Institution Portal', path: '/institution' },
      UNIVERSITY_ADMIN: { id: 'university', label: 'Affiliating University', path: '/university' },
      STUDENT: { id: 'student', label: 'Student Consent (DPDP)', path: '/student' },
      VERIFIER: { id: 'verifier', label: 'Verification Terminal', path: '/verifier' },
    };

let navItems: NavItem[] = [];

if (!user) {
  navItems = isHindi
    ? [
        { id: 'overview', label: 'मुख्य पृष्ठ', path: '/hi' },
        { id: 'verifier', label: 'सार्वजनिक सत्यापन', path: '/verifier' },
        { id: 'mandate', label: 'एआईसीटीई अधिदेश', path: '/hi#aicte-mandate' },
      ]
    : [
        { id: 'overview', label: 'Overview', path: '/' },
        { id: 'verifier', label: 'Public Verification', path: '/verifier' },
        { id: 'mandate', label: 'About AICTE Mandate', path: '/#aicte-mandate' },
      ];
} else {
  const userPortal = rolePortalMap[user.role];
  navItems = [
    { id: 'overview', label: isHindi ? 'मुख्य पृष्ठ' : 'Overview', path: isHindi ? '/hi' : '/' },
    ...(userPortal ? [userPortal] : []),
    ...(user.role !== 'VERIFIER'
      ? [{ id: 'verifier', label: isHindi ? 'सार्वजनिक सत्यापन' : 'Public Verification', path: '/verifier' }]
      : []),
  ];
}

const defaultBreadcrumbs: Record<string, string> = isHindi
  ? {
      overview: 'राष्ट्रीय अवलोकन एवं संस्थान निर्देशिका',
      institution: 'स्वीकृत संस्थान रोस्टर पोर्टल (INST-01)',
      aicte: 'एआईसीटीई राष्ट्रीय निगरानी एवं ऑडिट डैशबोर्ड (REG-02)',
      university: 'संबद्धता विश्वविद्यालय डिग्री लेजर (UNIV-03)',
      student: 'छात्र सहमति प्राधिकरण एवं डीपीडीपी वॉल्ट (STU-04)',
      verifier: 'सार्वजनिक प्रमाणपत्र सत्यापन टर्मिनल (VRF-05)',
      login: 'अधिकारी एकल साइन-ऑन (परिचय गेटवे)',
      policy: 'वैधानिक नीति एवं दिशानिर्देश',
      mandate: 'एआईसीटीई अनुमोदन प्रक्रिया पुस्तिका (2024–2027)',
      none: 'राष्ट्रीय छात्र रजिस्ट्री पोर्टल',
    }
  : {
      overview: 'National Overview & Institution Directory',
      institution: 'Approved Institution Roster Portal (INST-01)',
      aicte: 'AICTE National Surveillance & Audit Dashboard (REG-02)',
      university: 'Affiliating University Degree Ledger (UNIV-03)',
      student: 'Student Consent Authority & DPDP Vault (STU-04)',
      verifier: 'Public Credential Verification Terminal (VRF-05)',
      login: 'Single Sign-On (Parichay Officer Gateway)',
      policy: 'Statutory Policy & Official Guidelines',
      mandate: 'AICTE Approval Process Handbook (2024–2027)',
      none: 'National Student Registry Portal',
    };

const resolvedBreadcrumb =
  breadcrumb ||
  (currentPath === '/login' ? defaultBreadcrumbs.login : defaultBreadcrumbs[activeRole] || defaultBreadcrumbs.none);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/emblem.svg" />
    <title>{title}</title>
    <!-- Standard Official Typography (Inter + Noto Sans Devanagari for UX4G / GIGW 3.0) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Inter', 'Noto Sans Devanagari', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      /* High contrast focus ring for GIGW accessibility */
      a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible {
        outline: 2px solid #FF9933 !important;
        outline-offset: 2px !important;
      }
    </style>
  </head>
  <body class="bg-[#F8FAFC] text-[#0F172A] min-h-screen flex flex-col antialiased">
    <!-- GIGW Screen Reader Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-[#0F2942] focus:text-white focus:px-4 focus:py-2.5 focus:rounded focus:shadow-2xl focus:border-2 focus:border-[#FF9933] text-xs font-bold uppercase tracking-wider"
    >
      {isHindi ? 'मुख्य सामग्री पर जाएँ' : 'Skip to main content'}
    </a>

    <!-- 1. Tricolor National Strip -->
    <div class="w-full flex h-1.5 shrink-0" aria-hidden="true">
      <div class="w-1/3 bg-[#FF9933]"></div>
      <div class="w-1/3 bg-[#FFFFFF]"></div>
      <div class="w-1/3 bg-[#138808]"></div>
    </div>

    <!-- 2. Top GoI Utility Strip (White / #F8FAFC border-b) -->
    <div class="bg-white border-b border-slate-200 py-2 px-4 sm:px-8">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-xs">
        <!-- Left: Official State Emblem of India & Ministry -->
        <div class="flex items-center gap-3">
          <img
            src="/emblem.svg"
            alt="State Emblem of India (Lion Capital of Ashoka)"
            class="h-10 w-auto object-contain shrink-0"
            width="26"
            height="40"
          />
          <div>
            <div class="font-bold text-[#0F2942] tracking-tight uppercase text-[11px] sm:text-xs leading-tight">
              भारत सरकार | GOVERNMENT OF INDIA
            </div>
            <div class="text-[#334155] text-[11px] font-medium leading-tight mt-0.5">
              शिक्षा मंत्रालय | Ministry of Education &bull; AICTE
            </div>
          </div>
        </div>

        <!-- Right: GIGW Utility Controls (Skip to Main Content, Font Scaler, Language Switcher) -->
        <div class="flex items-center flex-wrap gap-2.5 sm:gap-3.5 text-xs text-slate-600">
          <a
            href="#main-content"
            class="hidden md:inline-flex items-center gap-1 text-slate-600 hover:text-[#0F2942] font-medium transition-colors"
          >
            <span>{isHindi ? 'मुख्य सामग्री पर जाएँ' : 'Skip to Main Content'}</span>
          </a>
          <span class="hidden md:inline-block text-slate-300" aria-hidden="true">|</span>

          <!-- GIGW Standard Font Size Scaler (A-, A, A+) -->
          <div class="flex items-center border border-slate-300 rounded overflow-hidden bg-slate-50 font-bold text-slate-700 shadow-xs" role="group" aria-label="Text Size Controls">
            <button
              type="button"
              id="btn-font-decrease"
              class="px-2 py-0.5 hover:bg-slate-200 focus:bg-slate-200 focus:outline-none transition-colors border-r border-slate-200 text-xs"
              title="Decrease Font Size (A-)"
              aria-label="Decrease Font Size"
            >
              A-
            </button>
            <button
              type="button"
              id="btn-font-reset"
              class="px-2 py-0.5 hover:bg-slate-200 focus:bg-slate-200 focus:outline-none transition-colors border-r border-slate-200 text-xs"
              title="Reset Font Size to Standard (A)"
              aria-label="Reset Font Size"
            >
              A
            </button>
            <button
              type="button"
              id="btn-font-increase"
              class="px-2 py-0.5 hover:bg-slate-200 focus:bg-slate-200 focus:outline-none transition-colors text-xs"
              title="Increase Font Size (A+)"
              aria-label="Increase Font Size"
            >
              A+
            </button>
          </div>

          <span class="text-slate-300" aria-hidden="true">|</span>

          <!-- Language Switcher English / हिन्दी -->
          <nav class="flex items-center gap-1.5 bg-slate-100 px-2.5 py-1 rounded border border-slate-200 font-semibold text-slate-700 text-xs" aria-label="Language / भाषा">
            {isHindi ? (
              <a href={enHref} hreflang="en" lang="en" class="text-slate-600 hover:text-[#0F2942] underline-offset-2 hover:underline">English</a>
            ) : (
              <span class="text-[#0F2942] font-bold" aria-current="true">English</span>
            )}
            <span class="text-slate-400" aria-hidden="true">/</span>
            {isHindi ? (
              <span class="text-[#0F2942] font-bold" aria-current="true">हिन्दी</span>
            ) : (
              <a href={hiHref} hreflang="hi" lang="hi" class="text-slate-600 hover:text-[#0F2942] underline-offset-2 hover:underline">हिन्दी</a>
            )}
          </nav>
        </div>
      </div>
    </div>

    <!-- 3. Primary Department Navbar (Deep Navy Blue #0F2942) -->
    <header class="bg-[#0F2942] text-white shadow-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="flex items-center justify-between min-h-16 py-2 gap-4">
          <!-- Main Portal Title with Official AICTE Emblem -->
          <a href={isHindi ? '/hi' : '/'} class="flex items-center gap-3.5 group">
            <div class="h-11 w-11 rounded-full bg-white p-1 flex items-center justify-center shadow-sm shrink-0 ring-2 ring-white/20 group-hover:ring-[#FF9933] transition-all">
              <img
                src="/aicte.png"
                alt="AICTE Official Emblem"
                class="h-9 w-9 object-contain"
                width="36"
                height="36"
              />
            </div>
            <div>
              <div class="text-[11px] sm:text-xs font-semibold text-amber-300 tracking-wide leading-snug">
                राष्ट्रीय छात्र रजिस्ट्री एवं सत्यापन पोर्टल
              </div>
              <div class="font-bold text-sm sm:text-base tracking-tight text-white leading-tight">
                National Student Registry & Verification Portal
              </div>
              <p class="text-[11px] text-slate-300 leading-tight mt-0.5">
                {isHindi
                  ? 'अखिल भारतीय तकनीकी शिक्षा परिषद (AICTE) • शिक्षा मंत्रालय'
                  : 'All India Council for Technical Education (AICTE) • Ministry of Education'}
              </p>
            </div>
          </a>

          <!-- Right: Desktop Navigation Links + ONE Clean CTA Button -->
          <div class="hidden lg:flex items-center gap-4 shrink-0">
            <nav class="flex items-center space-x-1" aria-label="Portal Navigation">
              {navItems.map((p) => {
                const isActive = activeRole === p.id;
                return (
                  <a
                    href={p.path}
                    class={`px-3.5 py-2 rounded text-xs font-semibold tracking-wide transition-colors ${
                      isActive
                        ? 'bg-white text-[#0F2942] shadow-xs font-bold'
                        : 'text-slate-200 hover:text-white hover:bg-white/10'
                    }`}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {p.label}
                  </a>
                );
              })}
            </nav>

            <div class="h-5 w-px bg-slate-700" aria-hidden="true"></div>

            {user ? (
              <div class="flex items-center gap-2.5 bg-slate-800/90 border border-slate-700 px-3 py-1.5 rounded shadow-xs text-xs">
                <div class="flex flex-col text-right leading-tight">
                  <div class="flex items-center justify-end gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="font-bold text-white font-mono text-xs">{user.username}</span>
                    <span class="bg-blue-900 text-blue-200 border border-blue-700 px-1.5 py-0.5 rounded text-[10px] font-semibold">
                      {roleLabels[user.role] || user.role}
                    </span>
                  </div>
                  {user.role === 'INSTITUTE_ADMIN' && user.institution_id && (
                    <span class="text-[10px] text-amber-300 font-mono font-medium mt-0.5">
                      {isHindi ? 'संस्थान:' : 'Institution:'} {user.institution_id}
                    </span>
                  )}
                </div>
                <a
                  href="/api/auth/logout"
                  class="ml-1 px-2.5 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded text-xs font-bold shadow-xs transition-colors flex items-center gap-1"
                  title={isHindi ? 'लॉग आउट करें' : 'Sign Out of Gateway'}
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  <span>{isHindi ? 'लॉग आउट' : 'Sign Out'}</span>
                </a>
              </div>
            ) : (
              <a
                href="/login"
                class={`px-4 py-2 font-bold rounded text-xs transition-colors shadow-xs flex items-center gap-2 ${
                  activeRole === 'login'
                    ? 'bg-white text-[#0F2942] ring-2 ring-[#FF9933]'
                    : 'bg-[#FF9933] hover:bg-[#F28500] text-slate-950'
                }`}
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
                <span>{isHindi ? 'अधिकारी लॉगिन' : 'Officer Sign In'}</span>
              </a>
            )}
          </div>

          <!-- Mobile / Tablet Navigation Select & Sign In/Out -->
          <div class="lg:hidden flex items-center gap-2">
            <label for="mobile-portal-select" class="sr-only">
              {isHindi ? 'पोर्टल चुनें' : 'Select Portal'}
            </label>
            <select
              id="mobile-portal-select"
              class="bg-slate-800 text-white text-xs rounded border border-slate-600 px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-[#FF9933]"
              onchange="window.location.href=this.value"
            >
              {navItems.map((p) => (
                <option value={p.path} selected={activeRole === p.id}>
                  {p.label}
                </option>
              ))}
            </select>
            {user ? (
              <a
                href="/api/auth/logout"
                class="px-2.5 py-1.5 bg-red-600 text-white rounded text-xs font-bold"
                title={isHindi ? 'लॉग आउट' : 'Sign Out'}
              >
                {isHindi ? 'लॉग आउट' : 'Sign Out'}
              </a>
            ) : (
              <a
                href="/login"
                class="px-3 py-1.5 bg-[#FF9933] text-slate-950 font-bold rounded text-xs"
              >
                {isHindi ? 'अधिकारी लॉगिन' : 'Officer Sign In'}
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Secondary Sub-Bar: UX4G Official Breadcrumb & Statutory Status Bar -->
      <div class="bg-[#0B1E32] border-t border-slate-700/70 px-4 sm:px-8 py-2 text-xs text-slate-300">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
          <!-- Left: Official Breadcrumb Trail -->
          <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs">
            <a href={isHindi ? '/hi' : '/'} class="text-slate-300 hover:text-white font-medium flex items-center gap-1 transition-colors">
              <svg class="w-3.5 h-3.5 text-[#FF9933]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span>{isHindi ? 'मुख्य पृष्ठ' : 'Home'}</span>
            </a>
            <span class="text-slate-500" aria-hidden="true">/</span>
            <span class="font-semibold text-white" aria-current="page">{resolvedBreadcrumb}</span>
          </nav>

          <!-- Right: Official Statutory Pills -->
          <div class="hidden md:flex items-center gap-2 text-[11px] font-medium text-slate-300">
            <span class="inline-flex items-center gap-1.5 bg-slate-800/90 border border-slate-700 px-2.5 py-0.5 rounded text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>{isHindi ? 'APAAR • ABC एकीकृत' : 'APAAR • ABC Integrated'}</span>
            </span>
            <span class="text-slate-600" aria-hidden="true">|</span>
            <span class="inline-flex items-center gap-1.5 bg-slate-800/90 border border-slate-700 px-2.5 py-0.5 rounded text-blue-200">
              <span>{isHindi ? 'DPDP अधिनियम 2023 अनुपालित' : 'DPDP Act 2023 Compliant'}</span>
            </span>
            <span class="text-slate-600" aria-hidden="true">|</span>
            <span class="inline-flex items-center gap-1.5 bg-slate-800/90 border border-slate-700 px-2.5 py-0.5 rounded text-amber-200">
              <span>{isHindi ? 'Ed25519 हस्ताक्षरित लेजर' : 'Ed25519 Signed Ledger'}</span>
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- 4. Main Page Content Container -->
    <main id="main-content" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-6 focus:outline-none">
      <slot />
    </main>

    <!-- 5. Standard Government of India UX4G Footer -->
    <footer class="bg-[#0F172A] text-slate-300 text-xs sm:text-sm border-t border-slate-800 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 py-10">
        <!-- Partner & Standards Row (Digital India, AICTE, GIGW 3.0, DPDP Act 2023) -->
        <div class="flex flex-wrap items-center justify-between gap-6 pb-8 mb-8 border-b border-slate-800">
          <div class="flex items-center flex-wrap gap-4">
            <div class="bg-white rounded px-2.5 py-1 shadow-xs flex items-center">
              <img
                src="/digital_india.svg"
                alt="Digital India - Power to Empower"
                class="h-8 sm:h-9 w-auto object-contain"
                width="110"
                height="36"
              />
            </div>
            <div class="bg-white rounded p-1 shadow-xs flex items-center">
              <img
                src="/aicte.png"
                alt="All India Council for Technical Education"
                class="h-8 sm:h-9 w-auto object-contain"
                width="36"
                height="36"
              />
            </div>
            <div class="border-l border-slate-700 pl-4 text-xs">
              <div class="font-bold text-white uppercase tracking-wider">
                {isHindi ? 'राष्ट्रीय डिजिटल शिक्षा वास्तुकला (NDEAR)' : 'National Digital Education Architecture (NDEAR)'}
              </div>
              <div class="text-slate-400 mt-0.5">
                {isHindi
                  ? 'APAAR • अकादमिक बैंक ऑफ़ क्रेडिट्स (ABC) • डिजिलॉकर के साथ एकीकृत'
                  : 'Integrated with APAAR • Academic Bank of Credits (ABC) • DigiLocker'}
              </div>
            </div>
          </div>

          <div class="flex items-center flex-wrap gap-3">
            <!-- GIGW 3.0 Compliance Badge -->
