        malformed = 0,
        missing = 0;
      let html = '';

      rows.forEach((r, idx) => {
        const is12 = /^[0-9]{12}$/.test(r.apaar_id || '');
        const isMissing = !r.apaar_id || r.apaar_id.trim() === '';
        const rollId = r.student_roll_id || `INST-2024-CSE-${String(idx + 1).padStart(3, '0')}`;

        let statusTag = '';
