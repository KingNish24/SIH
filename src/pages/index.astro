---
import Layout from '../layouts/Layout.astro';
import {
  getLanguageInfo,
  getUIDictionary,
  isSupportedLang,
  type LangCode,
} from '../lib/i18n';

const resolvedLang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langInfo = getLanguageInfo(resolvedLang);
const t = getUIDictionary(resolvedLang);
const langPrefix = resolvedLang === 'en' ? '' : `/${resolvedLang}`;
---

<Layout
  title={`${t.portalTitle} (${langInfo.nativeName}) | AICTE | Ministry of Education`}
  activeRole="overview"
  breadcrumb={t.portalTitle}
  lang={resolvedLang}
  fullBleed={true}
>
  <div class="w-full bg-white">
    <!-- 1. HERO BANNER: Contained UIDAI-Style Card + APAAR Academic ID Card Preview -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 pt-6 pb-8">
      <div class="relative rounded-2xl bg-gradient-to-r from-[#040E29] via-[#092052] to-[#0E337A] text-white overflow-hidden shadow-lg px-6 sm:px-12 py-10 sm:py-14">
        <!-- Subtle Background Dot Grid -->
        <div
          class="absolute inset-0 opacity-15 pointer-events-none"
          style="background-image: radial-gradient(#60A5FA 1px, transparent 1px); background-size: 24px 24px;"
          aria-hidden="true"
        ></div>

        <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <!-- Left 7 Cols: AICTE APAAR Student Registry Headline & Pill CTAs -->
          <div class="lg:col-span-7 space-y-4">
            <p class="text-xs sm:text-sm font-bold text-[#FF9933] uppercase tracking-wider" data-i18n="heroBadge">
              {t.heroBadge}
            </p>

            <h1 class="text-2xl sm:text-4xl lg:text-[40px] font-extrabold tracking-tight text-white leading-[1.18]" data-i18n="heroTitle">
              {t.heroTitle}
            </h1>

            <p class="text-xs sm:text-sm text-slate-200/90 leading-relaxed max-w-xl" data-i18n="heroSubtitle">
              {t.heroSubtitle}
            </p>

            <div class="pt-3 flex flex-wrap items-center gap-3">
              <a
                href="#stakeholder-flow"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#FF9933] hover:bg-[#F28500] text-slate-950 text-xs sm:text-sm font-bold shadow-sm transition-all"
              >
                <span data-i18n="portalsHeading">{t.portalsHeading}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a
                href={`${langPrefix}/verifier`}
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-white/15 hover:bg-white/25 border border-white/30 text-white text-xs sm:text-sm font-bold transition-all"
              >
                <span data-i18n="navVerifier">{t.navVerifier}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <!-- Right 5 Cols: Authentic APAAR Academic ID Card Preview (Like apaar.education.gov.in) -->
          <div class="lg:col-span-5 flex items-center justify-center py-2">
            <div class="relative w-full max-w-[370px] select-none">
              <!-- Floating Verified Pill (Bottom Left) -->
              <div class="-bottom-3.5 left-4 z-20 absolute bg-emerald-50 text-slate-900 rounded-full shadow-lg border border-emerald-300 px-3.5 py-1.5 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#138808]"></span>
                <span class="text-[11px] font-extrabold text-[#0B1E48] leading-none">AICTE Seat Verified • Within Limit</span>
              </div>

              <!-- Main White APAAR Card -->
              <div class="relative z-10 bg-white text-slate-900 rounded-2xl shadow-2xl border border-slate-200/90 p-5 pb-6">
                <!-- Card Header: Ministry + APAAR -->
                <div class="flex items-center justify-between pb-3 mb-3.5 border-b border-slate-100">
                  <div class="flex items-center gap-2">
                    <img src="/emblem.svg" alt="" class="h-7 w-auto object-contain" />
                    <div class="leading-tight">
                      <div class="text-[9px] font-bold uppercase text-slate-500">Ministry of Education</div>
                      <div class="text-[11px] font-extrabold text-[#0B1E48]">AICTE • Govt. of India</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-sm font-black tracking-tight text-[#138808] leading-none">APAAR</div>
                    <div class="text-[8px] font-bold uppercase tracking-wider text-slate-400 mt-0.5">One Nation One ID</div>
                  </div>
                </div>

                <!-- Card Body: Student Details + QR Code -->
                <div class="flex items-center justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-[#0B1E48] font-extrabold text-sm shrink-0">
                      SS
                    </div>
                    <div class="space-y-0.5">
                      <div class="text-xs font-extrabold text-slate-900">Sneha Sundaram</div>
                      <div class="text-[11px] text-slate-600">B.Tech Computer Science</div>
                      <div class="text-[10px] font-mono text-slate-500">Roll ID: TCA-2024-029</div>
                    </div>
                  </div>

                  <div class="w-14 h-14 p-1 rounded-lg border border-slate-200 bg-white shrink-0">
                    <svg viewBox="0 0 36 36" class="w-full h-full text-slate-900" fill="currentColor" aria-hidden="true">
                      <path d="M2 2h10v10H2V2zm2 2v6h6V4H4zm2 2h2v2H6V6zm18-4h10v10H24V2zm2 2v6h6V4h-6zm2 2h2v2h-2V6zM2 24h10v10H2V24zm2 2v6h6v-6H4zm2 2h2v2H6v-2zm10-24h2v4h-2V4zm4 2h2v4h-2V6zm-4 6h4v2h-4v-2zm6 2h6v2h-6v-2zm-8 4h4v4h-4v-4zm6 4h4v4h-4v-4zm6-2h4v6h-4v-6zm-12 8h2v4h-2v-4zm4 2h6v2h-6v-2zm8 0h4v4h-4v-4z" />
                    </svg>
                  </div>
                </div>

                <!-- Card Footer: 12-Digit Number -->
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">APAAR ID</span>
                  <span class="font-mono text-sm font-extrabold tracking-widest text-[#0B1E48]">4123 9847 1029</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. UIDAI-STYLE "CHOOSE YOUR PORTAL" SOFT CONTAINER WITH 4 MINIMAL WHITE CARDS -->
    <section id="stakeholder-flow" class="max-w-7xl mx-auto px-4 sm:px-8 py-4">
      <div class="rounded-3xl bg-[#F3F5FB] p-6 sm:p-9">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-7">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-[#0B1E48]" data-i18n="portalsHeading">
              {t.portalsHeading}
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-0.5" data-i18n="portalsSub">
              {t.portalsSub}
            </p>
          </div>
          <a
            href={`${langPrefix}/verifier`}
            class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-[#0B1E48]/30 hover:border-[#0B1E48] bg-white text-[#0B1E48] text-xs font-bold transition-all self-start sm:self-auto"
          >
            <span data-i18n="navVerifier">{t.navVerifier}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <!-- Card 1: Colleges -->
          <a
            href={`${langPrefix}/institution`}
            class="group bg-white rounded-2xl p-6 shadow-2xs hover:shadow-md border border-slate-100 transition-all flex flex-col justify-between min-h-[195px]"
          >
            <div>
              <div class="w-10 h-10 text-[#0B1E48] mb-3">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-[#0B4EA2] transition-colors" data-i18n="portal1Title">
                {t.portal1Title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mt-1.5" data-i18n="portal1Desc">
                {t.portal1Desc}
              </p>
            </div>
            <div class="pt-5 flex items-center justify-between">
              <span class="w-7 h-7 rounded-full border border-slate-300 group-hover:border-[#0B4EA2] group-hover:bg-[#0B4EA2] group-hover:text-white text-slate-600 flex items-center justify-center text-xs transition-all">
                &rarr;
              </span>
              <span class="text-[11px] font-medium text-slate-400">{t.nav_institution}</span>
            </div>
          </a>

          <!-- Card 2: AICTE Portal -->
          <a
            href={`${langPrefix}/aicte`}
            class="group bg-white rounded-2xl p-6 shadow-2xs hover:shadow-md border border-slate-100 transition-all flex flex-col justify-between min-h-[195px]"
          >
            <div>
              <div class="w-10 h-10 text-[#0B1E48] mb-3">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-[#0B4EA2] transition-colors" data-i18n="portal2Title">
                {t.portal2Title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mt-1.5" data-i18n="portal2Desc">
                {t.portal2Desc}
              </p>
            </div>
            <div class="pt-5 flex items-center justify-between">
              <span class="w-7 h-7 rounded-full border border-slate-300 group-hover:border-[#0B4EA2] group-hover:bg-[#0B4EA2] group-hover:text-white text-slate-600 flex items-center justify-center text-xs transition-all">
                &rarr;
              </span>
              <span class="text-[11px] font-medium text-slate-400">{t.nav_aicte}</span>
            </div>
          </a>

          <!-- Card 3: Universities -->
          <a
            href={`${langPrefix}/university`}
            class="group bg-white rounded-2xl p-6 shadow-2xs hover:shadow-md border border-slate-100 transition-all flex flex-col justify-between min-h-[195px]"
          >
            <div>
              <div class="w-10 h-10 text-[#0B1E48] mb-3">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-[#0B4EA2] transition-colors" data-i18n="nav_university">
                {t.nav_university}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mt-1.5" data-i18n="portal3Desc">
                {t.portal3Desc}
              </p>
            </div>
            <div class="pt-5 flex items-center justify-between">
              <span class="w-7 h-7 rounded-full border border-slate-300 group-hover:border-[#0B4EA2] group-hover:bg-[#0B4EA2] group-hover:text-white text-slate-600 flex items-center justify-center text-xs transition-all">
                &rarr;
              </span>
              <span class="text-[11px] font-medium text-slate-400">{t.nav_university}</span>
            </div>
          </a>

          <!-- Card 4: Students -->
          <a
            href={`${langPrefix}/student`}
            class="group bg-white rounded-2xl p-6 shadow-2xs hover:shadow-md border border-slate-100 transition-all flex flex-col justify-between min-h-[195px]"
          >
            <div>
              <div class="w-10 h-10 text-[#0B1E48] mb-3">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-[#0B4EA2] transition-colors" data-i18n="portal4Title">
                {t.portal4Title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mt-1.5" data-i18n="portal4Desc">
                {t.portal4Desc}
              </p>
            </div>
            <div class="pt-5 flex items-center justify-between">
              <span class="w-7 h-7 rounded-full border border-slate-300 group-hover:border-[#0B4EA2] group-hover:bg-[#0B4EA2] group-hover:text-white text-slate-600 flex items-center justify-center text-xs transition-all">
                &rarr;
              </span>
              <span class="text-[11px] font-medium text-slate-400">{t.nav_student}</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 3. BALANCED 3-CARD BENEFITS SECTION WITH CLEAN YELLOW CIRCLE LOGOS -->
    <section id="how-it-works" class="max-w-7xl mx-auto px-4 sm:px-8 py-14">
      <div class="max-w-2xl mb-9">
        <div class="text-xs font-bold uppercase tracking-widest text-[#0B4EA2] mb-1.5" data-i18n="home_steps_eyebrow">
          {t.home_steps_eyebrow}
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight" data-i18n="home_steps_heading">
          {t.home_steps_heading}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed" data-i18n="home_steps_sub">
          {t.home_steps_sub}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        <!-- Card 1: Seat Limit & Quota Check -->
        <div class="bg-white rounded-2xl p-7 shadow-[0_8px_30px_rgba(11,30,72,0.08)] border border-slate-200/80 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-full bg-[#FFAE19] text-slate-950 flex items-center justify-center mb-5 shadow-xs">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-[#0B1E48] mb-2" data-i18n="home_hero_promise_2">
              {t.home_hero_promise_2}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3" data-i18n="home_step1_desc">
              {t.home_step1_desc}
            </p>
            <p class="text-xs text-slate-500 leading-relaxed" data-i18n="home_step2_desc">
              {t.home_step2_desc}
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-100">
            <a href={`${langPrefix}/institution`} class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0B4EA2] hover:text-[#0B1E48] transition-colors">
              <span data-i18n="nav_institution">{t.nav_institution}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Card 2: Verified Digital Degrees -->
        <div class="bg-white rounded-2xl p-7 shadow-[0_8px_30px_rgba(11,30,72,0.08)] border border-slate-200/80 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-full bg-[#FFAE19] text-slate-950 flex items-center justify-center mb-5 shadow-xs">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-[#0B1E48] mb-2" data-i18n="home_hero_promise_1">
              {t.home_hero_promise_1}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3" data-i18n="home_step3_desc">
              {t.home_step3_desc}
            </p>
            <p class="text-xs text-slate-500 leading-relaxed" data-i18n="home_rule2_desc">
              {t.home_rule2_desc}
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-100">
            <a href={`${langPrefix}/university`} class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0B4EA2] hover:text-[#0B1E48] transition-colors">
              <span data-i18n="nav_university">{t.nav_university}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Card 3: Free Employer & Public Check -->
        <div class="bg-white rounded-2xl p-7 shadow-[0_8px_30px_rgba(11,30,72,0.08)] border border-slate-200/80 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-full bg-[#FFAE19] text-slate-950 flex items-center justify-center mb-5 shadow-xs">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-[#0B1E48] mb-2" data-i18n="home_hero_promise_3">
              {t.home_hero_promise_3}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3" data-i18n="home_step4_desc">
              {t.home_step4_desc}
            </p>
            <p class="text-xs text-slate-500 leading-relaxed" data-i18n="portal5Desc">
              {t.portal5Desc}
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-100">
            <a href={`${langPrefix}/verifier`} class="inline-flex items-center gap-1.5 text-xs font-bold text-[#138808] hover:text-[#0E6506] transition-colors">
              <span data-i18n="navVerifier">{t.navVerifier}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. NAD-STYLE FULL-WIDTH BLUE VIDEO CONFERENCE BANNER -->
    <section class="w-full bg-[#09569B] text-white py-10 px-4 sm:px-8">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div>
          <h3 class="text-lg sm:text-2xl font-extrabold text-white" data-i18n="home_helpdesk_title">
            {t.home_helpdesk_title}
          </h3>
          <p class="text-xs sm:text-sm text-sky-100 mt-1">
            <span data-i18n="home_helpdesk_hours_val">{t.home_helpdesk_hours_val}</span> &bull; Helpline: <strong class="font-mono text-white">1800-889-3511</strong>
          </p>
        </div>

        <a
          href={`${langPrefix}/institution`}
          class="px-7 py-2.5 rounded-full bg-white hover:bg-slate-100 text-[#09569B] font-extrabold text-xs sm:text-sm shadow-md transition-all shrink-0"
        >
          Join Now
        </a>
      </div>
    </section>
  </div>
</Layout>
