---
import Layout from '../layouts/Layout.astro';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const t = getUIDictionary(lang);

const url = Astro.url;
const queryApaar = url.searchParams.get('apaar')?.trim() || '';
const queryInst = url.searchParams.get('institution')?.trim() || '';
const queryToken = url.searchParams.get('token')?.trim() || '';
const initialApaar = /^\d{12}$/.test(queryApaar) ? queryApaar : '';
const initialOrg = queryInst
  ? `Institutional Audit (${queryInst})`
  : '';
---

<Layout
  title={`SIH 2026 | ${t.verifier_page_title}`}
  activeRole="verifier"
  breadcrumb={t.crumb_verifier}
  lang={lang}
>
  <style is:global>
    @media print {
      body {
        background: #FFFFFF !important;
        color: #0F172A !important;
      }
      header,
      footer,
      .no-print,
      #gov-toast-container {
        display: none !important;
      }
      main#main-content {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      #resultContainer {
        border: 2px solid #0B1E48 !important;
        box-shadow: none !important;
        break-inside: avoid;
      }
      .print-only-attestation {
        display: block !important;
      }
    }
  </style>

  <!-- INDIAN GOVERNMENT PORTAL 2-COLUMN LEFT SIDEBAR + RIGHT MAIN CONTENT LAYOUT -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- 1. LEFT SIDEBAR (Matching /institution Style) -->
    <aside class="lg:col-span-3 no-print lg:sticky lg:top-6">
      <div class="rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-xs">
        <!-- Top Dark Navy Card Header -->
        <div class="bg-[#0B1E48] text-white p-5">
          <div class="text-[11px] font-mono uppercase tracking-wider text-blue-200">
            AICTE &bull; DIGILOCKER &bull; NAD
          </div>
          <h1 class="text-base font-bold text-white mt-1 leading-snug">
            Public Degree &amp; Admission Verifier
          </h1>
          <p class="text-xs text-blue-200 mt-1">
            Employer &amp; University Verification Desk
          </p>
          {queryInst && (
            <div class="mt-2 inline-block bg-amber-100 text-amber-950 border border-amber-300 px-2 py-0.5 rounded font-mono text-[10px]">
              Filter: {queryInst}
            </div>
          )}
          <div class="mt-3 pt-3 border-t border-white/15 text-xs text-emerald-300 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
            <span>Official Registry Online</span>
          </div>
        </div>

        <!-- Vertical Navigation Menu -->
        <div class="p-3 space-y-1" role="tablist" aria-label="Verification Menu">
          <div class="px-3 pt-1 pb-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">
            VERIFICATION MENU
          </div>

          <button
            type="button"
            id="navTabApaarLookup"
            role="tab"
            aria-selected="true"
            aria-controls="panelApaarLookup"
            class="w-full text-left px-3.5 py-3 rounded-xl text-sm font-bold bg-[#0B4EA2] text-white flex items-center justify-between gap-2 cursor-pointer transition-colors"
          >
            <span class="inline-flex items-center gap-2.5 truncate">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span class="truncate">Verify by APAAR ID</span>
            </span>
            <span
              data-sidebar-badge
              class="shrink-0 whitespace-nowrap px-2 py-0.5 rounded-full text-[11px] font-mono font-bold bg-white/20 text-white"
            >
              APAAR
            </span>
          </button>

          <button
            type="button"
            id="navTabScanMarksheet"
            role="tab"
            aria-selected="false"
            aria-controls="vlmForensicsSection"
            class="w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between gap-2 cursor-pointer transition-colors"
          >
            <span class="inline-flex items-center gap-2.5 truncate">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span class="truncate">Check Certificate</span>
            </span>
            <span
              data-sidebar-badge
              class="shrink-0 whitespace-nowrap px-2 py-0.5 rounded-full text-[11px] font-mono font-bold bg-slate-100 text-slate-600"
            >
              SCAN
            </span>
          </button>

          <button
            type="button"
            id="navTabOfflineQr"
            role="tab"
            aria-selected="false"
            aria-controls="offlineVerifierSection"
            class="w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between gap-2 cursor-pointer transition-colors"
          >
            <span class="inline-flex items-center gap-2.5 truncate">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
              </svg>
              <span class="truncate">Verify QR Code</span>
            </span>
            <span
              data-sidebar-badge
              class="shrink-0 whitespace-nowrap px-2 py-0.5 rounded-full text-[11px] font-mono font-bold bg-slate-100 text-slate-600"
            >
              QR
            </span>
          </button>
        </div>

        <!-- Bottom Helpdesk Box inside Sidebar -->
        <div class="p-4 bg-slate-50 border-t border-slate-200 text-xs text-slate-600 space-y-1">
          <div class="font-bold text-[#0B1E48]">NIC / NAD Verification Helpdesk</div>
          <div class="font-mono text-slate-500">Toll-Free: 1800-889-3511</div>
        </div>
      </div>
    </aside>

    <!-- 2. RIGHT MAIN CONTENT AREA -->
    <div class="lg:col-span-9 space-y-5 min-w-0">
      <!-- PANEL 1 (Default Visible): Verify by APAAR ID -->
      <div id="panelApaarLookup" role="tabpanel" aria-labelledby="navTabApaarLookup" class="space-y-5">
        <!-- Top 3 Simple Summary Cards (matching /institution top cards) -->
        <section aria-label="Verification Summary" class="grid grid-cols-1 sm:grid-cols-3 gap-4 no-print">
          <!-- Card 1: Verification Status -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Verification Status</div>
            <div id="topCardStatus" class="text-2xl font-extrabold text-[#0B1E48] mt-1">
              Ready
            </div>
            <div id="topCardStatusSub" class="text-xs text-slate-500 mt-0.5">
              Official NAD / AICTE Record
            </div>
          </div>

          <!-- Card 2: Student & Roll No. -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Student &amp; Roll No.</div>
            <div id="resName" class="text-xl font-extrabold text-[#0B1E48] mt-1 truncate">
              Enter 12-Digit APAAR
            </div>
            <div id="resStudentRollId" class="text-xs font-mono text-slate-500 mt-0.5">
              {initialApaar ? `Roll: STU-TCA-2020-${initialApaar.slice(-4)}` : 'Roll: Awaiting Lookup'}
            </div>
          </div>

          <!-- Card 3: Digital Signature -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Digital Signature</div>
            <div id="resCryptoStatus" class="text-xl font-extrabold text-slate-700 mt-1 flex items-center gap-1">
              <span>Awaiting Check</span>
            </div>
            <div id="resConsentPill" class="text-xs text-slate-500 mt-0.5 flex items-center gap-1">
              <span>DPDP Consent: Pending</span>
            </div>
            <span id="i18nTamperVerified" class="hidden">{t.verifier_tamper_verified}</span>
            <span id="i18nTamperFailed" class="hidden">{t.verifier_tamper_failed}</span>
          </div>
        </section>

        <!-- Clean Search Card -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-4 no-print shadow-xs">
          <!-- Header Row: Title on Left + 3 Clean Sample Buttons on Right -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-bold text-[#0B1E48]">
                Check Student Degree or Admission Record
              </h2>
              <p class="text-xs text-slate-600 mt-0.5">
                Enter the student's 12-digit APAAR ID to verify degree status, university signature, and enrollment history.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2 shrink-0">
              <button
                type="button"
                class="demoApaarBtn px-2.5 py-1.5 rounded-lg text-xs font-bold border border-slate-300 bg-slate-50 hover:bg-slate-100 text-[#0B1E48] inline-flex items-center gap-1.5 transition-colors cursor-pointer"
                data-apaar="412398471029"
                data-org="UPSC / Employer Verification"
              >
                <span class="w-2 h-2 rounded-full bg-emerald-600 shrink-0" aria-hidden="true"></span>
                <span>Sample: Valid Degree</span>
              </button>

              <button
                type="button"
                class="demoApaarBtn px-2.5 py-1.5 rounded-lg text-xs font-bold border border-slate-300 bg-slate-50 hover:bg-slate-100 text-[#0B1E48] inline-flex items-center gap-1.5 transition-colors cursor-pointer"
                data-apaar="601928374819"
                data-org="AICTE Vigilance Desk"
              >
                <span class="w-2 h-2 rounded-full bg-red-600 shrink-0" aria-hidden="true"></span>
                <span>Sample: Revoked Degree</span>
              </button>

              <button
                type="button"
                class="demoApaarBtn px-2.5 py-1.5 rounded-lg text-xs font-bold border border-slate-300 bg-slate-50 hover:bg-slate-100 text-[#0B1E48] inline-flex items-center gap-1.5 transition-colors cursor-pointer"
                data-apaar="739284019283"
                data-org="NSP Scholarship Desk"
              >
                <span class="w-2 h-2 rounded-full bg-amber-600 shrink-0" aria-hidden="true"></span>
                <span>Sample: Duplicate Alert</span>
              </button>
            </div>
          </div>

          <!-- Search Form -->
          <form id="verifierQueryForm" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-4">
              <label for="queryApaar" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                12-Digit Student APAAR ID *
              </label>
              <input
                type="text"
                id="queryApaar"
                required
                pattern="[0-9]{12}"
                maxlength="12"
                placeholder={t.verifier_apaar_placeholder}
                value={initialApaar}
                class="w-full h-11 bg-slate-50 border border-slate-300 rounded-lg py-2.5 px-3.5 font-mono text-slate-900 text-sm tracking-wider focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2] transition-all"
              />
            </div>

            <div class="md:col-span-5">
              <label for="verifierOrg" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Your Organization / Purpose *
              </label>
              <input
                type="text"
                id="verifierOrg"
                required
                value={initialOrg}
                placeholder="e.g. UPSC / TCS HR / IIT Admissions"
                class="w-full h-11 bg-slate-50 border border-slate-300 rounded-lg py-2.5 px-3.5 text-slate-800 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2] transition-all"
              />
            </div>

            <div class="md:col-span-3">
              <button
                type="submit"
                id="verifySubmitBtn"
                class="w-full h-11 py-2.5 px-4 rounded-lg bg-[#0B4EA2] hover:bg-[#083B7E] text-white font-bold text-sm transition-colors flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap"
              >
                <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span id="verifyBtnLabel">{t.verifier_btn}</span>
              </button>
            </div>
          </form>

          <!-- Collapsible Optional Eligibility Check & Consent Pass -->
          <div class="pt-3 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
            <details class="flex-1">
              <summary class="cursor-pointer font-semibold text-slate-700 hover:text-[#0B4EA2] select-none">
                Optional: Check Minimum CGPA Cutoff or Enter Student Consent Pass
              </summary>

              <div class="mt-3 pt-3 border-t border-slate-100 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                <div class="flex items-start sm:items-center gap-2.5">
                  <input
                    type="checkbox"
                    id="zkPredicateToggle"
                    class="mt-0.5 sm:mt-0 w-4 h-4 rounded border-slate-300 text-[#0B4EA2] focus:ring-[#0B4EA2] cursor-pointer"
                  />
                  <div>
                    <label for="zkPredicateToggle" class="text-xs font-bold text-[#0B1E48] cursor-pointer">
                      Yes / No Eligibility Check (Hide Exact Marks)
                    </label>
                    <p class="text-[11px] text-slate-600 mt-0.5">
                      Confirms whether the student meets your minimum CGPA and graduation year cutoff.
                    </p>
                  </div>
                </div>

                <div id="zkPredicateControls" class="flex flex-wrap items-center gap-2.5 text-xs pt-2 lg:pt-0">
                  <button
                    type="button"
                    id="zkPresetCutoffBtn"
                    class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-[#0B1E48] border border-slate-300 font-mono font-semibold text-[11px] transition-colors cursor-pointer"
                    data-cgpa="7.5"
                    data-year="2022"
                  >
                    Preset: CGPA &ge; 7.5 &bull; 2022
                  </button>
                  <div class="flex items-center gap-1.5">
                    <label for="zkMinCgpa" class="font-semibold text-slate-700 whitespace-nowrap">Min CGPA &ge;</label>
                    <input
                      type="number"
                      id="zkMinCgpa"
                      step="0.05"
                      min="4.0"
                      max="10.0"
                      placeholder="7.5"
                      class="w-20 h-8 bg-white border border-slate-300 rounded px-2 font-mono font-bold text-slate-900 text-xs"
                    />
                  </div>
                  <div class="flex items-center gap-1.5">
                    <label for="zkMinYear" class="font-semibold text-slate-700 whitespace-nowrap">Grad Year &ge;</label>
                    <input
                      type="number"
                      id="zkMinYear"
                      step="1"
                      min="2000"
                      max="2030"
                      placeholder="2022"
                      class="w-20 h-8 bg-white border border-slate-300 rounded px-2 font-mono font-bold text-slate-900 text-xs"
                    />
                  </div>
                  <div class="flex items-center gap-1.5">
                    <label for="zkConsentToken" class="font-semibold text-slate-700 whitespace-nowrap">Consent Pass:</label>
                    <input
                      type="text"
                      id="zkConsentToken"
                      value={queryToken}
                      placeholder="Optional DPDP Pass"
                      class="w-36 h-8 bg-white border border-slate-300 rounded px-2 font-mono text-slate-800 text-xs"
                    />
                  </div>
                </div>
              </div>
            </details>

            <button
              type="button"
              id="scanQrBtn"
              class="self-start sm:self-center text-xs font-bold text-[#0B4EA2] hover:text-[#0B1E48] inline-flex items-center gap-1.5 cursor-pointer shrink-0"
              title="Verify QR Code Data"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
              </svg>
              <span>{t.verifier_scan_qr_btn}</span>
            </button>
          </div>
        </div>

        <!-- Clean Official Verification Result Card -->
        <section id="resultContainer" aria-live="polite" class="rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-xs">
          <!-- Clean White/Slate Header Bar -->
          <div id="resBanner" class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="bg-white rounded-lg border border-slate-200 p-1.5 shrink-0">
                <img src="/emblem.svg" alt="State Emblem of India" class="h-7 w-auto object-contain" width="22" height="28" />
              </div>
              <div>
                <h2 id="resTitle" class="text-base font-bold text-[#0B1E48]">
                  Official Degree &amp; Enrollment Verification Report
                </h2>
                <div class="text-xs text-slate-600 mt-0.5">
                  National Academic Depository (NAD) &bull; AICTE Registry
                </div>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-center">
              <span id="resBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-300">
                <span>Awaiting Lookup</span>
              </span>
              <button
                type="button"
                id="btnPrintSection63"
                class="no-print inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-colors cursor-pointer"
              >
                <svg class="w-3.5 h-3.5 text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                <span>Print Official Report</span>
              </button>
            </div>
          </div>

          <div class="p-6 space-y-4">
            <!-- Eligibility Check Banner (shown when cutoff toggle is active) -->
            <div id="resPredicateBanner" class="hidden p-4 rounded-xl border bg-blue-50/70 border-blue-200 text-xs space-y-2"></div>

            <!-- Degree & Enrollment Table / Grid Body -->
            <div id="resDegrees" class="space-y-4">
              <div class="py-4 px-4 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-600">
                Enter a 12-digit student APAAR ID above or click <strong>Sample: Valid Degree</strong> to view the official verification report.
              </div>
            </div>

            <!-- Collapsed Technical Signature & Audit Details (Preserves Required DOM IDs cleanly) -->
            <details class="text-xs text-slate-500 pt-2">
              <summary class="cursor-pointer font-semibold text-slate-600 hover:text-[#0B1E48] select-none">
                View Technical Signature &amp; Audit Details
              </summary>
              <div class="mt-2 p-3.5 rounded-xl bg-slate-50 border border-slate-200 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs">
                <div>
                  <span class="text-slate-500 font-semibold">APAAR Reference:</span>
                  <div id="resApaar" class="font-mono font-bold text-slate-800 mt-0.5">
                    {initialApaar ? `XXXX-XXXX-${initialApaar.slice(-4)}` : 'XXXX-XXXX-••••'}
                  </div>
                </div>
                <div>
                  <span class="text-slate-500 font-semibold">Signing Key ID:</span>
                  <div id="resKeyId" class="font-mono font-bold text-slate-800 mt-0.5 truncate">Key ID: aicte-nad-2026</div>
                </div>
                <div>
                  <span class="text-slate-500 font-semibold">Audit Request ID:</span>
                  <div id="resRequestId" class="font-mono font-bold text-slate-800 mt-0.5 truncate">REQ-READY</div>
                </div>
                <div>
                  <span class="text-slate-500 font-semibold">Verification Time:</span>
                  <div id="resLatency" class="font-mono font-bold text-emerald-700 mt-0.5">-- ms</div>
                </div>
                <div id="resTechDigestBox" class="sm:col-span-2 lg:col-span-4 pt-2 border-t border-slate-200 font-mono text-[11px] text-slate-600 hidden"></div>
              </div>
            </details>

            <!-- Single Clean Footer Line (Section 63 BSA 2023) -->
            <div class="text-xs text-slate-500 pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <span>Valid Electronic Record under Section 63, Bharatiya Sakshya Adhiniyam (BSA), 2023</span>
              <span id="bsaTimestamp" class="font-mono">Checked: {new Date().toISOString().slice(0, 19).replace('T', ' ')} UTC</span>
            </div>
          </div>
        </section>
      </div>

      <!-- PANEL 2 (Hidden until clicked): Check Certificate File -->
      <section
        id="vlmForensicsSection"
        role="tabpanel"
        aria-labelledby="navTabScanMarksheet"
        class="hidden no-print bg-white border border-slate-200 rounded-2xl p-6 shadow-xs space-y-5"
      >
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 pb-4 border-b border-slate-200">
          <div>
            <h2 class="text-base font-bold text-[#0B1E48]">
              Check a Scanned Certificate or Marksheet
            </h2>
            <p class="text-xs text-slate-600 mt-0.5">
              Upload a certificate image or PDF to compare every field on the document against the official AICTE / NAD record.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2 shrink-0">
            <button
              type="button"
              id="btnGenAuthenticScan"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border border-emerald-200 font-bold text-xs transition-colors cursor-pointer"
            >
              <span>Load Genuine Sample (CGPA 9.42)</span>
            </button>

            <button
              type="button"
              id="btnGenTamperedScan"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-900 border border-red-200 font-bold text-xs transition-colors cursor-pointer"
            >
              <span>Load Forged Sample (CGPA 9.85)</span>
            </button>
          </div>
        </div>

        <!-- Top Area: Clean Certificate Preview + Upload & Action Controls -->
        <div class="space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="text-xs font-bold text-[#0B1E48] flex items-center gap-2">
              <span>Certificate Preview</span>
              <span id="forensicDocModePill" class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold text-xs">
                Genuine Sample Loaded
              </span>
            </div>

            <label
              for="forensicFileInput"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 text-xs font-bold cursor-pointer transition-colors"
            >
              <svg class="w-4 h-4 text-[#0B4EA2] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span>Upload Certificate File</span>
              <input
                type="file"
                id="forensicFileInput"
                accept=".png,.jpg,.jpeg,.webp,.json,.pdf"
                class="sr-only"
              />
            </label>
          </div>

          <div
            id="forensicDropZone"
            class="bg-slate-50 p-4 rounded-xl border-2 border-dashed border-slate-300 hover:border-[#0B4EA2] transition-colors flex flex-col items-center justify-center overflow-hidden"
          >
            <canvas
              id="forensicCanvas"
              width="820"
              height="480"
              class="w-full h-auto max-h-[320px] object-contain rounded-lg bg-white border border-slate-200"
            ></canvas>
            <div class="text-xs text-slate-500 mt-2 font-medium">
              Drag &amp; drop a certificate file (.png, .jpg, .pdf, .json) here, or use the sample buttons above
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button
              type="button"
              id="btnFastCanvasPrecheck"
              class="h-10 px-5 rounded-lg bg-[#0B4EA2] hover:bg-[#083B7E] text-white font-bold text-xs transition-colors inline-flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Compare Certificate with Official Record</span>
            </button>

            <button
              type="button"
              id="btnRunVlmInference"
              class="h-10 px-4 rounded-lg bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 font-bold text-xs transition-colors inline-flex items-center justify-center gap-2 cursor-pointer"
            >
              <span id="vlmBtnLabel">Deep Image Scan</span>
            </button>
          </div>
        </div>

        <!-- Bottom Area: Immediate Field-by-Field Comparison Table -->
        <div class="space-y-3 pt-4 border-t border-slate-200">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h3 class="text-base font-bold text-[#0B1E48]">
                Field-by-Field Comparison with Official Registry
              </h3>
              <p class="text-xs text-slate-600">
                Each detail on the uploaded certificate is checked against the official AICTE / NAD record.
              </p>
            </div>
            <div id="forensicOverallVerdict" class="shrink-0"></div>
          </div>

          <div class="overflow-x-auto border border-slate-200 rounded-xl">
            <table class="w-full text-left border-collapse text-xs sm:text-sm">
              <caption class="sr-only">Field-by-Field Comparison with Official Registry</caption>
              <thead>
                <tr class="bg-slate-100 text-slate-700 border-b border-slate-200 font-bold">
                  <th scope="col" class="py-3 px-4">Field</th>
                  <th scope="col" class="py-3 px-4">On Uploaded Certificate</th>
                  <th scope="col" class="py-3 px-4">In Official AICTE Registry</th>
                  <th scope="col" class="py-3 px-4 text-right">Status</th>
                </tr>
              </thead>
              <tbody id="forensicComparisonTbody" class="divide-y divide-slate-200 bg-white">
                <tr>
                  <td colspan="4" class="py-4 px-4 text-center text-slate-600">
                    Loading comparison...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Collapsed Technical OCR / JSON Details -->
        <details class="text-xs text-slate-500 pt-2 border-t border-slate-100">
          <summary class="cursor-pointer font-semibold text-slate-600 hover:text-[#0B1E48] select-none">
            Technical OCR / JSON Details
          </summary>

          <div class="mt-3 p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
            <div id="vlmProgressBox" class="space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <span id="vlmStatusLabel" class="font-semibold text-slate-700 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>Ready to scan certificate in browser</span>
                </span>
                <div class="flex items-center gap-2">
                  <span id="vlmEngineBadge" class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-900 font-mono text-[10px] font-bold">
                    READY
                  </span>
                  <span id="vlmProgressPct" class="font-mono font-bold text-[#0B4EA2]">100%</span>
                </div>
              </div>
              <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
                <div
                  id="vlmProgressBar"
                  role="progressbar"
                  aria-valuenow="100"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-label="Certificate Scan Progress"
                  class="h-full bg-[#0B4EA2] transition-all duration-200"
                  style="width: 100%"
                ></div>
              </div>
              <div id="vlmFileDetail" class="font-mono text-[11px] text-slate-600 truncate">
                Local browser document verification
              </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
              <div>
                <div class="font-semibold text-slate-700 mb-1">Extracted Certificate Data (JSON)</div>
                <pre id="vlmExtractedJson" class="p-3 rounded-lg bg-white border border-slate-200 text-slate-800 font-mono text-[11px] leading-relaxed overflow-x-auto max-h-44"></pre>
              </div>
              <div>
                <div class="font-semibold text-slate-700 mb-1">Expected Certificate Schema</div>
                <pre id="vlmSchemaPreview" class="p-3 rounded-lg bg-white border border-slate-200 text-slate-700 font-mono text-[11px] leading-relaxed overflow-x-auto max-h-44">{`{
  "type": "object",
  "properties": {
    "apaar_id": { "type": "string" },
    "candidate_name": { "type": "string" },
    "degree_name": { "type": "string" },
    "specialization": { "type": "string" },
    "cgpa": { "type": "number" },
    "year_of_passing": { "type": "integer" },
    "issuing_authority": { "type": "string" }
  }
}`}</pre>
              </div>
            </div>
          </div>
        </details>
      </section>

      <!-- PANEL 3 (Hidden until clicked): Verify QR Code Data -->
      <section
        id="offlineVerifierSection"
        role="tabpanel"
        aria-labelledby="navTabOfflineQr"
        class="hidden no-print bg-white border border-slate-200 rounded-2xl p-6 shadow-xs space-y-5"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200">
          <div>
            <h2 class="text-base font-bold text-[#0B1E48]">
              Verify QR Code Data
            </h2>
            <p class="text-xs text-slate-600 mt-0.5">
              Paste the data scanned from a degree QR code to verify its official university digital signature.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2 shrink-0">
            <button
              type="button"
              id="btnLoadCurrentQrPayload"
              class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0B1E48] border border-slate-300 text-xs font-bold transition-colors cursor-pointer"
            >
              Load Sample QR Data
            </button>
            <button
              type="button"
              id="btnTamperOfflinePayload"
              class="px-3 py-1.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-900 border border-red-200 text-xs font-bold transition-colors cursor-pointer"
            >
              Test Forged CGPA
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          <div class="lg:col-span-7 space-y-2">
            <label for="offlinePayloadInput" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
              Scanned QR Code Data
            </label>
            <textarea
              id="offlinePayloadInput"
              rows="6"
              class="w-full bg-slate-50 text-slate-900 border border-slate-300 rounded-xl p-3 font-mono text-xs leading-relaxed focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
              placeholder='{"id":"DEG-2024-8841","apaar_id":"412398471029",...}'
            ></textarea>
          </div>

          <div class="lg:col-span-5 space-y-3">
            <button
              type="button"
              id="btnVerifyOfflineCrypto"
              class="w-full h-11 px-4 rounded-lg bg-[#0B4EA2] hover:bg-[#083B7E] text-white font-bold text-sm transition-colors flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Verify QR Signature</span>
            </button>

            <div id="offlineVerifyResultBox" class="p-4 rounded-xl border border-slate-200 bg-slate-50 text-xs text-slate-700">
              Click <strong>Verify QR Signature</strong> to check whether the QR code data is genuine and unaltered.
            </div>

            <details class="text-xs text-slate-500 pt-1">
              <summary class="cursor-pointer font-semibold text-slate-600 hover:text-[#0B1E48] select-none">
                Official University Public Key Details
              </summary>
              <div class="mt-2 p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-slate-700">Key Status:</span>
                  <span id="offlineKeyCachedBadge" class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-900 font-mono text-[10px] font-bold">
                    READY
                  </span>
                </div>
                <div id="offlinePubKeyDisplay" class="font-mono text-[11px] text-slate-600 break-all">
                  Loading public key from /api/keys/degree...
                </div>
              </div>
            </details>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    const SVG_CHECK = `<svg class="w-3.5 h-3.5 inline-block shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`;
    const SVG_ALERT = `<svg class="w-3.5 h-3.5 inline-block shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`;
    const SVG_CROSS = `<svg class="w-3.5 h-3.5 inline-block shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>`;

    const navTabApaarLookup = document.getElementById('navTabApaarLookup');
    const navTabScanMarksheet = document.getElementById('navTabScanMarksheet');
    const navTabOfflineQr = document.getElementById('navTabOfflineQr');

    const panelApaarLookup = document.getElementById('panelApaarLookup');
    const vlmForensicsSection = document.getElementById('vlmForensicsSection');
    const offlineVerifierSection = document.getElementById('offlineVerifierSection');

    const ACTIVE_TAB_CLASS =
      'w-full text-left px-3.5 py-3 rounded-xl text-sm font-bold bg-[#0B4EA2] text-white flex items-center justify-between gap-2 cursor-pointer transition-colors';
    const INACTIVE_TAB_CLASS =
      'w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between gap-2 cursor-pointer transition-colors';

    function switchVerifierTab(tab: 'apaar' | 'scan' | 'qr') {
      const tabs: Array<{ key: 'apaar' | 'scan' | 'qr'; btn: HTMLElement | null; panel: HTMLElement | null }> = [
        { key: 'apaar', btn: navTabApaarLookup, panel: panelApaarLookup },
        { key: 'scan', btn: navTabScanMarksheet, panel: vlmForensicsSection },
        { key: 'qr', btn: navTabOfflineQr, panel: offlineVerifierSection },
      ];

      tabs.forEach(({ key, btn, panel }) => {
        const isActive = key === tab;
        if (panel) panel.classList.toggle('hidden', !isActive);
        if (btn) {
          btn.className = isActive ? ACTIVE_TAB_CLASS : INACTIVE_TAB_CLASS;
          btn.setAttribute('aria-selected', String(isActive));
          const badge = btn.querySelector<HTMLElement>('[data-sidebar-badge]');
          if (badge) {
            badge.className = isActive
              ? 'shrink-0 whitespace-nowrap px-2 py-0.5 rounded-full text-[11px] font-mono font-bold bg-white/20 text-white'
              : 'shrink-0 whitespace-nowrap px-2 py-0.5 rounded-full text-[11px] font-mono font-bold bg-slate-100 text-slate-600';
          }
        }
      });
    }

    navTabApaarLookup?.addEventListener('click', () => switchVerifierTab('apaar'));
    navTabScanMarksheet?.addEventListener('click', () => switchVerifierTab('scan'));
    navTabOfflineQr?.addEventListener('click', () => switchVerifierTab('qr'));

    const form = document.getElementById('verifierQueryForm') as HTMLFormElement | null;
    const topCardStatus = document.getElementById('topCardStatus');
    const topCardStatusSub = document.getElementById('topCardStatusSub');
    const resBanner = document.getElementById('resBanner');
    const resTitle = document.getElementById('resTitle');
    const resBadge = document.getElementById('resBadge');
    const resName = document.getElementById('resName');
    const resConsentPill = document.getElementById('resConsentPill');
    const resApaar = document.getElementById('resApaar');
    const resCryptoStatus = document.getElementById('resCryptoStatus');
    const resKeyId = document.getElementById('resKeyId');
    const resRequestId = document.getElementById('resRequestId');
    const resLatency = document.getElementById('resLatency');
    const resTechDigestBox = document.getElementById('resTechDigestBox');
    const resDegrees = document.getElementById('resDegrees');
    const resPredicateBanner = document.getElementById('resPredicateBanner');
    const verifyBtnLabel = document.getElementById('verifyBtnLabel');
    const zkPredicateToggle = document.getElementById('zkPredicateToggle') as HTMLInputElement | null;
    const zkMinCgpa = document.getElementById('zkMinCgpa') as HTMLInputElement | null;
    const zkMinYear = document.getElementById('zkMinYear') as HTMLInputElement | null;
    const zkConsentToken = document.getElementById('zkConsentToken') as HTMLInputElement | null;

    let isInitialAutoLoad = true;
    let activeOfflineQrPayload: Record<string, any> | null = null;
    let cachedIssuerKeyData: { kid: string; jwk: JsonWebKey; publicKeyRaw: string } | null = null;

    function formatApaarHyphenated(apaar: string) {
      const clean = (apaar || '').trim();
      if (clean.length === 12) {
        return `${clean.slice(0, 4)}-${clean.slice(4, 8)}-${clean.slice(8, 12)}`;
      }
      return clean || 'XXXX-XXXX-••••';
    }

    // Print Official Section 63 BSA Certificate
    document.getElementById('btnPrintSection63')?.addEventListener('click', () => {
      const tsEl = document.getElementById('bsaTimestamp');
      if (tsEl) {
        tsEl.textContent = 'Checked: ' + new Date().toISOString().slice(0, 19).replace('T', ' ') + ' UTC';
      }
      window.print();
    });

    // Re-trigger verification when Cutoff toggle changes
    zkPredicateToggle?.addEventListener('change', () => {
      if (zkPredicateToggle.checked) {
        if (zkMinCgpa && !zkMinCgpa.value) zkMinCgpa.value = '7.5';
        if (zkMinYear && !zkMinYear.value) zkMinYear.value = '2022';
      }
      const input = document.getElementById('queryApaar') as HTMLInputElement | null;
      if (input && /^\d{12}$/.test(input.value.trim())) {
        isInitialAutoLoad = false;
        form?.dispatchEvent(new Event('submit'));
      }
    });

    document.getElementById('zkPresetCutoffBtn')?.addEventListener('click', () => {
      if (zkMinCgpa) zkMinCgpa.value = '7.5';
      if (zkMinYear) zkMinYear.value = '2022';
      if (zkPredicateToggle) zkPredicateToggle.checked = true;
      (window as any).showToast?.('Eligibility cutoff set: CGPA >= 7.5 & Graduation Year >= 2022.', 'info');
    });

    document.getElementById('scanQrBtn')?.addEventListener('click', () => {
      switchVerifierTab('qr');
      const offlineInput = document.getElementById('offlinePayloadInput') as HTMLTextAreaElement | null;
      if (offlineInput) {
        if (!offlineInput.value && activeOfflineQrPayload) {
          offlineInput.value = JSON.stringify(activeOfflineQrPayload, null, 2);
        }
        offlineInput.focus();
      }
      (window as any).showToast?.('Switched to Verify QR Code Data.', 'info');
    });

    document.querySelectorAll('.demoApaarBtn').forEach((btn) => {
      btn.addEventListener('click', () => {
        switchVerifierTab('apaar');
        isInitialAutoLoad = false;
        const input = document.getElementById('queryApaar') as HTMLInputElement | null;
        const orgInput = document.getElementById('verifierOrg') as HTMLInputElement | null;
        const apaar = (btn as HTMLElement).dataset.apaar || '';
        const org = (btn as HTMLElement).dataset.org || 'UPSC / Employer Verification';
        if (input) input.value = apaar;
        if (orgInput) orgInput.value = org;
        form?.dispatchEvent(new Event('submit'));
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const queryApaarParam = urlParams.get('apaar');
    const queryInstParam = urlParams.get('institution');
    const queryTokenParam = urlParams.get('token');

    if (queryTokenParam && queryTokenParam.trim()) {
      const cleanTok = queryTokenParam.trim();
      if (zkConsentToken) zkConsentToken.value = cleanTok;
      if (zkPredicateToggle) zkPredicateToggle.checked = true;
      if (zkMinCgpa && !zkMinCgpa.value) zkMinCgpa.value = '7.5';
      if (zkMinYear && !zkMinYear.value) zkMinYear.value = '2022';
      document.getElementById('zkPredicateControls')?.classList.remove('hidden');
    }

    if (queryApaarParam && /^\d{12}$/.test(queryApaarParam.trim())) {
      const input = document.getElementById('queryApaar') as HTMLInputElement | null;
      const orgInput = document.getElementById('verifierOrg') as HTMLInputElement | null;
      if (input) input.value = queryApaarParam.trim();
      if (orgInput && !orgInput.value.trim()) {
        orgInput.value = queryInstParam?.trim()
          ? `Institutional Audit (${queryInstParam.trim()})`
          : 'UPSC / Employer Verification';
      }
      setTimeout(() => {
        form?.dispatchEvent(new Event('submit'));
      }, 100);
    } else if (queryTokenParam && queryTokenParam.trim()) {
      const input = document.getElementById('queryApaar') as HTMLInputElement | null;
      const orgInput = document.getElementById('verifierOrg') as HTMLInputElement | null;
      if (input && !input.value.trim()) input.value = '739284019283';
      if (orgInput && !orgInput.value.trim()) {
        orgInput.value = 'UPSC / Employer Verification';
      }
      setTimeout(() => {
        form?.dispatchEvent(new Event('submit'));
      }, 100);
    } else if (queryInstParam && queryInstParam.trim()) {
      const orgInput = document.getElementById('verifierOrg') as HTMLInputElement | null;
      if (orgInput) {
        orgInput.value = `Institutional Audit (${queryInstParam.trim()})`;
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const apaarInput = document.getElementById('queryApaar') as HTMLInputElement | null;
      const orgInput = document.getElementById('verifierOrg') as HTMLInputElement | null;
      const apaar = apaarInput ? apaarInput.value.trim() : '';
      const org = orgInput ? orgInput.value.trim() : '';

      const usePredicate = Boolean(zkPredicateToggle?.checked);
      const minCgpaVal = Number(zkMinCgpa?.value || 7.5);
      const minYearVal = Number(zkMinYear?.value || 2022);
      const consentTok = zkConsentToken?.value.trim() || undefined;

      if (verifyBtnLabel) verifyBtnLabel.textContent = 'Verifying...';

      const startTime = performance.now();
      try {
        const reqBody: Record<string, any> = {
          apaar_id: apaar,
          verifier_name: org,
        };
        if (consentTok) reqBody.consent_token = consentTok;
        if (usePredicate) {
          reqBody.predicate = {
            min_cgpa: minCgpaVal,
            min_year: minYearVal,
            require_valid_degree: true,
          };
        }

        const res = await fetch('/api/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(reqBody),
        });
        const elapsed = Math.round(performance.now() - startTime);
        const data = await res.json();

        const resStudentRollId = document.getElementById('resStudentRollId');
        const derivedRollId = `STU-TCA-2020-${apaar.slice(-4) || '0412'}`;

        if (verifyBtnLabel) verifyBtnLabel.textContent = 'Verify Record';
        if (resLatency) resLatency.textContent = (data.responseTimeMs || elapsed) + ' ms';
        if (resApaar) resApaar.textContent = formatApaarHyphenated(apaar);
        if (resStudentRollId) resStudentRollId.textContent = `Roll: ${derivedRollId}`;
        if (resRequestId) resRequestId.textContent = data.requestId || 'REQ-VERIFIED';

        if (!data.success) {
          if (topCardStatus) {
            topCardStatus.textContent = 'Not Found';
            topCardStatus.className = 'text-2xl font-extrabold text-amber-700 mt-1';
          }
          if (topCardStatusSub) topCardStatusSub.textContent = 'Verification Halted';

          if (resBanner) resBanner.className = 'px-6 py-4 bg-slate-50 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3';
          if (resTitle) resTitle.textContent = 'Verification Request Blocked / Record Not Found';
          if (resBadge) {
            resBadge.innerHTML = `${SVG_ALERT} <span>RECORD NOT AVAILABLE</span>`;
            resBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-900 border border-amber-300';
          }
          if (resName) resName.textContent = 'Unverified Candidate';
          if (resConsentPill) {
            resConsentPill.textContent = 'DPDP Consent: Unavailable';
            resConsentPill.className = 'text-xs text-amber-700 font-medium mt-0.5';
          }
          if (resCryptoStatus) resCryptoStatus.innerHTML = '<span class="text-amber-700">Not Evaluated</span>';
          if (resKeyId) resKeyId.textContent = 'Key ID: N/A';
          if (resTechDigestBox) resTechDigestBox.classList.add('hidden');
          if (resPredicateBanner) resPredicateBanner.classList.add('hidden');
          if (resDegrees) {
