---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution, Admission, Student, VerificationRequest } from '../lib/types';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = getUIDictionary(lang);

const db = getDB(Astro.locals);

const instRes = await db.prepare('SELECT * FROM institutions ORDER BY risk_score DESC').bind().all<Institution>();
const institutions = instRes.results || [];

const admRes = await db.prepare('SELECT * FROM admissions').bind().all<Admission>();
const admissions = admRes.results || [];

const stuRes = await db.prepare('SELECT * FROM students').bind().all<Student>();
const students = stuRes.results || [];

const verRes = await db
  .prepare('SELECT * FROM verification_requests ORDER BY verified_at DESC LIMIT 20')
  .bind()
  .all<VerificationRequest>();
const verificationLogs = verRes.results || [];

const overrunColleges = institutions
  .filter((i) => i.current_enrollment > i.sanctioned_intake)
  .map((i) => ({
    ...i,
    excess: i.current_enrollment - i.sanctioned_intake,
    utilization: ((i.current_enrollment / Math.max(1, i.sanctioned_intake)) * 100).toFixed(1),
  }));

const totalMonitoredEnrollment = institutions.reduce((sum, i) => sum + i.current_enrollment, 0);
const totalSanctionedIntake = institutions.reduce((sum, i) => sum + i.sanctioned_intake, 0);

const policyReportRows = institutions.map((i) => ({
  id: i.id,
  code: i.code,
  name: i.name,
  state: i.state,
  district: i.district,
  approved_intake: i.sanctioned_intake,
  actual_enrolment: i.current_enrollment,
  supernumerary_seats: Math.round(i.sanctioned_intake * 0.15),
  nri_category: Math.round(i.sanctioned_intake * 0.05),
  oci_status: Math.max(1, Math.round(i.sanctioned_intake * 0.02)),
  fn_status: Math.max(1, Math.round(i.sanctioned_intake * 0.03)),
  nba_naac_status:
    i.current_enrollment <= i.sanctioned_intake
      ? 'NBA Accredited & NAAC A+ Eligible'
      : 'Accreditation Hold (Quota Overrun)',
  compliance_status: i.current_enrollment > i.sanctioned_intake ? 'OVERRUN_FLAGGED' : 'COMPLIANT',
}));

const duplicatesMap = new Map<string, Admission[]>();
for (const a of admissions) {
  if (!duplicatesMap.has(a.apaar_id)) {
    duplicatesMap.set(a.apaar_id, []);
  }
  duplicatesMap.get(a.apaar_id)!.push(a);
}

interface CrossCouncilAnomaly {
  apaar_id: string;
  name: string;
  email: string;
  has_nsp_overlap: boolean;
  nsp_scheme_name: string;
  nsp_disbursement_status: string;
  colleges: {
    id: string;
    name: string;
    code: string;
    program: string;
    batch: number;
    date: string;
  }[];
}

const duplicateStudents: CrossCouncilAnomaly[] = [];
const collegeDuplicateCount = new Map<string, number>();

for (const [apaar, list] of duplicatesMap.entries()) {
  const distinctInsts = new Set(list.map((l) => l.institution_id));
  if (distinctInsts.size > 1) {
    const student = students.find((s) => s.apaar_id === apaar);
    const hasFlaggedDuplicate = list.some((l) => Boolean(l.is_duplicate));
    for (const instId of distinctInsts) {
      collegeDuplicateCount.set(instId, (collegeDuplicateCount.get(instId) || 0) + 1);
    }
    duplicateStudents.push({
      apaar_id: apaar,
      name: student?.full_name || 'Student',
      email: student?.email || '',
      has_nsp_overlap: hasFlaggedDuplicate,
      nsp_scheme_name: hasFlaggedDuplicate
        ? 'AICTE Pragati / Post-Matric Scholarship (PFMS Hold)'
        : 'Dual Seat Reservation (No Active NSP DBT Claim)',
      nsp_disbursement_status: hasFlaggedDuplicate
        ? 'Duplicate Scholarship Blocked'
        : 'Concurrent Seat Lock Flagged',
      colleges: list.map((l) => {
        const inst = institutions.find((i) => i.id === l.institution_id);
        return {
          id: l.institution_id,
          name: inst?.name || l.institution_id,
          code: inst?.code || l.institution_id,
          program: l.program,
          batch: l.batch_year,
          date: l.enrollment_date,
        };
      }),
    });
  }
}

const sampleSearchCodes = institutions.slice(0, 2).map((i) => i.code);
const defaultNoticeCollege = overrunColleges[0] || institutions[0];
---

<Layout title={`SIH 2026 | ${t.aicte_page_title}`} activeRole="aicte" lang={lang} breadcrumb={t.crumb_aicte}>
  <div class="space-y-6">
    <!-- Hidden data carrier for CSV export compatibility -->
    <div id="policyAccreditationSection" data-policy-rows={JSON.stringify(policyReportRows)} class="hidden"></div>

    <!-- Dynamic Regulatory Feedback Banner -->
    <div id="aicteFeedbackBanner" class="hidden rounded-xl border p-4 text-sm" role="alert" aria-live="polite"></div>

    <!-- Urgent Overrun Alert Banner (Clean Government Card, No border-l-4) -->
    {overrunColleges.length > 0 && (
      <div
        role="alert"
        aria-live="polite"
        class="bg-red-50 border border-red-200 p-4 sm:p-5 rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
      >
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-600 text-white whitespace-nowrap">
              INTAKE OVERRUN ALERT
            </span>
            <span class="font-bold text-red-950 text-sm sm:text-base">
              {overrunColleges[0].name} ({overrunColleges[0].code})
            </span>
          </div>
          <p class="text-xs sm:text-sm text-red-800 mt-1">
            Admitted <strong>{overrunColleges[0].current_enrollment}</strong> students against AICTE sanctioned intake of <strong>{overrunColleges[0].sanctioned_intake} Seats</strong> (+{overrunColleges[0].excess} excess admissions).
          </p>
        </div>
        <button
          type="button"
          data-notice-code={overrunColleges[0].code}
          id="topShowCauseBtn"
          class="shrink-0 h-10 bg-red-700 hover:bg-red-800 text-white font-semibold text-xs sm:text-sm px-4 rounded-lg transition-colors cursor-pointer whitespace-nowrap"
        >
          Issue Show-Cause Notice ({overrunColleges[0].code})
        </button>
      </div>
    )}

    <!-- INDIAN GOVERNMENT PORTAL 2-COLUMN LEFT SIDEBAR + RIGHT MAIN CONTENT LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- 1. LEFT GOVERNMENT SIDEBAR (NIC / Samarth eGov Style) -->
      <aside class="lg:col-span-3 lg:sticky lg:top-6">
        <div class="rounded-2xl bg-white border border-slate-200 overflow-hidden">
          <!-- Top Identity Block -->
          <div class="bg-[#0B1E48] text-white p-5">
            <div class="text-[11px] font-mono uppercase tracking-wider text-blue-200">
              AICTE &bull; APPROVAL BUREAU &bull; NEW DELHI
            </div>
            <h1 class="text-base font-bold text-white mt-1 leading-snug">
              AICTE National Regulatory Portal
            </h1>
            <p class="text-xs text-blue-200 mt-1">
              Seat Intake &amp; Duplicate Admission Vigilance &middot; 2026–27
            </p>
            <div class="mt-3 pt-3 border-t border-white/15 text-xs text-emerald-300 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
              <span>Dr. Rajeshwari Iyer (Vigilance Director)</span>
            </div>
          </div>

          <!-- Vertical Navigation Menu (1 Panel Shown at a Time) -->
          <div class="p-3 space-y-1" role="tablist" aria-label="Regulatory Menu">
            <div class="px-3 pt-1 pb-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">
              REGULATORY MENU
            </div>

            <!-- Tab 1: Approved Colleges (Default Active) -->
            <button
              type="button"
              id="navTabInstitutions"
              role="tab"
              aria-selected="true"
              aria-controls="panelInstitutions"
              data-aicte-tab="panelInstitutions"
              class="aicte-nav-tab w-full text-left px-3.5 py-3 rounded-xl text-sm font-bold bg-[#0B4EA2] text-white flex items-center justify-between cursor-pointer transition-colors"
            >
              <span class="inline-flex items-center gap-2.5 min-w-0">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span class="truncate">Approved Colleges</span>
              </span>
              <span
                data-sidebar-badge
                class="px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-white/20 text-white whitespace-nowrap"
              >
                {institutions.length}
              </span>
            </button>

            <!-- Tab 2: Duplicate Admissions -->
            <button
              type="button"
              id="navTabDuplicates"
              role="tab"
              aria-selected="false"
              aria-controls="panelDuplicates"
              data-aicte-tab="panelDuplicates"
              class="aicte-nav-tab w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between cursor-pointer transition-colors"
            >
              <span class="inline-flex items-center gap-2.5 min-w-0">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span class="truncate">Duplicate Admissions</span>
              </span>
              <span
                data-sidebar-badge
                class="px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-600 whitespace-nowrap"
              >
                {duplicateStudents.length}
              </span>
            </button>

            <!-- Tab 3: Show-Cause Notices -->
            <button
              type="button"
              id="navTabShowCause"
              role="tab"
              aria-selected="false"
              aria-controls="panelShowCause"
              data-aicte-tab="panelShowCause"
              class="aicte-nav-tab w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between gap-2 cursor-pointer transition-colors"
            >
              <span class="inline-flex items-center gap-2.5 min-w-0">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="truncate">Show-Cause Notices</span>
              </span>
              <span
                data-sidebar-badge
                class="shrink-0 px-2 py-0.5 rounded-full text-[11px] font-mono font-bold bg-slate-100 text-slate-600 whitespace-nowrap"
              >
                NOTICE
              </span>
            </button>

            <!-- Tab 4: Verification Audit Log -->
            <button
              type="button"
              id="navTabAuditLogs"
              role="tab"
              aria-selected="false"
              aria-controls="panelAuditLogs"
              data-aicte-tab="panelAuditLogs"
              class="aicte-nav-tab w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between gap-2 cursor-pointer transition-colors"
            >
              <span class="inline-flex items-center gap-2.5 min-w-0">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span class="truncate">Verification Audit</span>
              </span>
              <span
                data-sidebar-badge
                class="shrink-0 px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-600 whitespace-nowrap"
              >
                {verificationLogs.length}
              </span>
            </button>
          </div>

          <!-- Quick Utility Actions inside Sidebar -->
          <div class="px-3 pb-3 pt-1 flex flex-col gap-2">
            <button
              type="button"
              id="refreshBtn"
              class="w-full h-9 px-3 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 inline-flex items-center justify-center gap-2 cursor-pointer transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>Sync Registry Data</span>
            </button>
          </div>

          <!-- Sidebar Footer -->
          <div class="p-4 bg-slate-50 border-t border-slate-200 text-xs text-slate-600 space-y-1">
            <div class="font-bold text-[#0B1E48]">AICTE e-Governance Vigilance Cell</div>
            <div class="text-slate-500">Nelson Mandela Marg, New Delhi</div>
          </div>
        </div>
      </aside>

      <!-- 2. RIGHT MAIN CONTENT AREA -->
      <div class="lg:col-span-9 space-y-5 min-w-0">
        <!-- Top 4 Simple Summary Cards -->
        <section
          aria-label="AICTE Regulatory Summary"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"
        >
          <!-- Card 1: Approved Colleges -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Approved Colleges</div>
            <div id="kpiTotalInst" class="text-2xl font-extrabold text-[#0B1E48] mt-1 font-mono">
              {institutions.length}
            </div>
            <div class="text-[11px] text-slate-500 mt-1">All India Technical Registry</div>
          </div>

          <!-- Card 2: Total Sanctioned Seats -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Total Sanctioned Seats</div>
            <div class="text-2xl font-extrabold text-[#0B1E48] mt-1 font-mono">
              {totalSanctionedIntake}
            </div>
            <div class="text-[11px] text-slate-500 mt-1">
              Session 2026–27 ({totalMonitoredEnrollment} Admitted)
            </div>
          </div>

          <!-- Card 3: Seats Over Limit Alerts -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Seats Over Limit Alerts</div>
            <div id="kpiOverrunCount" class="text-2xl font-extrabold text-red-600 mt-1 font-mono">
              {overrunColleges.length}
            </div>
            <div class="text-[11px] text-slate-500 mt-1">Colleges exceeding intake cap</div>
          </div>

          <!-- Card 4: Cross-Campus Duplicates -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Cross-Campus Duplicates</div>
            <div id="kpiDuplicateCount" class="text-2xl font-extrabold text-amber-600 mt-1 font-mono">
              {duplicateStudents.length}
            </div>
            <div class="text-[11px] text-slate-500 mt-1">Same APAAR in 2 Colleges</div>
          </div>
        </section>

        <!-- PANEL 1 (Default Visible): Approved Colleges & Seat Compliance Register -->
        <section
          id="panelInstitutions"
          role="tabpanel"
          aria-labelledby="navTabInstitutions"
          class="aicte-panel bg-white border border-slate-200 rounded-2xl overflow-hidden"
        >
          <div class="p-4 sm:p-5 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-base font-bold text-[#0B1E48]">
                  Approved Colleges &amp; Seat Compliance Register
                </h2>
                <span
                  id="aicteCountBadge"
                  class="text-xs font-mono font-semibold text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200 whitespace-nowrap"
                >
                  {institutions.length} / {institutions.length}
                </span>
              </div>
              <p class="text-xs text-slate-600 mt-0.5">
                Real-time monitoring of sanctioned seat intake versus APAAR-verified student admissions across approved technical institutions.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                id="downloadPolicyCsvBtn"
                class="h-9 px-3.5 rounded-lg bg-[#0B1E48] hover:bg-[#1E3A8A] text-white text-xs font-semibold transition-colors inline-flex items-center gap-2 cursor-pointer whitespace-nowrap"
              >
                <svg class="w-3.5 h-3.5 text-amber-300 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Download Compliance CSV</span>
              </button>

              <button
                type="button"
                id="printRegulatoryDossierBtn"
                onclick="window.print()"
                class="h-9 px-3 rounded-lg bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-xs font-semibold transition-colors inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap"
              >
                <span>Print Register</span>
              </button>
            </div>
          </div>

          <!-- Filter & Search Bar -->
          <div class="px-4 sm:px-5 py-3 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2 flex-1 min-w-[220px]">
              <label for="aicteSearchInput" class="sr-only">Search by College Name, AISHE Code, or State</label>
              <input
                type="text"
                id="aicteSearchInput"
                placeholder="Search by College Name, AISHE Code, or State..."
                class="h-9 px-3 text-xs bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0B4EA2] w-full sm:w-72"
              />

              <div class="flex items-center gap-1.5 text-xs">
                {sampleSearchCodes.map((code) => (
                  <button
                    type="button"
                    data-sample-aicte-code={code}
                    class="font-mono font-bold text-[#0B1E48] bg-white hover:bg-blue-50 border border-slate-300 px-2.5 py-1 rounded-md text-[11px] transition-colors cursor-pointer whitespace-nowrap"
                    title={`Filter by ${code}`}
                  >
                    {code}
                  </button>
                ))}
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <label for="stateFilter" class="sr-only">Filter by State</label>
              <select
                id="stateFilter"
                aria-label="Filter by State"
                class="h-9 px-2.5 text-xs bg-white border border-slate-300 rounded-lg text-slate-700"
              >
                <option value="">All States</option>
                {Array.from(new Set(institutions.map((i) => i.state))).map((st) => (
                  <option value={st}>{st}</option>
                ))}
              </select>

              <label for="statusFilter" class="sr-only">Filter by Compliance Status</label>
              <select
                id="statusFilter"
                aria-label="Filter by Compliance Status"
                class="h-9 px-2.5 text-xs bg-white border border-slate-300 rounded-lg text-slate-700"
              >
                <option value="">All Colleges</option>
                <option value="OVERRUN">Over Limit / Risk</option>
                <option value="COMPLIANT">Compliant</option>
              </select>
            </div>
          </div>

          <!-- 6-Column Spacious Table -->
          <div class="overflow-x-auto" role="region" aria-label="Approved Colleges & Seat Compliance Register" tabindex="0">
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <caption class="sr-only">Approved Colleges &amp; Seat Compliance Register</caption>
              <thead class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
                <tr>
                  <th scope="col" class="py-3.5 px-4">College Name &amp; AISHE Code</th>
                  <th scope="col" class="py-3.5 px-4">State / District</th>
                  <th scope="col" class="py-3.5 px-4">Seats (Admitted / Cap)</th>
                  <th scope="col" class="py-3.5 px-4">Duplicate Alerts</th>
                  <th scope="col" class="py-3.5 px-4 text-right">Status &amp; Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 text-slate-800" id="aicteInstTableBody">
                {institutions.map((i) => {
                  const diff = i.current_enrollment - i.sanctioned_intake;
                  const isOverrun = diff > 0;
                  const dupCount = collegeDuplicateCount.get(i.id) || 0;
                  return (
                    <tr
                      class="institution-row hover:bg-slate-50"
                      data-state={i.state}
                      data-status={isOverrun ? 'OVERRUN' : 'COMPLIANT'}
                    >
                      <td class="py-4 px-4">
                        <div class="font-bold text-[#0B1E48]">{i.name}</div>
                        <div class="text-xs font-mono text-slate-500 mt-0.5">AISHE: {i.code}</div>
                      </td>
                      <td class="py-4 px-4">
                        <div class="font-medium text-slate-800">{i.state}</div>
                        <div class="text-xs text-slate-500">{i.district}</div>
                      </td>
                      <td class="py-4 px-4">
                        <div class="font-mono font-bold text-slate-900">
                          {i.current_enrollment} <span class="text-slate-500 font-normal">/ {i.sanctioned_intake}</span>
                        </div>
                        <div class="mt-0.5">
                          <span
                            class={`text-[11px] font-mono font-bold px-2 py-0.5 rounded-full whitespace-nowrap ${
                              isOverrun
                                ? 'bg-red-100 text-red-800'
                                : 'bg-emerald-50 text-emerald-800'
                            }`}
                          >
                            {isOverrun ? `+${diff} Over Limit` : `${Math.max(0, i.sanctioned_intake - i.current_enrollment)} Vacant`}
                          </span>
                        </div>
                      </td>
                      <td class="py-4 px-4">
                        {dupCount > 0 ? (
                          <button
                            type="button"
