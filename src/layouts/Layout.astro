---
import {
  EIGHTH_SCHEDULE_LANGUAGES,
  getLanguageInfo,
  getUIDictionary,
  isSupportedLang,
  type LangCode,
} from '../lib/i18n';
import ReviewerTour from '../components/ReviewerTour.astro';

interface Props {
  title?: string;
  activeRole?: 'overview' | 'institution' | 'aicte' | 'university' | 'student' | 'verifier' | 'mandate' | 'login' | 'policy' | 'none';
  breadcrumb?: string;
  lang?: LangCode | string;
}

const {
  title = 'SIH 2026 | National Student Data Management & Verification Portal',
  activeRole = 'none',
  breadcrumb,
  lang,
} = Astro.props;
const user = Astro.locals.user;

const resolvedLang: LangCode = isSupportedLang(lang)
  ? lang
  : (isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en');
const langInfo = getLanguageInfo(resolvedLang);
const t = getUIDictionary(resolvedLang);
const isIndic = resolvedLang !== 'en';
const isHindi = resolvedLang === 'hi';

// Universal Language routing: supports all pages
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathSegments = currentPath.split('/').filter(Boolean);
const hasLangPrefix = pathSegments.length > 0 && isSupportedLang(pathSegments[0]) && pathSegments[0] !== 'en';
const cleanBasePath = hasLangPrefix ? '/' + pathSegments.slice(1).join('/') : currentPath;

function getLangHref(targetCode: LangCode): string {
  if (targetCode === 'en') {
    return cleanBasePath === '' ? '/' : cleanBasePath;
  }
  const base = cleanBasePath === '/' ? '' : cleanBasePath;
  return `/${targetCode}${base}`;
}

const hiHref = getLangHref('hi');
const enHref = getLangHref('en');
const policyBase = isIndic ? `/${resolvedLang}` : '';
const homeHref = isIndic ? `/${resolvedLang}` : '/';
const verifierHref = isIndic ? `/${resolvedLang}/verifier` : '/verifier';
const loginHref = isIndic ? `/${resolvedLang}/login` : '/login';

const roleLabels: Record<string, string> = {
  AICTE_ADMIN: t.nav_aicte || 'AICTE Regulatory Council',
  INSTITUTE_ADMIN: t.nav_institution || 'Institute Admin',
  UNIVERSITY_ADMIN: t.nav_university || 'Affiliating University',
  STUDENT: t.nav_student || 'Student (DPDP Vault)',
  VERIFIER: t.nav_verifier || 'Verification Officer',
};

interface NavItem {
  id: string;
  label: string;
  path: string;
}

const rolePortalMap: Record<string, NavItem> = {
  AICTE_ADMIN: { id: 'aicte', label: t.nav_aicte || 'AICTE Regulatory Council', path: `${policyBase}/aicte` },
  INSTITUTE_ADMIN: { id: 'institution', label: t.nav_institution || 'Institution Portal', path: `${policyBase}/institution` },
  UNIVERSITY_ADMIN: { id: 'university', label: t.nav_university || 'Affiliating University', path: `${policyBase}/university` },
  STUDENT: { id: 'student', label: t.nav_student || 'Student Consent (DPDP)', path: `${policyBase}/student` },
  VERIFIER: { id: 'verifier', label: t.navVerifier, path: verifierHref },
};

let navItems: NavItem[] = [];

if (!user) {
  navItems = [
    { id: 'overview', label: t.navOverview, path: homeHref },
    { id: 'verifier', label: t.navVerifier, path: verifierHref },
    { id: 'mandate', label: t.navMandate, path: `${homeHref}#aicte-mandate` },
  ];
} else {
  const userPortal = rolePortalMap[user.role];
  navItems = [
    { id: 'overview', label: t.navOverview, path: homeHref },
    ...(userPortal ? [userPortal] : []),
    ...(user.role !== 'VERIFIER'
      ? [{ id: 'verifier', label: t.navVerifier, path: verifierHref }]
      : []),
  ];
}

const defaultBreadcrumbs: Record<string, string> = {
  overview: t.crumb_overview || t.portalTitle,
  institution: t.crumb_institution || 'Approved Institution Roster Portal (INST-01)',
  aicte: t.crumb_aicte || 'AICTE National Surveillance & Audit Dashboard (REG-02)',
  university: t.crumb_university || 'Affiliating University Degree Ledger (UNIV-03)',
  student: t.crumb_student || 'Student Consent Authority & DPDP Vault (STU-04)',
  verifier: t.crumb_verifier || 'Public Credential Verification Terminal (VRF-05)',
  login: t.crumb_login || 'Single Sign-On (Parichay Officer Gateway)',
  policy: t.crumb_policy || 'Statutory Policy & Official Guidelines',
  mandate: t.heroBadge || 'AICTE Approval Process Handbook (2024–2027)',
  none: t.portalTitle,
};

const resolvedBreadcrumb =
  breadcrumb ||
  (cleanBasePath === '/login' ? defaultBreadcrumbs.login : defaultBreadcrumbs[activeRole] || defaultBreadcrumbs.none);

const scriptFontFamilyMap: Record<string, string> = {
  bn: 'Noto+Sans+Bengali:wght@400;500;600;700',
  as: 'Noto+Sans+Bengali:wght@400;500;600;700',
  mni: 'Noto+Sans+Bengali:wght@400;500;600;700',
  te: 'Noto+Sans+Telugu:wght@400;500;600;700',
  ta: 'Noto+Sans+Tamil:wght@400;500;600;700',
  ur: 'Noto+Nastaliq+Urdu:wght@400;600;700',
  gu: 'Noto+Sans+Gujarati:wght@400;500;600;700',
  kn: 'Noto+Sans+Kannada:wght@400;500;600;700',
  ml: 'Noto+Sans+Malayalam:wght@400;500;600;700',
  or: 'Noto+Sans+Oriya:wght@400;500;600;700',
  pa: 'Noto+Sans+Gurmukhi:wght@400;500;600;700',
  sat: 'Noto+Sans+Ol+Chiki:wght@400;500;600;700',
};
const extraScriptFont = scriptFontFamilyMap[resolvedLang];
const googleFontsHref = `https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700${extraScriptFont ? `&family=${extraScriptFont}` : ''}&display=swap`;
---

<!doctype html>
<html lang={resolvedLang} dir={langInfo.dir || 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/emblem.svg" />
    <title>{title}</title>
    <!-- Standard Official Typography (Inter + Noto Sans Indic Scripts for UX4G / GIGW 3.0) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={googleFontsHref}
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Inter', 'Noto Sans Devanagari', 'Noto Sans Bengali', 'Noto Sans Telugu', 'Noto Sans Tamil', 'Noto Sans Gujarati', 'Noto Sans Kannada', 'Noto Sans Malayalam', 'Noto Sans Oriya', 'Noto Sans Gurmukhi', 'Noto Sans Ol Chiki', 'Noto Nastaliq Urdu', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      /* High contrast focus ring for GIGW accessibility */
      a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible {
        outline: 2px solid #FF9933 !important;
        outline-offset: 2px !important;
      }
      /* GIGW 3.0 High Contrast Theme */
      html.gov-hc body {
        filter: contrast(1.18) saturate(1.05);
        background-color: #FFFFFF !important;
      }
      html.gov-hc .bg-white, html.gov-hc .bg-slate-50 {
        border-color: #0F2942 !important;
      }
    </style>
  </head>
  <body class="bg-[#F8FAFC] text-[#0F172A] min-h-screen flex flex-col antialiased">
    <!-- GIGW Screen Reader Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-[#0F2942] focus:text-white focus:px-4 focus:py-2.5 focus:rounded focus:shadow-2xl focus:border-2 focus:border-[#FF9933] text-xs font-bold uppercase tracking-wider"
    >
      {isIndic ? 'मुख्य सामग्री पर जाएँ' : 'Skip to main content'}
    </a>

    <!-- 1. Official Government of India Slim Top Bar (Matches ux4g.gov.in & abc.gov.in) -->
    <div class="bg-[#0B1F3A] text-white border-b border-slate-800 py-1.5 px-4 sm:px-8 text-xs">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <!-- Left: Indian Flag + Government of India -->
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-3.5 rounded-[1px] shadow-2xs shrink-0" viewBox="0 0 30 20" aria-label="National Flag of India">
            <rect width="30" height="6.67" fill="#FF9933" />
            <rect y="6.67" width="30" height="6.67" fill="#FFFFFF" />
            <rect y="13.33" width="30" height="6.67" fill="#138808" />
            <circle cx="15" cy="10" r="2.4" fill="none" stroke="#000080" stroke-width="0.6" />
            <circle cx="15" cy="10" r="0.5" fill="#000080" />
          </svg>
          <span class="font-semibold tracking-wide text-[11px] sm:text-xs text-white" data-i18n="govTitle">
            {t.govTitle}
          </span>
        </div>

        <!-- Right: GIGW Utility Controls (Skip to Main Content, Font Scaler, Helpline, 22 Languages) -->
        <div class="flex items-center flex-wrap gap-2.5 sm:gap-3.5 text-[11px] sm:text-xs text-slate-200">
          <a
            href="#main-content"
            class="hidden md:inline-flex items-center gap-1 text-slate-200 hover:text-amber-300 font-medium transition-colors"
          >
            <span>{isIndic ? 'मुख्य सामग्री पर जाएँ' : 'Skip to Main Content'}</span>
          </a>
          <span class="hidden md:inline-block text-slate-600" aria-hidden="true">|</span>

          <!-- GIGW Standard Font Size Scaler (-A, A, A+) + High Contrast Toggle -->
          <div class="flex items-center gap-1 font-bold text-slate-200" role="group" aria-label="Text Size & Contrast Controls">
            <button
              type="button"
              id="btn-font-decrease"
              class="px-1.5 py-0.5 hover:bg-white/15 rounded-xs focus:outline-none transition-colors text-[11px] cursor-pointer"
              title="Decrease Font Size (-A)"
              aria-label="Decrease Font Size"
            >
              -A
            </button>
            <button
              type="button"
              id="btn-font-reset"
              class="px-1.5 py-0.5 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xs focus:outline-none transition-colors text-[11px] cursor-pointer"
              title="Reset Font Size to Standard (A)"
              aria-label="Reset Font Size"
            >
              A
            </button>
            <button
              type="button"
              id="btn-font-increase"
              class="px-1.5 py-0.5 hover:bg-white/15 rounded-xs focus:outline-none transition-colors text-[11px] cursor-pointer"
              title="Increase Font Size (A+)"
              aria-label="Increase Font Size"
            >
              A+
            </button>
            <button
              type="button"
              id="btn-high-contrast"
              class="ml-1 px-1.5 py-0.5 bg-amber-400 text-slate-950 hover:bg-amber-300 rounded-xs focus:outline-none transition-colors text-[10px] font-black cursor-pointer"
              title="Toggle High Contrast Mode"
              aria-label="Toggle High Contrast Mode"
            >
              HC
            </button>
          </div>

          <span class="hidden lg:inline-block text-slate-600" aria-hidden="true">|</span>
          <span class="hidden lg:inline-flex items-center gap-1 text-slate-300 font-medium">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Helpline: 1800-889-3511</span>
          </span>

          <span class="text-slate-600" aria-hidden="true">|</span>

          <!-- UX4G 22 Eighth Schedule Official Indian Languages Selector -->
          <nav class="flex items-center text-xs" aria-label="Language / 22 भारतीय भाषाएँ">
            <label for="gov-lang-select" class="sr-only">
              Select from 22 Official Indian Languages (8th Schedule)
            </label>
            <div class="relative inline-flex items-center">
              <svg
                class="w-3.5 h-3.5 text-amber-300 absolute left-2 pointer-events-none shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
                />
              </svg>
              <select
                id="gov-lang-select"
                aria-label="22 Official Indian Languages (Eighth Schedule)"
                class="appearance-none bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs rounded-xs border border-slate-600 pl-7 pr-6 py-0.5 focus:outline-none focus:ring-1 focus:ring-[#FF9933] cursor-pointer transition-colors"
              >
                {EIGHTH_SCHEDULE_LANGUAGES.map((l) => (
                  <option
                    value={l.code}
                    data-href={getLangHref(l.code)}
                    selected={l.code === resolvedLang}
                    class="bg-white text-slate-900"
                  >
                    {l.nativeName}
                  </option>
                ))}
              </select>
              <svg
                class="w-3 h-3 text-slate-300 absolute right-1.5 pointer-events-none shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </nav>
        </div>
      </div>
    </div>

    <!-- 2. Official Ministry of Education & AICTE White Institutional Masthead (Matches apaar.education.gov.in & abc.gov.in) -->
    <header class="bg-white text-slate-900 border-b-2 border-[#FF9933] shadow-xs sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="flex items-center justify-between min-h-[72px] py-2.5 gap-4">
          <!-- Left: State Emblem of India + Ministry of Education | AICTE + Portal Title -->
          <a href={homeHref} class="flex items-center gap-3 sm:gap-4 group">
            <!-- Emblem + Ministry Lockup -->
            <div class="flex items-center gap-2.5 pr-3 sm:pr-4 border-r border-slate-300">
              <img
                src="/emblem.svg"
                alt="State Emblem of India"
                class="h-11 sm:h-12 w-auto object-contain shrink-0"
                width="30"
                height="46"
              />
              <div class="hidden sm:block leading-tight">
                <div class="text-[11px] font-bold text-slate-800">शिक्षा मंत्रालय</div>
                <div class="text-[11px] font-extrabold text-[#0F2942] uppercase tracking-tight">
                  MINISTRY OF<br />EDUCATION
                </div>
              </div>
            </div>

            <!-- AICTE + APAAR National Registry Lockup -->
            <div class="flex items-center gap-2.5">
              <img
                src="/aicte.png"
                alt="AICTE Official Emblem"
                class="h-10 sm:h-11 w-10 sm:w-11 object-contain shrink-0"
                width="42"
                height="42"
              />
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-black text-base sm:text-lg tracking-tight text-[#0F766E] leading-none">
                    APAAR &bull; AICTE
                  </span>
                  <span class="hidden md:inline-block text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-full">
                    One Nation, One Student ID
                  </span>
                </div>
                <div class="font-bold text-xs sm:text-sm text-[#0F2942] leading-snug mt-0.5" data-i18n="portalTitle">
                  {t.portalTitle}
                </div>
              </div>
            </div>
          </a>

          <!-- Right: Clean Desktop Navigation Links + Saffron Officer Login Button -->
          <div class="hidden lg:flex items-center gap-2 shrink-0">
            <nav class="flex items-center space-x-1" aria-label="Portal Navigation">
              {navItems.map((p) => {
                const isActive = activeRole === p.id;
                return (
                  <a
                    href={p.path}
                    class={`px-3.5 py-2 rounded-md text-xs sm:text-sm font-semibold transition-colors ${
                      isActive
                        ? 'bg-[#0F2942] text-white font-bold shadow-2xs'
                        : 'text-slate-700 hover:text-[#0F2942] hover:bg-slate-100'
                    }`}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {p.label}
                  </a>
                );
              })}
            </nav>

            <div class="h-6 w-px bg-slate-200 mx-1" aria-hidden="true"></div>

            {user ? (
              <div class="flex items-center gap-2.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-md text-xs">
                <div class="flex flex-col text-right leading-tight">
                  <div class="flex items-center justify-end gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span class="font-bold text-[#0F2942] font-mono text-xs">{user.username}</span>
                    <span class="bg-blue-50 text-blue-900 border border-blue-200 px-1.5 py-0.5 rounded text-[10px] font-bold">
                      {roleLabels[user.role] || user.role}
                    </span>
                  </div>
                  {user.role === 'INSTITUTE_ADMIN' && user.institution_id && (
                    <span class="text-[10px] text-amber-800 font-mono font-semibold mt-0.5">
                      {isIndic ? 'संस्थान:' : 'Institution:'} {user.institution_id}
                    </span>
                  )}
                </div>
                <a
                  href="/api/auth/logout"
                  class="ml-1 px-2.5 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded text-xs font-bold shadow-2xs transition-colors flex items-center gap-1"
                  title={t.signOut}
                >
                  <span data-i18n="signOut">{t.signOut}</span>
                </a>
              </div>
            ) : (
              <a
                href={loginHref}
                class="px-4 py-2.5 font-bold rounded-md text-xs sm:text-sm transition-colors shadow-2xs flex items-center gap-2 bg-[#F59E0B] hover:bg-[#D97706] text-slate-950"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
                <span data-i18n="signIn">{t.signIn}</span>
              </a>
            )}
          </div>

          <!-- Mobile / Tablet Navigation Select & Sign In/Out -->
          <div class="lg:hidden flex items-center gap-2">
            <label for="mobile-portal-select" class="sr-only">
              {t.portalsHeading}
            </label>
            <select
              id="mobile-portal-select"
              class="bg-slate-50 text-slate-900 text-xs font-semibold rounded border border-slate-300 px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-[#0F2942]"
              onchange="window.location.href=this.value"
            >
              {navItems.map((p) => (
                <option value={p.path} selected={activeRole === p.id}>
                  {p.label}
                </option>
              ))}
            </select>
            {user ? (
              <a
                href="/api/auth/logout"
                class="px-2.5 py-1.5 bg-red-600 text-white rounded text-xs font-bold"
                title={t.signOut}
              >
                {t.signOut}
              </a>
            ) : (
              <a
                href={loginHref}
                class="px-3 py-1.5 bg-[#F59E0B] text-slate-950 font-bold rounded text-xs"
              >
                {t.signIn}
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Subtle Breadcrumb Strip (Only shown on inner pages, keeping landing page clean like apaar.education.gov.in) -->
      {activeRole !== 'overview' && (
        <div class="bg-slate-50 border-t border-slate-200 px-4 sm:px-8 py-1.5 text-xs text-slate-600">
          <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
            <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs">
              <a href={homeHref} class="text-slate-600 hover:text-[#0F2942] font-medium flex items-center gap-1 transition-colors">
                <svg class="w-3.5 h-3.5 text-[#0F766E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span>{t.navOverview}</span>
              </a>
              <span class="text-slate-400" aria-hidden="true">/</span>
              <span class="font-bold text-[#0F2942]" aria-current="page">{resolvedBreadcrumb}</span>
            </nav>
            <div class="hidden md:flex items-center gap-2 text-[11px] font-medium text-slate-500">
              <span>{t.heroBadge}</span>
              <span>&bull;</span>
              <span>DPDP Act 2023 Compliant</span>
            </div>
          </div>
        </div>
      )}
    </header>

    <!-- 4. Main Page Content Container -->
    <main id="main-content" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-6 focus:outline-none">
      <slot />
    </main>

    <!-- 5. Standard Government of India UX4G Footer -->
    <footer class="bg-[#0F172A] text-slate-300 text-xs sm:text-sm border-t border-slate-800 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 py-10">
        <!-- Partner & Standards Row (Digital India, AICTE, GIGW 3.0, DPDP Act 2023, 22 Scheduled Languages) -->
        <div class="flex flex-wrap items-center justify-between gap-6 pb-8 mb-8 border-b border-slate-800">
          <div class="flex items-center flex-wrap gap-4">
            <div class="bg-white rounded px-2.5 py-1 shadow-xs flex items-center">
              <img
                src="/digital_india.svg"
                alt="Digital India - Power to Empower"
                class="h-8 sm:h-9 w-auto object-contain"
                width="110"
                height="36"
              />
            </div>
            <div class="bg-white rounded p-1 shadow-xs flex items-center">
              <img
                src="/aicte.png"
                alt="All India Council for Technical Education"
                class="h-8 sm:h-9 w-auto object-contain"
                width="36"
                height="36"
              />
            </div>
            <div class="border-l border-slate-700 pl-4 text-xs">
              <div class="font-bold text-white uppercase tracking-wider">
                {isIndic ? 'राष्ट्रीय डिजिटल शिक्षा वास्तुकला (NDEAR)' : 'National Digital Education Architecture (NDEAR)'}
              </div>
