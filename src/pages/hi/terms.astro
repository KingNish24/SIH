---
import PolicyPage from '../../components/PolicyPage.astro';

const sections = [
  { heading: 'स्वीकृति', paragraphs: ['इस पोर्टल का उपयोग करके आप इन शर्तों से सहमत होते हैं। यदि आप सहमत नहीं हैं, तो पोर्टल का उपयोग न करें।'] },
  {
    heading: 'पोर्टल का उपयोग कौन कर सकता है',
    items: [
      'कोई भी व्यक्ति सार्वजनिक सत्यापन पृष्ठ का उपयोग कर सकता है।',
      'केवल एआईसीटीई, संस्थानों और विश्वविद्यालयों के अधिकृत अधिकारी ही अधिकारी पोर्टल का उपयोग कर सकते हैं।',
      'केवल पंजीकृत छात्र ही छात्र पोर्टल का उपयोग कर सकता है।',
    ],
  },
  {
    heading: 'आपका खाता',
    items: [
      'अपना पासवर्ड गुप्त रखें। अपना खाता किसी से साझा न करें।',
      'आपके खाते से किए गए सभी कार्यों के लिए आप उत्तरदायी हैं।',
      'काम पूरा होने पर साइन आउट करें, विशेषकर साझा कंप्यूटर पर।',
      'यदि आपको लगता है कि किसी ने आपके खाते का उपयोग किया है, तो तुरंत अपने प्रशासक को बताएँ।',
    ],
  },
  {
    heading: 'सही उपयोग',
    paragraphs: ['आपको यह नहीं करना चाहिए:'],
    items: [
      'जानबूझकर गलत डेटा अपलोड करना।',
      'जिस डेटा को देखने की अनुमति नहीं है, उसे देखने का प्रयास करना।',
      'लिखित अनुमति के बिना पोर्टल को तोड़ने, अधिभारित करने या उसकी सुरक्षा जाँचने का प्रयास करना।',
      'पोर्टल से डेटा कॉपी करने के लिए स्वचालित उपकरणों का उपयोग करना।',
      'सत्यापन परिणामों का उपयोग उस उद्देश्य के अलावा करना जिसके लिए छात्र ने सहमति दी है।',
    ],
  },
  { heading: 'डेटा की शुद्धता', paragraphs: ['डेटा संस्थान और विश्वविद्यालय देते हैं। उसकी शुद्धता के लिए वे उत्तरदायी हैं। एआईसीटीई पोर्टल को सही रखने का उचित प्रयास करता है, पर यह गारंटी नहीं देता कि सारा डेटा त्रुटिरहित है।'] },
  { heading: 'उपलब्धता', paragraphs: ['हम पोर्टल को हर समय उपलब्ध रखने का प्रयास करते हैं। रखरखाव या सुरक्षा कारणों से हम बिना सूचना के पोर्टल बंद कर सकते हैं।'] },
  { heading: 'दायित्व', paragraphs: ['कानून द्वारा अनुमत सीमा तक, पोर्टल के उपयोग, दूसरों द्वारा दिए गए डेटा, या पोर्टल के अनुपलब्ध होने से हुई किसी भी हानि के लिए एआईसीटीई उत्तरदायी नहीं है।'] },
  { heading: 'निलंबन', paragraphs: ['यदि आप इन शर्तों का उल्लंघन करते हैं, तो हम आपका खाता निलंबित या बंद कर सकते हैं और मामले की सूचना संबंधित प्राधिकारी को दे सकते हैं।'] },
  { heading: 'लागू कानून', paragraphs: ['ये शर्तें भारत के कानूनों के अधीन हैं। इन शर्तों से जुड़े विवादों की सुनवाई केवल नई दिल्ली के न्यायालय कर सकते हैं।'] },
  { heading: 'परिवर्तन', paragraphs: ['हम इन शर्तों में परिवर्तन कर सकते हैं। इस पृष्ठ के ऊपर दी गई तिथि अंतिम परिवर्तन दिखाती है।'] },
];
---

<PolicyPage
  lang="hi"
  title="उपयोग की शर्तें"
  updated="28 अक्टूबर 2026"
  intro="ये शर्तें राष्ट्रीय छात्र रजिस्ट्री एवं सत्यापन पोर्टल के उपयोग के नियम बताती हैं।"
  sections={sections}
/>
