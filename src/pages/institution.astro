        const capUiVal = parseInt(selectedOpt?.getAttribute('data-sanctioned') || '180', 10);

        if (res.ok && data.success) {
          const newEnrolled = data.new_enrollment ?? currentUiVal + 1;
          const cap = data.sanctioned_intake ?? capUiVal;
          if (selectedOpt) {
            const instName = selectedOpt.getAttribute('data-name') || selectedOpt.textContent?.split(' (')[0] || '';
            selectedOpt.setAttribute('data-current', String(newEnrolled));
            selectedOpt.setAttribute('data-sanctioned', String(cap));
