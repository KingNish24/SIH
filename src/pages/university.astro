        <div>
          <label for="revokeReasonInput" class="block font-semibold text-slate-700 mb-1.5">
            {t.univ_revocation_sub}
          </label>
          <textarea
            id="revokeReasonInput"
            rows="3"
            placeholder="Enter statutory reason or select a preset above..."
            class="w-full bg-white border border-slate-300 rounded p-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-600"
          ></textarea>
        </div>
      </div>

      <div class="bg-slate-50 border-t border-slate-200 px-5 py-3.5 flex items-center justify-end gap-2.5">
        <button
          type="button"
          id="cancelRevokeBtn"
          class="h-10 px-4 rounded bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 font-semibold text-xs sm:text-sm transition-colors cursor-pointer"
        >
          {t.ui_close}
        </button>
        <button
          type="button"
          id="confirmRevokeBtn"
          class="h-10 px-4 rounded bg-red-700 hover:bg-red-800 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm cursor-pointer"
        >
          Revoke
        </button>
      </div>
    </div>
  </div>

  <!-- Accessible In-Page Modal Dialog for Degree Reinstatement -->
  <div
    id="reinstateModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reinstateModalTitle"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4"
  >
    <div class="bg-white border border-slate-200 rounded-md shadow-xl max-w-md w-full overflow-hidden">
      <div class="bg-emerald-50 border-b border-emerald-200 px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
          <h3 id="reinstateModalTitle" class="text-sm sm:text-base font-bold text-emerald-950">
            Reinstate Degree Record
          </h3>
        </div>
        <button
          type="button"
          id="closeReinstateModalBtn"
          aria-label={t.ui_close}
          class="text-slate-500 hover:text-slate-800 text-lg font-bold px-1 cursor-pointer"
        >
          &times;
        </button>
      </div>

      <div class="p-5 space-y-3 text-xs sm:text-sm text-slate-700">
        <p class="leading-relaxed">
          Reinstate <strong id="reinstateTargetId" class="font-mono text-slate-900">--</strong> (<span id="reinstateTargetCandidate" class="font-semibold">--</span>) to <strong>ISSUED (VALID)</strong> status?
        </p>
      </div>

      <div class="bg-slate-50 border-t border-slate-200 px-5 py-3.5 flex items-center justify-end gap-2.5">
        <button
          type="button"
          id="cancelReinstateBtn"
          class="h-10 px-4 rounded bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 font-semibold text-xs sm:text-sm transition-colors cursor-pointer"
        >
          {t.ui_close}
        </button>
        <button
          type="button"
          id="confirmReinstateBtn"
          class="h-10 px-4 rounded bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm cursor-pointer"
        >
          Reinstate
        </button>
      </div>
    </div>
  </div>

  <script>
    let activeDegreeId: string | null = null;
    let lastFocusedTrigger: HTMLElement | null = null;

    const revokeModal = document.getElementById('revokeModal');
    const reinstateModal = document.getElementById('reinstateModal');
    const revokeReasonSelect = document.getElementById('revokeReasonSelect') as HTMLSelectElement | null;
    const revokeReasonInput = document.getElementById('revokeReasonInput') as HTMLTextAreaElement | null;

    const degApaarInput = document.getElementById('degApaar') as HTMLInputElement | null;
    const degInstSelect = document.getElementById('degInst') as HTMLSelectElement | null;
    const degNameInput = document.getElementById('degName') as HTMLInputElement | null;
    const degSpecInput = document.getElementById('degSpec') as HTMLInputElement | null;
    const degCgpaInput = document.getElementById('degCgpa') as HTMLInputElement | null;
    const degYearInput = document.getElementById('degYear') as HTMLInputElement | null;

    // Numeric sanitization on 12-digit APAAR input
    degApaarInput?.addEventListener('input', () => {
      degApaarInput.value = degApaarInput.value.replace(/\D/g, '').slice(0, 12);
    });

    // Clickable candidate example buttons (populates empty form on click)
    document.querySelectorAll<HTMLButtonElement>('[data-example-apaar]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (degApaarInput) degApaarInput.value = btn.getAttribute('data-example-apaar') || '';
        if (degInstSelect) degInstSelect.value = btn.getAttribute('data-example-inst') || degInstSelect.value;
        if (degNameInput) degNameInput.value = btn.getAttribute('data-example-degree') || '';
        if (degSpecInput) degSpecInput.value = btn.getAttribute('data-example-spec') || '';
        if (degCgpaInput) degCgpaInput.value = btn.getAttribute('data-example-cgpa') || '';
        if (degYearInput) degYearInput.value = btn.getAttribute('data-example-year') || '';
        degApaarInput?.focus();
      });
    });

    revokeReasonSelect?.addEventListener('change', () => {
      if (revokeReasonInput && revokeReasonSelect.value) {
        revokeReasonInput.value = revokeReasonSelect.value;
      }
    });

    function openRevokeModal(degreeId: string, studentName: string, degreeName: string, trigger: HTMLElement) {
      activeDegreeId = degreeId;
      lastFocusedTrigger = trigger;
      const idEl = document.getElementById('revokeTargetId');
      const candEl = document.getElementById('revokeTargetCandidate');
      if (idEl) idEl.textContent = degreeId;
      if (candEl) candEl.textContent = `${studentName || 'Candidate'}${degreeName ? ' — ' + degreeName : ''}`;
      if (revokeReasonSelect) revokeReasonSelect.value = '';
      if (revokeReasonInput) revokeReasonInput.value = '';
      revokeModal?.classList.remove('hidden');
      revokeModal?.classList.add('flex');
      revokeReasonInput?.focus();
    }

    function closeRevokeModal() {
      revokeModal?.classList.add('hidden');
      revokeModal?.classList.remove('flex');
      activeDegreeId = null;
      lastFocusedTrigger?.focus();
    }

    function openReinstateModal(degreeId: string, studentName: string, degreeName: string, trigger: HTMLElement) {
      activeDegreeId = degreeId;
      lastFocusedTrigger = trigger;
      const idEl = document.getElementById('reinstateTargetId');
      const candEl = document.getElementById('reinstateTargetCandidate');
      if (idEl) idEl.textContent = degreeId;
      if (candEl) candEl.textContent = `${studentName || 'Candidate'}${degreeName ? ' — ' + degreeName : ''}`;
      reinstateModal?.classList.remove('hidden');
      reinstateModal?.classList.add('flex');
      document.getElementById('confirmReinstateBtn')?.focus();
    }

    function closeReinstateModal() {
      reinstateModal?.classList.add('hidden');
      reinstateModal?.classList.remove('flex');
      activeDegreeId = null;
      lastFocusedTrigger?.focus();
    }

    // Event delegation for Revoke / Reinstate buttons (eliminates inline onclick quote issues)
    document.querySelectorAll<HTMLButtonElement>('[data-revoke-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        openRevokeModal(
          btn.getAttribute('data-revoke-id') || '',
          btn.getAttribute('data-student-name') || '',
          btn.getAttribute('data-degree-name') || '',
          btn
        );
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-reinstate-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        openReinstateModal(
          btn.getAttribute('data-reinstate-id') || '',
          btn.getAttribute('data-student-name') || '',
          btn.getAttribute('data-degree-name') || '',
          btn
        );
      });
    });

    document.getElementById('closeRevokeModalBtn')?.addEventListener('click', closeRevokeModal);
    document.getElementById('cancelRevokeBtn')?.addEventListener('click', closeRevokeModal);
    document.getElementById('closeReinstateModalBtn')?.addEventListener('click', closeReinstateModal);
    document.getElementById('cancelReinstateBtn')?.addEventListener('click', closeReinstateModal);

    // Close modals on Escape key or backdrop click
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!revokeModal?.classList.contains('hidden')) closeRevokeModal();
        if (!reinstateModal?.classList.contains('hidden')) closeReinstateModal();
      }
    });

    revokeModal?.addEventListener('click', (e) => {
      if (e.target === revokeModal) closeRevokeModal();
    });
    reinstateModal?.addEventListener('click', (e) => {
      if (e.target === reinstateModal) closeReinstateModal();
    });

    document.getElementById('confirmRevokeBtn')?.addEventListener('click', async () => {
      if (!activeDegreeId) return;
      const reason = revokeReasonInput?.value?.trim();
      if (!reason) {
        (window as any).showToast('Please select or enter a statutory reason for revocation.', 'warning');
        return;
      }

      const btn = document.getElementById('confirmRevokeBtn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;

      try {
        const res = await fetch('/api/university/degree', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            degreeId: activeDegreeId,
            action: 'REVOKE',
            reason,
          }),
        });
        const data = await res.json();
        if (data.success) {
          closeRevokeModal();
          (window as any).showToast('Degree record marked REVOKED in Central D1 Registry.', 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          (window as any).showToast('Revocation failed: ' + (data.error || 'Server error'), 'error');
        }
      } catch {
        (window as any).showToast('Network error processing revocation.', 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    document.getElementById('confirmReinstateBtn')?.addEventListener('click', async () => {
      if (!activeDegreeId) return;
      const btn = document.getElementById('confirmReinstateBtn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;

      try {
        const res = await fetch('/api/university/degree', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            degreeId: activeDegreeId,
            action: 'REINSTATE',
          }),
        });
        const data = await res.json();
        if (data.success) {
          closeReinstateModal();
          (window as any).showToast('Degree record REINSTATED in Central D1 Registry.', 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          (window as any).showToast('Reinstatement failed: ' + (data.error || 'Server error'), 'error');
        }
      } catch {
        (window as any).showToast('Network error processing reinstatement.', 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    // Single Degree Issuance Form
    const issueSubmitBtn = document.getElementById('issueSubmitBtn') as HTMLButtonElement | null;
    document.getElementById('issueDegreeForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (issueSubmitBtn) issueSubmitBtn.disabled = true;

      const apaar = degApaarInput?.value.trim() || '';
      const inst = degInstSelect?.value || 'INST-001';
      const name = degNameInput?.value.trim() || '';
      const spec = degSpecInput?.value.trim() || '';
      const cgpa = parseFloat(degCgpaInput?.value || '8.5');
      const year = parseInt(degYearInput?.value || '2026', 10);

      try {
        const res = await fetch('/api/university/degree', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            apaar_id: apaar,
            institution_id: inst,
            degree_name: name,
            specialization: spec,
            cgpa,
            year_of_passing: year,
            issuing_authority: 'State Technological Affiliating University',
          }),
        });

        const data = await res.json();
        if (data.success) {
          (window as any).showToast('Degree issued with Ed25519 Signature & SHA-256 Stamp.', 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          (window as any).showToast('Issuance error: ' + (data.error || 'Server error'), 'error');
        }
      } catch {
        (window as any).showToast('Network error issuing degree.', 'error');
      } finally {
        if (issueSubmitBtn) issueSubmitBtn.disabled = false;
      }
    });

    // Wired Batch Sign Eligible Verified Rosters Button
    const batchSignBtn = document.getElementById('batchSignBtn') as HTMLButtonElement | null;
    batchSignBtn?.addEventListener('click', async () => {
      batchSignBtn.disabled = true;
      const batchCandidates = [
        {
          apaar_id: '901238471920',
          institution_id: 'INST-001',
          degree_name: 'Bachelor of Technology',
          specialization: 'Mechanical Engineering',
          cgpa: 8.85,
          year_of_passing: 2026,
          issuing_authority: 'State Technological Affiliating University',
        },
        {
          apaar_id: '582910384729',
          institution_id: 'INST-002',
          degree_name: 'Bachelor of Technology',
          specialization: 'Electronics & Telecommunication',
          cgpa: 9.12,
          year_of_passing: 2026,
          issuing_authority: 'State Technological Affiliating University',
        },
      ];

      let issuedCount = 0;
      try {
        for (const cand of batchCandidates) {
          const res = await fetch('/api/university/degree', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(cand),
          });
          const data = await res.json();
          if (data.success) issuedCount++;
        }
        if (issuedCount > 0) {
          (window as any).showToast(`Batch signed & issued ${issuedCount} Ed25519 degree records to D1.`, 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          (window as any).showToast('Batch signing failed or no eligible records.', 'warning');
        }
      } catch {
        (window as any).showToast('Network error during batch signing.', 'error');
      } finally {
        batchSignBtn.disabled = false;
      }
    });

    // Browser SHA-256 helper for Section 63 BSA Merkle Audit Verifier
    function escapeHtml(str: unknown): string {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    async function sha256Univ(text: string): Promise<string> {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }

    async function computeMerkleRootUniv(hashes: string[]): Promise<string> {
      if (!hashes || hashes.length === 0) return sha256Univ('VIDYA-EMPTY-LEDGER');
      let level = [...hashes];
      while (level.length > 1) {
        const next: string[] = [];
        for (let i = 0; i < level.length; i += 2) {
          const left = level[i];
          const right = i + 1 < level.length ? level[i + 1] : left;
          next.push(await sha256Univ(left + ':' + right));
        }
        level = next;
      }
      return level[0];
    }

    const verifyMerkleBtnUniv = document.getElementById('verifyMerkleBtnUniv') as HTMLButtonElement | null;
    verifyMerkleBtnUniv?.addEventListener('click', async () => {
      verifyMerkleBtnUniv.disabled = true;
      const stripEl = document.getElementById('merkleSummaryStripUniv');
      const statusEl = document.getElementById('merkleStatusTextUniv');
      const rootEl = document.getElementById('merkleRootTextUniv');
      const countEl = document.getElementById('merkleBlockCountUniv');
      const containerEl = document.getElementById('merkleBlocksContainerUniv');
      const listEl = document.getElementById('merkleBlocksListUniv');

      stripEl?.setAttribute('aria-busy', 'true');
      if (statusEl) statusEl.textContent = 'SHA-256...';

      try {
        const res = await fetch('/api/ledger/merkle');
        const data = await res.json();
        if (!data.success || !Array.isArray(data.blocks)) {
          throw new Error(data.error || 'Failed to load ledger blocks');
        }

        let prev = data.genesis_prev_hash;
        let allValid = true;
        const computedHashes: string[] = [];
        let rowsHtml = '';

        for (const blk of data.blocks) {
          const expectedHash = await sha256Univ(prev + ':' + blk.canonical_payload);
          const linkMatches = expectedHash === blk.block_hash && prev === blk.prev_hash;
          if (!linkMatches) allValid = false;
          computedHashes.push(expectedHash);

          rowsHtml += `
            <div class="p-3 bg-white hover:bg-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-[#0F2942] font-bold border border-slate-300">#${Number(blk.index)} ${escapeHtml(blk.block_type)}</span>
                  <span class="font-sans font-semibold text-slate-800">${escapeHtml(blk.summary)}</span>
                </div>
                <div class="text-[11px] text-slate-500 mt-1">
                  prev: <span class="text-slate-700">${escapeHtml(String(blk.prev_hash).slice(0, 16))}...</span> &rarr;
                  hash: <span class="text-[#0F2942] font-bold">${expectedHash.slice(0, 20)}...</span>
                </div>
              </div>
              <span class="px-2.5 py-0.5 rounded text-[10px] font-bold border shrink-0 ${
                linkMatches
                  ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
                  : 'bg-red-100 text-red-800 border-red-200'
              }">
                ${linkMatches ? 'SHA-256 VERIFIED' : 'TAMPER DETECTED'}
              </span>
            </div>
          `;
          prev = expectedHash;
        }

        const browserMerkleRoot = await computeMerkleRootUniv(computedHashes);
        const rootMatches = browserMerkleRoot === data.merkle_root;

        if (statusEl) {
          statusEl.innerHTML =
            allValid && rootMatches
              ? `<span class="text-emerald-800">VERIFIED (BSA Sec. 63)</span>`
              : `<span class="text-red-700">HASH DISCREPANCY</span>`;
        }
        if (rootEl) {
          rootEl.textContent = browserMerkleRoot;
          rootEl.title = browserMerkleRoot;
        }
        if (countEl) {
          countEl.textContent = `${data.blocks.length} (${data.counts.institutions} Inst, ${data.counts.admissions} Adm, ${data.counts.degrees} Deg)`;
        }
        if (listEl && containerEl) {
          listEl.innerHTML = rowsHtml;
          containerEl.classList.remove('hidden');
        }
        (window as any).showToast?.(
          `Verified ${data.blocks.length} blocks. Root: ${browserMerkleRoot.slice(0, 16)}...`,
          'success'
        );
      } catch (err: any) {
        if (statusEl) statusEl.textContent = err?.message || 'Error';
        (window as any).showToast?.('Error verifying Merkle ledger', 'error');
      } finally {
        stripEl?.setAttribute('aria-busy', 'false');
        verifyMerkleBtnUniv.disabled = false;
      }
    });
  </script>
</Layout>
