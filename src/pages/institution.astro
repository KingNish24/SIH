                  <option value="APPROVED_INTAKE">Approved Intake — Merit / JoSAA / State CET</option>
                  <option value="SUPERNUMERARY">Supernumerary — TFW / EWS / PMSSS (15%)</option>
                  <option value="NRI">NRI Quota — Non-Resident Indian (5%)</option>
                  <option value="OCI">OCI / PIO Quota — Overseas Citizen (2%)</option>
                  <option value="FN">Foreign National Quota (3%)</option>
