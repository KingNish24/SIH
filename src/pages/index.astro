---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution } from '../lib/types';
import {
  EIGHTH_SCHEDULE_LANGUAGES,
  getLanguageInfo,
  getUIDictionary,
  isSupportedLang,
  type LangCode,
} from '../lib/i18n';

const resolvedLang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langInfo = getLanguageInfo(resolvedLang);
const t = getUIDictionary(resolvedLang);
const langPrefix = resolvedLang === 'en' ? '' : `/${resolvedLang}`;

const db = getDB(Astro.locals);
const instRes = await db.prepare('SELECT * FROM institutions ORDER BY name ASC').bind().all<Institution>();
const institutions = instRes.results || [];
const user = Astro.locals.user;

const totalMonitored = institutions.length;
const overrunCount = institutions.filter((i) => i.current_enrollment > i.sanctioned_intake).length;
const compliantCount = totalMonitored - overrunCount;
const totalSanctioned = institutions.reduce((sum, i) => sum + (i.sanctioned_intake || 0), 0);
const totalEnrollment = institutions.reduce((sum, i) => sum + (i.current_enrollment || 0), 0);
const compliancePct = totalMonitored > 0 ? ((compliantCount / totalMonitored) * 100).toFixed(1) : '100.0';
const verifiedDegreesRow = await db.prepare('SELECT COUNT(*) as cnt FROM degrees WHERE revoked = 0').bind().first<{ cnt: number }>();
const verifiedDegreesCount = verifiedDegreesRow?.cnt ?? 0;

const portals = [
  {
    role: 'institution',
    title: t.portal1Title,
    code: 'INST-01',
    description: t.portal1Desc,
    path: `${langPrefix}/institution`,
    stats: '60 / 120 / 180 / 240 Cap',
    isPublic: false,
  },
  {
    role: 'aicte',
    title: t.portal2Title,
    code: 'REG-02',
    description: t.portal2Desc,
    path: `${langPrefix}/aicte`,
    stats: 'AICTE APH 2024–2027 Audit',
    isPublic: false,
  },
  {
    role: 'university',
    title: t.portal3Title,
    code: 'UNIV-03',
    description: t.portal3Desc,
    path: `${langPrefix}/university`,
    stats: 'Ed25519 Signed Ledger',
    isPublic: false,
  },
  {
    role: 'student',
    title: t.portal4Title,
    code: 'STU-04',
    description: t.portal4Desc,
    path: `${langPrefix}/student`,
    stats: 'DPDP Act Sec. 6 & Passkey',
    isPublic: false,
  },
  {
    role: 'verifier',
    title: t.portal5Title,
    code: 'VRF-05',
    description: t.portal5Desc,
    path: `${langPrefix}/verifier`,
    stats: '< 50 ms Edge Verification',
    isPublic: true,
  },
];
---

<Layout
  title={`${t.portalTitle} (${langInfo.nativeName}) | AICTE | Ministry of Education`}
  activeRole="overview"
  breadcrumb={t.portalTitle}
  lang={resolvedLang}
>
  <!-- 1. Authoritative UX4G Hero / Statutory Header Card (Localized in 22 Eighth Schedule Languages) -->
  <section class="bg-gradient-to-br from-[#0F2942] via-[#133251] to-[#0B1E32] text-white rounded-lg border-t-4 border-[#FF9933] shadow-md p-6 sm:p-8 mb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
      <!-- Left Column: Statutory Mandate & Primary CTAs -->
      <div class="lg:col-span-7 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="bg-[#FF9933] text-slate-950 font-bold text-xs uppercase px-2.5 py-0.5 rounded tracking-wide" data-i18n="heroBadge">
            {t.heroBadge}
          </span>
          <span class="bg-white/10 border border-white/20 text-slate-100 text-xs font-medium px-2.5 py-0.5 rounded">
            NEP 2020 | APAAR &amp; ABC Registry
          </span>
          <span class="bg-emerald-900/60 border border-emerald-500/40 text-emerald-200 text-xs font-semibold px-2.5 py-0.5 rounded inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            <span>{langInfo.nativeName}</span>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white leading-tight" data-i18n="heroTitle">
          {t.heroTitle}
        </h1>

        <p class="text-sm text-slate-200 leading-relaxed" data-i18n="heroSubtitle">
          {t.heroSubtitle}
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href={`${langPrefix}/verifier`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[#138808] hover:bg-[#0E6506] text-white text-xs sm:text-sm font-bold shadow-xs transition-colors"
          >
            <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span data-i18n="verifyCta">{t.verifyCta}</span>
          </a>
          <a
            href={`${langPrefix}/login`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[#FF9933] hover:bg-[#F28500] text-slate-950 text-xs sm:text-sm font-bold shadow-xs transition-colors"
          >
            <span data-i18n="signIn">{t.signIn}</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a
            href="#institution-search"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded bg-white/10 hover:bg-white/20 text-white border border-white/20 text-xs sm:text-sm font-semibold transition-colors"
          >
            <span>{t.dirHeading}</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Quick Inline 12-Digit APAAR Verification Card -->
      <div class="lg:col-span-5">
        <div class="bg-white text-slate-900 rounded-lg p-5 shadow-lg border border-slate-200">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-4">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 block">
                {t.navVerifier}
              </span>
              <h2 class="text-base font-bold text-[#0F2942]" data-i18n="quickVerifyTitle">
                {t.quickVerifyTitle}
              </h2>
            </div>
            <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold px-2.5 py-0.5 rounded">
              {t.navVerifier}
            </span>
          </div>

          <form action={`${langPrefix}/verifier`} method="GET" class="space-y-3" id="quickVerifyForm">
            <div>
              <label for="quickApaarInputLang" class="block text-xs font-bold text-slate-700 mb-1.5" data-i18n="quickVerifyLabel">
                {t.quickVerifyLabel}
              </label>
              <input
                type="text"
                id="quickApaarInputLang"
                name="apaar"
                inputmode="numeric"
                pattern="[0-9]{12}"
                maxlength="12"
                required
                placeholder="412398471029"
                class="w-full bg-slate-50 border border-slate-300 rounded px-3.5 py-2.5 font-mono text-sm text-slate-900 tracking-wider focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
              />
            </div>
            <button
              type="submit"
              class="w-full py-2.5 px-4 bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold rounded text-xs sm:text-sm transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer"
            >
              <span data-i18n="quickVerifyBtn">{t.quickVerifyBtn}</span>
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </button>
          </form>

          <div class="mt-3 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span>APAAR:</span>
              <button
                type="button"
                data-sample-apaar="102938475610"
                class="font-mono font-bold text-[#0F2942] bg-slate-100 hover:bg-blue-50 hover:text-blue-800 border border-slate-300 px-2 py-0.5 rounded transition-colors cursor-pointer"
                title="Click to populate sample APAAR ID"
              >
                102938475610
              </button>
              <button
                type="button"
                data-sample-apaar="412398471029"
                class="font-mono font-bold text-[#0F2942] bg-slate-100 hover:bg-blue-50 hover:text-blue-800 border border-slate-300 px-2 py-0.5 rounded transition-colors cursor-pointer"
                title="Click to populate Sneha Deshmukh APAAR ID"
              >
                412398471029
              </button>
            </div>
            <a href={`${langPrefix}/verifier`} class="text-blue-700 hover:underline font-semibold inline-flex items-center gap-1">
              <span>{t.navVerifier}</span>
              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 4 KPI Benchmark Cards (With Live D1 Registry Telemetry) -->
  <section aria-label={t.portalTitle} class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#0F2942] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-i18n="kpi1Label">{t.kpi1Label}</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5 font-mono">{totalMonitored}</div>
      <div class="text-xs text-slate-600 mt-1 flex items-center justify-between">
        <span>{t.aicte_kpi_total_colleges}:</span>
        <span class="font-mono font-bold text-[#0F2942] bg-slate-100 px-1.5 py-0.5 rounded">{compliantCount} Compliant</span>
      </div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#FF9933] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-i18n="kpi2Label">{t.kpi2Label}</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5 font-mono">{totalEnrollment} <span class="text-base font-normal text-slate-500">/ {totalSanctioned}</span></div>
      <div class="text-xs text-slate-600 mt-1 flex items-center justify-between">
        <span>{t.aicte_col_actual} / {t.aicte_col_sanctioned}:</span>
        <span class="font-mono font-bold text-[#0F2942] bg-amber-50 px-1.5 py-0.5 rounded">{((totalEnrollment / Math.max(1, totalSanctioned)) * 100).toFixed(1)}%</span>
      </div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#138808] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-i18n="kpi3Label">{t.kpi3Label}</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5 font-mono">{compliancePct}%</div>
      <div class="text-xs text-slate-600 mt-1 flex items-center justify-between">
        <span>{t.statusCompliant}:</span>
        <span class="font-mono font-bold text-emerald-800 bg-emerald-50 px-1.5 py-0.5 rounded">{compliantCount} / {totalMonitored}</span>
      </div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-blue-600 shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-i18n="kpi4Label">{t.kpi4Label}</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5 font-mono">{verifiedDegreesCount}</div>
      <div class="text-xs text-slate-600 mt-1 flex items-center justify-between">
        <span>Ed25519 + WebAuthn</span>
        <span class="font-mono font-bold text-blue-800 bg-blue-50 px-1.5 py-0.5 rounded">Signed Ledger</span>
      </div>
    </div>
  </section>

  <!-- 3. Public Institution Directory & Regulatory Compliance Table -->
  <section class="bg-white rounded-lg border border-slate-200 shadow-xs p-5 sm:p-6 mb-8" id="institution-search">
    <div class="border-b border-slate-200 pb-4 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">{t.heroBadge}</span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold text-[#0F2942] mt-0.5" data-i18n="dirHeading">
          {t.dirHeading}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5" data-i18n="dirSub">
          {t.dirSub}
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span id="dirCountBadge" class="text-xs font-mono font-bold bg-slate-100 text-slate-700 border border-slate-300 px-2.5 py-1.5 rounded">
          {totalMonitored} / {totalMonitored}
        </span>
        <a
          href={`${langPrefix}/verifier`}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white text-xs font-bold shadow-xs transition-colors"
        >
          <span>{t.navVerifier}</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>

    <!-- Search & Filter Controls for Directory -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-4">
      <div class="md:col-span-6 relative">
        <label for="instSearchInput" class="sr-only">{t.dirHeading}</label>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="instSearchInput"
          placeholder={t.aicte_search_placeholder || t.dirSub}
          class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-300 rounded text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600"
        />
      </div>

      <div class="md:col-span-3">
        <label for="stateFilterSelect" class="sr-only">{t.aicte_col_state}</label>
        <select
          id="stateFilterSelect"
          class="w-full py-2 px-3 bg-slate-50 border border-slate-300 rounded text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600"
        >
          <option value="">{t.aicte_all_states}</option>
          {Array.from(new Set(institutions.map((i) => i.state).filter(Boolean))).sort().map((st) => (
            <option value={st.toLowerCase()}>{st}</option>
          ))}
        </select>
      </div>

      <div class="md:col-span-3">
        <label for="statusFilterSelect" class="sr-only">{t.aicte_col_status}</label>
        <select
          id="statusFilterSelect"
          class="w-full py-2 px-3 bg-slate-50 border border-slate-300 rounded text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600"
        >
          <option value="">{t.aicte_all_statuses}</option>
          <option value="compliant">{t.statusCompliant} ({compliantCount})</option>
          <option value="overrun">{t.statusOverrun} ({overrunCount})</option>
        </select>
      </div>
    </div>

    <!-- Interactive Directory Table -->
    <div class="overflow-x-auto border border-slate-200 rounded-lg">
      <table class="w-full text-left text-xs sm:text-sm" id="institutionsTable">
        <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200 uppercase tracking-wider text-xs">
          <tr>
            <th class="py-3 px-4">{t.aicte_col_inst}</th>
            <th class="py-3 px-4">{t.aicte_col_state}</th>
            <th class="py-3 px-4">{t.aicte_col_sanctioned}</th>
            <th class="py-3 px-4">{t.aicte_col_actual}</th>
            <th class="py-3 px-4">{t.aicte_col_status}</th>
            <th class="py-3 px-4 text-right">{t.verifyRecordsBtn}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 font-medium text-slate-700" id="instTableBody">
          {institutions.map((inst) => {
            const isOverrun = inst.current_enrollment > inst.sanctioned_intake;
            const excessSeats = inst.current_enrollment - inst.sanctioned_intake;

            return (
              <tr
                class={`transition-colors inst-row ${isOverrun ? 'bg-red-50/30 hover:bg-red-50/60' : 'hover:bg-slate-50'}`}
                data-name={inst.name.toLowerCase()}
                data-code={inst.code.toLowerCase()}
                data-id={inst.id.toLowerCase()}
                data-state={inst.state.toLowerCase()}
                data-district={inst.district.toLowerCase()}
                data-status={isOverrun ? 'overrun' : 'compliant'}
              >
                <td class="py-3.5 px-4">
                  <div class="font-bold text-[#0F2942] text-sm">{inst.name}</div>
                  <div class="text-xs font-mono text-slate-500 mt-0.5">
                    {t.aicte_col_code}: {inst.code} &bull; ID: {inst.id}
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-800">{inst.district}</div>
                  <div class="text-xs text-slate-500">{inst.state}</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-bold text-slate-900 font-mono">{inst.sanctioned_intake}</span>
                </td>
                <td class="py-3.5 px-4">
                  {isOverrun ? (
                    <span class="font-mono font-bold text-red-700">
                      {inst.current_enrollment} / {inst.sanctioned_intake}
                    </span>
                  ) : (
                    <span class="font-mono font-semibold text-slate-800">
                      {inst.current_enrollment} / {inst.sanctioned_intake}
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4">
                  {isOverrun ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold bg-red-50 text-red-800 border border-red-200">
                      <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
                      <span data-i18n="statusOverrun">{t.statusOverrun} (+{excessSeats})</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                      <span data-i18n="statusCompliant">{t.statusCompliant}</span>
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href={`${langPrefix}/verifier?institution=${encodeURIComponent(inst.id)}&code=${encodeURIComponent(inst.code)}`}
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-slate-100 hover:bg-[#0F2942] text-[#0F2942] hover:text-white border border-slate-300 text-xs font-bold transition-colors"
                  >
                    <span data-i18n="verifyRecordsBtn">{t.verifyRecordsBtn}</span>
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div id="noResultsMsg" class="hidden p-6 text-center text-sm text-slate-500">
        0 / {totalMonitored} — {t.dirHeading}
      </div>
    </div>
  </section>

  <!-- 4. 5 Stakeholder Portals Grid -->
  <section class="mb-8" aria-labelledby="portals-heading">
    <div class="border-b border-slate-200 pb-3 mb-5 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 id="portals-heading" class="text-lg sm:text-xl font-bold text-[#0F2942]" data-i18n="portalsHeading">
          {t.portalsHeading}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5" data-i18n="portalsSub">
          {t.portalsSub}
        </p>
      </div>
      <span class="text-xs font-mono font-semibold bg-slate-100 text-slate-700 px-3 py-1 rounded border border-slate-300">
        INST-01 &bull; REG-02 &bull; UNIV-03 &bull; STU-04 &bull; VRF-05
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5">
      {portals.map((p, index) => {
        const isPublic = p.isPublic;
        const targetUrl = user
          ? p.path
          : isPublic
          ? `${langPrefix}/verifier`
          : `${langPrefix}/login?redirect=${encodeURIComponent(p.path)}`;
        const actionText = user
          ? `${t.navOverview}`
          : isPublic
          ? `${t.verifyCta}`
          : `${t.signIn}`;

        const colSpanClass = index < 3 ? 'lg:col-span-2' : 'lg:col-span-3';

        return (
          <div
            class={`${colSpanClass} bg-white rounded-lg border shadow-xs flex flex-col justify-between transition-all ${
              isPublic
                ? 'border-emerald-600 ring-1 ring-emerald-500/30 hover:border-emerald-700'
                : 'border-slate-200 hover:border-[#0F2942]'
            }`}
          >
            <div class="p-5 sm:p-6">
              <div class="flex items-center justify-between gap-2 mb-3">
