---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SIH 2026 | Credential Verification Authority" activeRole="verifier">
  <div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-slate-200 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div>
        <div class="text-xs font-semibold text-[#1E40AF] uppercase tracking-wider mb-1">
          Verification Authority Module &bull; Code VRF-05
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942]">
          Instant Academic Credential Verification
        </h1>
        <p class="text-xs text-slate-600 mt-0.5">
          Authorized verification gateway for public recruitment commissions, corporate employers, and higher education admissions.
        </p>
      </div>

      <div class="flex items-center gap-2 font-mono text-xs">
        <span class="bg-blue-50 text-blue-900 border border-blue-200 px-3 py-1 rounded font-semibold">
          Edge Latency Benchmark: &lt; 5000ms
        </span>
      </div>
    </div>

    <!-- Query Form -->
    <div class="bg-white border border-slate-200 rounded p-6 shadow-sm">
      <form id="verifierQueryForm" class="flex flex-col md:flex-row items-stretch md:items-end gap-4 text-xs">
        <div class="flex-1">
          <label class="block font-bold text-slate-800 uppercase tracking-wider mb-1.5">
            Enter Candidate 12-Digit APAAR ID:
          </label>
          <input
            type="text"
            id="queryApaar"
            required
            pattern="[0-9]{12}"
            placeholder="e.g. 412398471029"
            value="412398471029"
            class="w-full bg-slate-50 border border-slate-300 rounded p-2.5 font-mono text-slate-900 text-sm tracking-wider focus:outline-none focus:ring-1 focus:ring-blue-600"
          />
        </div>

        <div class="w-full md:w-72">
          <label class="block font-semibold text-slate-700 mb-1.5">Verifying Organization Identity:</label>
          <input
            type="text"
            id="verifierOrg"
            value="National Recruitment Authority / Employer"
            class="w-full bg-slate-50 border border-slate-300 rounded p-2.5 text-slate-800 focus:outline-none focus:ring-1 focus:ring-blue-600"
          />
        </div>

        <button
          type="submit"
          id="verifySubmitBtn"
          class="px-5 py-2.5 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-semibold text-xs transition-colors shrink-0"
        >
          Verify Credential Record
        </button>
      </form>

      <!-- Pre-Set Test Scenarios -->
      <div class="mt-4 pt-4 border-t border-slate-200 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-slate-500 font-semibold text-[11px]">Test Profiles:</span>
        <button
          type="button"
          class="demoApaarBtn px-3 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-800 font-mono text-[11px] border border-slate-300"
          data-apaar="412398471029"
        >
          412398471029 (Valid Degree Issued)
        </button>
        <button
          type="button"
          class="demoApaarBtn px-3 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-800 font-mono text-[11px] border border-slate-300"
          data-apaar="601928374819"
        >
          601928374819 (Revoked Credential)
        </button>
        <button
          type="button"
          class="demoApaarBtn px-3 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-800 font-mono text-[11px] border border-slate-300"
          data-apaar="739284019283"
        >
          739284019283 (Cross-Campus Duplicate)
        </button>
      </div>
    </div>

    <!-- Verification Output Result Console -->
    <div id="resultContainer" class="hidden bg-white border border-slate-200 rounded p-6 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between pb-4 border-b border-slate-200 gap-3">
        <div>
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Official Verification Result</div>
          <h2 id="resTitle" class="text-base font-bold text-[#0F2942] mt-0.5">Verification Output</h2>
        </div>
        <div id="resBadge" class="text-xs font-bold px-3 py-1 rounded"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-4 text-xs">
        <div class="p-3 bg-slate-50 rounded border border-slate-200">
          <div class="text-slate-500 text-[11px]">Candidate (Masked)</div>
          <div id="resName" class="font-bold text-slate-900 mt-0.5">-</div>
        </div>
        <div class="p-3 bg-slate-50 rounded border border-slate-200">
          <div class="text-slate-500 text-[11px]">Masked APAAR ID</div>
          <div id="resApaar" class="font-bold font-mono text-slate-900 mt-0.5">-</div>
        </div>
        <div class="p-3 bg-slate-50 rounded border border-slate-200">
          <div class="text-slate-500 text-[11px]">Edge Latency</div>
          <div id="resLatency" class="font-bold font-mono text-emerald-700 mt-0.5">-</div>
        </div>
      </div>

      <div id="resDegrees" class="mt-4 space-y-3"></div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('verifierQueryForm');
    const resultBox = document.getElementById('resultContainer');
    const resTitle = document.getElementById('resTitle');
    const resBadge = document.getElementById('resBadge');
    const resName = document.getElementById('resName');
    const resApaar = document.getElementById('resApaar');
    const resLatency = document.getElementById('resLatency');
    const resDegrees = document.getElementById('resDegrees');

    document.querySelectorAll('.demoApaarBtn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.getElementById('queryApaar').value = btn.dataset.apaar || '';
        form.dispatchEvent(new Event('submit'));
      });
    });

    // Check if APAAR ID passed in query string (?apaar=...)
    const urlParams = new URLSearchParams(window.location.search);
    const queryApaarParam = urlParams.get('apaar');
    if (queryApaarParam && /^\d{12}$/.test(queryApaarParam.trim())) {
      const input = document.getElementById('queryApaar');
      if (input) {
        input.value = queryApaarParam.trim();
        setTimeout(() => form?.dispatchEvent(new Event('submit')), 150);
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const apaar = document.getElementById('queryApaar').value.trim();
      const org = document.getElementById('verifierOrg').value.trim();

      const startTime = performance.now();
      try {
        const res = await fetch('/api/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ apaar_id: apaar, verifier_name: org }),
        });
        const elapsed = Math.round(performance.now() - startTime);
        const data = await res.json();

        resultBox.classList.remove('hidden');
        resLatency.textContent = elapsed + ' ms';
        resApaar.textContent = 'XXXX-XXXX-' + apaar.slice(-4);

        if (!data.success) {
          resTitle.textContent = 'Verification Request Blocked';
          resBadge.textContent = 'CONSENT WITHHELD';
          resBadge.className = 'text-xs font-bold px-3 py-1 rounded bg-amber-100 text-amber-800 border border-amber-200';
          resName.textContent = 'Student Consent Pending';
          resDegrees.innerHTML = `<div class="p-3.5 bg-amber-50 rounded border border-amber-200 text-xs text-amber-900 leading-relaxed">${data.error || 'Student has not authorized third-party record release under DPDP Act 2023.'}</div>`;
          return;
        }

        function maskNameClient(val) {
          if (!val) return 'Candidate';
          const parts = val.split(' ');
          return parts.length > 1 ? `${parts[0]} ${parts[1][0]}.` : val;
        }

        const info = data.data || data;
        resName.textContent = maskNameClient(info.student?.fullName || info.student?.full_name || 'Candidate ' + apaar.slice(-4));

        if (info.degrees && info.degrees.length > 0) {
          const deg = info.degrees[0];
          if (deg.status === 'ISSUED') {
            resTitle.textContent = 'Official Academic Credential Verified';
            resBadge.textContent = 'DEGREE AUTHENTIC';
            resBadge.className = 'text-xs font-bold px-3 py-1 rounded bg-emerald-100 text-emerald-800 border border-emerald-200';
          } else {
            resTitle.textContent = 'Credential Flagged / Revoked';
            resBadge.textContent = 'DEGREE REVOKED';
            resBadge.className = 'text-xs font-bold px-3 py-1 rounded bg-red-100 text-red-800 border border-red-200';
          }

          resDegrees.innerHTML = `
            <div class="p-4 bg-slate-50 rounded border border-slate-200 text-xs space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-900">${deg.degree_name} &bull; ${deg.specialization}</span>
                <span class="font-mono text-slate-600">Graduation: ${deg.year_of_passing} (CGPA: ${deg.cgpa})</span>
              </div>
              <div class="text-slate-600">Authority: ${deg.issuing_authority}</div>
              <div class="text-[11px] font-mono text-slate-500">SHA-256 Hash: ${deg.digital_signature_hash}</div>
              ${deg.revocation_reason ? `<div class="p-2 bg-red-50 text-red-800 border border-red-200 rounded font-semibold text-[11px]">Revocation Reason: ${deg.revocation_reason}</div>` : ''}
            </div>
          `;
        } else {
          resTitle.textContent = 'Candidate Enrollment Record Found';
          resBadge.textContent = 'ENROLLED (NO DEGREE YET)';
          resBadge.className = 'text-xs font-bold px-3 py-1 rounded bg-blue-100 text-blue-800 border border-blue-200';
          resDegrees.innerHTML = `<div class="p-3 bg-slate-50 rounded border border-slate-200 text-xs text-slate-700">Student is currently enrolled; degree record has not yet been issued by affiliating university.</div>`;
        }

        window.showToast(`Candidate verified successfully (${elapsed} ms edge response).`, 'success');
      } catch (err) {
        window.showToast('Verification endpoint error. Please check network connection.', 'error');
      }
    });
  </script>
</Layout>
