---
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;
const url = Astro.url;
const redirectParam = url.searchParams.get('redirect') || '';
const reason = url.searchParams.get('reason') || '';
const errorParam = url.searchParams.get('error') || '';

const defaultRedirect = redirectParam && redirectParam.startsWith('/') && !redirectParam.startsWith('/login')
  ? redirectParam
  : '';

const quickSwitchRoles = [
  {
    role: 'AICTE_ADMIN',
    roleLabel: 'AICTE Regulatory Council',
    username: 'aicte.officer',
    password: 'Aicte@2026!',
    target: '/aicte',
    name: 'Dr. S. K. Mahajan',
    badge: 'All-India',
    badgeColor: 'bg-amber-50 text-amber-900 border-amber-300',
    description: 'National surveillance, duplicate triage & intake overrun alerts',
  },
  {
    role: 'INSTITUTE_ADMIN',
    roleLabel: 'Institution Admin (Principal)',
    username: 'principal.pune',
    password: 'Pune@2026!',
    target: '/institution',
    name: 'Dr. Ramesh Joshi',
    badge: 'Tenant: INST-001',
    badgeColor: 'bg-blue-50 text-blue-900 border-blue-300',
    description: 'Dynamic intake quota lock & client-side APAAR roster upload',
  },
  {
    role: 'UNIVERSITY_ADMIN',
    roleLabel: 'Affiliating University',
    username: 'registrar.univ',
    password: 'Univ@2026!',
    target: '/university',
    name: 'Prof. K. Venkatesh',
    badge: 'University',
    badgeColor: 'bg-purple-50 text-purple-900 border-purple-300',
    description: 'Ed25519 degree signing & immutable revocation ledger',
  },
  {
    role: 'STUDENT',
    roleLabel: 'Student Consent (DPDP)',
    username: 'student.rahul',
    password: 'Rahul@2026!',
    target: '/student',
    name: 'Rahul Sharma',
    badge: 'APAAR Vault',
    badgeColor: 'bg-emerald-50 text-emerald-900 border-emerald-300',
    description: 'DPDP Section 6 explicit consent & FIDO2 WebAuthn passkey vault',
  },
  {
    role: 'VERIFIER',
    roleLabel: 'Verification Authority',
    username: 'verifier.gov',
    password: 'Verify@2026!',
    target: '/verifier',
    name: 'Vikramaditya Rao',
    badge: 'Public Verifier',
    badgeColor: 'bg-sky-50 text-sky-900 border-sky-300',
    description: 'Instant Ed25519 degree & admission verification gateway',
  },
];
---

<Layout
  title="National Single Sign-On (Parichay / MeriPehchaan) | VIDYA Portal"
  activeRole="login"
  breadcrumb="Single Sign-On (Parichay Gateway)"
>
  <div class="max-w-6xl mx-auto">
    <!-- Notice Banners based on query params -->
    {reason === 'unauthorized' && (
      <div class="mb-5 p-4 rounded-lg bg-amber-50 border-l-4 border-amber-500 text-amber-900 text-xs shadow-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <div class="font-bold text-sm">Access Restricted: Insufficient Privileges or Session Expired</div>
          <p class="mt-0.5 text-amber-800">
            The requested administrative boundary requires specific Role-Based Access Control (RBAC) authorization. Please authenticate with an authorized Parichay / APAAR account.
          </p>
        </div>
      </div>
    )}

    {reason === 'logged_out' && (
      <div class="mb-5 p-4 rounded-lg bg-emerald-50 border-l-4 border-emerald-600 text-emerald-900 text-xs shadow-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <div>
          <div class="font-bold text-sm">Session Successfully Terminated</div>
          <p class="mt-0.5 text-emerald-800">
            Your cryptographic authentication session token has been invalidated across the National Academic Data Gateway.
          </p>
        </div>
      </div>
    )}

    {errorParam && (
      <div class="mb-5 p-4 rounded-lg bg-red-50 border-l-4 border-red-600 text-red-900 text-xs shadow-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <div>
          <div class="font-bold text-sm">Authentication Error</div>
          <p class="mt-0.5 text-red-800">{decodeURIComponent(errorParam)}</p>
        </div>
      </div>
    )}

    {user && (
      <div class="mb-5 p-4 rounded-lg bg-blue-50 border border-blue-200 text-blue-900 text-xs shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <div>
            <div class="font-bold text-sm text-[#0F2942]">Active Parichay Session Detected</div>
            <div class="text-slate-700 mt-0.5">
              Authenticated as <strong class="font-mono text-[#0F2942]">{user.username}</strong> ({user.full_name}) &bull; Role: <strong class="uppercase">{user.role}</strong>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a
            href={quickSwitchRoles.find(r => r.role === user.role)?.target || '/'}
            class="px-3.5 py-2 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-semibold transition-colors text-xs"
          >
            Continue to Dashboard &rarr;
          </a>
          <a
            href="/api/auth/logout"
            class="px-3 py-2 rounded bg-white hover:bg-red-50 text-red-700 border border-red-200 font-semibold transition-colors text-xs"
          >
            Sign Out
          </a>
        </div>
      </div>
    )}

    <!-- Authentic Two-Column National Single Sign-On Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <!-- Left Column (7 cols): Official Officer & Student Sign-In Card -->
      <div class="lg:col-span-7 bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between">
        <!-- Top Official NIC Parichay / MeriPehchaan Identity Strip -->
        <div>
          <div class="bg-[#0F2942] text-white px-6 py-4 border-b-2 border-[#FF9933] flex items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
              <div class="bg-white rounded p-1.5 shrink-0 shadow-sm">
                <img
                  src="/emblem.svg"
                  alt="State Emblem of India"
                  class="h-8 w-auto object-contain"
                  width="24"
                  height="32"
                />
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-[11px] font-bold uppercase tracking-widest text-[#FF9933]">
                    NIC Parichay &bull; MeriPehchaan
                  </span>
                  <span class="hidden sm:inline-block text-slate-400 text-[10px]">|</span>
                  <span class="hidden sm:inline-block text-[10px] font-medium text-slate-300">
                    GIGW 3.0 Certified
                  </span>
                </div>
                <h1 class="text-base sm:text-lg font-bold tracking-tight text-white mt-0.5">
                  National Academic Depository &amp; AICTE Single Sign-On
                </h1>
              </div>
            </div>
            <div class="hidden sm:flex flex-col items-end shrink-0">
              <span class="inline-flex items-center gap-1.5 bg-emerald-950/90 text-emerald-300 border border-emerald-700/80 px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Level-3 Assurance
              </span>
              <span class="text-[10px] text-slate-300 mt-1 font-mono">e-Pramaan SSO v4.2</span>
            </div>
          </div>

          <div class="p-6 sm:p-7">
            <div class="mb-5 pb-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2">
              <div>
                <h2 class="text-sm font-bold text-[#0F2942] uppercase tracking-wider">
                  Officer &amp; Student Credential Sign-In
                </h2>
                <p class="text-xs text-slate-600 mt-0.5">
                  Enter your official NIC Parichay handle, institutional ID, or 12-digit APAAR student identifier.
                </p>
              </div>
              <span class="text-[11px] font-semibold text-blue-800 bg-blue-50 border border-blue-200 px-2.5 py-1 rounded">
                RBAC Auto-Routed
              </span>
            </div>

            <form id="formalLoginForm" action="/api/auth/login" method="POST" class="space-y-5">
              <input type="hidden" name="redirect" id="formRedirect" value={defaultRedirect} />
              <input type="hidden" id="roleSelector" name="role" value="" />

              <!-- Username Input -->
              <div>
                <label for="usernameInput" class="block text-sm font-bold text-slate-800 mb-1.5">
                  Official Username / APAAR ID <span class="text-red-600">*</span>
                </label>
                <div class="relative">
                  <input
                    type="text"
                    id="usernameInput"
                    name="username"
                    required
                    autocomplete="username"
                    placeholder="e.g. aicte.officer, principal.pune, or student.rahul"
                    class="w-full h-11 bg-slate-50 border border-slate-300 rounded py-2.5 px-3.5 font-mono text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F2942] focus:border-transparent transition-all"
                  />
                </div>
                <p class="text-xs text-slate-500 mt-1.5">
                  Administrative domain and tenant isolation boundaries are automatically resolved from your verified account.
                </p>
              </div>

              <!-- Password Input -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="passwordInput" class="block text-sm font-bold text-slate-800">
                    Statutory Passcode <span class="text-red-600">*</span>
                  </label>
                  <button
                    type="button"
                    id="togglePasswordBtn"
                    class="text-xs font-semibold text-[#1E40AF] hover:text-[#0F2942] hover:underline cursor-pointer"
                  >
                    Show Passcode
                  </button>
                </div>
                <div class="relative">
                  <input
                    type="password"
                    id="passwordInput"
                    name="password"
                    required
                    autocomplete="current-password"
                    placeholder="••••••••••••"
                    class="w-full h-11 bg-slate-50 border border-slate-300 rounded py-2.5 px-3.5 font-mono text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F2942] focus:border-transparent transition-all"
                  />
                </div>
                <p class="text-xs text-slate-500 mt-1.5">
                  Protected via PBKDF2-HMAC-SHA256 (100,000 iterations) with unique per-account cryptographic salt.
                </p>
              </div>

              <!-- Statutory IT Act 2000 & DPDP Act 2023 Notice Box -->
              <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-md text-xs text-slate-700 space-y-1">
                <div class="flex items-center gap-2 font-bold text-[#0F2942]">
                  <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span>Statutory Compliance Notice (IT Act 2000 &amp; DPDP Act 2023)</span>
                </div>
                <p class="leading-relaxed text-slate-600">
                  This is a restricted Government of India information system. All authentication attempts and session actions are logged with IP provenance under Section 43 &amp; 66 of the Information Technology Act, 2000 and the Digital Personal Data Protection Act, 2023.
                </p>
              </div>

              <div id="loginFeedback" class="hidden p-3 rounded text-xs"></div>

              <!-- Submit Button -->
              <button
                type="submit"
                id="loginSubmitBtn"
                class="w-full h-11 bg-[#0F2942] hover:bg-[#1E3A8A] text-white rounded font-bold text-sm tracking-wide shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-[#FF9933] flex items-center justify-center gap-2 cursor-pointer"
              >
                <svg class="w-4 h-4 text-[#FF9933]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
                <span id="btnText">Sign In with Parichay Gateway</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Bottom Card Footer Strip -->
        <div class="bg-slate-50 border-t border-slate-200 px-6 py-3 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>National Informatics Centre (NIC) Directory Sync Active</span>
          </div>
          <a href="/verifier" class="font-semibold text-[#0F2942] hover:underline">
            Public Verifier (No Login Required) &rarr;
          </a>
        </div>
      </div>

      <!-- Right Column (5 cols): Official Role Sandbox & Security Architecture -->
      <div class="lg:col-span-5 flex flex-col justify-between gap-5">
        <!-- Authorized Role Sandbox (1-Click Quick Sign-In) -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-slate-900 text-white px-5 py-3.5 border-b border-slate-800 flex items-center justify-between gap-2">
            <div>
              <div class="flex items-center gap-2">
                <span class="bg-[#FF9933] text-black text-[10px] font-extrabold uppercase px-2 py-0.5 rounded tracking-wider">
                  SIH 2026 Sandbox
                </span>
                <h2 class="text-sm font-bold tracking-tight text-white">
                  Authorized Role Sandbox (1-Click Quick Sign-In)
                </h2>
              </div>
              <p class="text-[11px] text-slate-300 mt-0.5">
                Pre-seeded statutory accounts for evaluating RBAC and tenant boundaries.
              </p>
            </div>
          </div>

          <div class="divide-y divide-slate-200">
            {quickSwitchRoles.map((item) => (
              <div class="p-3.5 hover:bg-slate-50/90 transition-colors flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center flex-wrap gap-1.5">
                    <span class="font-bold text-slate-900 text-xs sm:text-sm truncate">
                      {item.roleLabel}
                    </span>
                    <span class={`text-[10px] font-bold px-2 py-0.5 rounded border uppercase tracking-wider ${item.badgeColor}`}>
                      {item.badge}
                    </span>
                  </div>
                  <div class="text-xs text-slate-600 mt-0.5 flex items-center gap-1.5 truncate">
                    <span class="font-medium text-slate-800">{item.name}</span>
                    <span class="text-slate-300">&bull;</span>
                    <code class="font-mono text-[11px] text-slate-500">{item.username}</code>
                  </div>
                  <p class="text-[11px] text-slate-500 mt-0.5 truncate">
                    {item.description}
                  </p>
                </div>

                <div class="flex items-center gap-1.5 shrink-0">
                  <button
                    type="button"
                    data-fill-username={item.username}
                    data-fill-password={item.password}
                    class="btn-fill-form px-2.5 py-1.5 rounded border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 text-[11px] font-semibold transition-colors cursor-pointer"
                    title={`Fill credentials for ${item.username}`}
                  >
                    Fill Form
                  </button>
                  <button
                    type="button"
                    data-username={item.username}
                    data-password={item.password}
                    data-role={item.role}
                    data-target={item.target}
                    class="btn-quick-login px-3 py-1.5 bg-[#0F2942] hover:bg-[#1E3A8A] text-white rounded text-xs font-bold shadow-sm transition-all flex items-center gap-1 cursor-pointer whitespace-nowrap"
                  >
                    <span>1-Click Sign In</span>
                    <span>&rarr;</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Compact Security & Session Architecture Card -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm p-5 text-xs space-y-3">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
            <div class="font-bold text-[#0F2942] uppercase tracking-wider text-xs flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span>Security &amp; Session Architecture</span>
            </div>
            <span class="text-[10px] font-mono bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded font-semibold">
              D1 Edge Enforced
            </span>
          </div>
          <ul class="space-y-2 text-slate-600 text-xs">
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold shrink-0">✓</span>
              <span><strong class="text-slate-800">PBKDF2-SHA256 Key Derivation:</strong> Passcodes are salted and hashed with 100,000 iterations via Web Crypto API.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold shrink-0">✓</span>
              <span><strong class="text-slate-800">HttpOnly Session Token:</strong> Stateful sessions persisted in Cloudflare D1 with <code class="font-mono text-[11px] bg-slate-100 px-1 rounded">HttpOnly; SameSite=Lax</code> cookies.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold shrink-0">✓</span>
              <span><strong class="text-slate-800">Strict Tenant Isolation:</strong> Institutional principals are cryptographically bound to their AICTE <code class="font-mono text-[11px] bg-slate-100 px-1 rounded">institution_id</code>.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Toggle password visibility
  const toggleBtn = document.getElementById('togglePasswordBtn');
  const passInput = document.getElementById('passwordInput') as HTMLInputElement | null;
  const userInput = document.getElementById('usernameInput') as HTMLInputElement | null;

  if (toggleBtn && passInput) {
    toggleBtn.addEventListener('click', () => {
      const isPass = passInput.type === 'password';
      passInput.type = isPass ? 'text' : 'password';
      toggleBtn.textContent = isPass ? 'Hide Passcode' : 'Show Passcode';
    });
  }

  // Fill Form helper buttons
  const fillButtons = document.querySelectorAll('.btn-fill-form');
  fillButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const u = target.getAttribute('data-fill-username') || '';
      const p = target.getAttribute('data-fill-password') || '';
      if (userInput && passInput) {
        userInput.value = u;
        passInput.value = p;
        userInput.focus();
      }
    });
  });

  // 1-Click Quick-Switch Buttons
  const quickButtons = document.querySelectorAll('.btn-quick-login');
  quickButtons.forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const username = target.getAttribute('data-username') || '';
      const password = target.getAttribute('data-password') || '';
      const role = target.getAttribute('data-role') || '';
      const destination = target.getAttribute('data-target') || '/';

      const originalHtml = target.innerHTML;
      target.disabled = true;
      target.innerHTML = `<span class="animate-spin inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full"></span> <span>Signing In...</span>`;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({ username, password, role, redirect: destination }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = data.redirect || destination;
        } else {
          alert('Login failed: ' + (data.error || 'Unknown error'));
          target.disabled = false;
          target.innerHTML = originalHtml;
        }
      } catch (err: any) {
        alert('Network error while authenticating: ' + err.message);
        target.disabled = false;
        target.innerHTML = originalHtml;
      }
    });
  });

  // Client-side form handler for smooth feedback
  const loginForm = document.getElementById('formalLoginForm') as HTMLFormElement | null;
  const loginFeedback = document.getElementById('loginFeedback');
  const loginSubmitBtn = document.getElementById('loginSubmitBtn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btnText');

  if (loginForm && loginFeedback && loginSubmitBtn && btnText) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginFeedback.className = 'hidden';
      loginSubmitBtn.disabled = true;
      btnText.textContent = 'Verifying Credentials with Parichay Gateway...';

      const formData = new FormData(loginForm);
      const payload: Record<string, any> = {};
      formData.forEach((val, key) => {
        payload[key] = val;
      });

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          loginFeedback.className = 'p-3 rounded text-xs bg-emerald-50 border border-emerald-300 text-emerald-800 font-medium';
          loginFeedback.textContent = 'Authentication successful! Redirecting to authorized portal...';
          btnText.textContent = 'Redirecting...';
          window.location.href = data.redirect || '/';
        } else {
          loginFeedback.className = 'p-3 rounded text-xs bg-red-50 border border-red-300 text-red-800 font-medium';
          loginFeedback.textContent = data.error || 'Authentication rejected by security policy.';
          loginSubmitBtn.disabled = false;
          btnText.textContent = 'Sign In with Parichay Gateway';
        }
      } catch (err: any) {
        loginFeedback.className = 'p-3 rounded text-xs bg-red-50 border border-red-300 text-red-800 font-medium';
        loginFeedback.textContent = 'Network or server communication failure: ' + err.message;
        loginSubmitBtn.disabled = false;
        btnText.textContent = 'Sign In with Parichay Gateway';
      }
    });
  }
</script>
