---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution, Degree, Student } from '../lib/types';
import { maskApaar, maskName } from '../lib/types';

const db = getDB(Astro.locals);

const instRes = await db.prepare('SELECT * FROM institutions').bind().all<Institution>();
const institutions = instRes.results || [];

const degRes = await db.prepare('SELECT * FROM degrees ORDER BY issued_at DESC').bind().all<Degree & { signing_key_id?: string }>();
const rawDegrees = degRes.results || [];

const stuRes = await db.prepare('SELECT * FROM students').bind().all<Student>();
const students = stuRes.results || [];

const degrees = rawDegrees.map((d) => {
  const st = students.find((s) => s.apaar_id === d.apaar_id);
  const inst = institutions.find((i) => i.id === d.institution_id);
  return {
    ...d,
    student_name: st?.full_name ? maskName(st.full_name) : 'Candidate ' + d.apaar_id.slice(-4),
    institution_name: inst?.name || d.institution_id,
  };
});

interface UnivAbcLedgerRow {
  apaar_id: string;
  student_name: string;
  program: string;
  accumulated_credits: number;
  nep_threshold_badge: string;
  entry_mode: string;
  prior_diploma_board: string;
  transferred_credits: number;
  verification_status: 'VERIFIED_ANCHORED' | 'STANDARD_DIRECT' | 'FRAUD_REVOKED';
}

const univAbcLedger: UnivAbcLedgerRow[] = [
  {
    apaar_id: '412398471029',
    student_name: maskName('Sneha Sundaram'),
    program: 'B.Tech Computer Science & Engineering',
    accumulated_credits: 160,
    nep_threshold_badge: '160 Cr — 4-Yr B.Tech Honours (Exit Year 4)',
    entry_mode: '1st-Year Regular (10+2 PCM)',
    prior_diploma_board: 'N/A (All 8 Semesters Earned at INST-001)',
    transferred_credits: 0,
    verification_status: 'STANDARD_DIRECT',
  },
  {
    apaar_id: '739284019283',
    student_name: maskName('Rahul Sharma'),
    program: 'B.Tech Computer Science & Engineering',
    accumulated_credits: 120,
    nep_threshold_badge: "120 Cr — 3-Yr Bachelor's Eligible (Exit Year 3)",
    entry_mode: '2nd-Year Lateral Entry (Sem 3 Direct)',
    prior_diploma_board: 'MSBTE State Polytechnic Diploma (80 ABC Credits Anchored)',
    transferred_credits: 80,
    verification_status: 'VERIFIED_ANCHORED',
  },
  {
    apaar_id: '582910384729',
    student_name: maskName('Priya Verma'),
    program: 'B.Tech Electronics & Comm.',
    accumulated_credits: 80,
    nep_threshold_badge: '80 Cr — UG Diploma / Lateral Entry Eligible (Exit Year 2)',
    entry_mode: '2nd-Year Lateral Entry (Sem 3 Direct)',
    prior_diploma_board: 'DTE Karnataka Polytechnic Diploma (80 ABC Credits Anchored)',
    transferred_credits: 80,
    verification_status: 'VERIFIED_ANCHORED',
  },
  {
    apaar_id: '901238471920',
    student_name: maskName('Aaditya Patel'),
    program: 'B.Tech Mechanical Engineering',
    accumulated_credits: 40,
    nep_threshold_badge: '40 Cr — UG Certificate Eligible (Exit Year 1)',
    entry_mode: '1st-Year Regular (10+2 PCM)',
    prior_diploma_board: 'N/A (Semesters 1–2 Completed at INST-001)',
    transferred_credits: 0,
    verification_status: 'STANDARD_DIRECT',
  },
  {
    apaar_id: '601928374819',
    student_name: maskName('Vikram Malhotra'),
    program: 'B.Tech Civil Engineering',
    accumulated_credits: 120,
    nep_threshold_badge: 'REVOKED — Unverified Lateral Entry Credit Transfer',
    entry_mode: '2nd-Year Lateral Entry (Disputed)',
    prior_diploma_board: 'Unverified Private Diploma (Missing APAAR / ABC Anchor)',
    transferred_credits: 80,
    verification_status: 'FRAUD_REVOKED',
  },
];
---

<Layout title="SIH 2026 | Affiliating University Degree Provenance" activeRole="university">
  <div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-slate-200 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="text-xs font-bold text-[#1E40AF] uppercase tracking-wider mb-1">
          Affiliating University Module &bull; Code UNIV-03
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942]">
          Academic Degree Provenance &amp; Revocation Ledger
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          Permanent degree anchoring to student APAAR IDs with Ed25519 asymmetric signatures, NEP 2020 ABC Lateral-Entry credit validation &amp; Section 63 BSA Merkle audit.
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="#issueDegreeSection"
          class="h-10 px-4 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white text-xs sm:text-sm font-semibold transition-colors inline-flex items-center gap-2 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Issue Degree Record
        </a>
      </div>
    </div>

    <!-- Affiliated Institutions Status -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {institutions.map((i) => (
        <div class="bg-white border border-slate-200 rounded p-4 sm:p-5 shadow-sm">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-xs font-mono font-bold text-slate-700">{i.code}</span>
            <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded border ${i.current_enrollment > i.sanctioned_intake ? 'bg-red-100 text-red-800 border-red-200' : 'bg-emerald-100 text-emerald-800 border-emerald-200'}`}>
              {i.current_enrollment > i.sanctioned_intake ? 'OVERRUN DETECTED' : 'AFFILIATED'}
            </span>
          </div>
          <h3 class="text-xs sm:text-sm font-bold text-slate-900 truncate">{i.name}</h3>
          <div class="mt-2.5 flex items-center justify-between text-xs text-slate-500 font-mono">
            <span>Enrolled: <strong class="text-slate-800">{i.current_enrollment} / {i.sanctioned_intake}</strong></span>
            <span>Risk Score: <strong class="text-slate-800">{i.risk_score}%</strong></span>
          </div>
        </div>
      ))}
    </div>

    <!-- Degrees Ledger Table -->
    <div class="bg-white border border-slate-200 rounded shadow-sm">
      <div class="p-4 sm:p-5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-xs sm:text-sm font-bold text-[#0F2942] uppercase tracking-wider">
            1. University Degree Registry ({degrees.length} Records in Central D1)
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Each degree is cryptographically bound to a 12-digit APAAR with an Ed25519 Signature &amp; SHA-256 Stamp.
          </p>
        </div>
        <span class="text-xs font-mono font-semibold bg-blue-50 text-blue-800 border border-blue-200 px-2.5 py-1 rounded">
          Ed25519 + SHA-256 Anchored
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">Degree ID</th>
              <th class="py-3 px-4">Candidate &amp; APAAR (Masked)</th>
              <th class="py-3 px-4">Degree &amp; Specialization</th>
              <th class="py-3 px-4">Graduation</th>
              <th class="py-3 px-4">Registry Status</th>
              <th class="py-3 px-4">Ed25519 Signature &amp; SHA-256 Stamp</th>
              <th class="py-3 px-4 text-right">Administrative Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-800">
            {degrees.map((d) => (
              <tr class="hover:bg-slate-50">
                <td class="py-3.5 px-4 font-mono font-bold text-slate-900">{d.id}</td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-900">{d.student_name}</div>
                  <div class="text-xs font-mono text-slate-500">{maskApaar(d.apaar_id)}</div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-900">{d.degree_name}</div>
                  <div class="text-xs text-slate-500">{d.specialization}</div>
                </td>
                <td class="py-3.5 px-4 font-mono">
                  <div class="font-semibold text-slate-800">CGPA: {d.cgpa}</div>
                  <div class="text-xs text-slate-500">Year: {d.year_of_passing}</div>
                </td>
                <td class="py-3.5 px-4">
                  {d.status === 'ISSUED' ? (
                    <span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded text-xs border border-emerald-200">
                      ISSUED (VALID)
                    </span>
                  ) : (
                    <div>
                      <span class="bg-red-100 text-red-800 font-bold px-2.5 py-0.5 rounded text-xs border border-red-200">
                        REVOKED
                      </span>
                      {d.revocation_reason && (
                        <div class="text-[11px] text-red-700 font-medium mt-1 max-w-xs leading-tight">
                          {d.revocation_reason}
                        </div>
                      )}
                    </div>
                  )}
                </td>
                <td class="py-3.5 px-4 max-w-xs">
                  <div class="flex items-center gap-1.5 mb-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-indigo-50 text-indigo-800 border border-indigo-200">
                      {d.signing_key_id || 'Ed25519 Signed'}
                    </span>
                  </div>
                  <div class="font-mono text-[11px] text-slate-500 truncate" title={d.digital_signature_hash}>
                    {d.digital_signature_hash.slice(0, 24)}...
                  </div>
                </td>
                <td class="py-3.5 px-4 text-right">
                  {d.status === 'ISSUED' ? (
                    <button
                      type="button"
                      onclick={`revokeDegreePrompt('${d.id}', '${d.student_name}', '${d.degree_name}')`}
                      class="px-3 py-1.5 rounded bg-red-50 hover:bg-red-100 border border-red-300 text-red-700 font-semibold text-xs transition-colors"
                    >
                      Revoke Degree
                    </button>
                  ) : (
                    <button
                      type="button"
                      onclick={`reinstateDegreePrompt('${d.id}', '${d.student_name}', '${d.degree_name}')`}
                      class="px-3 py-1.5 rounded bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-700 font-semibold text-xs transition-colors"
                    >
                      Reinstate Degree
                    </button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FEATURE #3: NEP 2020 Academic Bank of Credits (ABC) & Multiple Entry/Exit Ledger -->
    <div class="bg-white border border-slate-200 border-t-4 border-t-[#138808] rounded shadow-sm">
      <div class="p-4 sm:p-5 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded">
              <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>NEP 2020 Multiple Entry / Exit &amp; NCrF</span>
            </span>
            <span class="text-[11px] font-mono font-semibold bg-amber-50 text-amber-900 border border-amber-200 px-2.5 py-0.5 rounded">
              2nd-Year Lateral Entry Credit Transfer Guard
            </span>
          </div>
          <h2 class="text-sm sm:text-base font-bold text-[#0F2942]">
            2. NEP 2020 Academic Bank of Credits (ABC) &amp; Multiple Entry/Exit Ledger
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Maps candidate credit accumulation (<strong class="text-slate-700">0 to 160 Credits</strong>) against NEP 2020 statutory awards and verifies prior Polytechnic Diploma credits anchored to 12-digit APAAR IDs.
          </p>
        </div>

        <!-- NEP 2020 4 Threshold Pills -->
        <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-mono font-bold shrink-0">
          <span class="px-2.5 py-1 rounded bg-slate-100 text-slate-800 border border-slate-300">40 Cr: UG Cert (Yr 1)</span>
          <span class="px-2.5 py-1 rounded bg-blue-50 text-blue-900 border border-blue-200">80 Cr: UG Diploma / Lateral (Yr 2)</span>
          <span class="px-2.5 py-1 rounded bg-indigo-50 text-indigo-900 border border-indigo-200">120 Cr: Bachelor's (Yr 3)</span>
          <span class="px-2.5 py-1 rounded bg-emerald-50 text-emerald-900 border border-emerald-200">160 Cr: B.Tech Honours (Yr 4)</span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead class="bg-slate-100 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">Candidate &amp; APAAR</th>
              <th class="py-3 px-4">ABC Credit Accumulation (0–160 Cr)</th>
              <th class="py-3 px-4">NEP 2020 Award / Exit Eligibility</th>
              <th class="py-3 px-4">Lateral-Entry Credit Transfer Provenance</th>
              <th class="py-3 px-4 text-right">Audit Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-800">
            {univAbcLedger.map((row) => {
              const pct = Math.min(100, Math.round((row.accumulated_credits / 160) * 100));
              const isFraud = row.verification_status === 'FRAUD_REVOKED';
              const isLateralVerified = row.verification_status === 'VERIFIED_ANCHORED';
              return (
                <tr class={isFraud ? 'bg-red-50/40 hover:bg-red-50/70' : 'hover:bg-slate-50'}>
                  <td class="py-3.5 px-4">
                    <div class="font-bold text-slate-900">{row.student_name}</div>
                    <div class="text-xs font-mono text-slate-500">{maskApaar(row.apaar_id)} &bull; {row.program}</div>
                  </td>
                  <td class="py-3.5 px-4 min-w-[200px]">
                    <div class="flex justify-between text-xs font-mono mb-1">
                      <span class="font-bold text-[#0F2942]">{row.accumulated_credits} / 160 Credits</span>
                      <span class="text-slate-500">{pct}%</span>
                    </div>
                    <div class="w-full bg-slate-200 rounded-full h-2.5 border border-slate-300 overflow-hidden">
                      <div
                        class={`h-full ${isFraud ? 'bg-red-600' : 'bg-emerald-600'}`}
                        style={`width: ${pct}%;`}
                      ></div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class={`inline-block font-mono font-bold text-xs px-2.5 py-1 rounded border ${
                      isFraud
                        ? 'bg-red-100 text-red-900 border-red-200'
                        : 'bg-slate-100 text-[#0F2942] border-slate-300'
                    }`}>
                      {row.nep_threshold_badge}
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="font-semibold text-slate-900">{row.entry_mode}</div>
                    <div class="text-xs text-slate-600 mt-0.5">
                      {row.prior_diploma_board}
                      {row.transferred_credits > 0 && (
                        <span class="ml-1 font-mono font-bold text-[#0F2942]">
                          ({row.transferred_credits} Cr Transferred)
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    {isLateralVerified ? (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-emerald-100 text-emerald-900 border border-emerald-200 font-bold text-xs">
                        <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Lateral Credits Verified</span>
                      </span>
                    ) : isFraud ? (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-red-100 text-red-900 border border-red-200 font-bold text-xs">
                        <svg class="w-3.5 h-3.5 text-red-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        <span>Unverified Lateral Blocked</span>
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-blue-50 text-blue-900 border border-blue-200 font-bold text-xs">
                        <span>Regular Direct Entry</span>
                      </span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FEATURE #5: Section 63 BSA Cryptographic Hash-Chain & Merkle Audit Verifier -->
    <div class="bg-white border border-slate-200 border-t-4 border-t-[#0F2942] rounded p-5 sm:p-6 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-200 pb-4 mb-4">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider bg-indigo-50 text-indigo-900 border border-indigo-200 px-2.5 py-0.5 rounded">
              <svg class="w-3.5 h-3.5 text-indigo-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Bharatiya Sakshya Adhiniyam (BSA) 2023 Section 63</span>
            </span>
            <span class="text-[11px] font-mono font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded">
              Tamper-Evident SHA-256 Hash Chain
            </span>
          </div>
          <h2 class="text-sm sm:text-base font-bold text-[#0F2942]">
            3. Section 63 BSA Cryptographic Hash-Chain &amp; Merkle Audit Verifier
          </h2>
          <p class="text-xs text-slate-600 mt-0.5">
            Independently verifies that no university degree or institutional admission record has been altered in SQLite/D1 by recomputing <code class="font-mono text-[11px] bg-slate-100 px-1 py-0.5 rounded">SHA256(prev_hash + ":" + canonical_payload)</code> and the Merkle Root in the browser.
          </p>
        </div>

        <button
          type="button"
          id="verifyMerkleBtnUniv"
          class="shrink-0 h-10 px-4 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold text-xs sm:text-sm transition-colors inline-flex items-center gap-2 shadow-xs"
        >
          <svg class="w-4 h-4 text-emerald-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Verify Full Ledger Hash-Chain in Browser</span>
        </button>
      </div>

      <!-- Summary Status Strip -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 text-xs">
        <div class="p-3.5 bg-slate-50 rounded border border-slate-200">
          <div class="text-[10px] font-bold uppercase text-slate-500">Verification Status</div>
          <div id="merkleStatusTextUniv" class="font-bold text-slate-800 mt-1 flex items-center gap-1.5">
            <span>Ready for Client-Side Cryptographic Audit</span>
          </div>
        </div>
        <div class="p-3.5 bg-slate-50 rounded border border-slate-200">
          <div class="text-[10px] font-bold uppercase text-slate-500">Verified Merkle Root (SHA-256)</div>
          <div id="merkleRootTextUniv" class="font-mono font-bold text-[#0F2942] mt-1 truncate">
            Click "Verify Full Ledger Hash-Chain" to compute
          </div>
        </div>
        <div class="p-3.5 bg-slate-50 rounded border border-slate-200">
          <div class="text-[10px] font-bold uppercase text-slate-500">Total Ledger Blocks Verified</div>
          <div id="merkleBlockCountUniv" class="font-mono font-bold text-emerald-700 mt-1">
            -- Blocks (Institutions + Admissions + Degrees)
          </div>
        </div>
      </div>

      <!-- Individual Block Links Table -->
      <div id="merkleBlocksContainerUniv" class="hidden border border-slate-200 rounded overflow-hidden">
        <div class="bg-slate-100 px-4 py-2.5 border-b border-slate-200 flex items-center justify-between text-xs font-bold text-slate-700">
          <span>Cryptographic Block Chain Links (prev_hash to block_hash)</span>
          <span class="font-mono text-[11px] text-emerald-800">100% Browser Recomputed via crypto.subtle.digest('SHA-256')</span>
        </div>
        <div class="max-h-64 overflow-y-auto divide-y divide-slate-200 text-xs font-mono" id="merkleBlocksListUniv"></div>
      </div>
    </div>

    <!-- Issue Degree Section -->
    <div id="issueDegreeSection" class="bg-white border border-slate-200 rounded p-6 shadow-sm">
      <h2 class="text-xs sm:text-sm font-bold text-[#0F2942] uppercase tracking-wider mb-1.5">
        4. Issue New Degree Record
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mb-5">
        Bind academic degree to student 12-digit APAAR ID with cryptographic Ed25519 Signature &amp; SHA-256 Stamp.
      </p>

      <form id="issueDegreeForm" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-xs sm:text-sm">
        <div>
          <label for="degApaar" class="block font-semibold text-slate-700 mb-1.5">Candidate APAAR ID (12 Digits):</label>
          <input
            type="text"
            id="degApaar"
            required
            pattern="[0-9]{12}"
            placeholder="e.g. 901238471920"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 font-mono text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div>
          <label for="degInst" class="block font-semibold text-slate-700 mb-1.5">Affiliated Institution:</label>
          <select id="degInst" class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-600">
            {institutions.map((i) => (
              <option value={i.id}>{i.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="degName" class="block font-semibold text-slate-700 mb-1.5">Degree Title:</label>
          <input
            type="text"
            id="degName"
            value="Bachelor of Technology"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div>
          <label for="degSpec" class="block font-semibold text-slate-700 mb-1.5">Specialization Program:</label>
          <input
            type="text"
            id="degSpec"
            value="Computer Science & Engineering"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div>
          <label for="degCgpa" class="block font-semibold text-slate-700 mb-1.5">Cumulative CGPA (0.00 - 10.00):</label>
          <input
            type="number"
            id="degCgpa"
            step="0.01"
            min="0"
            max="10"
            value="8.75"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 font-mono text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div>
          <label for="degYear" class="block font-semibold text-slate-700 mb-1.5">Year of Passing:</label>
          <input
            type="number"
            id="degYear"
            value="2024"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 font-mono text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-600"
          />
        </div>

        <div class="sm:col-span-2 md:col-span-3 pt-2">
          <button
            type="submit"
            id="issueSubmitBtn"
            class="h-10 px-5 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm"
          >
            Authenticate &amp; Issue Degree to Central D1
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Accessible In-Page Modal Dialog for Statutory Degree Revocation -->
  <div
    id="revokeModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="revokeModalTitle"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4"
  >
    <div class="bg-white border border-slate-200 rounded-md shadow-xl max-w-lg w-full overflow-hidden">
      <div class="bg-red-50 border-b border-red-200 px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span>
          <h3 id="revokeModalTitle" class="text-sm sm:text-base font-bold text-red-950">
            Statutory Degree Revocation Order
          </h3>
        </div>
        <button
          type="button"
          id="closeRevokeModalBtn"
          aria-label="Close modal"
          class="text-slate-500 hover:text-slate-800 text-lg font-bold px-1"
        >
          &times;
        </button>
      </div>

      <div class="p-5 space-y-4 text-xs sm:text-sm">
        <div class="bg-slate-50 border border-slate-200 rounded p-3 font-mono text-xs text-slate-700">
          <div>Target Degree ID: <strong id="revokeTargetId" class="text-slate-900">DEG-001</strong></div>
          <div class="mt-0.5">Candidate Record: <strong id="revokeTargetCandidate" class="text-slate-900">Candidate</strong></div>
        </div>

        <div>
          <label for="revokeReasonSelect" class="block font-semibold text-slate-700 mb-1.5">
            Statutory Revocation Category:
          </label>
          <select
            id="revokeReasonSelect"
            class="w-full h-10 bg-slate-50 border border-slate-300 rounded px-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-600"
          >
            <option value="Academic Integrity Violation detected during AICTE quota inspection.">
              AICTE Quota Overrun / Unapproved Seat Admission
            </option>
            <option value="Concurrent dual-institution enrollment violation under UGC/AICTE norms.">
              Concurrent Dual-Institution Enrollment Anomaly
            </option>
            <option value="Fraudulent admission credentials or forged qualifying mark sheets.">
              Forged Qualifying Credentials / Discrepancy
            </option>
            <option value="University Executive Council disciplinary revocation order.">
              University Executive Council Disciplinary Order
            </option>
          </select>
        </div>

        <div>
          <label for="revokeReasonInput" class="block font-semibold text-slate-700 mb-1.5">
            Formal Statutory Reason (Recorded on Ledger):
          </label>
          <textarea
            id="revokeReasonInput"
            rows="3"
            class="w-full bg-white border border-slate-300 rounded p-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-600"
          >Academic Integrity Violation detected during AICTE quota inspection.</textarea>
        </div>
      </div>

      <div class="bg-slate-50 border-t border-slate-200 px-5 py-3.5 flex items-center justify-end gap-2.5">
        <button
          type="button"
          id="cancelRevokeBtn"
          class="h-10 px-4 rounded bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 font-semibold text-xs sm:text-sm transition-colors"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirmRevokeBtn"
          class="h-10 px-4 rounded bg-red-700 hover:bg-red-800 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm"
        >
          Confirm Revocation
        </button>
      </div>
    </div>
  </div>

  <!-- Accessible In-Page Modal Dialog for Degree Reinstatement -->
  <div
    id="reinstateModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reinstateModalTitle"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4"
  >
    <div class="bg-white border border-slate-200 rounded-md shadow-xl max-w-md w-full overflow-hidden">
      <div class="bg-emerald-50 border-b border-emerald-200 px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
          <h3 id="reinstateModalTitle" class="text-sm sm:text-base font-bold text-emerald-950">
            Reinstate Academic Degree Record
          </h3>
        </div>
        <button
          type="button"
          id="closeReinstateModalBtn"
          aria-label="Close modal"
          class="text-slate-500 hover:text-slate-800 text-lg font-bold px-1"
        >
          &times;
        </button>
      </div>

      <div class="p-5 space-y-3 text-xs sm:text-sm text-slate-700">
        <p class="leading-relaxed">
          Are you sure you want to reinstate degree <strong id="reinstateTargetId" class="font-mono text-slate-900">DEG-001</strong> (<span id="reinstateTargetCandidate" class="font-semibold">Candidate</span>) to <strong>ISSUED (VALID)</strong> status in the Central D1 Registry?
        </p>
        <p class="text-xs text-slate-500">
          This action restores employer verification validity immediately and logs an appellate clearance entry.
        </p>
      </div>

      <div class="bg-slate-50 border-t border-slate-200 px-5 py-3.5 flex items-center justify-end gap-2.5">
        <button
          type="button"
          id="cancelReinstateBtn"
          class="h-10 px-4 rounded bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 font-semibold text-xs sm:text-sm transition-colors"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirmReinstateBtn"
          class="h-10 px-4 rounded bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm"
        >
          Confirm Reinstatement
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    let activeDegreeId = null;

    const revokeModal = document.getElementById('revokeModal');
    const reinstateModal = document.getElementById('reinstateModal');
    const revokeReasonSelect = document.getElementById('revokeReasonSelect');
    const revokeReasonInput = document.getElementById('revokeReasonInput');

    revokeReasonSelect?.addEventListener('change', () => {
      if (revokeReasonInput) {
        revokeReasonInput.value = revokeReasonSelect.value;
      }
    });

    function revokeDegreePrompt(degreeId, studentName, degreeName) {
      activeDegreeId = degreeId;
      const idEl = document.getElementById('revokeTargetId');
      const candEl = document.getElementById('revokeTargetCandidate');
      if (idEl) idEl.textContent = degreeId;
      if (candEl) candEl.textContent = (studentName || 'Candidate') + (degreeName ? ' — ' + degreeName : '');
      if (revokeReasonInput && revokeReasonSelect) {
        revokeReasonInput.value = revokeReasonSelect.value;
      }
      revokeModal?.classList.remove('hidden');
      revokeModal?.classList.add('flex');
      revokeReasonInput?.focus();
    }

    function closeRevokeModal() {
      revokeModal?.classList.add('hidden');
      revokeModal?.classList.remove('flex');
      activeDegreeId = null;
    }

    function reinstateDegreePrompt(degreeId, studentName, degreeName) {
      activeDegreeId = degreeId;
      const idEl = document.getElementById('reinstateTargetId');
      const candEl = document.getElementById('reinstateTargetCandidate');
      if (idEl) idEl.textContent = degreeId;
      if (candEl) candEl.textContent = (studentName || 'Candidate') + (degreeName ? ' — ' + degreeName : '');
      reinstateModal?.classList.remove('hidden');
      reinstateModal?.classList.add('flex');
    }

    function closeReinstateModal() {
      reinstateModal?.classList.add('hidden');
      reinstateModal?.classList.remove('flex');
      activeDegreeId = null;
    }

    document.getElementById('closeRevokeModalBtn')?.addEventListener('click', closeRevokeModal);
    document.getElementById('cancelRevokeBtn')?.addEventListener('click', closeRevokeModal);
    document.getElementById('closeReinstateModalBtn')?.addEventListener('click', closeReinstateModal);
    document.getElementById('cancelReinstateBtn')?.addEventListener('click', closeReinstateModal);

    document.getElementById('confirmRevokeBtn')?.addEventListener('click', async () => {
      if (!activeDegreeId) return;
      const reason = revokeReasonInput?.value?.trim();
      if (!reason) {
        window.showToast('Please provide a formal statutory reason for revocation.', 'warning');
        return;
      }

      const btn = document.getElementById('confirmRevokeBtn');
      if (btn) btn.disabled = true;

      try {
        const res = await fetch('/api/university/degree', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            degreeId: activeDegreeId,
            action: 'REVOKE',
            reason: reason,
          }),
        });
        const data = await res.json();
        if (data.success) {
          closeRevokeModal();
          window.showToast('Degree record marked REVOKED in Central D1 Registry.', 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          window.showToast('Revocation failed: ' + (data.error || 'Server error'), 'error');
        }
      } catch (err) {
        window.showToast('Network error processing revocation.', 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    document.getElementById('confirmReinstateBtn')?.addEventListener('click', async () => {
      if (!activeDegreeId) return;
      const btn = document.getElementById('confirmReinstateBtn');
      if (btn) btn.disabled = true;

      try {
        const res = await fetch('/api/university/degree', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            degreeId: activeDegreeId,
            action: 'REINSTATE',
          }),
        });
        const data = await res.json();
        if (data.success) {
          closeReinstateModal();
          window.showToast('Degree record REINSTATED in Central D1 Registry.', 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          window.showToast('Reinstatement failed: ' + (data.error || 'Server error'), 'error');
        }
      } catch (err) {
        window.showToast('Network error processing reinstatement.', 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    document.getElementById('issueDegreeForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const apaar = document.getElementById('degApaar').value.trim();
      const inst = document.getElementById('degInst').value;
      const name = document.getElementById('degName').value.trim();
      const spec = document.getElementById('degSpec').value.trim();
      const cgpa = parseFloat(document.getElementById('degCgpa').value);
      const year = parseInt(document.getElementById('degYear').value);

      try {
        const res = await fetch('/api/university/degree', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            apaar_id: apaar,
            institution_id: inst,
            degree_name: name,
            specialization: spec,
            cgpa: cgpa,
            year_of_passing: year,
            issuing_authority: 'State Technological Affiliating University',
          }),
        });

        const data = await res.json();
        if (data.success) {
          window.showToast('Degree issued to Central D1 Registry with Ed25519 Signature & SHA-256 Stamp.', 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          window.showToast('Issuance error: ' + (data.error || 'Server error'), 'error');
        }
      } catch (err) {
        window.showToast('Network error issuing degree.', 'error');
      }
    });

    // Browser SHA-256 helper for Section 63 BSA Merkle Audit Verifier
    async function sha256Univ(text) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }

    async function computeMerkleRootUniv(hashes) {
      if (!hashes || hashes.length === 0) return sha256Univ('VIDYA-EMPTY-LEDGER');
      let level = [...hashes];
      while (level.length > 1) {
        const next = [];
        for (let i = 0; i < level.length; i += 2) {
          const left = level[i];
          const right = i + 1 < level.length ? level[i + 1] : left;
          next.push(await sha256Univ(left + ':' + right));
        }
        level = next;
      }
      return level[0];
    }

    const verifyMerkleBtnUniv = document.getElementById('verifyMerkleBtnUniv');
    verifyMerkleBtnUniv?.addEventListener('click', async () => {
      verifyMerkleBtnUniv.disabled = true;
      const statusEl = document.getElementById('merkleStatusTextUniv');
      const rootEl = document.getElementById('merkleRootTextUniv');
      const countEl = document.getElementById('merkleBlockCountUniv');
      const containerEl = document.getElementById('merkleBlocksContainerUniv');
      const listEl = document.getElementById('merkleBlocksListUniv');

      if (statusEl) statusEl.textContent = 'Recomputing SHA-256 Hash-Chain in Browser...';

      try {
        const res = await fetch('/api/ledger/merkle');
        const data = await res.json();
        if (!data.success || !Array.isArray(data.blocks)) {
          throw new Error(data.error || 'Failed to load ledger blocks');
        }

        let prev = data.genesis_prev_hash;
        let allValid = true;
        const computedHashes = [];
        let rowsHtml = '';

        for (const blk of data.blocks) {
          const expectedHash = await sha256Univ(prev + ':' + blk.canonical_payload);
          const linkMatches = expectedHash === blk.block_hash && prev === blk.prev_hash;
          if (!linkMatches) allValid = false;
          computedHashes.push(expectedHash);

          rowsHtml += `
            <div class="p-3 bg-white hover:bg-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-[#0F2942] font-bold border border-slate-300">#${blk.index} ${blk.block_type}</span>
                  <span class="font-sans font-semibold text-slate-800">${blk.summary}</span>
                </div>
                <div class="text-[11px] text-slate-500 mt-1">
                  prev: <span class="text-slate-700">${blk.prev_hash.slice(0, 16)}...</span> &rarr;
                  hash: <span class="text-[#0F2942] font-bold">${expectedHash.slice(0, 20)}...</span>
                </div>
              </div>
              <span class="px-2.5 py-0.5 rounded text-[10px] font-bold border shrink-0 ${
                linkMatches
                  ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
                  : 'bg-red-100 text-red-800 border-red-200'
              }">
                ${linkMatches ? 'SHA-256 LINK VERIFIED' : 'TAMPER DETECTED'}
              </span>
            </div>
          `;
          prev = expectedHash;
        }

        const browserMerkleRoot = await computeMerkleRootUniv(computedHashes);
        const rootMatches = browserMerkleRoot === data.merkle_root;

        if (statusEl) {
          statusEl.innerHTML =
            allValid && rootMatches
              ? `<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg><span class="text-emerald-800">TAMPER-FREE VERIFIED (Section 63 BSA Compliant)</span>`
              : `<span class="text-red-700">HASH DISCREPANCY DETECTED</span>`;
        }
        if (rootEl) {
          rootEl.textContent = browserMerkleRoot;
          rootEl.title = browserMerkleRoot;
        }
        if (countEl) {
          countEl.textContent = `${data.blocks.length} Blocks Verified (${data.counts.institutions} Inst, ${data.counts.admissions} Adm, ${data.counts.degrees} Deg)`;
        }
        if (listEl && containerEl) {
          listEl.innerHTML = rowsHtml;
          containerEl.classList.remove('hidden');
        }
        window.showToast?.(
          `Verified ${data.blocks.length} cryptographic ledger blocks. Merkle Root: ${browserMerkleRoot.slice(0, 16)}...`,
          'success'
        );
      } catch (err) {
        if (statusEl) statusEl.textContent = 'Verification failed: ' + (err?.message || 'Error');
        window.showToast?.('Error verifying Merkle ledger', 'error');
      } finally {
        verifyMerkleBtnUniv.disabled = false;
      }
    });
  </script>
</Layout>
