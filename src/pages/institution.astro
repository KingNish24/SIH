                  class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                >
                  <option value="B.Tech Computer Science">B.Tech Computer Science (CSE-101 · Cap: 60)</option>
                  <option value="B.Tech Electronics & Comm.">B.Tech Electronics &amp; Comm. (ECE-102 · Cap: 60)</option>
                  <option value="B.Tech Mechanical Engg">B.Tech Mechanical Engg (MECH-103 · Cap: 60)</option>
                </select>
