---
import Layout from '../layouts/Layout.astro';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const t = getUIDictionary(lang);

const url = Astro.url;
const queryApaar = url.searchParams.get('apaar')?.trim() || '';
const queryInst = url.searchParams.get('institution')?.trim() || '';
const initialApaar = /^\d{12}$/.test(queryApaar) ? queryApaar : '';
const initialOrg = queryInst
  ? `Institutional Audit (${queryInst}) — National Recruitment / Admissions`
  : '';
---

<Layout
  title={`SIH 2026 | ${t.verifier_page_title}`}
  activeRole="verifier"
  breadcrumb={t.crumb_verifier}
  lang={lang}
>
  <style is:global>
    @media print {
      body {
        background: #FFFFFF !important;
        color: #0F172A !important;
      }
      header,
      footer,
      .no-print,
      #gov-toast-container {
        display: none !important;
      }
      main#main-content {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      #resultContainer {
        border: 2px solid #0F2942 !important;
        box-shadow: none !important;
        break-inside: avoid;
      }
      .print-only-attestation {
        display: block !important;
      }
    }
  </style>

  <div class="space-y-6">
    <!-- Official Portal Header -->
    <div class="no-print bg-white border border-slate-200 rounded-lg p-5 sm:p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <div class="w-11 h-11 rounded-lg bg-[#0F2942] text-white flex items-center justify-center shrink-0 shadow-sm border border-slate-700">
          <svg class="w-6 h-6 text-[#FF9933]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2 text-xs font-bold text-[#1E40AF] uppercase tracking-wider">
            <span>National Academic Depository (NAD) &bull; DigiLocker Verified</span>
            {queryInst && (
              <span class="bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 rounded font-mono text-[11px]">
                Institution Filter: {queryInst}
              </span>
            )}
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942] mt-0.5">
            {t.verifier_page_title}
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
            {t.verifier_subtitle}
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0 self-start md:self-center">
        <span class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-900 border border-emerald-300 px-3.5 py-1.5 rounded-md font-semibold text-xs shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Ed25519 Cryptographic Verification &bull; DPDP Act 2023 Compliant</span>
        </span>
      </div>
    </div>

    <!-- Verification Query Form Card + Feature #8: Zero-Knowledge Selective Attribute Disclosure -->
    <div class="no-print bg-white border border-slate-200 rounded-lg p-6 shadow-sm space-y-4">
      <form id="verifierQueryForm" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
        <div class="md:col-span-4">
          <label for="queryApaar" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            {t.verifier_apaar_label}
          </label>
          <input
            type="text"
            id="queryApaar"
            required
            pattern="[0-9]{12}"
            maxlength="12"
            placeholder={t.verifier_apaar_placeholder}
            value={initialApaar}
            class="w-full h-11 bg-slate-50 border border-slate-300 rounded py-2.5 px-3.5 font-mono text-slate-900 text-sm tracking-wider focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F2942] transition-all"
          />
        </div>

        <div class="md:col-span-5">
          <label for="verifierOrg" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            {t.verifier_org_label} *
          </label>
          <input
            type="text"
            id="verifierOrg"
            required
            value={initialOrg}
            placeholder="e.g. UPSC / TCS Background Verification"
            class="w-full h-11 bg-slate-50 border border-slate-300 rounded py-2.5 px-3.5 text-slate-800 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F2942] transition-all"
          />
        </div>

        <div class="md:col-span-3 flex items-center gap-2">
          <button
            type="submit"
            id="verifySubmitBtn"
            class="flex-1 h-11 py-2.5 px-3.5 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold text-sm transition-colors shadow-sm flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap"
          >
            <svg class="w-4 h-4 text-[#FF9933] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span id="verifyBtnLabel">{t.verifier_btn}</span>
          </button>
          <button
            type="button"
            id="scanQrBtn"
            class="h-11 px-3 rounded bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-700 font-semibold text-xs transition-colors flex items-center gap-1.5 cursor-pointer whitespace-nowrap"
            title="Scan QR Code"
          >
            <svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
            </svg>
            <span>{t.verifier_scan_qr_btn}</span>
          </button>
        </div>
      </form>

      <!-- Feature #8: Zero-Knowledge Selective Attribute Disclosure (Predicate Proof Mode) Bar -->
      <div class="p-3.5 rounded-lg bg-slate-50 border border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div class="flex items-start sm:items-center gap-3">
          <input
            type="checkbox"
            id="zkPredicateToggle"
            class="mt-0.5 sm:mt-0 w-4 h-4 rounded border-slate-300 text-[#0F2942] focus:ring-[#0F2942] cursor-pointer"
          />
          <div>
            <label for="zkPredicateToggle" class="text-xs font-bold text-[#0F2942] cursor-pointer flex flex-wrap items-center gap-2">
              <span>Zero-Knowledge Eligibility Predicate Mode (DPDP Sec. 6 Selective Attribute Disclosure)</span>
              <span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-900 border border-indigo-300 font-mono text-[10px] font-bold uppercase">
                Ed25519 Signed Inequality Attestation
              </span>
            </label>
            <p class="text-[11px] text-slate-600 mt-0.5">
              Cryptographically proves candidate meets minimum CGPA &amp; passing year cutoffs without disclosing exact grades or raw PII to third-party recruiters.
            </p>
          </div>
        </div>

        <div id="zkPredicateControls" class="flex flex-wrap items-center gap-3 text-xs pt-2 lg:pt-0 border-t lg:border-t-0 border-slate-200">
          <button
            type="button"
            id="zkPresetCutoffBtn"
            class="px-2 py-1 rounded bg-indigo-50 hover:bg-indigo-100 text-indigo-900 border border-indigo-200 font-mono font-semibold text-[11px] transition-colors cursor-pointer"
            data-cgpa="7.5"
            data-year="2022"
          >
            Preset: CGPA &ge; 7.5 &bull; 2022
          </button>
          <div class="flex items-center gap-1.5">
            <label for="zkMinCgpa" class="font-semibold text-slate-700 whitespace-nowrap">Min CGPA &ge;</label>
            <input
              type="number"
              id="zkMinCgpa"
              step="0.05"
              min="4.0"
              max="10.0"
              placeholder="e.g. 7.5"
              class="w-20 h-8 bg-white border border-slate-300 rounded px-2 font-mono font-bold text-slate-900 text-xs"
            />
          </div>
          <div class="flex items-center gap-1.5">
            <label for="zkMinYear" class="font-semibold text-slate-700 whitespace-nowrap">Grad Year &ge;</label>
            <input
              type="number"
              id="zkMinYear"
              step="1"
              min="2000"
              max="2030"
              placeholder="e.g. 2022"
              class="w-20 h-8 bg-white border border-slate-300 rounded px-2 font-mono font-bold text-slate-900 text-xs"
            />
          </div>
          <div class="flex items-center gap-1.5">
            <label for="zkConsentToken" class="font-semibold text-slate-700 whitespace-nowrap">Consent Token:</label>
            <input
              type="text"
              id="zkConsentToken"
              placeholder="Optional DPDP Token"
              class="w-36 h-8 bg-white border border-slate-300 rounded px-2 font-mono text-slate-800 text-xs"
            />
          </div>
        </div>
      </div>

      <!-- Pre-Set Interactive Quick-Test Scenario Pills -->
      <div class="pt-2 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2 text-xs">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-slate-600 font-bold uppercase tracking-wider text-[11px] mr-1">
            Quick-Test Registry Scenarios:
          </span>
          <button
            type="button"
            class="demoApaarBtn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-900 font-medium text-xs border border-emerald-300 transition-colors cursor-pointer"
            data-apaar="412398471029"
            data-org="Union Public Service Commission (UPSC) / Corporate Verification Gateway"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            <span class="font-mono font-bold">412398471029</span>
            <span>&mdash; Valid Degree (Ed25519 Signed)</span>
          </button>
          <button
            type="button"
            class="demoApaarBtn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-50 hover:bg-red-100 text-red-900 font-medium text-xs border border-red-300 transition-colors cursor-pointer"
            data-apaar="601928374819"
            data-org="AICTE Vigilance & Anti-Forgery Cell"
          >
            <span class="w-2 h-2 rounded-full bg-red-600"></span>
            <span class="font-mono font-bold">601928374819</span>
            <span>&mdash; Revoked Credential</span>
          </button>
          <button
            type="button"
            class="demoApaarBtn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-50 hover:bg-amber-100 text-amber-900 font-medium text-xs border border-amber-300 transition-colors cursor-pointer"
            data-apaar="739284019283"
            data-org="National Scholarship Portal (NSP) Nodal Cell"
          >
            <span class="w-2 h-2 rounded-full bg-amber-600"></span>
            <span class="font-mono font-bold">739284019283</span>
            <span>&mdash; Cross-Campus Duplicate</span>
          </button>
        </div>

        <!-- Feature #9: Instant Printable Section 63 BSA / DigiLocker Attestation Certificate Button -->
        <button
          type="button"
          id="btnPrintSection63"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded bg-slate-900 hover:bg-[#0F2942] text-white font-bold text-xs border border-slate-700 transition-colors cursor-pointer shadow-xs"
        >
          <svg class="w-4 h-4 text-[#FF9933] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{t.verifier_print_btn}</span>
        </button>
      </div>
    </div>

    <!-- Official Digital Credential Verification Certificate Card -->
    <div id="resultContainer" aria-live="polite" class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
      <!-- Top Certificate Banner -->
      <div id="resBanner" class="bg-[#0F2942] text-white px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#FF9933]">
        <div class="flex items-center gap-3">
          <div class="bg-white rounded p-1.5 shrink-0">
            <img src="/emblem.svg" alt="State Emblem of India" class="h-7 w-auto object-contain" width="22" height="28" />
          </div>
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#FF9933]">
              Official Digital Credential Verification Certificate &bull; NAD / DigiLocker Standard
            </div>
            <h2 id="resTitle" class="text-base sm:text-lg font-bold text-white mt-0.5">
              Ready to Verify Academic Credential Against Cloudflare D1 Registry
            </h2>
          </div>
        </div>
        <div class="flex items-center gap-2 self-start sm:self-center">
          <span id="resBadge" class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider px-3 py-1.5 rounded bg-emerald-500/20 text-emerald-200 border border-emerald-400/40">
            <span>AWAITING QUERY</span>
          </span>
        </div>
      </div>

      <!-- Certificate Metadata Telemetry Strip -->
      <div class="p-6 space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 text-xs">
          <div class="p-3.5 bg-slate-50 rounded-md border border-slate-200">
            <div class="text-slate-500 text-[11px] font-semibold uppercase tracking-wider">Candidate Name</div>
            <div id="resName" class="font-bold text-slate-900 text-sm mt-1 truncate">Select or Enter Candidate</div>
            <div id="resConsentPill" class="text-[11px] text-slate-600 font-medium mt-0.5 flex items-center gap-1">
              <span>DPDP Consent: Pending Lookup</span>
            </div>
          </div>

          <div class="p-3.5 bg-slate-50 rounded-md border border-slate-200">
            <div class="text-slate-500 text-[11px] font-semibold uppercase tracking-wider">12-Digit APAAR &amp; Student ID</div>
            <div id="resApaar" class="font-bold font-mono text-slate-900 text-sm mt-1">{initialApaar ? `XXXX-XXXX-${initialApaar.slice(-4)}` : 'XXXX-XXXX-••••'}</div>
            <div id="resStudentRollId" class="text-[11px] font-mono font-bold text-[#1E40AF] mt-0.5">{initialApaar ? `Roll ID: STU-TCA-2020-${initialApaar.slice(-4)}` : 'Roll ID: Awaiting Query'}</div>
          </div>

          <div class="p-3.5 bg-slate-50 rounded-md border border-slate-200">
            <div class="text-slate-500 text-[11px] font-semibold uppercase tracking-wider">Cryptographic Proof</div>
            <div id="resCryptoStatus" class="font-bold text-slate-700 text-sm mt-1 flex items-center gap-1">
              <span>Awaiting Ed25519 Check</span>
            </div>
            <div id="resKeyId" class="text-[11px] font-mono text-slate-500 mt-0.5 truncate">Key ID: aicte-nad-2026</div>
            <span id="i18nTamperVerified" class="hidden">{t.verifier_tamper_verified}</span>
            <span id="i18nTamperFailed" class="hidden">{t.verifier_tamper_failed}</span>
          </div>

          <div class="p-3.5 bg-slate-50 rounded-md border border-slate-200">
            <div class="text-slate-500 text-[11px] font-semibold uppercase tracking-wider">Audit Request ID</div>
            <div id="resRequestId" class="font-bold font-mono text-slate-900 text-xs mt-1 truncate">REQ-READY</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Logged in D1 Audit Trail</div>
          </div>

          <div class="p-3.5 bg-slate-50 rounded-md border border-slate-200">
            <div class="text-slate-500 text-[11px] font-semibold uppercase tracking-wider">Edge Response Time</div>
            <div id="resLatency" class="font-bold font-mono text-emerald-700 text-sm mt-1">-- ms</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Cloudflare Worker Edge</div>
          </div>
        </div>

        <!-- Zero-Knowledge Predicate Attestation Banner (shown when Predicate Mode is enabled) -->
        <div id="resPredicateBanner" class="hidden p-4 rounded-lg border bg-indigo-50/80 border-indigo-200 text-xs space-y-2"></div>

        <!-- Degree & Enrollment Certificate Body -->
        <div id="resDegrees" class="space-y-4">
          <div class="p-5 bg-slate-50 rounded-lg border border-slate-200 text-xs text-slate-600 flex items-center justify-between gap-3">
            <span>Enter a 12-digit APAAR ID above or click one of the <strong>Quick-Test Registry Scenarios</strong> to verify Ed25519 cryptographic signatures and D1 revocation status in real time.</span>
          </div>
        </div>

        <!-- Feature #9: Statutory Section 63 Bharatiya Sakshya Adhiniyam (BSA) 2023 Electronic Evidence Declaration -->
        <div class="pt-4 border-t border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4 text-[11px] text-slate-600 bg-slate-50/70 p-4 rounded-lg border border-slate-200/80">
          <div class="space-y-1 max-w-3xl">
            <div class="font-bold text-[#0F2942] uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#1E40AF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Statutory Electronic Record Attestation &bull; Section 63, Bharatiya Sakshya Adhiniyam (BSA), 2023</span>
            </div>
            <p class="leading-relaxed">
              This computer-generated output is cryptographically signed using asymmetric Ed25519 keys issued by the National Academic Depository (NAD) &amp; AICTE Sovereign Ledger. Under Section 63 of the Bharatiya Sakshya Adhiniyam, 2023 (formerly Section 65B of the Indian Evidence Act) and Section 4 &amp; 5 of the Information Technology Act, 2000, this verifiable credential is legally admissible without physical seal or ink signature.
            </p>
          </div>
          <div class="shrink-0 flex flex-col items-start md:items-end justify-center font-mono text-[10px] text-slate-500 space-y-0.5">
            <div class="font-bold text-slate-800">ISSUER: AICTE-NAD-D1-AUTHORITY</div>
            <div id="bsaTimestamp">ATTESTED: {new Date().toISOString().slice(0, 19).replace('T', ' ')} UTC</div>
            <div class="text-emerald-700 font-bold">RFC 8032 Ed25519 + SHA-256</div>
          </div>
        </div>
      </div>
    </div>

    <!-- =========================================================================================
         TASK 1: In-Browser VLM Document Forensics & Tamper Detection
         (@huggingface/transformers v4.3.0 + onnx-community/LFM2.5-VL-450M-ONNX • q4f16 • Structured Output)
         ========================================================================================= -->
    <div id="vlmForensicsSection" class="no-print bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
      <div class="bg-[#0F2942] text-white px-6 py-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3 border-b-2 border-[#FF9933]">
        <div class="flex items-start sm:items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-white/10 border border-white/20 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-[#FF9933]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#FF9933]">
              Zero-PII Edge AI Document Forensics &bull; WebGPU / WASM Vision-Language Model
            </div>
            <h2 class="text-base sm:text-lg font-bold text-white mt-0.5">
              In-Browser VLM Document Forensics &amp; Tamper Detection (LFM2.5-VL-450M-ONNX &bull; q4f16 &bull; Structured Output)
            </h2>
          </div>
        </div>

        <!-- Model Architecture Badges -->
        <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono">
          <span class="px-2.5 py-1 rounded bg-slate-800 text-amber-300 border border-slate-600 font-bold">
            onnx-community/LFM2.5-VL-450M-ONNX
          </span>
          <span class="px-2.5 py-1 rounded bg-emerald-950 text-emerald-300 border border-emerald-700 font-bold">
            dtype: q4f16
          </span>
          <span class="px-2.5 py-1 rounded bg-blue-950 text-blue-200 border border-blue-700 font-bold">
            Transformers.js v4.3.0 Structured JSON Schema
          </span>
          <span class="px-2.5 py-1 rounded bg-indigo-950 text-indigo-200 border border-indigo-700 font-bold">
            Zero-PII Client-Side Execution
          </span>
        </div>
      </div>

      <div class="p-6 space-y-6">
        <!-- Top Description & 1-Click Live Canvas Marksheet Generators -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-200">
          <div class="text-xs text-slate-600 max-w-2xl leading-relaxed">
            Upload a scanned university degree or marksheet image (<code class="font-mono text-slate-800">.png, .jpg, .webp, .json</code>) or generate a live high-resolution certificate scan on the HTML5 forensic canvas. The Vision-Language Model (<code class="font-mono font-bold text-[#0F2942]">onnx-community/LFM2.5-VL-450M-ONNX</code> with <code class="font-mono font-bold text-[#0F2942]">q4f16</code> quantization) extracts structured JSON attributes in-browser and cross-verifies every field against the Ed25519-signed Cloudflare D1 ledger.
          </div>

          <div class="flex flex-wrap items-center gap-2.5 shrink-0">
            <button
              type="button"
              id="btnGenAuthenticScan"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded bg-emerald-50 hover:bg-emerald-100 text-emerald-950 border border-emerald-300 font-bold text-xs transition-colors cursor-pointer shadow-xs"
            >
              <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
