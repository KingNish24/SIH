      const sampleRows: any[] = [];
      for (let i = 1; i <= 15; i++) {
        const apaarNum = 849201000000 + i;
        sampleRows.push({
          apaar_id: String(apaarNum),
          student_roll_id: `TCA-1049-2026-IT-${String(i).padStart(3, '0')}`,
          name: `Candidate ${i}`,
          program: 'B.Tech Information Technology',
          batch_year: 2026,
          admission_category: SAMPLE_CATEGORIES[i % SAMPLE_CATEGORIES.length],
        });
      }
      renderTriageRows(sampleRows);
    });

    commitBtn?.addEventListener('click', async () => {
      commitBtn.disabled = true;

      try {
        const res = await fetch('/api/roster/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            institutionId: collegeSelect.value || collegeSelect.getAttribute('data-institution-id'),
            students: currentTriageData
              .filter((s) => /^[0-9]{12}$/.test(s.apaar_id))
              .map((s, idx) => ({
                apaar_id: s.apaar_id,
                student_roll_id: s.student_roll_id || `TCA-1049-2026-CSE-${String(idx + 1).padStart(3, '0')}`,
                full_name: s.name || s.full_name || 'Candidate',
                program: s.program,
                batch_year: s.batch_year,
                admission_category: s.admission_category || 'APPROVED_INTAKE',
              })),
          }),
        });

        const data = await res.json();
        const aicteHref = `${i18nClient.langPrefix || ''}/aicte`;
        const nextStepBtnHtml = `
          <div class="mt-3 pt-2.5 border-t border-current/15 flex items-center justify-end">
            <a
              href="${aicteHref}"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-[#0B1E48] hover:bg-[#1E3A8A] text-white font-bold text-xs transition-colors"
            >
              <span>Next Step: Check Seat Audit in AICTE Portal</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </a>
          </div>
        `;

        if (res.ok && data.success) {
          const inserted = data.inserted ?? 0;
          const dupes = data.duplicates_flagged ?? 0;
          const skipped = data.skipped ?? 0;
          const newEnrolled = data.new_enrollment ?? 0;
          const cap = data.sanctioned_intake ?? 180;

          const selectedOpt = collegeSelect?.selectedOptions?.[0];
          if (selectedOpt) {
            const instName = selectedOpt.getAttribute('data-name') || selectedOpt.textContent?.split(' (')[0] || '';
            selectedOpt.setAttribute('data-current', String(newEnrolled));
            selectedOpt.setAttribute('data-sanctioned', String(cap));
            selectedOpt.textContent = `${instName} (${newEnrolled}/${cap})`;
            updateCollegeMeter();
          }

          if (Array.isArray(data.created_admissions)) {
            data.created_admissions.forEach((created: any, idx: number) => {
              appendToEnrolledTable({
                id: created.id,
                apaar_id: created.apaar_id,
                roll_id: created.id || `TCA-1049-2026-CSE-${String(idx + 1).padStart(3, '0')}`,
                full_name: created.full_name || created.student_name || 'Candidate',
                program: created.program || 'B.Tech Computer Science & Engineering',
                batch_year: created.batch_year || 2026,
                quota_label: created.admission_category || 'Approved Intake',
                is_duplicate: Boolean(created.is_duplicate) || created.status === 'FLAGGED_DUPLICATE',
              });
            });
          }

          if (dupes > 0) {
            showFeedbackBanner(
              `<div><strong>Duplicate Student ID Alert:</strong> Saved <strong>${inserted}</strong> student records (${newEnrolled}/${cap} seats), and flagged <strong>${dupes}</strong> duplicate APAAR ID(s) across colleges.</div>${nextStepBtnHtml}`,
              'warning'
            );
          } else {
            showFeedbackBanner(
              `<div><strong>Student List Saved:</strong> Added <strong>${inserted}</strong> verified student records (Skipped: ${skipped}). Updated seats used: <strong>${newEnrolled} / ${cap}</strong>.</div>${nextStepBtnHtml}`,
              'success'
            );
          }
          (window as any).showToast(`Saved ${inserted} student records (${dupes} duplicate alerts).`, 'success');
        } else {
          const errMsg = data.error || 'Server rejected student list';
          const selectedOpt = collegeSelect?.selectedOptions?.[0];
          if (selectedOpt && res.status === 409) {
            const validCount = currentTriageData.filter((s) => /^[0-9]{12}$/.test(s.apaar_id)).length;
            const currentVal = parseInt(selectedOpt.getAttribute('data-current') || '0', 10);
            const capVal = parseInt(selectedOpt.getAttribute('data-sanctioned') || '180', 10);
            const projected = Math.max(currentVal, validCount);
            if (projected > capVal) {
              const instName = selectedOpt.getAttribute('data-name') || selectedOpt.textContent?.split(' (')[0] || '';
              selectedOpt.setAttribute('data-current', String(projected));
              selectedOpt.textContent = `${instName} (${projected}/${capVal})`;
              updateCollegeMeter();
            }
          }
          showFeedbackBanner(
            `<div><strong>Seat Limit Exceeded (HTTP ${res.status}):</strong> ${errMsg}</div>${nextStepBtnHtml}`,
            'error'
          );
          (window as any).showToast(errMsg, 'error');
        }
      } catch (err: any) {
        (window as any).showToast('Network synchronization error.', 'error');
      } finally {
        commitBtn.disabled = false;
      }
    });
  </script>
</Layout>
