  <!-- Serialize ABC Profiles & localized i18n strings for instant client-side switching -->
  <div
    id="studentI18nData"
    class="hidden"
    data-passkey-active={t.student_passkey_active}
    data-consent-active={t.student_consent_active}
    data-consent-revoked={t.student_consent_revoked}
    data-revoke-btn={t.student_revoke_btn}
    data-grant-btn={t.student_grant_btn}
    data-register-btn={t.student_register_passkey_btn}
  ></div>
  <script is:inline define:vars={{ abcProfiles }}>
    window.__ABC_PROFILES__ = abcProfiles;
  </script>

  <script>
    import { startRegistration, startAuthentication, browserSupportsWebAuthn } from '@simplewebauthn/browser';

    const toast = (msg: string, kind: string) => (window as any).showToast?.(msg, kind);
    const i18nEl = document.getElementById('studentI18nData');
    const i18n = {
      passkeyActive: i18nEl?.getAttribute('data-passkey-active') || 'Passkey Bound',
      consentActive: i18nEl?.getAttribute('data-consent-active') || 'DPDP CONSENT ACTIVE',
      consentRevoked: i18nEl?.getAttribute('data-consent-revoked') || 'DPDP CONSENT REVOKED',
      revokeBtn: i18nEl?.getAttribute('data-revoke-btn') || 'Consent Active (Revoke)',
      grantBtn: i18nEl?.getAttribute('data-grant-btn') || 'Consent Revoked (Grant)',
      registerBtn: i18nEl?.getAttribute('data-register-btn') || 'Bind Hardware Biometric Passkey',
    };

    const escapeHtml = (str: unknown) =>
      String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const selector = document.getElementById('studentSelector') as HTMLSelectElement | null;
    const nameDisplay = document.getElementById('studentNameDisplay');
    const emailDisplay = document.getElementById('studentEmailDisplay');
    const phoneDisplay = document.getElementById('studentPhoneDisplay');
    const apaarDisplay = document.getElementById('studentApaarDisplay');
    const toggleBtn = document.getElementById('toggleConsentBtn') as HTMLButtonElement | null;
    const registerBtn = document.getElementById('registerPasskeyBtn') as HTMLButtonElement | null;
    const passkeyBadge = document.getElementById('passkeyBindingBadge');

    async function postJSON(url: string, body: unknown) {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      return res.json();
    }

    function updatePasskeyBadge(hasPasskey: boolean) {
      if (!passkeyBadge) return;
      if (hasPasskey) {
        passkeyBadge.innerHTML = `<svg class="w-3 h-3 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg><span>${escapeHtml(i18n.passkeyActive)}</span>`;
        passkeyBadge.className = 'inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded border bg-emerald-100 text-emerald-800 border-emerald-200';
      } else {
        passkeyBadge.textContent = 'No Passkey Bound — Click Below to Register';
        passkeyBadge.className = 'inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded border bg-amber-100 text-amber-800 border-amber-200';
      }
    }

    function updateConsentUI(status: string) {
      const consentBadge = document.getElementById('consentBadge');
      if (status === 'GRANTED') {
        if (toggleBtn) {
          toggleBtn.textContent = i18n.revokeBtn;
          toggleBtn.className = 'h-10 px-4 rounded bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm';
        }
        if (consentBadge) {
          consentBadge.textContent = i18n.consentActive;
          consentBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200';
        }
      } else if (status === 'REVOKED') {
        if (toggleBtn) {
          toggleBtn.textContent = i18n.grantBtn;
          toggleBtn.className = 'h-10 px-4 rounded bg-red-700 hover:bg-red-800 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm';
        }
        if (consentBadge) {
          consentBadge.textContent = i18n.consentRevoked;
          consentBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded bg-red-100 text-red-800 border border-red-200';
        }
      } else {
        if (toggleBtn) {
          toggleBtn.textContent = i18n.grantBtn;
          toggleBtn.className = 'h-10 px-4 rounded bg-amber-700 hover:bg-amber-800 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm';
        }
        if (consentBadge) {
          consentBadge.textContent = 'DPDP CONSENT PENDING';
          consentBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200';
        }
      }
    }

    function updateAbcLedgerUI(apaar: string) {
      const profiles = (window as any).__ABC_PROFILES__ || {};
      const p = profiles[apaar] || profiles['739284019283'];
      if (!p) return;

      const totalBadge = document.getElementById('abcTotalBadge');
      const stageText = document.getElementById('abcStageText');
      const bar = document.getElementById('abcProgressBar');
      const latBadge = document.getElementById('abcLateralBadge');
      const dipSource = document.getElementById('abcDiplomaSource');
      const latNote = document.getElementById('abcLateralNote');
      const transCredits = document.getElementById('abcTransferredCredits');

      if (totalBadge) totalBadge.textContent = `${p.accumulated_credits} / 160 ABC Credits`;
      if (stageText) stageText.textContent = p.nep_exit_stage;
      if (bar) {
        bar.style.width = `${Math.min(100, (p.accumulated_credits / 160) * 100)}%`;
        bar.setAttribute('aria-valuenow', String(p.accumulated_credits));
      }

      const setMilestone = (id: string, threshold: number) => {
        const el = document.getElementById(id);
        if (!el) return;
        const reached = p.accumulated_credits >= threshold;
        el.className = `p-3 rounded border ${
          reached ? 'bg-emerald-50/80 border-emerald-300 text-emerald-950' : 'bg-white border-slate-200 text-slate-500'
        }`;
      };
      setMilestone('nepMilestone40', 40);
      setMilestone('nepMilestone80', 80);
      setMilestone('nepMilestone120', 120);
      setMilestone('nepMilestone160', 160);

      if (latBadge) {
        if (p.lateral_status === 'VERIFIED_ANCHORED') {
          latBadge.textContent = 'LATERAL DIPLOMA CREDITS VERIFIED (80 CR)';
          latBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded border bg-emerald-100 text-emerald-800 border-emerald-200';
        } else if (p.lateral_status === 'DISCREPANCY_FLAGGED') {
          latBadge.textContent = 'UNVERIFIED LATERAL ENTRY FLAGGED';
          latBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded border bg-red-100 text-red-800 border-red-200';
        } else {
          latBadge.textContent = 'REGULAR 1ST-YEAR DIRECT ADMISSION';
          latBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded border bg-blue-50 text-blue-800 border-blue-200';
        }
      }
      if (dipSource) dipSource.textContent = `Qualifying Channel: ${p.prior_diploma_board}`;
      if (latNote) latNote.textContent = p.lateral_note;
      if (transCredits) transCredits.textContent = `${p.transferred_credits} Credits`;
    }

    async function loadScopedTokens(apaar: string) {
      const listEl = document.getElementById('scopedTokensList');
      const countBadge = document.getElementById('scopedTokenCountBadge');
      if (!listEl) return;

      try {
        const res = await fetch(`/api/student/token?apaar_id=${encodeURIComponent(apaar)}`);
        const json = await res.json();
        const tokens: any[] = json.data || [];

        const activeCount = tokens.filter((t) => t.status === 'ACTIVE').length;
        if (countBadge) {
          countBadge.textContent = `${activeCount} Active / ${tokens.length} Total`;
        }

        if (tokens.length === 0) {
          listEl.innerHTML = `<div class="p-4 text-center text-slate-500 bg-slate-50 rounded border border-slate-200">No purpose-scoped consent tokens minted for this candidate yet. Use the form on the left to mint a 24-hour single-use token.</div>`;
          return;
        }

        listEl.innerHTML = tokens
          .map((t) => {
            const isActive = t.status === 'ACTIVE';
            const badgeClass = isActive
              ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
              : 'bg-red-100 text-red-800 border-red-200';
            const scopeLabels = escapeHtml((t.disclosed_fields || []).join(', '));
            const safeTokenId = escapeHtml(t.token_id);
            const safeStatus = escapeHtml(t.status);
            const safeTtl = escapeHtml(t.ttl_label);
            const safeOrg = escapeHtml(t.verifier_org);
            const safePurpose = escapeHtml(t.purpose);
            const safeDigest = escapeHtml(t.signature_digest);
            const safeExpires = escapeHtml(String(t.expires_at || '').replace('T', ' ').slice(0, 16));
            return `
              <div class="p-3.5 rounded border border-slate-200 bg-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <code class="font-mono font-bold text-[#0F2942] bg-white px-2 py-0.5 rounded border border-slate-300 text-xs">${safeTokenId}</code>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded border ${badgeClass}">${safeStatus}</span>
                    <span class="text-[11px] font-mono text-slate-500">${safeTtl}</span>
                  </div>
                  <div class="font-bold text-slate-900 text-xs sm:text-sm">${safeOrg}</div>
                  <div class="text-xs text-slate-600">
                    Purpose: <strong>${safePurpose}</strong> &bull; Disclosed Scope: <code class="font-mono text-[11px] bg-slate-200/70 px-1.5 py-0.5 rounded">${scopeLabels}</code>
                  </div>
                  <div class="text-[10px] font-mono text-slate-400 truncate max-w-md" title="${safeDigest}">
                    ${safeDigest} &bull; Expires: ${safeExpires} UTC
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    data-copy-token="${safeTokenId}"
                    class="copy-token-btn px-2.5 py-1.5 rounded bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 font-semibold text-xs inline-flex items-center gap-1 transition-colors"
                  >
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span>Copy</span>
                  </button>
                  ${
                    isActive
                      ? `<button
                          type="button"
                          data-revoke-token="${safeTokenId}"
                          class="revoke-token-btn px-2.5 py-1.5 rounded bg-red-50 hover:bg-red-100 border border-red-300 text-red-700 font-semibold text-xs inline-flex items-center gap-1 transition-colors"
                        >
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                          </svg>
                          <span>Revoke Token</span>
                        </button>`
                      : ''
                  }
                </div>
              </div>
            `;
          })
          .join('');

        listEl.querySelectorAll<HTMLButtonElement>('.copy-token-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const code = btn.getAttribute('data-copy-token') || '';
            navigator.clipboard?.writeText(code);
            toast(`Consent token ${code} copied to clipboard.`, 'info');
          });
        });

        listEl.querySelectorAll<HTMLButtonElement>('.revoke-token-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const code = btn.getAttribute('data-revoke-token') || '';
            if (!code) return;
            btn.disabled = true;
            try {
              const delRes = await fetch(`/api/student/token?token_id=${encodeURIComponent(code)}`, {
                method: 'DELETE',
              });
              const delJson = await delRes.json();
              if (delJson.success) {
                toast(`Scoped Consent Token ${code} revoked immediately under DPDP Section 6(4).`, 'warning');
                await loadScopedTokens(apaar);
              } else {
                toast(delJson.error || 'Failed to revoke token', 'error');
              }
            } catch {
              toast('Network error revoking token', 'error');
            } finally {
              btn.disabled = false;
            }
          });
        });
      } catch {
        listEl.innerHTML = `<div class="p-4 text-center text-red-600 bg-red-50 rounded border border-red-200">Error loading scoped consent tokens.</div>`;
      }
    }

    function filterStudentRecords(apaar: string) {
      const toggleSection = (itemSelector: string, emptyId: string) => {
        const items = document.querySelectorAll<HTMLElement>(itemSelector);
        let visibleCount = 0;
        items.forEach((el) => {
          if (el.getAttribute('data-student-apaar') === apaar) {
            el.classList.remove('hidden');
            visibleCount++;
          } else {
            el.classList.add('hidden');
          }
        });
        const emptyEl = document.getElementById(emptyId);
        if (emptyEl) {
          emptyEl.classList.toggle('hidden', visibleCount > 0);
        }
      };

      toggleSection('.student-admission-item', 'noAdmissionsMsg');
      toggleSection('.student-degree-item', 'noDegreesMsg');
      toggleSection('.student-audit-item', 'noAuditMsg');
      updateAbcLedgerUI(apaar);
      loadScopedTokens(apaar);
    }

    selector?.addEventListener('change', () => {
      const opt = selector.selectedOptions[0];
      if (!opt) return;
      if (nameDisplay) nameDisplay.textContent = opt.dataset.name || 'Candidate';
      if (emailDisplay) emailDisplay.textContent = opt.dataset.email || 'r***@***.in';
      if (phoneDisplay) phoneDisplay.textContent = opt.dataset.phone || '+91 XXXXX X3210';
      if (apaarDisplay) apaarDisplay.textContent = 'XXXX-XXXX-' + (opt.value ? opt.value.slice(-4) : '9283');
      const avatar = document.getElementById('studentAvatar');
      if (avatar && opt.dataset.name) {
        const parts = opt.dataset.name.split(' ');
        avatar.textContent = parts.map((p) => p.replace(/[^A-Za-z]/g, '')[0] || '').join('').slice(0, 2).toUpperCase();
      }
      updateConsentUI(opt.dataset.consent || 'PENDING');
      updatePasskeyBadge(opt.dataset.haspasskey === 'true');
      filterStudentRecords(opt.value);
    });

    if (selector && selector.selectedOptions[0]) {
      const initialOpt = selector.selectedOptions[0];
      updateConsentUI(initialOpt.dataset.consent || 'GRANTED');
      updatePasskeyBadge(initialOpt.dataset.haspasskey === 'true');
      filterStudentRecords(initialOpt.value);
    }

    // Wire Quick Consent Preset Chips
    document.querySelectorAll<HTMLButtonElement>('.token-preset-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const orgEl = document.getElementById('tokenVerifierOrg') as HTMLSelectElement | null;
        const purpEl = document.getElementById('tokenPurpose') as HTMLSelectElement | null;
        const scopeEl = document.getElementById('tokenScope') as HTMLSelectElement | null;
        const ttlEl = document.getElementById('tokenTtl') as HTMLSelectElement | null;
        if (orgEl && chip.dataset.org) orgEl.value = chip.dataset.org;
        if (purpEl && chip.dataset.purpose) purpEl.value = chip.dataset.purpose;
        if (scopeEl && chip.dataset.scope) scopeEl.value = chip.dataset.scope;
        if (ttlEl && chip.dataset.ttl) ttlEl.value = chip.dataset.ttl;
        toast(`Preset loaded: ${chip.dataset.org}`, 'info');
      });
    });

    // Mint Purpose-Scoped One-Time Consent Token
    const mintBtn = document.getElementById('mintTokenBtn') as HTMLButtonElement | null;
    const mintedBanner = document.getElementById('mintedTokenBanner');
    const mintedCodeEl = document.getElementById('mintedTokenCode');
    const copyMintedBtn = document.getElementById('copyMintedTokenBtn');

    mintBtn?.addEventListener('click', async () => {
      const apaar = selector ? selector.value : '739284019283';
      const verifierOrg = (document.getElementById('tokenVerifierOrg') as HTMLSelectElement)?.value || '';
      const purpose = (document.getElementById('tokenPurpose') as HTMLSelectElement)?.value || '';
      const scopeRaw = (document.getElementById('tokenScope') as HTMLSelectElement)?.value || 'degree_status,cgpa_threshold';
      const ttlSelect = document.getElementById('tokenTtl') as HTMLSelectElement | null;
      const ttlHours = Number(ttlSelect?.value || 24);
      const singleUse = ttlSelect?.selectedOptions?.[0]?.getAttribute('data-single') !== 'false';

      if (!verifierOrg || !purpose) {
        toast('Please select a Target Verifier Organization and Statutory Purpose (or click a Quick Consent Preset above).', 'warning');
        return;
      }

      mintBtn.disabled = true;
      try {
        const data = await postJSON('/api/student/token', {
          apaar_id: apaar,
          verifier_org: verifierOrg,
          purpose,
          disclosed_fields: scopeRaw.split(',').map((s) => s.trim()),
          ttl_hours: ttlHours,
          single_use: singleUse,
        });

        if (!data.success) {
          throw new Error(data.error || 'Failed to mint consent token');
        }

        if (mintedBanner && mintedCodeEl) {
          mintedCodeEl.textContent = data.data.token_id;
          mintedBanner.classList.remove('hidden');
        }
        toast(`Scoped Token ${data.data.token_id} minted for ${verifierOrg}.`, 'success');
        await loadScopedTokens(apaar);
      } catch (err: any) {
        toast(err?.message || 'Error minting scoped token', 'error');
      } finally {
        mintBtn.disabled = false;
      }
    });

    copyMintedBtn?.addEventListener('click', () => {
      const code = mintedCodeEl?.textContent || '';
      if (code) {
        navigator.clipboard?.writeText(code);
        toast(`Copied token ${code} to clipboard.`, 'info');
      }
    });

    // Consent grant/revoke requires a successful passkey assertion, verified server-side.
    toggleBtn?.addEventListener('click', async () => {
      const opt = selector ? selector.selectedOptions[0] : null;
      const apaar = selector ? selector.value : '';
      if (!apaar) return;
      if (!browserSupportsWebAuthn()) {
        toast('This browser does not support passkeys (WebAuthn).', 'error');
        return;
      }

      const currentConsent = opt ? opt.dataset.consent : (toggleBtn.textContent?.includes('Active') ? 'GRANTED' : 'REVOKED');
      const targetConsent = currentConsent === 'GRANTED' ? 'REVOKED' : 'GRANTED';

      toggleBtn.disabled = true;
      try {
        const ch = await postJSON('/api/passkey/verify', { action: 'GET_CHALLENGE', apaar_id: apaar });
        if (!ch.success) throw new Error(ch.error || 'Could not get passkey challenge. Register a passkey first.');

        const assertion = await startAuthentication({ optionsJSON: ch.options });

        const data = await postJSON('/api/passkey/verify', {
          action: 'COMPLETE_VERIFICATION',
          apaar_id: apaar,
          assertion,
          consent_status: targetConsent,
        });
        if (!data.success) throw new Error(data.error || 'Server rejected passkey assertion');

        if (opt) opt.dataset.consent = targetConsent;
        updateConsentUI(targetConsent);
        if (targetConsent === 'REVOKED') {
          toast('DPDP Consent REVOKED in Central D1 Registry. Third-party verifiers are now blocked from querying your records.', 'warning');
        } else {
          toast('DPDP Consent GRANTED in Central D1 Registry. Third-party verifiers are authorized.', 'success');
        }
      } catch (err: any) {
        toast('Error updating consent: ' + (err?.message || 'Passkey verification failed'), 'error');
      } finally {
        toggleBtn.disabled = false;
      }
    });

    registerBtn?.addEventListener('click', async () => {
      const apaar = selector ? selector.value : '';
      if (!apaar) {
        toast('Please select a candidate first.', 'error');
        return;
      }
      if (!browserSupportsWebAuthn()) {
        toast('This browser does not support passkeys (WebAuthn).', 'error');
        return;
      }

      registerBtn.disabled = true;
      registerBtn.innerHTML = '<span>Communicating with Hardware Authenticator...</span>';

      try {
        const optData = await postJSON('/api/passkey/register', { action: 'GET_OPTIONS', apaar_id: apaar });
        if (!optData.success || !optData.options) {
          throw new Error(optData.error || 'Failed to fetch registration options');
        }

        const credential = await startRegistration({ optionsJSON: optData.options });
        const deviceType = credential.authenticatorAttachment === 'platform'
          ? 'Platform Biometric Passkey (FIDO2)'
          : 'Roaming Security Key / Passkey (FIDO2)';

        const regData = await postJSON('/api/passkey/register', {
          action: 'COMPLETE_REGISTRATION',
          apaar_id: apaar,
          credential,
          device_type: deviceType,
        });

        if (!regData.success) throw new Error(regData.error || 'Server error');

        toast('Passkey hardware credentials registered and bound to student APAAR in Central D1 Registry.', 'success');
        const opt = selector?.selectedOptions[0];
        if (opt) {
          opt.dataset.consent = 'GRANTED';
          opt.dataset.haspasskey = 'true';
        }
        updateConsentUI('GRANTED');
        updatePasskeyBadge(true);
        const passkeyDisplay = document.getElementById('passkeyDeviceDisplay');
        if (passkeyDisplay) passkeyDisplay.textContent = deviceType;
      } catch (err: any) {
        toast('Passkey registration error: ' + (err?.message || 'Unknown error'), 'error');
      } finally {
        registerBtn.disabled = false;
        registerBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          <span>${escapeHtml(i18n.registerBtn)}</span>
        `;
      }
    });
  </script>
</Layout>
