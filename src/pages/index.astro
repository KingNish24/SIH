---
import Layout from '../layouts/Layout.astro';
import {
  getLanguageInfo,
  getUIDictionary,
  isSupportedLang,
  type LangCode,
} from '../lib/i18n';

const resolvedLang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langInfo = getLanguageInfo(resolvedLang);
const t = getUIDictionary(resolvedLang);
const langPrefix = resolvedLang === 'en' ? '' : `/${resolvedLang}`;
---

<Layout
  title={`${t.portalTitle} (${langInfo.nativeName}) | AICTE | Ministry of Education`}
  activeRole="overview"
  breadcrumb={t.portalTitle}
  lang={resolvedLang}
  fullBleed={true}
>
  <div class="w-full bg-white">
    <!-- 1. HERO BANNER: Contained UIDAI-Style Card + APAAR Academic ID Card Preview -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 pt-6 pb-6">
      <div class="relative rounded-2xl bg-gradient-to-r from-[#040E29] via-[#092052] to-[#0E337A] text-white overflow-hidden shadow-[0_20px_50px_-12px_rgba(4,14,41,0.35)] px-6 sm:px-12 py-10 sm:py-13">
        <!-- Geometric Architectural Blueprint Lines -->
        <svg
          class="absolute right-0 top-0 h-full w-1/2 opacity-10 pointer-events-none"
          viewBox="0 0 600 400"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="460" cy="200" r="140" stroke="#93C5FD" stroke-width="1" />
          <circle cx="460" cy="200" r="210" stroke="#93C5FD" stroke-width="1" stroke-dasharray="4 6" />
          <circle cx="460" cy="200" r="280" stroke="#93C5FD" stroke-width="1" />
          <line x1="180" y1="200" x2="600" y2="200" stroke="#93C5FD" stroke-width="1" />
          <line x1="460" y1="0" x2="460" y2="400" stroke="#93C5FD" stroke-width="1" />
        </svg>

        <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <!-- Left 7 Cols: AICTE APAAR Student Registry Headline & Pill CTAs -->
          <div class="lg:col-span-7">
            <h1
              class="text-2xl sm:text-4xl lg:text-[42px] font-extrabold tracking-[-0.025em] text-white leading-[1.15] text-balance"
              data-i18n="heroTitle"
            >
              {t.heroTitle}
            </h1>

            <p
              class="mt-4 text-sm sm:text-base text-blue-100 leading-relaxed max-w-[62ch]"
              data-i18n="heroSubtitle"
            >
              {t.heroSubtitle}
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-3.5">
              <a
                href="#choose-portal"
                class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-[#FF9933] hover:bg-[#e88622] text-[#040E29] font-extrabold text-xs sm:text-sm shadow-[0_8px_20px_-4px_rgba(255,153,51,0.45)] transition-all"
              >
                <span data-i18n="portalsHeading">{t.portalsHeading}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
                </svg>
              </a>
              <a
                href={`${langPrefix}/verifier`}
                class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white/12 hover:bg-white/20 text-white font-semibold text-xs sm:text-sm transition-all"
              >
                <span data-i18n="navVerifier">{t.navVerifier}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Right 5 Cols: Official Government of India APAAR ID Card -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <div class="w-full max-w-[420px]">
              <img
                src="/apaar_card_official.png"
                alt="Official Government of India APAAR ID Card"
                class="w-full h-auto drop-shadow-[0_24px_40px_rgba(0,0,0,0.45)] select-none"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. CHOOSE YOUR PORTAL: 4 Distinct Rich Color-Themed Portal Cards (ABC.gov.in Style) -->
    <section id="choose-portal" class="max-w-7xl mx-auto px-4 sm:px-8 py-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
        <div>
          <h2
            class="text-2xl sm:text-3xl font-extrabold text-[#0B1E48] tracking-[-0.02em]"
            data-i18n="portalsHeading"
          >
            {t.portalsHeading}
          </h2>
          <p class="text-sm text-[#334155] mt-1" data-i18n="portalsSub">
            {t.portalsSub}
          </p>
        </div>
        <a
          href={`${langPrefix}/verifier`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#FFAE19] hover:bg-[#f09f0a] text-[#040E29] text-xs font-extrabold shadow-[0_6px_16px_-4px_rgba(255,174,25,0.4)] transition-all self-start sm:self-auto"
        >
          <span data-i18n="quickVerifyTitle">{t.quickVerifyTitle}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Card 1: Colleges (Royal Cobalt Blue) -->
        <a
          href={`${langPrefix}/institution`}
          class="group relative rounded-2xl bg-gradient-to-br from-[#0B4EA2] to-[#072F6B] hover:from-[#0D58B5] hover:to-[#093A82] text-white p-6 shadow-[0_12px_28px_-6px_rgba(11,78,162,0.32)] hover:-translate-y-0.5 transition-all flex flex-col justify-between overflow-hidden"
        >
          <svg class="absolute -right-6 -bottom-6 w-28 h-28 text-white/[0.06] pointer-events-none" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <circle cx="50" cy="50" r="50" />
          </svg>
          <div>
            <div class="w-12 h-12 rounded-full bg-white text-[#0B4EA2] flex items-center justify-center mb-5 shadow-sm">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="text-lg font-extrabold text-white mb-2" data-i18n="portal1Title">{t.portal1Title}</h3>
            <p class="text-xs sm:text-[13px] text-blue-50 leading-relaxed mb-6" data-i18n="portal1Desc">
              {t.portal1Desc}
            </p>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-[#072F6B] group-hover:bg-[#FFAE19] group-hover:text-[#040E29] text-xs font-extrabold transition-colors">
              <span>College Portal</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </span>
          </div>
        </a>

        <!-- Card 2: AICTE Portal (Rich Warm Amber / Saffron-Bronze) -->
        <a
          href={`${langPrefix}/aicte`}
          class="group relative rounded-2xl bg-gradient-to-br from-[#B45309] to-[#78350F] hover:from-[#C25E0E] hover:to-[#8A3E12] text-white p-6 shadow-[0_12px_28px_-6px_rgba(180,83,9,0.32)] hover:-translate-y-0.5 transition-all flex flex-col justify-between overflow-hidden"
        >
          <svg class="absolute -right-6 -bottom-6 w-28 h-28 text-white/[0.06] pointer-events-none" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <circle cx="50" cy="50" r="50" />
          </svg>
          <div>
            <div class="w-12 h-12 rounded-full bg-white text-[#92400E] flex items-center justify-center mb-5 shadow-sm">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-lg font-extrabold text-white mb-2" data-i18n="portal2Title">{t.portal2Title}</h3>
            <p class="text-xs sm:text-[13px] text-amber-50 leading-relaxed mb-6" data-i18n="portal2Desc">
              {t.portal2Desc}
            </p>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-[#78350F] group-hover:bg-[#FFAE19] group-hover:text-[#040E29] text-xs font-extrabold transition-colors">
              <span>AICTE Portal</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </span>
          </div>
        </a>

        <!-- Card 3: University Portal (Rich Royal Indigo / Plum-Violet) -->
        <a
          href={`${langPrefix}/university`}
          class="group relative rounded-2xl bg-gradient-to-br from-[#4338CA] to-[#27206B] hover:from-[#4F46E5] hover:to-[#312885] text-white p-6 shadow-[0_12px_28px_-6px_rgba(67,56,202,0.32)] hover:-translate-y-0.5 transition-all flex flex-col justify-between overflow-hidden"
        >
          <svg class="absolute -right-6 -bottom-6 w-28 h-28 text-white/[0.06] pointer-events-none" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <circle cx="50" cy="50" r="50" />
          </svg>
          <div>
            <div class="w-12 h-12 rounded-full bg-white text-[#3730A3] flex items-center justify-center mb-5 shadow-sm">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-lg font-extrabold text-white mb-2">University Portal</h3>
            <p class="text-xs sm:text-[13px] text-indigo-50 leading-relaxed mb-6" data-i18n="portal3Desc">
              {t.portal3Desc}
            </p>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-[#27206B] group-hover:bg-[#FFAE19] group-hover:text-[#040E29] text-xs font-extrabold transition-colors">
              <span>University Portal</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </span>
          </div>
        </a>

        <!-- Card 4: Students (Rich Emerald / Forest Teal) -->
        <a
          href={`${langPrefix}/student`}
          class="group relative rounded-2xl bg-gradient-to-br from-[#047857] to-[#064E3B] hover:from-[#058762] hover:to-[#075C46] text-white p-6 shadow-[0_12px_28px_-6px_rgba(4,120,87,0.32)] hover:-translate-y-0.5 transition-all flex flex-col justify-between overflow-hidden"
        >
          <svg class="absolute -right-6 -bottom-6 w-28 h-28 text-white/[0.06] pointer-events-none" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <circle cx="50" cy="50" r="50" />
          </svg>
          <div>
            <div class="w-12 h-12 rounded-full bg-white text-[#065F46] flex items-center justify-center mb-5 shadow-sm">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <h3 class="text-lg font-extrabold text-white mb-2" data-i18n="portal4Title">{t.portal4Title}</h3>
            <p class="text-xs sm:text-[13px] text-emerald-50 leading-relaxed mb-6" data-i18n="portal4Desc">
              {t.portal4Desc}
            </p>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-[#064E3B] group-hover:bg-[#FFAE19] group-hover:text-[#040E29] text-xs font-extrabold transition-colors">
              <span>Student Portal</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </span>
          </div>
        </a>
      </div>
    </section>

    <!-- 3. HOW IT WORKS: Full-Bleed Soft Band with 3 Elevated Yellow-Circle Cards -->
    <section id="how-it-works" class="w-full bg-[#F2F5FC] py-12 mt-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="mb-8">
          <h2
            class="text-2xl sm:text-3xl font-extrabold text-[#0B1E48] tracking-[-0.02em]"
            data-i18n="home_steps_heading"
          >
            {t.home_steps_heading}
          </h2>
          <p class="mt-1.5 text-sm sm:text-base text-[#334155]" data-i18n="home_steps_sub">
            {t.home_steps_sub}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Benefit Card 1 -->
          <div class="bg-white rounded-2xl p-7 shadow-[0_10px_28px_-6px_rgba(11,30,72,0.08)] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-14 h-14 rounded-full bg-[#FFAE19] text-[#0B1E48] shadow-[0_6px_16px_rgba(255,174,25,0.35)] flex items-center justify-center shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <span class="px-3 py-1 rounded-full bg-[#EEF4FF] text-[#0B4EA2] text-xs font-bold">
                  Admission Check
                </span>
              </div>
              <h3 class="text-lg font-extrabold text-[#0B1E48] mb-2">{t.home_hero_promise_2}</h3>
              <p class="text-sm text-[#334155] leading-relaxed">
                <span data-i18n="home_step1_desc">{t.home_step1_desc}</span>{' '}
                <span data-i18n="home_step2_desc">{t.home_step2_desc}</span>
              </p>
            </div>
            <a
              href={`${langPrefix}/institution`}
              class="mt-6 inline-flex items-center gap-1.5 text-xs font-extrabold text-[#0B4EA2] hover:underline"
            >
              <span>Open College Portal</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </a>
          </div>

          <!-- Benefit Card 2 -->
          <div class="bg-white rounded-2xl p-7 shadow-[0_10px_28px_-6px_rgba(11,30,72,0.08)] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-14 h-14 rounded-full bg-[#FFAE19] text-[#0B1E48] shadow-[0_6px_16px_rgba(255,174,25,0.35)] flex items-center justify-center shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  </svg>
                </div>
                <span class="px-3 py-1 rounded-full bg-[#E0E7FF] text-[#3730A3] text-xs font-bold">
                  IT Act, 2000 Valid
                </span>
              </div>
              <h3 class="text-lg font-extrabold text-[#0B1E48] mb-2">{t.home_hero_promise_1}</h3>
              <p class="text-sm text-[#334155] leading-relaxed">
                <span data-i18n="home_step3_desc">{t.home_step3_desc}</span>{' '}
                <span data-i18n="home_rule2_desc">{t.home_rule2_desc}</span>
              </p>
            </div>
            <a
              href={`${langPrefix}/university`}
              class="mt-6 inline-flex items-center gap-1.5 text-xs font-extrabold text-[#3730A3] hover:underline"
            >
              <span>Open University Portal</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </a>
          </div>

          <!-- Benefit Card 3 -->
          <div class="bg-white rounded-2xl p-7 shadow-[0_10px_28px_-6px_rgba(11,30,72,0.08)] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-14 h-14 rounded-full bg-[#FFAE19] text-[#0B1E48] shadow-[0_6px_16px_rgba(255,174,25,0.35)] flex items-center justify-center shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                <span class="px-3 py-1 rounded-full bg-[#D1FAE5] text-[#065F46] text-xs font-bold">
                  Free Public Check
                </span>
              </div>
              <h3 class="text-lg font-extrabold text-[#0B1E48] mb-2">{t.home_hero_promise_3}</h3>
              <p class="text-sm text-[#334155] leading-relaxed">
                <span data-i18n="home_step4_desc">{t.home_step4_desc}</span>{' '}
                <span data-i18n="portal5Desc">{t.portal5Desc}</span>
              </p>
            </div>
            <a
              href={`${langPrefix}/verifier`}
              class="mt-6 inline-flex items-center gap-1.5 text-xs font-extrabold text-[#047857] hover:underline"
            >
              <span>Open Public Verifier</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. FULL-WIDTH BLUE VIDEO CONFERENCE / HELPDESK BANNER -->
    <section class="w-full bg-[#09569B] text-white py-8 px-4 sm:px-8">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-center md:text-left">
          <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-1" data-i18n="home_helpdesk_title">
            {t.home_helpdesk_title}
          </h2>
          <p class="text-xs sm:text-sm text-blue-100 font-medium">
            <span data-i18n="home_helpdesk_hours_val">{t.home_helpdesk_hours_val}</span> &bull; Helpline: <strong class="text-white">1800-889-3511</strong>
          </p>
        </div>

        <div>
          <a
            href={`${langPrefix}/login`}
            class="inline-flex items-center justify-center px-8 py-2.5 rounded-full bg-white hover:bg-slate-100 text-[#09569B] font-extrabold text-xs sm:text-sm shadow-md transition-all"
          >
            Join Now
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
