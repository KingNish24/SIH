                  <span>Lock Seat &amp; Commit Admission</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
                  </svg>
                </button>
              </div>
            </form>
          </div>

          <!-- TAB 2: Production CSV Batch Import -->
          <div id="panelBulkCsv" role="tabpanel" class="hidden p-5 space-y-4">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <h3 class="text-sm font-extrabold text-[#0B1E48]">
                  {t.inst_upload_heading}
                </h3>
