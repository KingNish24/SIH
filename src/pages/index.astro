---
/**
 * Home Page (SIH26263 — National APAAR Student Registry for AICTE Institutions)
 * Three Impeccable-crafted variants switchable via `?variant=A|B|C` in dev.
 */
import Layout from '../layouts/Layout.astro';
import PrototypeSwitcher from '../components/PrototypeSwitcher.astro';
import {
  getLanguageInfo,
  getUIDictionary,
  isSupportedLang,
  type LangCode,
} from '../lib/i18n';

const resolvedLang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langInfo = getLanguageInfo(resolvedLang);
const t = getUIDictionary(resolvedLang);
const langPrefix = resolvedLang === 'en' ? '' : `/${resolvedLang}`;

const rawVariant = (Astro.url.searchParams.get('variant') || 'A').toUpperCase();
const activeVariant = ['A', 'B', 'C'].includes(rawVariant) ? rawVariant : 'A';

const prototypeVariants = [
  { key: 'A', name: 'UIDAI Rich Surface + 3-Col Yellow Cards' },
  { key: 'B', name: '2x2 Horizontal Portals + NAD 1+2 Grid' },
  { key: 'C', name: 'Deep Civic Cards + 3-Col Benefits' },
];
---

<Layout
  title={`${t.portalTitle} (${langInfo.nativeName}) | AICTE | Ministry of Education`}
  activeRole="overview"
  breadcrumb={t.portalTitle}
  lang={resolvedLang}
  fullBleed={true}
>
  <div class="w-full bg-white">
    <!-- HERO BANNER: Contained UIDAI-Style Card + APAAR Academic ID Card Preview -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 pt-6 pb-6">
      <div class="relative rounded-2xl bg-gradient-to-r from-[#040E29] via-[#092052] to-[#0E337A] text-white overflow-hidden shadow-[0_20px_50px_-12px_rgba(4,14,41,0.35)] px-6 sm:px-12 py-10 sm:py-13">
        <!-- Geometric Architectural Blueprint Lines -->
        <svg
          class="absolute right-0 top-0 h-full w-1/2 opacity-10 pointer-events-none"
          viewBox="0 0 600 400"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="460" cy="200" r="140" stroke="#93C5FD" stroke-width="1" />
          <circle cx="460" cy="200" r="210" stroke="#93C5FD" stroke-width="1" stroke-dasharray="4 6" />
          <circle cx="460" cy="200" r="280" stroke="#93C5FD" stroke-width="1" />
          <line x1="180" y1="200" x2="600" y2="200" stroke="#93C5FD" stroke-width="1" />
          <line x1="460" y1="0" x2="460" y2="400" stroke="#93C5FD" stroke-width="1" />
        </svg>

        <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <!-- Left 7 Cols: AICTE APAAR Student Registry Headline & Pill CTAs -->
          <div class="lg:col-span-7">
            <h1
              class="text-2xl sm:text-4xl lg:text-[42px] font-extrabold tracking-[-0.025em] text-white leading-[1.15] text-balance"
              data-i18n="heroTitle"
            >
              {t.heroTitle}
            </h1>

            <p
              class="mt-4 text-sm sm:text-base text-blue-100 leading-relaxed max-w-[62ch]"
              data-i18n="heroSubtitle"
            >
              {t.heroSubtitle}
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-3.5">
              <a
                href="#choose-portal"
                class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-[#FF9933] hover:bg-[#e88622] text-[#040E29] font-extrabold text-xs sm:text-sm shadow-[0_8px_20px_-4px_rgba(255,153,51,0.45)] transition-all"
              >
                <span data-i18n="portalsHeading">{t.portalsHeading}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
                </svg>
              </a>
              <a
                href={`${langPrefix}/verifier`}
                class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white/12 hover:bg-white/20 text-white font-semibold text-xs sm:text-sm transition-all"
              >
                <span data-i18n="navVerifier">{t.navVerifier}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Right 5 Cols: Clean APAAR Student ID Card Visual -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <div class="relative w-full max-w-sm">
              <div class="bg-white text-slate-900 rounded-2xl p-5 shadow-[0_24px_48px_-12px_rgba(0,0,0,0.4)]">
                <!-- Card Top Strip -->
                <div class="flex items-center justify-between border-b border-slate-200/80 pb-3 mb-4">
                  <div class="flex items-center gap-2.5">
                    <img src="/emblem.svg" alt="State Emblem of India" class="w-5 h-5 object-contain" />
                    <div>
                      <div class="text-[10px] font-semibold text-slate-600">Ministry of Education</div>
                      <div class="text-xs font-extrabold text-[#0B1E48]">AICTE &bull; Govt. of India</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <span class="text-xs font-black tracking-tight text-[#138808]">APAAR</span>
                    <div class="text-[9px] font-bold text-slate-500">One Nation One ID</div>
                  </div>
                </div>

                <!-- Student Profile Row -->
                <div class="flex items-center gap-3.5 mb-4">
                  <div class="w-12 h-12 rounded-xl bg-[#EEF2FA] text-[#0B1E48] flex items-center justify-center font-extrabold text-sm shrink-0">
                    SS
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="text-sm font-extrabold text-slate-900 truncate">Sneha Sundaram</div>
                    <div class="text-xs font-medium text-slate-600 truncate">B.Tech Computer Science</div>
                    <div class="text-[11px] font-mono text-slate-600">Roll ID: TCA-2024-029</div>
                  </div>
                  <!-- Simple QR Box -->
                  <div class="w-12 h-12 rounded-lg bg-slate-50 p-1.5 shrink-0 flex items-center justify-center">
                    <svg class="w-full h-full text-slate-900" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v8h-8V3zm2 2v4h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm13-2h3v2h-3v-2zm-3 0h2v3h-2v-3zm3 3h3v2h-3v-2zm-3 3h2v2h-2v-2zm3 0h3v2h-3v-2z" />
                    </svg>
                  </div>
                </div>

                <!-- 12-Digit APAAR Number Bar -->
                <div class="bg-[#F4F7FC] rounded-xl px-3.5 py-2.5 flex items-center justify-between">
                  <span class="text-[11px] font-bold text-slate-600">APAAR ID</span>
                  <span class="font-mono text-sm font-black tracking-widest text-[#0B1E48]">4123 9847 1029</span>
                </div>
              </div>

              <!-- Verified Pill Callout -->
              <div class="-mt-3 ml-4 inline-flex items-center gap-2 bg-[#ECFDF5] text-[#065F46] px-3.5 py-1.5 rounded-full shadow-[0_8px_20px_-4px_rgba(6,95,70,0.25)] text-xs font-bold relative z-10">
                <span class="w-2 h-2 rounded-full bg-[#059669]"></span>
                <span>AICTE Seat Verified &bull; Within Limit</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         VARIANT A: UIDAI Rich Surface (Duotone Medallions + Inset Scope Bar)
                    + 3-Column Yellow-Medallion Benefits Section
         ===================================================================== -->
    <div data-proto-variant-panel="A" class={activeVariant === 'A' ? '' : 'hidden'}>
      <!-- A1. Choose Your Portal: Warm Tinted Surface + Inline Degree Check + 4 Rich Cards -->
      <section id="choose-portal" class="max-w-7xl mx-auto px-4 sm:px-8 py-5">
        <div class="relative rounded-2xl bg-[#EEF2FA] px-6 sm:px-10 py-9 overflow-hidden">
          <!-- Subtle UIDAI-Style Geometric Watermark -->
          <svg
            class="absolute -right-12 -top-12 w-72 h-72 text-[#0B4EA2]/[0.04] pointer-events-none"
            viewBox="0 0 200 200"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="100" cy="100" r="90" stroke="currentColor" stroke-width="6" />
            <circle cx="100" cy="100" r="65" stroke="currentColor" stroke-width="3" />
            <circle cx="100" cy="100" r="35" stroke="currentColor" stroke-width="3" />
          </svg>

          <!-- Top Header + Instant Public Verifier Bar -->
          <div class="relative flex flex-col lg:flex-row lg:items-center justify-between gap-5 mb-8">
            <div>
              <h2
                class="text-2xl sm:text-[28px] font-extrabold text-[#0B1E48] tracking-[-0.02em]"
                data-i18n="portalsHeading"
              >
                {t.portalsHeading}
              </h2>
              <p class="text-sm text-[#334155] mt-1" data-i18n="portalsSub">
                {t.portalsSub}
              </p>
            </div>

            <!-- Inline Quick Verifier Form -->
            <form
              action={`${langPrefix}/verifier`}
              method="get"
              class="flex items-center gap-2 bg-white p-1.5 rounded-xl shadow-[0_4px_16px_rgba(11,30,72,0.06)] w-full lg:w-auto"
            >
              <div class="flex items-center gap-2 pl-3 pr-1 flex-1 lg:w-64">
                <svg class="w-4 h-4 text-[#0B4EA2] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input
                  type="text"
                  name="apaar"
                  maxlength="12"
                  placeholder="Enter 12-digit APAAR ID to verify..."
                  aria-label="Enter 12-digit APAAR ID to verify"
                  class="w-full text-xs font-semibold text-slate-900 placeholder:text-slate-500 bg-transparent focus:outline-none"
                />
              </div>
              <button
                type="submit"
                class="px-4 py-2 rounded-lg bg-[#0B1E48] hover:bg-[#0B4EA2] text-white text-xs font-bold transition-colors cursor-pointer shrink-0"
              >
                {t.quickVerifyBtn}
              </button>
            </form>
          </div>

          <!-- 4 Rich Portal Cards -->
          <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <!-- Card 1: Colleges -->
            <a
              href={`${langPrefix}/institution`}
              class="group bg-white rounded-2xl p-6 shadow-[0_8px_24px_-4px_rgba(11,30,72,0.06)] hover:shadow-[0_18px_36px_-8px_rgba(11,30,72,0.14)] hover:-translate-y-0.5 transition-all flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-5">
                  <div class="w-12 h-12 rounded-xl bg-[#EEF4FF] text-[#0B4EA2] flex items-center justify-center group-hover:bg-[#0B4EA2] group-hover:text-white transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  </div>
                  <span class="px-2.5 py-1 rounded-md bg-[#F1F5F9] text-[#334155] text-[11px] font-bold">
                    Seat Intake
                  </span>
                </div>

                <h3
                  class="text-lg font-extrabold text-[#0B1E48] group-hover:text-[#0B4EA2] transition-colors"
                  data-i18n="portal1Title"
                >
                  {t.portal1Title}
                </h3>
                <p class="mt-1.5 text-xs sm:text-[13px] text-[#334155] leading-relaxed" data-i18n="portal1Desc">
                  {t.portal1Desc}
                </p>

                <!-- Inset Capability Strip -->
                <div class="mt-4 rounded-xl bg-[#F4F7FC] px-3.5 py-2.5 text-[11px] font-semibold text-[#1E293B] flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#0B4EA2] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>CSV Batch &amp; ERP API Upload</span>
                </div>
              </div>

              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-extrabold text-[#0B4EA2]">Open College Portal</span>
                <span class="w-8 h-8 rounded-full bg-[#EEF4FF] text-[#0B4EA2] group-hover:bg-[#0B4EA2] group-hover:text-white flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>

            <!-- Card 2: AICTE Portal -->
            <a
              href={`${langPrefix}/aicte`}
              class="group bg-white rounded-2xl p-6 shadow-[0_8px_24px_-4px_rgba(11,30,72,0.06)] hover:shadow-[0_18px_36px_-8px_rgba(11,30,72,0.14)] hover:-translate-y-0.5 transition-all flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-5">
                  <div class="w-12 h-12 rounded-xl bg-[#FEF3C7] text-[#B45309] flex items-center justify-center group-hover:bg-[#D97706] group-hover:text-white transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                  </div>
                  <span class="px-2.5 py-1 rounded-md bg-[#F1F5F9] text-[#334155] text-[11px] font-bold">
                    National Audit
                  </span>
                </div>

                <h3
                  class="text-lg font-extrabold text-[#0B1E48] group-hover:text-[#B45309] transition-colors"
                  data-i18n="portal2Title"
                >
                  {t.portal2Title}
                </h3>
                <p class="mt-1.5 text-xs sm:text-[13px] text-[#334155] leading-relaxed" data-i18n="portal2Desc">
                  {t.portal2Desc}
                </p>

                <div class="mt-4 rounded-xl bg-[#F4F7FC] px-3.5 py-2.5 text-[11px] font-semibold text-[#1E293B] flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#B45309] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Seat Cap &amp; Duplicate ID Alerts</span>
                </div>
              </div>

              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-extrabold text-[#B45309]">Open AICTE Portal</span>
                <span class="w-8 h-8 rounded-full bg-[#FEF3C7] text-[#B45309] group-hover:bg-[#D97706] group-hover:text-white flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>

            <!-- Card 3: University Portal -->
            <a
              href={`${langPrefix}/university`}
              class="group bg-white rounded-2xl p-6 shadow-[0_8px_24px_-4px_rgba(11,30,72,0.06)] hover:shadow-[0_18px_36px_-8px_rgba(11,30,72,0.14)] hover:-translate-y-0.5 transition-all flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-5">
                  <div class="w-12 h-12 rounded-xl bg-[#E0E7FF] text-[#3730A3] flex items-center justify-center group-hover:bg-[#3730A3] group-hover:text-white transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  </div>
                  <span class="px-2.5 py-1 rounded-md bg-[#F1F5F9] text-[#334155] text-[11px] font-bold">
                    Digital Seal
                  </span>
                </div>

                <h3 class="text-lg font-extrabold text-[#0B1E48] group-hover:text-[#3730A3] transition-colors">
                  University Portal
                </h3>
                <p class="mt-1.5 text-xs sm:text-[13px] text-[#334155] leading-relaxed" data-i18n="portal3Desc">
                  {t.portal3Desc}
                </p>

                <div class="mt-4 rounded-xl bg-[#F4F7FC] px-3.5 py-2.5 text-[11px] font-semibold text-[#1E293B] flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#3730A3] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Sign &amp; Issue Verified Degrees</span>
                </div>
              </div>

              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-extrabold text-[#3730A3]">Open University Portal</span>
                <span class="w-8 h-8 rounded-full bg-[#E0E7FF] text-[#3730A3] group-hover:bg-[#3730A3] group-hover:text-white flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>

            <!-- Card 4: Students -->
            <a
              href={`${langPrefix}/student`}
              class="group bg-white rounded-2xl p-6 shadow-[0_8px_24px_-4px_rgba(11,30,72,0.06)] hover:shadow-[0_18px_36px_-8px_rgba(11,30,72,0.14)] hover:-translate-y-0.5 transition-all flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-5">
                  <div class="w-12 h-12 rounded-xl bg-[#D1FAE5] text-[#065F46] flex items-center justify-center group-hover:bg-[#059669] group-hover:text-white transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    </svg>
                  </div>
                  <span class="px-2.5 py-1 rounded-md bg-[#F1F5F9] text-[#334155] text-[11px] font-bold">
                    APAAR Wallet
                  </span>
                </div>

                <h3
                  class="text-lg font-extrabold text-[#0B1E48] group-hover:text-[#059669] transition-colors"
                  data-i18n="portal4Title"
                >
                  {t.portal4Title}
                </h3>
                <p class="mt-1.5 text-xs sm:text-[13px] text-[#334155] leading-relaxed" data-i18n="portal4Desc">
                  {t.portal4Desc}
                </p>

                <div class="mt-4 rounded-xl bg-[#F4F7FC] px-3.5 py-2.5 text-[11px] font-semibold text-[#1E293B] flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#059669] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Download Degree &amp; Manage Access</span>
                </div>
              </div>

              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-extrabold text-[#065F46]">Open Student Portal</span>
                <span class="w-8 h-8 rounded-full bg-[#D1FAE5] text-[#065F46] group-hover:bg-[#059669] group-hover:text-white flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <!-- A2. 3-Card Section with Yellow Circle Medallions (#FFAE19) & NAD Ecosystem Pill -->
      <section id="how-it-works" class="max-w-7xl mx-auto px-4 sm:px-8 py-12">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-9">
          <div>
            <h2
              class="text-2xl sm:text-3xl font-extrabold text-[#0B1E48] tracking-[-0.02em]"
              data-i18n="home_steps_heading"
            >
              {t.home_steps_heading}
            </h2>
            <p class="mt-2 text-sm sm:text-base text-[#334155] max-w-[65ch]" data-i18n="home_steps_sub">
              {t.home_steps_sub}
            </p>
          </div>

          <!-- Compact NAD-Style 3-Step Connected Flow Pill -->
          <div class="inline-flex items-center gap-2 sm:gap-3 bg-[#F4F7FC] px-4 py-2.5 rounded-2xl text-xs font-bold text-[#0B1E48] self-start lg:self-auto">
            <span class="px-2.5 py-1 rounded-lg bg-white shadow-2xs">Colleges Admit</span>
