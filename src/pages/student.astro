---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Student, Admission, Degree, VerificationRequest, Institution, SemesterCreditRow } from '../lib/types';
import { maskApaar, maskName, maskEmail, maskPhone } from '../lib/types';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const t = getUIDictionary(lang);

const db = getDB(Astro.locals);

const stuRes = await db.prepare('SELECT * FROM students').bind().all<Student>();
const students = stuRes.results || [];

const admRes = await db.prepare('SELECT * FROM admissions').bind().all<Admission>();
const admissions = admRes.results || [];

const degRes = await db.prepare('SELECT * FROM degrees').bind().all<Degree & { signing_key_id?: string }>();
const degrees = degRes.results || [];

const reqRes = await db.prepare('SELECT * FROM verification_requests').bind().all<VerificationRequest>();
const verificationRequests = reqRes.results || [];

const instRes = await db.prepare('SELECT * FROM institutions').bind().all<Institution>();
const institutions = instRes.results || [];

const creditsRes = await db.prepare('SELECT * FROM semester_credits').bind().all<SemesterCreditRow>();
const dbCreditRows = creditsRes.results || [];

const user = Astro.locals.user;
const studentApaar = user?.role === 'STUDENT' ? user.apaar_id : null;

const activeStudent = (studentApaar ? students.find((s) => s.apaar_id === studentApaar) : students[0]) || students[0];
const initialMaskedName = activeStudent ? maskName(activeStudent.full_name) : 'Candidate';
const initialAvatar = initialMaskedName
  .split(' ')
  .map((p) => p.replace(/[^A-Za-z]/g, '')[0] || '')
  .join('')
  .slice(0, 2)
  .toUpperCase() || 'CA';

const initialConsent = activeStudent?.dpdp_consent_status || 'PENDING';
const initialHasPasskey = !!activeStudent?.passkey_credential_id;

const enrichedAdmissions = admissions.map((a) => {
  const inst = institutions.find((i) => i.id === a.institution_id);
  return {
    ...a,
    institution_name: inst?.name || a.institution_id,
    institution_code: inst?.code || a.institution_id,
  };
});

const enrichedDegrees = degrees.map((d) => {
  const inst = institutions.find((i) => i.id === d.institution_id);
  return {
    ...d,
    institution_name: inst?.name || d.institution_id,
  };
});

interface AbcCreditProfile {
  apaar_id: string;
  student_name: string;
  accumulated_credits: number;
  max_credits: number;
  nep_exit_stage: string;
  semester_breakdown: number[];
  is_lateral_entry: boolean;
  prior_diploma_board: string;
  transferred_credits: number;
  lateral_status: 'VERIFIED_ANCHORED' | 'STANDARD_ENTRY' | 'DISCREPANCY_FLAGGED';
  lateral_note: string;
}

const abcProfiles: Record<string, AbcCreditProfile> = {};
for (const row of dbCreditRows) {
  let semArr: number[] = [0, 0, 0, 0, 0, 0, 0, 0];
  try {
    const parsed = typeof row.semester_breakdown === 'string' ? JSON.parse(row.semester_breakdown) : row.semester_breakdown;
    if (Array.isArray(parsed)) semArr = parsed.map(Number);
  } catch {
    // keep default
  }
  const st = students.find((s) => s.apaar_id === row.apaar_id);
  abcProfiles[row.apaar_id] = {
    apaar_id: row.apaar_id,
    student_name: st ? maskName(st.full_name) : 'Candidate ' + row.apaar_id.slice(-4),
    accumulated_credits: Number(row.accumulated_credits) || 0,
    max_credits: Number(row.max_credits) || 160,
    nep_exit_stage: row.nep_exit_stage,
    semester_breakdown: semArr,
    is_lateral_entry: Boolean(row.is_lateral_entry),
    prior_diploma_board: row.prior_diploma_board,
    transferred_credits: Number(row.transferred_credits) || 0,
    lateral_status: row.lateral_status,
    lateral_note: row.lateral_note,
  };
}

function buildFallbackAbcProfile(apaarId: string): AbcCreditProfile {
  if (abcProfiles[apaarId]) return abcProfiles[apaarId];
  const st = students.find((s) => s.apaar_id === apaarId);
  const stuDegs = enrichedDegrees.filter((d) => d.apaar_id === apaarId);
  const stuAdms = enrichedAdmissions.filter((a) => a.apaar_id === apaarId);
  const maskedStuName = st ? maskName(st.full_name) : 'Student';

  const issuedDeg = stuDegs.find((d) => d.status === 'ISSUED');
  const revokedDeg = stuDegs.find((d) => d.status === 'REVOKED');
  const primaryAdm = stuAdms[0];

  if (issuedDeg) {
    return {
      apaar_id: apaarId,
      student_name: maskedStuName,
      accumulated_credits: 160,
      max_credits: 160,
      nep_exit_stage: `160 Credits — ${issuedDeg.degree_name} (${issuedDeg.specialization}) Conferred in ${issuedDeg.year_of_passing}`,
      semester_breakdown: [20, 20, 20, 20, 20, 20, 20, 20],
      is_lateral_entry: false,
      prior_diploma_board: `Regular Admission — ${issuedDeg.institution_name}`,
      transferred_credits: 0,
      lateral_status: 'STANDARD_ENTRY',
      lateral_note: `Completed 160 credits for ${issuedDeg.degree_name} at ${issuedDeg.institution_name} (CGPA: ${issuedDeg.cgpa}).`,
    };
  }

  if (revokedDeg) {
    return {
      apaar_id: apaarId,
      student_name: maskedStuName,
      accumulated_credits: 120,
      max_credits: 160,
      nep_exit_stage: `REVOKED — ${revokedDeg.degree_name} at ${revokedDeg.institution_name}`,
      semester_breakdown: [20, 20, 20, 20, 20, 20, 0, 0],
      is_lateral_entry: false,
      prior_diploma_board: `Admission Record — ${revokedDeg.institution_name}`,
      transferred_credits: 0,
      lateral_status: 'DISCREPANCY_FLAGGED',
      lateral_note: `Degree record (${revokedDeg.id}) was revoked by ${revokedDeg.issuing_authority}.`,
    };
  }

  if (primaryAdm) {
    const yearsCompleted = Math.max(1, Math.min(4, 2026 - (Number(primaryAdm.batch_year) || 2024)));
    const credits = yearsCompleted * 40;
    const semsCompleted = yearsCompleted * 2;
    const semBreakdown = Array.from({ length: 8 }, (_, idx) => (idx < semsCompleted ? 20 : 0));
    const hasDuplicate = stuAdms.some((a) => a.status === 'FLAGGED_DUPLICATE' || Boolean(a.is_duplicate));
    return {
      apaar_id: apaarId,
      student_name: maskedStuName,
      accumulated_credits: credits,
      max_credits: 160,
      nep_exit_stage: `${credits} Credits — Active in ${primaryAdm.program} (${primaryAdm.institution_name}, Batch ${primaryAdm.batch_year})`,
      semester_breakdown: semBreakdown,
      is_lateral_entry: false,
      prior_diploma_board: `${primaryAdm.program} — ${primaryAdm.institution_name} (${primaryAdm.institution_code})`,
      transferred_credits: 0,
      lateral_status: hasDuplicate ? 'DISCREPANCY_FLAGGED' : 'STANDARD_ENTRY',
      lateral_note: hasDuplicate
        ? `Duplicate enrollment flagged across colleges for ${primaryAdm.program}.`
        : `Completed ${semsCompleted} semesters (${credits} credits) in ${primaryAdm.program} at ${primaryAdm.institution_name}.`,
    };
  }

  return {
    apaar_id: apaarId,
    student_name: maskedStuName,
    accumulated_credits: 0,
    max_credits: 160,
    nep_exit_stage: '0 Credits — No Active Course Credits Recorded Yet',
    semester_breakdown: [0, 0, 0, 0, 0, 0, 0, 0],
    is_lateral_entry: false,
    prior_diploma_board: 'No College Admission Recorded Yet',
    transferred_credits: 0,
    lateral_status: 'STANDARD_ENTRY',
    lateral_note: 'No semester credits, college admissions, or issued degrees found for this APAAR ID.',
  };
}

for (const s of students) {
  if (!abcProfiles[s.apaar_id]) {
    abcProfiles[s.apaar_id] = buildFallbackAbcProfile(s.apaar_id);
  }
}

const currentStudent = activeStudent;
const initialAbc = buildFallbackAbcProfile(currentStudent?.apaar_id || '');
const verifierBasePath = `/${lang === 'en' ? '' : lang + '/'}verifier`;
---

<Layout title={`SIH 2026 | ${t.student_page_title}`} activeRole="student" lang={lang} breadcrumb={t.crumb_student}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-slate-200 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="text-xs font-bold text-[#1E40AF] uppercase tracking-wider mb-1">
          Student Portal &bull; Academic Records &amp; Access Passes
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942]">
          {t.student_page_title}
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          {t.student_subtitle}
        </p>
      </div>

      <!-- Candidate Selector with Identity Isolation -->
      <div class="flex items-center gap-2.5 bg-white px-3.5 py-2 rounded border border-slate-200 shadow-sm text-xs sm:text-sm">
        <label for="studentSelector" class="font-semibold text-slate-700 whitespace-nowrap">Candidate:</label>
        {user?.role === 'STUDENT' && studentApaar ? (
          <div class="flex items-center gap-2">
            <select id="studentSelector" class="h-9 bg-slate-100 border border-slate-300 rounded px-2.5 text-slate-800 font-bold focus:outline-none text-xs sm:text-sm">
              {students.filter(s => s.apaar_id === studentApaar).map((s) => (
                <option
                  value={s.apaar_id}
                  data-name={maskName(s.full_name)}
                  data-email={maskEmail(s.email)}
                  data-phone={maskPhone(s.phone)}
                  data-consent={s.dpdp_consent_status}
                  data-haspasskey={s.passkey_credential_id ? 'true' : 'false'}
                  selected
                >
                  {maskName(s.full_name)} (APAAR: {maskApaar(s.apaar_id)})
                </option>
              ))}
            </select>
            <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-900 border border-emerald-300 px-2.5 py-1 rounded text-[11px] font-bold whitespace-nowrap">
              <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Candidate Authenticated ({user.username})</span>
            </span>
          </div>
        ) : (
          <select id="studentSelector" class="h-9 bg-slate-50 border border-slate-300 rounded px-2.5 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-600 text-xs sm:text-sm">
            {students.map((s) => (
              <option
                value={s.apaar_id}
                data-name={maskName(s.full_name)}
                data-email={maskEmail(s.email)}
                data-phone={maskPhone(s.phone)}
                data-consent={s.dpdp_consent_status}
                data-haspasskey={s.passkey_credential_id ? 'true' : 'false'}
                selected={s.apaar_id === activeStudent?.apaar_id}
              >
                {maskName(s.full_name)} (APAAR: {maskApaar(s.apaar_id)})
              </option>
            ))}
          </select>
        )}
      </div>
    </div>

    <!-- Student Identity Profile Summary -->
    <section class="bg-white border border-slate-200 rounded p-5 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded bg-[#0F2942] flex items-center justify-center text-white font-bold text-lg shadow-sm shrink-0">
          <span id="studentAvatar">{initialAvatar}</span>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="text-xs font-bold uppercase text-slate-500">{t.student_consent_label}</span>
            <span
              id="consentBadge"
              role="status"
              aria-live="polite"
              class={`text-[11px] font-bold px-2.5 py-0.5 rounded border ${
                initialConsent === 'GRANTED'
                  ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
                  : initialConsent === 'REVOKED'
                  ? 'bg-red-100 text-red-800 border-red-200'
                  : 'bg-amber-100 text-amber-800 border-amber-200'
              }`}
            >
              {initialConsent === 'GRANTED'
                ? t.student_consent_active
                : initialConsent === 'REVOKED'
                ? t.student_consent_revoked
                : 'DPDP CONSENT PENDING'}
            </span>
          </div>
          <h2 id="studentNameDisplay" class="text-base sm:text-lg font-bold text-[#0F2942]">
            {initialMaskedName}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 font-mono mt-0.5">
            Masked APAAR: <span id="studentApaarDisplay" class="font-semibold text-slate-900">{activeStudent ? maskApaar(activeStudent.apaar_id) : 'XXXX-XXXX-9283'}</span> &bull; 
            Registered Email: <span id="studentEmailDisplay" class="text-slate-600">{activeStudent ? maskEmail(activeStudent.email) : 'r***@***.in'}</span> &bull;
            Phone: <span id="studentPhoneDisplay" class="text-slate-600">{activeStudent ? maskPhone(activeStudent.phone) : '+91 XXXXX X3210'}</span>
          </p>
        </div>
      </div>

      <!-- Biometric Passkey Binding Status -->
      <div class="border-t md:border-t-0 md:border-l border-slate-200 pt-3 md:pt-0 md:pl-6 text-xs min-w-[240px]">
        <div class="flex items-center justify-between gap-2 mb-1">
          <span class="text-[10px] font-bold uppercase text-slate-500">Passkey Status</span>
          <span
            id="passkeyBindingBadge"
            role="status"
            aria-live="polite"
            class={`inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded border ${
              initialHasPasskey
                ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
                : 'bg-amber-100 text-amber-800 border-amber-200'
            }`}
          >
            {initialHasPasskey ? (
              <>
                <svg class="w-3 h-3 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>{t.student_passkey_active}</span>
              </>
            ) : (
              <span>No Passkey Bound — Click Below to Register</span>
            )}
          </span>
        </div>
        <div id="passkeyDeviceDisplay" class="font-bold text-slate-900 mt-1">{t.student_passkey_heading}</div>
        <div class="text-[11px] text-emerald-700 font-medium mt-0.5">{t.student_passkey_sub}</div>
      </div>
    </section>

    <!-- Create a One-Time Access Pass -->
    <section class="bg-white border border-slate-200 border-t-4 border-t-[#0F2942] rounded p-5 sm:p-6 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 border-b border-slate-200 pb-4 mb-5">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#0F2942]">
            Create a One-Time Access Pass
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
            Share only the fields an employer or college needs. Each single-use pass expires automatically after one check.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-blue-50 text-[#1E40AF] px-3 py-1.5 rounded border border-blue-200 self-start lg:self-auto">
          <span>DPDP Act 2023 Section 6</span>
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left: Pass Creation Form -->
        <div class="lg:col-span-5 space-y-4">
          <div>
            <div class="text-xs font-bold text-slate-700 mb-1.5">
              Quick Presets (Click to Fill):
            </div>
            <div class="flex flex-wrap gap-1.5">
              <button
                type="button"
                class="token-preset-chip text-[11px] font-semibold px-2.5 py-1 rounded bg-blue-50 hover:bg-blue-100 text-[#1E40AF] border border-blue-200 transition-colors cursor-pointer"
                data-org="UPSC Civil Services Board"
                data-purpose="Degree & Eligibility Verification"
                data-scope="degree_status,cgpa_threshold"
                data-ttl="24"
              >
                UPSC Eligibility Pass
              </button>
              <button
                type="button"
                class="token-preset-chip text-[11px] font-semibold px-2.5 py-1 rounded bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition-colors cursor-pointer"
                data-org="TCS Background Verification"
                data-purpose="Zero-Knowledge CGPA >= 7.5 Check"
                data-scope="degree_status,cgpa_threshold"
                data-ttl="24"
              >
                TCS CGPA &ge; 7.5 Pass
              </button>
              <button
                type="button"
                class="token-preset-chip text-[11px] font-semibold px-2.5 py-1 rounded bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition-colors cursor-pointer"
                data-org="GATE Admissions Committee (IIT Roorkee)"
                data-purpose="NEP 2020 ABC Credit & Lateral-Entry Audit"
                data-scope="degree_status,cgpa_threshold,abc_credits"
                data-ttl="1"
              >
                GATE 160-Credit Pass
              </button>
            </div>
          </div>

          <div>
            <label for="tokenVerifierOrg" class="block text-xs font-semibold text-slate-700 mb-1">
              Who can use this pass? (Organization)
            </label>
            <select
              id="tokenVerifierOrg"
              class="w-full h-9 bg-white border border-slate-300 rounded px-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
            >
              <option value="">-- Select Organization --</option>
              <option value="UPSC Civil Services Board">UPSC Civil Services Board</option>
              <option value="TCS Background Verification">TCS Background Verification</option>
              <option value="GATE Admissions Committee (IIT Roorkee)">GATE Admissions Committee (IIT Roorkee)</option>
              <option value="DRDO Scientist Entry Recruitment Board">DRDO Scientist Entry Recruitment Board</option>
              <option value="National Scholarship Portal (NSP) Nodal Cell">National Scholarship Portal (NSP) Nodal Cell</option>
            </select>
          </div>

          <div>
            <label for="tokenPurpose" class="block text-xs font-semibold text-slate-700 mb-1">
              Why do they need it? (Purpose)
            </label>
            <select
              id="tokenPurpose"
              class="w-full h-9 bg-white border border-slate-300 rounded px-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
            >
              <option value="">-- Select Purpose --</option>
              <option value="Degree & Eligibility Verification">Degree &amp; Eligibility Verification</option>
              <option value="Zero-Knowledge CGPA >= 7.5 Check">Zero-Knowledge CGPA &gt;= 7.5 Check</option>
              <option value="NEP 2020 ABC Credit & Lateral-Entry Audit">NEP 2020 ABC Credit &amp; Lateral-Entry Audit</option>
              <option value="Pre-Employment Credential Authenticity Check">Pre-Employment Credential Authenticity Check</option>
            </select>
          </div>

          <div>
            <label for="tokenScope" class="block text-xs font-semibold text-slate-700 mb-1">
              What information can they see?
            </label>
            <select
              id="tokenScope"
              class="w-full h-9 bg-white border border-slate-300 rounded px-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
            >
              <option value="degree_status,cgpa_threshold">Yes / No Only: Valid Degree + CGPA &gt;= 7.5 (Hide Exact Marks)</option>
              <option value="degree_status,cgpa_threshold,abc_credits">Degree Status + Course Credits (160 Cr)</option>
              <option value="full_transcript">Full Record: Complete Degree &amp; Marks</option>
            </select>
          </div>

          <div>
            <label for="tokenTtl" class="block text-xs font-semibold text-slate-700 mb-1">
              How long is this pass valid?
            </label>
            <select
              id="tokenTtl"
              class="w-full h-9 bg-white border border-slate-300 rounded px-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
            >
              <option value="24" data-single="true">24 Hours — Single-Use (Recommended)</option>
              <option value="1" data-single="true">1 Hour — Single-Use</option>
              <option value="24" data-single="false">24 Hours — Multiple Checks</option>
            </select>
          </div>

          <button
            type="button"
            id="mintTokenBtn"
            class="w-full h-10 px-4 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold text-xs sm:text-sm transition-colors flex items-center justify-center gap-2 shadow-xs"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Create One-Time Access Pass</span>
          </button>

          <!-- Newly Created Pass Banner + Prominent 1-Click Handoff Button -->
          <div id="mintedTokenBanner" role="status" aria-live="polite" class="hidden p-3.5 rounded bg-emerald-50 border border-emerald-300 text-xs space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="font-bold text-emerald-900 uppercase tracking-wider text-[11px]">Access Pass Ready</span>
              <span class="text-[10px] font-mono text-emerald-700 font-semibold">Single-Use Active</span>
            </div>
            <div class="flex items-center justify-between gap-2 bg-white px-3 py-2 rounded border border-emerald-200">
              <code id="mintedTokenCode" class="font-mono font-bold text-sm text-[#0F2942]">VIDYA-DPDP-0000-0000</code>
              <button
                type="button"
                id="copyMintedTokenBtn"
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs transition-colors"
              >
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Copy Pass</span>
              </button>
            </div>
            <a
              id="testMintedTokenLink"
              href={`${verifierBasePath}?apaar=${currentStudent?.apaar_id || ''}&token=`}
              class="w-full py-2 px-3 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-colors shadow-xs"
            >
              <span>Test This Pass in Public Verifier &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Right: Active & Past Passes List -->
        <div class="lg:col-span-7 flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-slate-200 pt-4 lg:pt-0 lg:pl-6">
          <div>
            <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-[#0F2942]">
                Your Active &amp; Past Access Passes
              </span>
              <span id="scopedTokenCountBadge" class="text-[11px] font-mono font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                Loading passes...
              </span>
            </div>
