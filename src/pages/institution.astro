              >
                <div class="w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center mb-2 group-hover:border-blue-300">
                  <svg class="w-4 h-4 text-[#0B1E48] group-hover:text-[#0B4EA2] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                  </svg>
                </div>
                <span class="text-xs font-bold text-[#0B1E48] group-hover:text-[#0B4EA2]">{t.inst_upload_dropzone}</span>
                <span id="csvSchemaHint" class="text-[11px] font-mono text-slate-500 mt-1">
