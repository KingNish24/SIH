    function maskApaarClient(val: string): string {
      if (!val || val.length !== 12) return 'INVALID';
      return `${val.slice(0, 4)}-${val.slice(4, 8)}-${val.slice(8, 12)}`;
    }

    function parseCols(line: string): string[] {
      const delimiter = line.includes('\t') ? '\t' : line.includes(';') && !line.includes(',') ? ';' : ',';
      return line.split(delimiter).map((c) => c.trim().replace(/^["']|["']$/g, ''));
    }

    function parseRawTextToRows(text: string): any[] {
      const lines = text
        .split(/\r?\n/)
        .map((l) => l.trim())
        .filter((l) => l.length > 0);
      if (lines.length === 0) return [];

      const headerCols = parseCols(lines[0]).map((h) => h.toLowerCase());
      const apaarIdx = headerCols.findIndex((h) => h.includes('apaar'));
      const nameIdx = headerCols.findIndex((h) => h.includes('name'));
      const progIdx = headerCols.findIndex((h) => h.includes('prog') || h.includes('branch'));
      const quotaIdx = headerCols.findIndex((h) => h.includes('quota') || h.includes('cat'));
      const allotIdx = headerCols.findIndex((h) => h.includes('allot') || h.includes('ref'));
      const batchIdx = headerCols.findIndex((h) => h.includes('batch') || h.includes('year'));

      const hasHeader = apaarIdx !== -1 || nameIdx !== -1;
      const startIdx = hasHeader ? 1 : 0;
      const parsedRows: any[] = [];

      for (let i = startIdx; i < lines.length; i++) {
        const cols = parseCols(lines[i]);
        if (!cols || cols.length === 0 || (cols.length === 1 && !cols[0])) continue;

        const apaar = apaarIdx !== -1 ? cols[apaarIdx] : cols[0];
        const name = nameIdx !== -1 ? cols[nameIdx] : cols[1] || `Candidate ${i}`;
        const prog = progIdx !== -1 ? cols[progIdx] : cols[2] || 'B.Tech Computer Science';
        const quota = quotaIdx !== -1 ? cols[quotaIdx] : cols[3] || 'APPROVED_INTAKE';
        const allotment = allotIdx !== -1 ? cols[allotIdx] : cols[4] || `CET-2026-MH-${88500 + i}`;
        const batchRaw = batchIdx !== -1 ? cols[batchIdx] : cols[5];
        const batchYear = parseInt(batchRaw, 10) || 2026;

        parsedRows.push({
          apaar_id: (apaar || '').trim(),
          full_name: (name || 'Candidate').trim(),
          program: normalizeBranchClient(prog),
          admission_quota: normalizeQuotaClient(quota),
          allotment_ref: (allotment || `CET-2026-MH-${88500 + i}`).trim(),
          batch_year: batchYear,
        });
      }

      return parsedRows;
    }

    function renderTriageRows(
      rows: any[],
      options?: { focusIdx?: number; selectionStart?: number | null; selectionEnd?: number | null; keepTab?: boolean }
    ) {
      currentTriageData = rows;
      if (stagedCountPill) stagedCountPill.textContent = String(rows.length);
      clearTriageBtn?.classList.toggle('hidden', rows.length === 0);
      if (!options?.keepTab) {
        switchWorkspaceTab('csv');
      }

      const sanctioned = parseInt(activeCollegeEl?.getAttribute('data-sanctioned') || '180', 10);

      if (!rows.length) {
        tableBody.innerHTML = `<tr><td colspan="6" class="py-10 px-4 text-center text-slate-500 text-sm">No rows queued yet. Drop a CSV file, paste from Excel, or click "Load 5-Row Sample Preview" above.</td></tr>`;
        document.getElementById('countValid')!.textContent = '0';
        document.getElementById('countMalformed')!.textContent = '0';
        document.getElementById('countMissing')!.textContent = '0';
        if (projectedSeatsEl) {
          projectedSeatsEl.textContent = `${enrolledList.length} / ${sanctioned}`;
        }
        if (commitBtn) commitBtn.disabled = true;
        return;
      }

      let valid = 0,
        malformed = 0,
        missing = 0,
        netNewValid = 0;
      let html = '';

      rows.forEach((r, idx) => {
        const cleanApaar = (r.apaar_id || '').trim();
        const is12 = /^[0-9]{12}$/.test(cleanApaar);
        const isMissing = !cleanApaar;
        const alreadyInThisCollege = is12 && enrolledList.some((item) => item.apaar_id === cleanApaar);
        const duplicateInOtherCollege = is12 && !alreadyInThisCollege && (cleanApaar === '819203847561' || cleanApaar === '601928374819');
        const allotmentRef = r.allotment_ref || `CET-2026-MH-${88500 + idx}`;

        let statusTag = '';
        if (is12) {
          valid++;
          if (!alreadyInThisCollege) {
            netNewValid++;
          }
          if (alreadyInThisCollege) {
            statusTag = `<span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 px-2.5 py-1 rounded-full border border-amber-300 font-bold text-xs whitespace-nowrap">⚠ Already in This College</span>`;
          } else if (duplicateInOtherCollege) {
            statusTag = `<span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 px-2.5 py-1 rounded-full border border-amber-300 font-bold text-xs whitespace-nowrap">⚠ Duplicate in Another College</span>`;
          } else {
            statusTag = `<span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-full border border-emerald-200 font-bold text-xs whitespace-nowrap">✓ Ready to Admit</span>`;
          }
        } else if (isMissing) {
          missing++;
          statusTag = `<span class="inline-flex items-center gap-1 bg-amber-50 text-amber-800 px-2.5 py-1 rounded-full border border-amber-200 font-bold text-xs whitespace-nowrap">✕ Missing APAAR</span>`;
        } else {
          malformed++;
          statusTag = `<span class="inline-flex items-center gap-1 bg-red-50 text-red-800 px-2.5 py-1 rounded-full border border-red-200 font-bold text-xs whitespace-nowrap">✕ Invalid 12-Digit ID</span>`;
        }

        const isEditing = Boolean(r._editing);
        const inputClasses = is12
          ? 'border-slate-300 bg-white text-[#0B1E48] focus:ring-[#0B4EA2]'
          : 'border-red-400 bg-red-50/50 text-red-900 focus:ring-red-500';
        const displayApaar = is12
          ? maskApaarClient(cleanApaar)
          : cleanApaar || '—';

        html += `
          <tr class="hover:bg-slate-50">
            <td class="py-3 px-4 font-mono text-slate-500">${idx + 1}</td>
            <td class="py-3 px-4">
              ${
                isEditing
                  ? `<input
                      type="text"
                      maxlength="12"
                      inputmode="numeric"
                      aria-label="12-Digit APAAR ID for row ${idx + 1}"
                      data-edit-triage-idx="${idx}"
                      data-edit-field="apaar_id"
                      value="${cleanApaar.replace(/"/g, '&quot;')}"
                      placeholder="12-digit APAAR"
                      class="w-36 h-8 px-2.5 rounded border font-mono text-xs font-bold focus:outline-none focus:ring-2 ${inputClasses}"
                    />`
                  : `<span class="font-mono font-bold text-xs sm:text-sm ${is12 ? 'text-[#0B1E48]' : 'text-red-700'}">${displayApaar}</span>`
              }
              <span class="sr-only">${maskApaarClient(cleanApaar)}</span>
            </td>
            <td class="py-3 px-4 text-slate-900 font-bold">${r.full_name || r.name || 'Candidate'}</td>
            <td class="py-3 px-4">
              <div class="font-semibold text-slate-800">${normalizeBranchClient(r.program)}</div>
              <div class="text-xs text-slate-500">${formatQuotaHuman(r.admission_quota || r.admission_category)} · <span class="font-mono">${allotmentRef}</span></div>
            </td>
            <td class="py-3 px-4">${statusTag}</td>
            <td class="py-3 px-4 text-right whitespace-nowrap space-x-1.5">
              <button
                type="button"
                data-toggle-edit-triage-idx="${idx}"
                class="px-2.5 py-1 rounded-lg ${isEditing ? 'bg-[#0B4EA2] text-white border-[#0B4EA2]' : 'bg-white hover:bg-slate-100 text-slate-700 border-slate-300'} border text-xs font-bold transition-colors cursor-pointer"
              >
                ${isEditing ? 'Done' : 'Edit'}
              </button>
              <button
                type="button"
                data-remove-triage-idx="${idx}"
                class="px-2.5 py-1 rounded-lg bg-white hover:bg-red-50 text-slate-700 hover:text-red-700 border border-slate-300 hover:border-red-300 text-xs font-bold transition-colors cursor-pointer"
              >
                Remove
              </button>
            </td>
          </tr>
        `;
      });

      tableBody.innerHTML = html;
      document.getElementById('countValid')!.textContent = String(valid);
      document.getElementById('countMalformed')!.textContent = String(malformed);
      document.getElementById('countMissing')!.textContent = String(missing);
      if (projectedSeatsEl) {
        projectedSeatsEl.textContent = `${enrolledList.length + netNewValid} / ${sanctioned}`;
      }
      if (commitBtn) commitBtn.disabled = valid === 0;

      if (options && typeof options.focusIdx === 'number' && options.focusIdx >= 0) {
        const restoredInput = tableBody.querySelector<HTMLInputElement>(
          `input[data-edit-triage-idx="${options.focusIdx}"]`
        );
        if (restoredInput) {
          restoredInput.focus();
          const pos = options.selectionStart ?? restoredInput.value.length;
          try {
            restoredInput.setSelectionRange(pos, options.selectionEnd ?? pos);
          } catch {
            // Ignore selection range errors on unsupported input states
          }
        }
      }
    }

