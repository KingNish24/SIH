---
interface Props {
  title?: string;
  activeRole?: 'overview' | 'institution' | 'aicte' | 'university' | 'student' | 'verifier' | 'mandate';
}

const { title = 'SIH 2026 | National Student Data Management & Verification Portal', activeRole = 'overview' } = Astro.props;
const user = Astro.locals.user;

const roleLabels: Record<string, string> = {
  AICTE_ADMIN: 'AICTE Regulatory Council',
  INSTITUTE_ADMIN: 'Institute Admin',
  UNIVERSITY_ADMIN: 'Affiliating University',
  STUDENT: 'Student (DPDP Vault)',
  VERIFIER: 'Verification Officer',
};

interface NavItem {
  id: string;
  label: string;
  path: string;
}

const rolePortalMap: Record<string, NavItem> = {
  AICTE_ADMIN: { id: 'aicte', label: 'AICTE Regulatory Council', path: '/aicte' },
  INSTITUTE_ADMIN: { id: 'institution', label: 'Institution Portal', path: '/institution' },
  UNIVERSITY_ADMIN: { id: 'university', label: 'Affiliating University', path: '/university' },
  STUDENT: { id: 'student', label: 'Student Consent (DPDP)', path: '/student' },
  VERIFIER: { id: 'verifier', label: 'Verification Terminal', path: '/verifier' },
};

let navItems: NavItem[] = [];

if (!user) {
  navItems = [
    { id: 'overview', label: 'Overview', path: '/' },
    { id: 'verifier', label: 'Public Verification', path: '/verifier' },
    { id: 'mandate', label: 'About AICTE Mandate', path: '/#aicte-mandate' },
  ];
} else {
  const userPortal = rolePortalMap[user.role];
  navItems = [
    { id: 'overview', label: 'Overview', path: '/' },
    ...(userPortal ? [userPortal] : []),
    ...(user.role !== 'VERIFIER' ? [{ id: 'verifier', label: 'Public Verification', path: '/verifier' }] : []),
  ];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/emblem.svg" />
    <title>{title}</title>
    <!-- Standard Official Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      /* High contrast focus ring for GIGW accessibility */
      a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible {
        outline: 2px solid #FF9933 !important;
        outline-offset: 2px !important;
      }
    </style>
  </head>
  <body class="bg-[#F8FAFC] text-[#0F172A] min-h-screen flex flex-col antialiased">
    <!-- GIGW Screen Reader Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-[#0F2942] focus:text-white focus:px-4 focus:py-2.5 focus:rounded focus:shadow-2xl focus:border-2 focus:border-[#FF9933] text-xs font-bold uppercase tracking-wider"
    >
      Skip to main content
    </a>

    <!-- 1. Tricolor National Strip -->
    <div class="w-full flex h-1.5 shrink-0" aria-hidden="true">
      <div class="w-1/3 bg-[#FF9933]"></div>
      <div class="w-1/3 bg-[#FFFFFF]"></div>
      <div class="w-1/3 bg-[#138808]"></div>
    </div>

    <!-- 2. Top Ministry & Government Header (White Bar) -->
    <div class="bg-white border-b border-slate-200 py-2.5 px-4 sm:px-8">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-xs">
        <!-- Left: Official State Emblem of India & Department -->
        <div class="flex items-center gap-3">
          <img
            src="/emblem.svg"
            alt="State Emblem of India (Lion Capital of Ashoka)"
            class="h-11 w-auto object-contain shrink-0"
            width="28"
            height="44"
          />
          <div>
            <div class="font-bold text-[#0F2942] tracking-tight uppercase text-[11px] sm:text-xs leading-tight">
              भारत सरकार | Government of India
            </div>
            <div class="text-[#334155] text-[10px] sm:text-[11px] font-medium leading-tight">
              शिक्षा मंत्रालय | Ministry of Education &bull; AICTE
            </div>
          </div>
        </div>

        <!-- Right: Official SIH Badges & GIGW Accessibility Controls -->
        <div class="flex items-center flex-wrap gap-2.5 sm:gap-3 text-[11px] text-slate-600">
          <span class="hidden md:inline-flex bg-slate-100 text-slate-800 font-semibold px-2.5 py-1 rounded border border-slate-200">
            SIH 2026 &bull; Problem Statement SIH26263
          </span>
          <span class="hidden md:inline-block text-slate-300">|</span>

          <!-- GIGW Standard Font Size Scaler (A-, A, A+) -->
          <div class="flex items-center border border-slate-300 rounded overflow-hidden bg-slate-50 font-bold text-slate-700 shadow-sm" role="group" aria-label="Text Size Controls">
            <button
              type="button"
              id="btn-font-decrease"
              class="px-2 py-0.5 hover:bg-slate-200 focus:bg-slate-200 focus:outline-none transition-colors border-r border-slate-200 text-xs"
              title="Decrease Font Size (A-)"
              aria-label="Decrease Font Size"
            >
              A-
            </button>
            <button
              type="button"
              id="btn-font-reset"
              class="px-2 py-0.5 hover:bg-slate-200 focus:bg-slate-200 focus:outline-none transition-colors border-r border-slate-200 text-xs"
              title="Reset Font Size to Standard (A)"
              aria-label="Reset Font Size"
            >
              A
            </button>
            <button
              type="button"
              id="btn-font-increase"
              class="px-2 py-0.5 hover:bg-slate-200 focus:bg-slate-200 focus:outline-none transition-colors text-xs"
              title="Increase Font Size (A+)"
              aria-label="Increase Font Size"
            >
              A+
            </button>
          </div>

          <span class="text-slate-300">|</span>

          <!-- Language Indicator English / हिन्दी -->
          <div class="flex items-center gap-1 bg-slate-100 px-2.5 py-1 rounded border border-slate-200 font-semibold text-slate-700 text-[11px]">
            <span class="text-[#0F2942] font-bold">English</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-500 hover:text-slate-800 cursor-pointer" title="Switch Language">हिन्दी</span>
          </div>

          <span class="text-slate-300">|</span>

          <!-- Top Bar Official Session Pill -->
          {user ? (
            <div class="flex items-center gap-1.5 bg-emerald-50 text-emerald-900 border border-emerald-300 px-2.5 py-0.5 rounded text-[11px] font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-mono">{user.username}</span>
              <span class="text-emerald-700 font-medium">[{roleLabels[user.role] || user.role}]</span>
              {user.institution_id && (
                <span class="bg-blue-100 text-blue-900 px-1 py-0.2 rounded text-[10px] font-mono border border-blue-200 font-bold">
                  {user.institution_id}
                </span>
              )}
            </div>
          ) : (
            <a
              href="/login"
              class="inline-flex items-center gap-1 text-[#0F2942] hover:text-[#1E40AF] font-bold text-[11px]"
            >
              <span>Officer Sign In</span>
              <span>&rarr;</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- 3. Primary Department Navbar (Deep Navy Blue #0F2942) -->
    <header class="bg-[#0F2942] text-white shadow-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Main Portal Title with Official AICTE and SIH Logos -->
          <a href="/" class="flex items-center gap-3 group">
            <div class="flex items-center gap-2 shrink-0">
              <img
                src="/aicte.png"
                alt="AICTE Official Logo"
                class="h-10 w-auto bg-white rounded p-0.5 object-contain shadow-sm"
                width="40"
                height="40"
              />
              <img
                src="/sih_logo.png"
                alt="Smart India Hackathon Official Logo"
                class="h-9 w-auto bg-white/95 rounded px-1.5 py-0.5 object-contain shadow-sm"
                width="48"
                height="36"
              />
            </div>
            <div>
              <div class="font-bold text-sm sm:text-base tracking-tight text-white leading-tight">
                National Student Registry & Verification Portal
              </div>
              <p class="text-[10px] sm:text-[11px] text-slate-300 leading-tight">
                All India Council for Technical Education (AICTE) &bull; Ministry of Education
              </p>
            </div>
          </a>

          <!-- Desktop Navigation Tabs -->
          <nav class="hidden lg:flex items-center space-x-1" aria-label="Portal Navigation">
            {navItems.map((p) => {
              const isActive = activeRole === p.id;
              return (
                <a
                  href={p.path}
                  class={`px-3 py-2 rounded text-xs font-semibold tracking-wide transition-colors ${
                    isActive
                      ? 'bg-white text-[#0F2942] shadow-sm font-bold'
                      : 'text-slate-200 hover:text-white hover:bg-white/10'
                  }`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {p.label}
                </a>
              );
            })}
          </nav>

          <!-- User Authentication Section in Primary Navbar -->
          <div class="hidden lg:flex items-center gap-3 shrink-0">
            {user ? (
              <div class="flex items-center gap-2 bg-slate-800/90 border border-slate-700/80 px-3 py-1.5 rounded shadow-sm text-xs">
                <div class="flex flex-col text-right leading-tight">
                  <div class="flex items-center justify-end gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="font-bold text-white font-mono text-[11px]">{user.username}</span>
                    <span class="bg-blue-900 text-blue-200 border border-blue-700 px-1 py-0.2 rounded text-[10px] font-semibold">
                      [{roleLabels[user.role] || user.role}]
                    </span>
                  </div>
                  {user.role === 'INSTITUTE_ADMIN' && user.institution_id && (
                    <span class="text-[10px] text-amber-300 font-mono font-medium">
                      Institution: {user.institution_id}
                    </span>
                  )}
                </div>
                <a
                  href="/api/auth/logout"
                  class="ml-1 px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-[11px] font-bold shadow-sm transition-colors flex items-center gap-1"
                  title="Sign Out of Gateway"
                >
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  <span>Sign Out</span>
                </a>
              </div>
            ) : (
              <a
                href="/login"
                class="px-4 py-2 bg-[#FF9933] hover:bg-[#F28500] text-black font-bold rounded text-xs transition-colors shadow-sm flex items-center gap-2"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
                <span>Officer Sign In</span>
                <span>&rarr;</span>
              </a>
            )}
          </div>

          <!-- Mobile / Tablet Navigation Select & Sign Out -->
          <div class="lg:hidden flex items-center gap-2">
            <label for="mobile-portal-select" class="sr-only">Select Portal</label>
            <select
              id="mobile-portal-select"
              class="bg-slate-800 text-white text-xs rounded border border-slate-600 px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-[#FF9933]"
              onchange="window.location.href=this.value"
            >
              {navItems.map((p) => (
                <option value={p.path} selected={activeRole === p.id}>
                  {p.label}
                </option>
              ))}
            </select>
            {user ? (
              <a
                href="/api/auth/logout"
                class="px-2 py-1 bg-red-600 text-white rounded text-[11px] font-bold"
                title="Sign Out"
              >
                Exit
              </a>
            ) : (
              <a
                href="/login"
                class="px-2.5 py-1.5 bg-[#FF9933] text-black font-bold rounded text-[11px]"
              >
                Sign In
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Secondary Sub-Navigation Strip (Breadcrumb / Status) -->
      <div class="bg-[#0B1E32] border-t border-slate-700/60 px-4 sm:px-8 py-1.5 text-[11px] text-slate-300">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="text-slate-400">Current Node:</span>
            <span class="font-semibold text-white uppercase tracking-wider">{activeRole.toUpperCase()}</span>
            {user && (
              <span class="hidden sm:inline-flex items-center gap-1 text-slate-300 border-l border-slate-700 pl-2">
                User: <strong class="text-white font-mono">{user.username}</strong>
                <span class="text-emerald-400 font-semibold">[{roleLabels[user.role] || user.role}]</span>
                {user.role === 'INSTITUTE_ADMIN' && user.institution_id && (
                  <span class="text-amber-300 font-mono font-bold bg-amber-950/60 border border-amber-800 px-1.5 py-0.2 rounded ml-1">
                    Tenant: {user.institution_id}
                  </span>
                )}
              </span>
            )}
          </div>
          <div class="flex items-center gap-4 text-slate-400">
            <span class="hidden sm:inline">Regulatory Norms: <strong class="text-emerald-400 font-medium">AICTE Intake Cap Locks Active</strong></span>
            <span>Security: <strong class="text-emerald-400 font-medium">FIDO2 / WebAuthn</strong></span>
          </div>
        </div>
      </div>
    </header>

    <!-- 4. Main Page Content Container -->
    <main id="main-content" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-6 focus:outline-none">
      <slot />
    </main>

    <!-- 5. Standard Government of India Footer -->
    <footer class="bg-[#0F172A] text-slate-400 text-xs border-t border-slate-800 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 py-8">
        <!-- Partner & Standards Row (Digital India, AICTE, GIGW 3.0, DPDP Act 2023) -->
        <div class="flex flex-wrap items-center justify-between gap-6 pb-6 mb-8 border-b border-slate-800">
          <div class="flex items-center flex-wrap gap-4">
            <img
              src="/digital_india.svg"
              alt="Digital India - Power to Empower"
              class="h-9 w-auto object-contain bg-white/10 rounded px-2.5 py-1 border border-slate-700/60"
              width="110"
              height="36"
            />
            <img
              src="/aicte.png"
              alt="All India Council for Technical Education"
              class="h-9 w-auto object-contain bg-white rounded p-0.5"
              width="36"
              height="36"
            />
            <div class="border-l border-slate-700 pl-4 text-[11px] text-slate-300">
              <div class="font-bold text-white uppercase tracking-wider">National Digital Education Architecture</div>
              <div class="text-slate-400">Integrated with APAAR &bull; Academic Bank of Credits (ABC) &bull; DigiLocker</div>
            </div>
          </div>

          <div class="flex items-center flex-wrap gap-3">
            <!-- GIGW 3.0 Compliance Badge -->
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-slate-800/90 text-slate-200 border border-slate-700 text-[11px] font-medium shadow-sm">
              <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              GIGW 3.0 Certified
            </span>

            <!-- DPDP Act 2023 Statutory Badge -->
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-[#07271A] text-emerald-300 border border-emerald-700/70 text-[11px] font-semibold shadow-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              DPDP Act 2023 Statutory Protected
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 pb-8 border-b border-slate-800 text-[11px]">
          <div>
            <div class="font-bold text-white text-xs mb-3 uppercase tracking-wider">
              Regulatory Oversight
            </div>
            <p class="leading-relaxed mb-2">
              All India Council for Technical Education (AICTE), Nelson Mandela Marg, Vasant Kunj, New Delhi-110070.
            </p>
            <p class="text-slate-500">
              Approval Process Handbook 2024–2027 Norms Compliant.
            </p>
          </div>

          <div>
            <div class="font-bold text-white text-xs mb-3 uppercase tracking-wider">
              Statutory Frameworks
            </div>
            <ul class="space-y-1.5">
              <li>&bull; Digital Personal Data Protection (DPDP) Act, 2023</li>
              <li>&bull; National Education Policy (NEP 2020) & APAAR Registry</li>
              <li>&bull; Academic Bank of Credits (ABC) Guidelines</li>
              <li>&bull; W3C Web Authentication (FIDO2) Specifications</li>
            </ul>
          </div>

          <div>
            <div class="font-bold text-white text-xs mb-3 uppercase tracking-wider">
              Portal Ecosystem
            </div>
            <ul class="space-y-1.5">
              <li><a href="/verifier" class="text-emerald-400 font-semibold hover:underline">&bull; Public Verification Gateway (Open)</a></li>
              <li><a href="/login?redirect=%2Finstitution" class="hover:text-white transition-colors">&bull; AICTE Approved Institutions</a></li>
              <li><a href="/login?redirect=%2Faicte" class="hover:text-white transition-colors">&bull; Regulatory Audit Dashboard</a></li>
              <li><a href="/login?redirect=%2Funiversity" class="hover:text-white transition-colors">&bull; Affiliating Universities</a></li>
              <li><a href="/login?redirect=%2Fstudent" class="hover:text-white transition-colors">&bull; Student Consent Management</a></li>
            </ul>
          </div>

          <div>
            <div class="font-bold text-white text-xs mb-3 uppercase tracking-wider">
              Technical Infrastructure
            </div>
            <p class="leading-relaxed mb-2">
              Edge serverless deployment with client-side WebAssembly isolation. Zero unverified PII transmission.
            </p>
            <div class="inline-block bg-slate-800 text-slate-300 px-2.5 py-1 rounded text-[10px] font-mono border border-slate-700">
              System ID: SIH-AICTE-PROD-2026
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-500 text-[11px]">
          <div>
            &copy; 2026 Government of India &bull; All India Council for Technical Education (AICTE). All Rights Reserved.
          </div>
          <div class="flex items-center gap-4">
            <span class="hover:text-slate-300 cursor-pointer">Privacy Policy</span>
            <span>&bull;</span>
            <span class="hover:text-slate-300 cursor-pointer">Terms of Use</span>
            <span>&bull;</span>
            <span class="hover:text-slate-300 cursor-pointer">Hyperlinking Policy</span>
            <span>&bull;</span>
            <span class="hover:text-slate-300 cursor-pointer">Accessibility Statement</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Accessible Gov Toast Notification Container -->
    <div
      id="gov-toast-container"
      class="fixed bottom-5 right-5 z-50 flex flex-col gap-2.5 pointer-events-none max-w-sm w-full px-4 sm:px-0"
      role="region"
      aria-label="System Notifications"
    ></div>

    <script is:inline>
      // 1. GIGW Font Size Scaler Implementation
      (function() {
        let currentScale = 100;
        const root = document.documentElement;

        function setScale(scale) {
          currentScale = Math.max(85, Math.min(125, scale));
          root.style.fontSize = currentScale + '%';
          try {
            localStorage.setItem('gov_font_scale', currentScale.toString());
          } catch (e) {}
        }

        try {
          const saved = localStorage.getItem('gov_font_scale');
          if (saved) setScale(parseInt(saved, 10));
        } catch (e) {}

        document.getElementById('btn-font-decrease')?.addEventListener('click', () => setScale(currentScale - 5));
        document.getElementById('btn-font-reset')?.addEventListener('click', () => setScale(100));
        document.getElementById('btn-font-increase')?.addEventListener('click', () => setScale(currentScale + 5));
      })();

      // 2. Production Grade Accessible Gov Toast Notification System
      window.showToast = function(message, type = 'info', duration = 5000) {
        const container = document.getElementById('gov-toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = 'pointer-events-auto flex items-start gap-3 p-3.5 rounded shadow-2xl text-xs border transition-all duration-300 transform translate-y-3 opacity-0';
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');

        let bgBorder = 'bg-[#0F2942] text-white border-blue-800';
        let icon = `<svg class="w-4 h-4 text-blue-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;

        if (type === 'success') {
          bgBorder = 'bg-[#0D381E] text-emerald-50 border-emerald-600';
          icon = `<svg class="w-4 h-4 text-emerald-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
        } else if (type === 'error' || type === 'danger') {
          bgBorder = 'bg-[#4B0F0F] text-red-50 border-red-600';
          icon = `<svg class="w-4 h-4 text-red-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`;
        } else if (type === 'warning') {
          bgBorder = 'bg-[#4D3300] text-amber-50 border-amber-500';
          icon = `<svg class="w-4 h-4 text-amber-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`;
        }

        toast.className += ' ' + bgBorder;
        toast.innerHTML = `
          ${icon}
          <div class="flex-1 font-medium leading-relaxed">${message}</div>
          <button type="button" class="text-white/60 hover:text-white shrink-0 ml-1 text-base leading-none focus:outline-none" aria-label="Close Notification">&times;</button>
        `;

        const closeBtn = toast.querySelector('button');
        if (closeBtn) {
          closeBtn.onclick = () => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => toast.remove(), 300);
          };
        }

        container.appendChild(toast);
        requestAnimationFrame(() => {
          toast.classList.remove('opacity-0', 'translate-y-3');
          toast.classList.add('opacity-100', 'translate-y-0');
        });

        if (duration > 0) {
          setTimeout(() => {
            if (toast.parentElement) {
              toast.classList.remove('opacity-100', 'translate-y-0');
              toast.classList.add('opacity-0', 'translate-y-2');
              setTimeout(() => toast.remove(), 300);
            }
          }, duration);
        }
      };

      // Safe fallback redirect of native alert() to production toast
      window.alert = function(msg) {
        window.showToast(msg, 'info', 5500);
      };
    </script>
  </body>
</html>
