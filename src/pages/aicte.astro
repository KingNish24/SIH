  <script>
    // 1. LEFT SIDEBAR 1-PANEL-AT-A-TIME TAB NAVIGATION
    const navTabs = document.querySelectorAll<HTMLButtonElement>('.aicte-nav-tab');
    const panels = document.querySelectorAll<HTMLElement>('.aicte-panel');
    const feedbackBanner = document.getElementById('aicteFeedbackBanner');

    function showBanner(message: string, tone: 'warning' | 'success' | 'info' = 'info') {
      if (!feedbackBanner) return;
      feedbackBanner.classList.remove(
        'hidden',
        'bg-amber-50',
        'border-amber-300',
        'text-amber-950',
        'bg-emerald-50',
        'border-emerald-300',
        'text-emerald-950',
        'bg-blue-50',
        'border-blue-300',
        'text-blue-950'
      );
      if (tone === 'warning') {
        feedbackBanner.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-950');
      } else if (tone === 'success') {
        feedbackBanner.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-950');
      } else {
        feedbackBanner.classList.add('bg-blue-50', 'border-blue-300', 'text-blue-950');
      }
      feedbackBanner.textContent = message;
    }

    function switchAicteTab(targetPanelId: string) {
      panels.forEach((p) => {
        p.classList.toggle('hidden', p.id !== targetPanelId);
      });

      navTabs.forEach((tab) => {
        const isTarget = tab.getAttribute('data-aicte-tab') === targetPanelId;
        tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
        const badge = tab.querySelector('[data-sidebar-badge]');
        if (isTarget) {
          tab.className =
            'aicte-nav-tab w-full text-left px-3.5 py-3 rounded-xl text-sm font-bold bg-[#0B4EA2] text-white flex items-center justify-between cursor-pointer transition-colors';
          if (badge) {
            badge.className =
              'px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-white/20 text-white whitespace-nowrap';
          }
        } else {
          tab.className =
            'aicte-nav-tab w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between cursor-pointer transition-colors';
          if (badge) {
            badge.className =
              'px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-600 whitespace-nowrap';
          }
        }
      });
    }

    navTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-aicte-tab');
        if (target) switchAicteTab(target);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-open-duplicates-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        switchAicteTab('panelDuplicates');
      });
    });

    // 2. PANEL 1: SEARCH & FILTER APPROVED COLLEGES TABLE
    const searchInput = document.getElementById('aicteSearchInput') as HTMLInputElement | null;
    const stateSelect = document.getElementById('stateFilter') as HTMLSelectElement | null;
    const statusSelect = document.getElementById('statusFilter') as HTMLSelectElement | null;
    const instRows = document.querySelectorAll<HTMLTableRowElement>('.institution-row');
    const countBadge = document.getElementById('aicteCountBadge');
    const emptyRow = document.getElementById('aicteEmptyRow');

    function filterInstTable() {
      const q = searchInput?.value.toLowerCase().trim() || '';
      const st = stateSelect?.value || '';
      const stat = statusSelect?.value || '';
      let visible = 0;

      instRows.forEach((r) => {
        const text = r.textContent?.toLowerCase() || '';
        const rowState = r.getAttribute('data-state') || '';
        const rowStatus = r.getAttribute('data-status') || '';
        const matchesQ = !q || text.includes(q);
        const matchesState = !st || rowState === st;
        const matchesStatus = !stat || rowStatus === stat;
        const show = matchesQ && matchesState && matchesStatus;
        r.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (countBadge) {
        countBadge.textContent = `${visible} / ${instRows.length}`;
      }
      if (emptyRow) {
        emptyRow.classList.toggle('hidden', visible > 0);
      }
    }

    searchInput?.addEventListener('input', filterInstTable);
    stateSelect?.addEventListener('change', filterInstTable);
    statusSelect?.addEventListener('change', filterInstTable);

    document.querySelectorAll<HTMLButtonElement>('[data-sample-aicte-code]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-sample-aicte-code') || '';
        if (searchInput) {
          searchInput.value = code;
          filterInstTable();
          searchInput.focus();
        }
      });
    });

    // 3. SHOW-CAUSE NOTICE PREVIEW & PERSISTENCE (Panel 1 + Panel 3)
    const noticeCollegeSelect = document.getElementById('noticeCollegeSelect') as HTMLSelectElement | null;
    const noticeViolationSelect = document.getElementById('noticeViolationSelect') as HTMLSelectElement | null;
    const noticePenaltyClause = document.getElementById('noticePenaltyClause') as HTMLTextAreaElement | null;
    const previewNoticeRef = document.getElementById('previewNoticeRef');
    const previewCollegeName = document.getElementById('previewCollegeName');
    const previewCollegeCodeLoc = document.getElementById('previewCollegeCodeLoc');
    const previewSeatNumbers = document.getElementById('previewSeatNumbers');
    const previewViolationType = document.getElementById('previewViolationType');
    const previewDirectiveBody = document.getElementById('previewDirectiveBody');
    const previewNoticeStatusBadge = document.getElementById('previewNoticeStatusBadge');

    function updateNoticePreview() {
      if (!noticeCollegeSelect) return;
      const opt = noticeCollegeSelect.selectedOptions[0];
      const code = noticeCollegeSelect.value;
      const name = opt?.getAttribute('data-college-name') || code;
      const loc = opt?.getAttribute('data-college-state') || '';
      const intake = opt?.getAttribute('data-college-intake') || '0';
      const admitted = opt?.getAttribute('data-college-admitted') || '0';
      const violation = noticeViolationSelect?.value || 'Excess Admission Beyond Approved Intake';
      const clause = noticePenaltyClause?.value || '';

      if (previewNoticeRef) previewNoticeRef.textContent = `AICTE/AB/VIG/2026/${code}`;
      if (previewCollegeName) previewCollegeName.textContent = name;
      if (previewCollegeCodeLoc) previewCollegeCodeLoc.textContent = `Code: ${code} · ${loc}`;
      if (previewSeatNumbers) previewSeatNumbers.textContent = `${admitted} Admitted / ${intake} Approved Seats`;
      if (previewViolationType) previewViolationType.textContent = `Violation: ${violation}`;
      if (previewDirectiveBody) previewDirectiveBody.textContent = clause;
    }

    noticeCollegeSelect?.addEventListener('change', updateNoticePreview);
    noticeViolationSelect?.addEventListener('change', updateNoticePreview);
    noticePenaltyClause?.addEventListener('input', updateNoticePreview);

    document.querySelectorAll<HTMLButtonElement>('[data-prefill-notice-code]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-prefill-notice-code') || '';
        const violation = btn.getAttribute('data-prefill-violation') || '';
        if (noticeCollegeSelect && code) {
          noticeCollegeSelect.value = code;
        }
        if (noticeViolationSelect && violation) {
          noticeViolationSelect.value = violation;
        }
        updateNoticePreview();
        switchAicteTab('panelShowCause');
      });
    });

    async function issueShowCauseNotice(code: string, label: string, btnEl?: HTMLButtonElement | null) {
      if (!code) return;
      if (btnEl) btnEl.disabled = true;
      try {
        const res = await fetch('/api/aicte/anomalies', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'ISSUE_SHOW_CAUSE', code }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (btnEl) {
            btnEl.textContent = 'Notice Issued ✓';
            btnEl.className =
              'px-3 py-1.5 rounded-lg bg-red-900 text-white border border-red-950 font-semibold text-xs transition-colors cursor-pointer whitespace-nowrap';
          }
          if (previewNoticeStatusBadge) {
            previewNoticeStatusBadge.textContent = 'OFFICIAL NOTICE SERVED ✓';
            previewNoticeStatusBadge.className =
              'px-2.5 py-1 rounded-full text-xs font-bold bg-red-900 text-white whitespace-nowrap';
          }
          const msg = data.message || `Official AICTE Show-Cause Notice issued to ${label}.`;
          showBanner(msg, 'warning');
          (window as any).showToast?.(msg, 'warning');
        } else {
          throw new Error(data.error || 'Failed to issue Show-Cause Notice');
        }
      } catch (err: any) {
        (window as any).showToast?.(err.message || 'Error issuing Show-Cause Notice', 'error');
        if (btnEl) btnEl.disabled = false;
      }
    }

    document.getElementById('topShowCauseBtn')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const code = btn.getAttribute('data-notice-code') || '';
      if (noticeCollegeSelect && code) {
        noticeCollegeSelect.value = code;
        updateNoticePreview();
      }
      issueShowCauseNotice(code, code, btn);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-action-notice]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-action-notice') || '';
        const name = btn.getAttribute('data-action-name') || code;
        issueShowCauseNotice(code, name, btn);
      });
    });

    const generateShowCauseSubmitBtn = document.getElementById(
      'generateShowCauseSubmitBtn'
    ) as HTMLButtonElement | null;
    generateShowCauseSubmitBtn?.addEventListener('click', () => {
      const code = noticeCollegeSelect?.value || '';
      const opt = noticeCollegeSelect?.selectedOptions[0];
      const name = opt?.getAttribute('data-college-name') || code;
      issueShowCauseNotice(code, `${name} (${code})`, generateShowCauseSubmitBtn);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-action-docket]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-action-docket') || '';
        showBanner(`Compliance Roster verified: ${target}`, 'success');
        (window as any).showToast?.(`Compliance Roster verified: ${target}`, 'info');
      });
    });

    // 4. PANEL 2: DUPLICATE ADMISSION RESOLUTION / HOLD ACTION
    document.querySelectorAll<HTMLButtonElement>('[data-freeze-apaar]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const apaar = btn.getAttribute('data-freeze-apaar') || '';
        if (!apaar) return;
        btn.disabled = true;
        try {
          const res = await fetch('/api/aicte/anomalies', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'FREEZE_DUPLICATE_SEAT', apaar_id: apaar }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            btn.textContent = 'Duplicate Flagged & Held ✓';
            btn.className =
              'px-3 py-1.5 rounded-lg bg-red-900 text-white border border-red-950 font-semibold text-xs inline-flex items-center gap-1.5 transition-colors whitespace-nowrap';
            const msg = data.message || `Duplicate admission hold applied for APAAR ${apaar}.`;
            showBanner(msg, 'warning');
            (window as any).showToast?.(msg, 'warning');
          } else {
            throw new Error(data.error || 'Failed to apply duplicate seat hold');
          }
        } catch (err: any) {
          (window as any).showToast?.(err.message || 'Error applying duplicate seat hold', 'error');
          btn.disabled = false;
        }
      });
    });

    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.anomaly-filter-btn');
    const anomalyCards = document.querySelectorAll<HTMLElement>('.anomaly-card-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-anomaly-filter') || 'ALL';
        filterBtns.forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
          b.className =
            'anomaly-filter-btn px-3 py-1.5 rounded-lg bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 text-xs font-semibold inline-flex items-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap';
        });
        btn.setAttribute('aria-pressed', 'true');
        btn.className =
          'anomaly-filter-btn px-3 py-1.5 rounded-lg bg-[#0B1E48] text-white border border-[#0B1E48] text-xs font-bold inline-flex items-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap';

        anomalyCards.forEach((card) => {
          const hasNsp = card.getAttribute('data-has-nsp') === 'true';
          if (mode === 'NSP') {
            card.classList.toggle('hidden', !hasNsp);
          } else if (mode === 'DUAL') {
            card.classList.toggle('hidden', hasNsp);
          } else {
            card.classList.remove('hidden');
          }
        });
      });
    });

    // 5. LIVE REGISTRY SYNC & CSV EXPORT
    const refreshBtn = document.getElementById('refreshBtn') as HTMLButtonElement | null;
    refreshBtn?.addEventListener('click', async () => {
      refreshBtn.disabled = true;
      try {
        const res = await fetch('/api/aicte/anomalies');
        const json = await res.json();
        if (json.success && json.data?.summary) {
          const s = json.data.summary;
          const totalEl = document.getElementById('kpiTotalInst');
          const overrunEl = document.getElementById('kpiOverrunCount');
          const dupEl = document.getElementById('kpiDuplicateCount');
          if (totalEl) totalEl.textContent = String(s.totalInstitutions);
          if (overrunEl) overrunEl.textContent = String(s.overrunCount);
          if (dupEl) dupEl.textContent = String(s.duplicateStudentsCount);
          const msg = `National Registry Synchronized: ${s.totalInstitutions} colleges, ${s.overrunCount} over limit, ${s.duplicateStudentsCount} duplicate alert(s).`;
          showBanner(msg, 'success');
          (window as any).showToast?.(msg, 'success');
        } else {
          throw new Error(json.error || 'Failed to sync registry');
        }
      } catch (err: any) {
        (window as any).showToast?.(err.message || 'Error syncing registry', 'error');
      } finally {
        refreshBtn.disabled = false;
      }
    });

    function escapeCsvCell(val: unknown): string {
      let str = String(val ?? '').replace(/"/g, '""');
      if (/^[=+\-@]/.test(str)) {
        str = "'" + str;
      }
      return `"${str}"`;
    }

    const downloadPolicyCsvBtn = document.getElementById('downloadPolicyCsvBtn');
    downloadPolicyCsvBtn?.addEventListener('click', () => {
      const sectionEl = document.getElementById('policyAccreditationSection');
      const rawJson = sectionEl?.getAttribute('data-policy-rows') || '[]';
      let rows: any[] = [];
      try {
        rows = JSON.parse(rawJson);
      } catch {
        rows = [];
      }

      const headers = [
        'institution_id',
        'aicte_code',
        'institution_name',
        'state',
        'district',
        'approved_intake',
        'actual_enrolment',
        'supernumerary_seats_tfw_ews',
        'nri_category',
        'oci_status',
        'foreign_national_fn',
        'nba_naac_accreditation_status',
        'compliance_status',
      ];

      const csvLines = [headers.join(',')];
      rows.forEach((r) => {
        csvLines.push(
          [
            escapeCsvCell(r.id),
            escapeCsvCell(r.code),
            escapeCsvCell(r.name),
            escapeCsvCell(r.state),
            escapeCsvCell(r.district),
            r.approved_intake,
            r.actual_enrolment,
            r.supernumerary_seats,
            r.nri_category,
            r.oci_status,
            r.fn_status,
            escapeCsvCell(r.nba_naac_status),
            escapeCsvCell(r.compliance_status),
          ].join(',')
        );
      });

      const blob = new Blob(['\uFEFF' + csvLines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'aicte_seat_compliance_register_2026.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      (window as any).showToast?.('AICTE Compliance Register CSV downloaded.', 'success');
    });

    // 6. REGISTRY SIGNATURE VERIFICATION (Preserved compatibility)
    async function sha256Browser(text: string): Promise<string> {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }

    async function computeMerkleRootBrowser(hashes: string[]): Promise<string> {
      if (hashes.length === 0) return sha256Browser('VIDYA-EMPTY-LEDGER');
      let level = [...hashes];
      while (level.length > 1) {
        const next: string[] = [];
        for (let i = 0; i < level.length; i += 2) {
          const left = level[i];
          const right = i + 1 < level.length ? level[i + 1] : left;
          next.push(await sha256Browser(`${left}:${right}`));
        }
        level = next;
      }
      return level[0];
    }

    const verifyBtn = document.getElementById('verifyMerkleBtnAicte') as HTMLButtonElement | null;
    verifyBtn?.addEventListener('click', async () => {
      verifyBtn.disabled = true;
      const stripEl = document.getElementById('merkleSummaryStripAicte');
      const statusEl = document.getElementById('merkleStatusTextAicte');
      const rootEl = document.getElementById('merkleRootTextAicte');
      const countEl = document.getElementById('merkleBlockCountAicte');

      stripEl?.setAttribute('aria-busy', 'true');
      if (statusEl) statusEl.textContent = 'Verifying Registry...';

      try {
        const res = await fetch('/api/ledger/merkle');
        const data = await res.json();
        if (!data.success || !Array.isArray(data.blocks)) {
          throw new Error(data.error || 'Failed to load registry records');
        }

        let prev = data.genesis_prev_hash;
        let allValid = true;
        const computedHashes: string[] = [];

        for (const blk of data.blocks) {
          const expectedHash = await sha256Browser(`${prev}:${blk.canonical_payload}`);
          const linkMatches = expectedHash === blk.block_hash && prev === blk.prev_hash;
          if (!linkMatches) allValid = false;
          computedHashes.push(expectedHash);
          prev = expectedHash;
        }

        const browserMerkleRoot = await computeMerkleRootBrowser(computedHashes);
        const rootMatches = browserMerkleRoot === data.merkle_root;

        if (statusEl) {
          statusEl.textContent =
            allValid && rootMatches ? 'All Records Verified ✓' : 'Verification Mismatch';
        }
        if (rootEl) {
          rootEl.textContent = browserMerkleRoot;
        }
        if (countEl) {
          countEl.textContent = String(data.blocks.length);
        }
        showBanner(`Verified ${data.blocks.length} institutional & degree records in the National Registry.`, 'success');
        (window as any).showToast?.(`Verified ${data.blocks.length} registry records.`, 'success');
      } catch (err: any) {
        if (statusEl) statusEl.textContent = err?.message || 'Verification Error';
        (window as any).showToast?.('Error verifying registry signatures', 'error');
      } finally {
        stripEl?.setAttribute('aria-busy', 'false');
        verifyBtn.disabled = false;
      }
    });
  </script>
</Layout>
