    }

    function renderCategoryBadge(cat: string): string {
      const c = (cat || 'APPROVED_INTAKE').toUpperCase();
      if (c.includes('SUPERNUMERARY') || c.includes('TFW') || c.includes('EWS')) {
        return `<span class="bg-blue-50 text-blue-800 px-2 py-0.5 rounded-md border border-blue-200 font-semibold text-[11px]">${i18nClient.catSupernumerary || 'Supernumerary'}</span>`;
