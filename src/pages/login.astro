---
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;
const url = Astro.url;
const redirectParam = url.searchParams.get('redirect') || '';
const reason = url.searchParams.get('reason') || '';
const errorParam = url.searchParams.get('error') || '';

const defaultRedirect = redirectParam && redirectParam.startsWith('/') && !redirectParam.startsWith('/login')
  ? redirectParam
  : '';

const quickSwitchRoles = [
  {
    role: 'AICTE_ADMIN',
    roleLabel: 'AICTE Regulatory Council',
    username: 'aicte.officer',
    password: 'Aicte@2026!',
    target: '/aicte',
    name: 'Dr. S. K. Mahajan',
    badge: 'Statutory Regulator',
    badgeColor: 'bg-amber-100 text-amber-900 border-amber-300',
    description: 'National surveillance, duplicate triage, overrun inspections',
    icon: 'shield',
  },
  {
    role: 'INSTITUTE_ADMIN',
    roleLabel: 'Institution Admin (Principal)',
    username: 'principal.pune',
    password: 'Pune@2026!',
    target: '/institution',
    name: 'Dr. Ramesh Joshi',
    badge: 'Tenant: INST-001 (Pune)',
    badgeColor: 'bg-blue-100 text-blue-900 border-blue-300',
    description: 'Dynamic intake quota monitor, client-side APAAR intake triage',
    icon: 'building',
  },
  {
    role: 'UNIVERSITY_ADMIN',
    roleLabel: 'Affiliating University',
    username: 'registrar.univ',
    password: 'Univ@2026!',
    target: '/university',
    name: 'Prof. K. Venkatesh',
    badge: 'Affiliating Body',
    badgeColor: 'bg-purple-100 text-purple-900 border-purple-300',
    description: 'Tamper-evident degree anchoring & immutable revocation ledger',
    icon: 'academic',
  },
  {
    role: 'STUDENT',
    roleLabel: 'Student Consent (DPDP)',
    username: 'student.rahul',
    password: 'Rahul@2026!',
    target: '/student',
    name: 'Rahul Sharma',
    badge: 'APAAR: 739284019283',
    badgeColor: 'bg-emerald-100 text-emerald-900 border-emerald-300',
    description: 'DPDP Section 6 explicit consent & WebAuthn passkey vault',
    icon: 'user',
  },
  {
    role: 'VERIFIER',
    roleLabel: 'Verification Authority',
    username: 'verifier.gov',
    password: 'Verify@2026!',
    target: '/verifier',
    name: 'Vikramaditya Rao',
    badge: 'UPSC / Corporate Gateway',
    badgeColor: 'bg-sky-100 text-sky-900 border-sky-300',
    description: 'Instant sub-5-second verified degree & admission audit',
    icon: 'check',
  },
];
---

<Layout title="Government of India Single Sign-On | VIDYA Portal">
  <div class="max-w-5xl mx-auto py-4">
    <!-- Notice Banners based on query params -->
    {reason === 'unauthorized' && (
      <div class="mb-6 p-4 rounded bg-amber-50 border-l-4 border-amber-500 text-amber-900 text-xs shadow-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <div class="font-bold text-sm">Access Restricted: Insufficient Privileges or Session Expired</div>
          <p class="mt-0.5 text-amber-800">
            The requested module requires specific Role-Based Access Control (RBAC) authorization. Please authenticate with an account permitted for this administrative boundary.
          </p>
        </div>
      </div>
    )}

    {reason === 'logged_out' && (
      <div class="mb-6 p-4 rounded bg-emerald-50 border-l-4 border-emerald-500 text-emerald-900 text-xs shadow-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <div>
          <div class="font-bold text-sm">Session Successfully Terminated</div>
          <p class="mt-0.5 text-emerald-800">
            Your cryptographic authentication token has been invalidated across the National Data Gateway.
          </p>
        </div>
      </div>
    )}

    {errorParam && (
      <div class="mb-6 p-4 rounded bg-red-50 border-l-4 border-red-500 text-red-900 text-xs shadow-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <div>
          <div class="font-bold text-sm">Authentication Error</div>
          <p class="mt-0.5 text-red-800">{decodeURIComponent(errorParam)}</p>
        </div>
      </div>
    )}

    {user && (
      <div class="mb-6 p-4 rounded bg-blue-50 border border-blue-200 text-blue-900 text-xs shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
          <div>
            <div class="font-bold">Active Authenticated Session</div>
            <div class="text-blue-700">
              Logged in as <strong class="font-mono">{user.username}</strong> ({user.full_name}) &bull; Role: <strong>{user.role}</strong>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={quickSwitchRoles.find(r => r.role === user.role)?.target || '/'}
            class="px-3 py-1.5 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-semibold transition-colors text-xs"
          >
            Go to My Dashboard
          </a>
          <a
            href="/api/auth/logout"
            class="px-3 py-1.5 rounded bg-red-600 hover:bg-red-700 text-white font-semibold transition-colors text-xs"
          >
            Sign Out
          </a>
        </div>
      </div>
    )}

    <!-- Evaluator 1-Click Quick-Switch Bar -->
    <div class="bg-gradient-to-r from-slate-900 via-[#0F2942] to-slate-900 text-white rounded-lg p-5 mb-8 shadow-md border border-slate-700">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 pb-3 border-b border-slate-700">
        <div>
          <div class="flex items-center gap-2">
            <span class="bg-[#FF9933] text-black text-[10px] font-black uppercase px-2 py-0.5 rounded tracking-wider">
              SIH Evaluator Mode
            </span>
            <h2 class="text-base font-bold tracking-tight">1-Click Role Switcher</h2>
          </div>
          <p class="text-xs text-slate-300 mt-1">
            Effortlessly evaluate tenant isolation, statutory permissions, and RBAC views without manually re-typing credentials.
          </p>
        </div>
        <div class="text-[11px] font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-800/80 px-2.5 py-1 rounded self-start md:self-auto">
          ● 5 Pre-Seeded Verified Credentials
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mt-4">
        {quickSwitchRoles.map((item) => (
          <div class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-[#FF9933] rounded-md p-3 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-1 mb-1.5">
                <span class={`text-[9px] font-bold px-1.5 py-0.5 rounded border uppercase tracking-wider ${item.badgeColor}`}>
                  {item.badge}
                </span>
              </div>
              <div class="font-bold text-white text-xs leading-tight group-hover:text-[#FF9933] transition-colors">
                {item.roleLabel}
              </div>
              <div class="text-[11px] text-slate-300 font-medium mt-1 truncate">
                {item.name}
              </div>
              <p class="text-[10px] text-slate-400 mt-1 leading-snug line-clamp-2">
                {item.description}
              </p>
            </div>

            <div class="mt-3 pt-2.5 border-t border-slate-700/60 flex flex-col gap-1.5">
              <div class="text-[10px] font-mono text-slate-400 truncate">
                <span class="text-slate-500">ID:</span> {item.username}
              </div>
              <button
                type="button"
                data-username={item.username}
                data-password={item.password}
                data-role={item.role}
                data-target={item.target}
                class="btn-quick-login w-full py-1.5 px-2 bg-gradient-to-r from-blue-700 to-indigo-700 hover:from-blue-600 hover:to-indigo-600 text-white rounded text-[11px] font-bold shadow-sm transition-all flex items-center justify-center gap-1.5 active:scale-95 cursor-pointer"
              >
                <span>1-Click Switch</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Main Authentication Gateway Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left: Formal GIGW 3.0 Login Form -->
      <div class="lg:col-span-7 bg-white rounded-lg border border-slate-200 shadow-sm p-6 sm:p-8">
        <div class="border-b border-slate-200 pb-4 mb-6">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#1E40AF]">
            <span>GIGW 3.0 Certified Gateway</span>
            <span>&bull;</span>
            <span>Level 3 Assurance</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942] mt-1">
            National Data Gateway Authentication
          </h1>
          <p class="text-xs text-slate-600 mt-1">
            Access restricted to verified academic institutions, statutory regulatory officers, affiliating universities, and students.
          </p>
        </div>

        <form id="formalLoginForm" action="/api/auth/login" method="POST" class="space-y-4 text-xs">
          <input type="hidden" name="redirect" id="formRedirect" value={defaultRedirect} />

          <!-- Username Input -->
          <div>
            <label for="usernameInput" class="block font-bold text-slate-800 uppercase tracking-wider mb-1">
              Government Officer / Student ID (Username) <span class="text-red-600">*</span>
            </label>
            <div class="relative">
              <input
                type="text"
                id="usernameInput"
                name="username"
                required
                autocomplete="username"
                placeholder="e.g. aicte.officer or principal.pune"
                class="w-full bg-slate-50 border border-slate-300 rounded p-2.5 pl-3 font-mono text-slate-900 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#FF9933] focus:border-transparent transition-all"
              />
            </div>
            <p class="text-[11px] text-slate-500 mt-1">
              Case-insensitive official administrative identifier or APAAR registry handle.
            </p>
          </div>

          <!-- Password Input -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="passwordInput" class="block font-bold text-slate-800 uppercase tracking-wider">
                Passcode / Statutory Secret <span class="text-red-600">*</span>
              </label>
              <button
                type="button"
                id="togglePasswordBtn"
                class="text-[11px] font-semibold text-blue-700 hover:underline cursor-pointer"
              >
                Show Password
              </button>
            </div>
            <div class="relative">
              <input
                type="password"
                id="passwordInput"
                name="password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full bg-slate-50 border border-slate-300 rounded p-2.5 pl-3 font-mono text-slate-900 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#FF9933] focus:border-transparent transition-all"
              />
            </div>
            <p class="text-[11px] text-slate-500 mt-1">
              Secured with PBKDF2 SHA-256 (100,000 Key Derivation Iterations).
            </p>
          </div>

          <!-- Role Selector -->
          <div>
            <label for="roleSelector" class="block font-bold text-slate-800 uppercase tracking-wider mb-1">
              Administrative Domain / Role Boundary
            </label>
            <select
              id="roleSelector"
              name="role"
              class="w-full bg-slate-50 border border-slate-300 rounded p-2.5 font-medium text-slate-900 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#FF9933] focus:border-transparent transition-all"
            >
              <option value="">Auto-Detect from Verified Identity</option>
              <option value="AICTE_ADMIN">AICTE Regulatory Council (All India)</option>
              <option value="INSTITUTE_ADMIN">Approved Institution Admin / Principal</option>
              <option value="UNIVERSITY_ADMIN">Affiliating University Examination / Provenance</option>
              <option value="STUDENT">Student Candidate (DPDP Consent Authority)</option>
              <option value="VERIFIER">Public / Corporate Verification Authority</option>
            </select>
          </div>

          <!-- Statutory Declaration & Security Badge -->
          <div class="p-3 bg-slate-50 border border-slate-200 rounded text-[11px] text-slate-600 space-y-1.5">
            <div class="flex items-center gap-2 font-semibold text-slate-800">
              <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Statutory Compliance Declaration</span>
            </div>
            <p>
              By authenticating, you affirm you are the lawful owner or statutory delegate under the IT Act 2000 and DPDP Act 2023. Unauthorized access is punishable under Section 43 & 66.
            </p>
          </div>

          <div id="loginFeedback" class="hidden p-3 rounded text-xs"></div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="loginSubmitBtn"
            class="w-full py-3 bg-[#0F2942] hover:bg-[#1E3A8A] text-white rounded font-bold text-xs uppercase tracking-wider shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-[#FF9933] flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4 text-[#FF9933]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
            <span id="btnText">Sign In to Government Gateway</span>
          </button>
        </form>
      </div>

      <!-- Right: Security & Architecture Info -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Credential Reference Table for Judges -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm p-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">
              Statutory Roles & Pre-Seeded Passwords
            </h3>
            <span class="text-[10px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
              SIH 2026 Test Matrix
            </span>
          </div>

          <div class="divide-y divide-slate-100 text-[11px] mt-2">
            <div class="py-2.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-800">1. AICTE Administrator</span>
                <span class="font-mono text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded">aicte.officer</span>
              </div>
              <div class="flex items-center justify-between text-slate-500 mt-0.5">
                <span>Pass: <code class="font-mono text-slate-700">Aicte@2026!</code></span>
                <span class="text-[10px] text-amber-700 font-medium">All India Regulatory Scope</span>
              </div>
            </div>

            <div class="py-2.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-800">2. Institute Principal</span>
                <span class="font-mono text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded">principal.pune</span>
              </div>
              <div class="flex items-center justify-between text-slate-500 mt-0.5">
                <span>Pass: <code class="font-mono text-slate-700">Pune@2026!</code></span>
                <span class="text-[10px] text-emerald-700 font-medium">Locked to INST-001 (Pune)</span>
              </div>
            </div>

            <div class="py-2.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-800">3. Affiliating University</span>
                <span class="font-mono text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded">registrar.univ</span>
              </div>
              <div class="flex items-center justify-between text-slate-500 mt-0.5">
                <span>Pass: <code class="font-mono text-slate-700">Univ@2026!</code></span>
                <span class="text-[10px] text-purple-700 font-medium">Degree Issuance & Ledger</span>
              </div>
            </div>

            <div class="py-2.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-800">4. Student Candidate</span>
                <span class="font-mono text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded">student.rahul</span>
              </div>
              <div class="flex items-center justify-between text-slate-500 mt-0.5">
                <span>Pass: <code class="font-mono text-slate-700">Rahul@2026!</code></span>
                <span class="text-[10px] text-indigo-700 font-medium">APAAR 739284019283 Vault</span>
              </div>
            </div>

            <div class="py-2.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-800">5. Verification Officer</span>
                <span class="font-mono text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded">verifier.gov</span>
              </div>
              <div class="flex items-center justify-between text-slate-500 mt-0.5">
                <span>Pass: <code class="font-mono text-slate-700">Verify@2026!</code></span>
                <span class="text-[10px] text-sky-700 font-medium">Commission & Corporate Audit</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Security Features Card -->
        <div class="bg-slate-50 rounded-lg border border-slate-200 p-5 text-xs space-y-3">
          <div class="font-bold text-[#0F2942] uppercase tracking-wider text-[11px] flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Cryptographic Session Controls</span>
          </div>
          <ul class="space-y-2 text-slate-600 text-[11px]">
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Tenant Isolation:</strong> Institute admins are mathematically bound to their approved institution ID with strict row-level segregation.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>HTTP-Only Cookie:</strong> Hardened against XSS attacks with SameSite=Lax and Path=/ policy.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Astro Edge Middleware:</strong> Every protected SSR route is validated against Cloudflare D1 before rendering.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Toggle password visibility
  const toggleBtn = document.getElementById('togglePasswordBtn');
  const passInput = document.getElementById('passwordInput') as HTMLInputElement | null;
  if (toggleBtn && passInput) {
    toggleBtn.addEventListener('click', () => {
      const isPass = passInput.type === 'password';
      passInput.type = isPass ? 'text' : 'password';
      toggleBtn.textContent = isPass ? 'Hide Password' : 'Show Password';
    });
  }

  // 1-Click Quick-Switch Buttons
  const quickButtons = document.querySelectorAll('.btn-quick-login');
  quickButtons.forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const username = target.getAttribute('data-username') || '';
      const password = target.getAttribute('data-password') || '';
      const role = target.getAttribute('data-role') || '';
      const destination = target.getAttribute('data-target') || '/';

      const originalHtml = target.innerHTML;
      target.disabled = true;
      target.innerHTML = `<span class="animate-spin inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full"></span> <span>Switching...</span>`;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({ username, password, role, redirect: destination }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = data.redirect || destination;
        } else {
          alert('Login failed: ' + (data.error || 'Unknown error'));
          target.disabled = false;
          target.innerHTML = originalHtml;
        }
      } catch (err: any) {
        alert('Network error while authenticating: ' + err.message);
        target.disabled = false;
        target.innerHTML = originalHtml;
      }
    });
  });

  // Client-side form handler for smooth feedback
  const loginForm = document.getElementById('formalLoginForm') as HTMLFormElement | null;
  const loginFeedback = document.getElementById('loginFeedback');
  const loginSubmitBtn = document.getElementById('loginSubmitBtn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btnText');

  if (loginForm && loginFeedback && loginSubmitBtn && btnText) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginFeedback.className = 'hidden';
      loginSubmitBtn.disabled = true;
      btnText.textContent = 'Verifying Credentials with Cloudflare D1...';

      const formData = new FormData(loginForm);
      const payload: Record<string, any> = {};
      formData.forEach((val, key) => {
        payload[key] = val;
      });

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          loginFeedback.className = 'p-3 rounded text-xs bg-emerald-50 border border-emerald-300 text-emerald-800 font-medium';
          loginFeedback.textContent = 'Authentication successful! Redirecting to authorized portal...';
          btnText.textContent = 'Redirecting...';
          window.location.href = data.redirect || '/';
        } else {
          loginFeedback.className = 'p-3 rounded text-xs bg-red-50 border border-red-300 text-red-800 font-medium';
          loginFeedback.textContent = data.error || 'Authentication rejected by security policy.';
          loginSubmitBtn.disabled = false;
          btnText.textContent = 'Sign In to Government Gateway';
        }
      } catch (err: any) {
        loginFeedback.className = 'p-3 rounded text-xs bg-red-50 border border-red-300 text-red-800 font-medium';
        loginFeedback.textContent = 'Network or server communication failure: ' + err.message;
        loginSubmitBtn.disabled = false;
        btnText.textContent = 'Sign In to Government Gateway';
      }
    });
  }
</script>
