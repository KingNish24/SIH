---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Student, Admission, Degree, VerificationRequest, Institution } from '../lib/types';
import { maskApaar, maskName, maskEmail, maskPhone } from '../lib/types';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const t = getUIDictionary(lang);

const db = getDB(Astro.locals);

const stuRes = await db.prepare('SELECT * FROM students').bind().all<Student>();
const students = stuRes.results || [];

const admRes = await db.prepare('SELECT * FROM admissions').bind().all<Admission>();
const admissions = admRes.results || [];

const degRes = await db.prepare('SELECT * FROM degrees').bind().all<Degree & { signing_key_id?: string }>();
const degrees = degRes.results || [];

const reqRes = await db.prepare('SELECT * FROM verification_requests').bind().all<VerificationRequest>();
const verificationRequests = reqRes.results || [];

const instRes = await db.prepare('SELECT * FROM institutions').bind().all<Institution>();
const institutions = instRes.results || [];

const user = Astro.locals.user;
const studentApaar = user?.role === 'STUDENT' ? user.apaar_id : null;

const activeStudent = (studentApaar ? students.find((s) => s.apaar_id === studentApaar) : students[0]) || students[0];
const initialMaskedName = activeStudent ? maskName(activeStudent.full_name) : 'Candidate';
const initialAvatar = initialMaskedName
  .split(' ')
  .map((p) => p.replace(/[^A-Za-z]/g, '')[0] || '')
  .join('')
  .slice(0, 2)
  .toUpperCase() || 'CA';

const initialConsent = activeStudent?.dpdp_consent_status || 'PENDING';
const initialHasPasskey = !!activeStudent?.passkey_credential_id;

const enrichedAdmissions = admissions.map((a) => {
  const inst = institutions.find((i) => i.id === a.institution_id);
  return {
    ...a,
    institution_name: inst?.name || a.institution_id,
    institution_code: inst?.code || a.institution_id,
  };
});

const enrichedDegrees = degrees.map((d) => {
  const inst = institutions.find((i) => i.id === d.institution_id);
  return {
    ...d,
    institution_name: inst?.name || d.institution_id,
  };
});

interface AbcCreditProfile {
  apaar_id: string;
  student_name: string;
  accumulated_credits: number;
  max_credits: number;
  nep_exit_stage: string;
  semester_breakdown: number[];
  is_lateral_entry: boolean;
  prior_diploma_board: string;
  transferred_credits: number;
  lateral_status: 'VERIFIED_ANCHORED' | 'STANDARD_ENTRY' | 'DISCREPANCY_FLAGGED';
  lateral_note: string;
}

const abcProfiles: Record<string, AbcCreditProfile> = {
  '739284019283': {
    apaar_id: '739284019283',
    student_name: maskName('Rahul Sharma'),
    accumulated_credits: 120,
    max_credits: 160,
    nep_exit_stage: "120 Credits — 3-Year Bachelor's Degree Eligible (Semester 6 Completed)",
    semester_breakdown: [20, 20, 20, 20, 20, 20, 0, 0],
    is_lateral_entry: true,
    prior_diploma_board: 'MSBTE State Polytechnic Diploma (Computer Engg — 80 Credits)',
    transferred_credits: 80,
    lateral_status: 'VERIFIED_ANCHORED',
    lateral_note: 'Prior 3-Year Polytechnic Diploma (80 ABC Credits) cryptographically verified via DigiLocker & MSBTE ledger before 2nd-Year B.Tech Lateral Entry.',
  },
  '412398471029': {
    apaar_id: '412398471029',
    student_name: maskName('Sneha Sundaram'),
    accumulated_credits: 160,
    max_credits: 160,
    nep_exit_stage: '160 Credits — 4-Year B.Tech Honours / Research Degree Conferred',
    semester_breakdown: [20, 20, 20, 20, 20, 20, 20, 20],
    is_lateral_entry: false,
    prior_diploma_board: 'Direct 1st-Year Regular Admission (10+2 PCM Qualifying)',
    transferred_credits: 0,
    lateral_status: 'STANDARD_ENTRY',
    lateral_note: 'All 8 semesters (160 Credits) earned continuously at AICTE-approved parent institution.',
  },
  '582910384729': {
    apaar_id: '582910384729',
    student_name: maskName('Priya Verma'),
    accumulated_credits: 80,
    max_credits: 160,
    nep_exit_stage: '80 Credits — UG Diploma / Lateral Entry Eligible (Exit Year 2)',
    semester_breakdown: [20, 20, 20, 20, 0, 0, 0, 0],
    is_lateral_entry: true,
    prior_diploma_board: 'DTE Karnataka Polytechnic Diploma (Electronics — 80 Credits)',
    transferred_credits: 80,
    lateral_status: 'VERIFIED_ANCHORED',
    lateral_note: 'Verified 80-credit UG Diploma anchored to 12-digit APAAR ID; eligible for NEP 2020 2nd-Year Lateral Entry.',
  },
  '901238471920': {
    apaar_id: '901238471920',
    student_name: maskName('Aaditya Patel'),
    accumulated_credits: 40,
    max_credits: 160,
    nep_exit_stage: '40 Credits — UG Certificate Threshold Reached (Exit Year 1)',
    semester_breakdown: [20, 20, 0, 0, 0, 0, 0, 0],
    is_lateral_entry: false,
    prior_diploma_board: 'Direct 1st-Year Regular Admission (10+2 Qualifying)',
    transferred_credits: 0,
    lateral_status: 'STANDARD_ENTRY',
    lateral_note: 'Completed Year 1 (40 Credits); qualifies for NEP 2020 UG Certificate if exiting early.',
  },
  '601928374819': {
    apaar_id: '601928374819',
    student_name: maskName('Vikram Malhotra'),
    accumulated_credits: 120,
    max_credits: 160,
    nep_exit_stage: 'REVOKED — Unverified Lateral Entry Credit Transfer Blocked',
    semester_breakdown: [0, 0, 20, 20, 20, 20, 20, 20],
    is_lateral_entry: true,
    prior_diploma_board: 'Unverified Private Polytechnic Certificate (No ABC / APAAR Anchor)',
    transferred_credits: 80,
    lateral_status: 'DISCREPANCY_FLAGGED',
    lateral_note: 'ALERT: Claimed 80 lateral-entry diploma credits lacked cryptographic APAAR/ABC provenance. Degree revoked during AICTE audit.',
  },
  '819203847561': {
    apaar_id: '819203847561',
    student_name: maskName('Ananya Sen'),
    accumulated_credits: 160,
    max_credits: 160,
    nep_exit_stage: '160 Credits — 4-Year B.Tech Honours / Research Degree Conferred',
    semester_breakdown: [20, 20, 20, 20, 20, 20, 20, 20],
    is_lateral_entry: false,
    prior_diploma_board: 'Direct 1st-Year Regular Admission (10+2 Qualifying)',
    transferred_credits: 0,
    lateral_status: 'STANDARD_ENTRY',
    lateral_note: 'Full 160-credit B.Tech curriculum verified and anchored on National Academic Bank of Credits.',
  },
};

const initialAbc = abcProfiles[activeStudent?.apaar_id || '739284019283'] || abcProfiles['739284019283'];
---

<Layout title={`SIH 2026 | ${t.student_page_title}`} activeRole="student" lang={lang} breadcrumb={t.crumb_student}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="border-b border-slate-200 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="text-xs font-bold text-[#1E40AF] uppercase tracking-wider mb-1">
          Candidate Consent Module &bull; Code STU-04
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-[#0F2942]">
          {t.student_page_title}
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          {t.student_subtitle}
        </p>
      </div>

      <!-- Candidate Selector with Identity Isolation -->
      <div class="flex items-center gap-2.5 bg-white px-3.5 py-2 rounded border border-slate-200 shadow-sm text-xs sm:text-sm">
        <label for="studentSelector" class="font-semibold text-slate-700 whitespace-nowrap">Candidate:</label>
        {user?.role === 'STUDENT' && studentApaar ? (
          <div class="flex items-center gap-2">
            <select id="studentSelector" class="h-9 bg-slate-100 border border-slate-300 rounded px-2.5 text-slate-800 font-bold focus:outline-none text-xs sm:text-sm">
              {students.filter(s => s.apaar_id === studentApaar).map((s) => (
                <option
                  value={s.apaar_id}
                  data-name={maskName(s.full_name)}
                  data-email={maskEmail(s.email)}
                  data-phone={maskPhone(s.phone)}
                  data-consent={s.dpdp_consent_status}
                  data-haspasskey={s.passkey_credential_id ? 'true' : 'false'}
                  selected
                >
                  {maskName(s.full_name)} (APAAR: {maskApaar(s.apaar_id)})
                </option>
              ))}
            </select>
            <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-900 border border-emerald-300 px-2.5 py-1 rounded text-[11px] font-bold whitespace-nowrap">
              <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Candidate Authenticated ({user.username})</span>
            </span>
          </div>
        ) : (
          <select id="studentSelector" class="h-9 bg-slate-50 border border-slate-300 rounded px-2.5 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-600 text-xs sm:text-sm">
            {students.map((s) => (
              <option
                value={s.apaar_id}
                data-name={maskName(s.full_name)}
                data-email={maskEmail(s.email)}
                data-phone={maskPhone(s.phone)}
                data-consent={s.dpdp_consent_status}
                data-haspasskey={s.passkey_credential_id ? 'true' : 'false'}
                selected={s.apaar_id === activeStudent?.apaar_id}
              >
                {maskName(s.full_name)} (APAAR: {maskApaar(s.apaar_id)})
              </option>
            ))}
          </select>
        )}
      </div>
    </div>

    <!-- Student Identity Profile Card (Clean Indian Gov Design) -->
    <div class="bg-white border border-slate-200 rounded p-5 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded bg-[#0F2942] flex items-center justify-center text-white font-bold text-lg shadow-sm shrink-0">
            <span id="studentAvatar">{initialAvatar}</span>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <span class="text-xs font-bold uppercase text-slate-500">{t.student_consent_label}</span>
              <span
                id="consentBadge"
                role="status"
                aria-live="polite"
                class={`text-[11px] font-bold px-2.5 py-0.5 rounded border ${
                  initialConsent === 'GRANTED'
                    ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
                    : initialConsent === 'REVOKED'
                    ? 'bg-red-100 text-red-800 border-red-200'
                    : 'bg-amber-100 text-amber-800 border-amber-200'
                }`}
              >
                {initialConsent === 'GRANTED'
                  ? t.student_consent_active
                  : initialConsent === 'REVOKED'
                  ? t.student_consent_revoked
                  : 'DPDP CONSENT PENDING'}
              </span>
            </div>
            <h2 id="studentNameDisplay" class="text-base sm:text-lg font-bold text-[#0F2942]">
              {initialMaskedName}
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 font-mono mt-0.5">
              Masked APAAR: <span id="studentApaarDisplay" class="font-semibold text-slate-900">{activeStudent ? maskApaar(activeStudent.apaar_id) : 'XXXX-XXXX-9283'}</span> &bull; 
              Registered Email: <span id="studentEmailDisplay" class="text-slate-600">{activeStudent ? maskEmail(activeStudent.email) : 'r***@***.in'}</span> &bull;
              Phone: <span id="studentPhoneDisplay" class="text-slate-600">{activeStudent ? maskPhone(activeStudent.phone) : '+91 XXXXX X3210'}</span>
            </p>
          </div>
        </div>

        <!-- Biometric Passkey Binding Status -->
        <div class="bg-slate-50 p-3.5 rounded border border-slate-200 text-xs font-mono min-w-[260px]">
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-[10px] font-bold uppercase text-slate-500">Security Standard</span>
            <span
              id="passkeyBindingBadge"
              role="status"
              aria-live="polite"
              class={`inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded border ${
                initialHasPasskey
                  ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
                  : 'bg-amber-100 text-amber-800 border-amber-200'
              }`}
            >
              {initialHasPasskey ? (
                <>
                  <svg class="w-3 h-3 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{t.student_passkey_active}</span>
                </>
              ) : (
                <span>No Passkey Bound — Click Below to Register</span>
              )}
            </span>
          </div>
          <div id="passkeyDeviceDisplay" class="font-bold text-slate-900 mt-1">{t.student_passkey_heading}</div>
          <div class="text-[11px] text-emerald-700 font-medium mt-0.5">{t.student_passkey_sub}</div>
        </div>
      </div>
    </div>

    <!-- FEATURE #2: Purpose-Scoped One-Time Consent Tokens (DPDP Section 6 Data Minimization) -->
    <div class="bg-white border border-slate-200 border-t-4 border-t-[#0F2942] rounded p-5 sm:p-6 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 border-b border-slate-200 pb-4 mb-5">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider bg-blue-50 text-[#1E40AF] border border-blue-200 px-2.5 py-0.5 rounded">
              <svg class="w-3.5 h-3.5 text-[#1E40AF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span>DPDP Act 2023 Section 6(1) &amp; 6(4)</span>
            </span>
            <span class="text-[11px] font-mono font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded">
              Zero-Knowledge Selective Disclosure
            </span>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-[#0F2942]">
            Purpose-Scoped One-Time Consent Tokens (DPDP Section 6 Data Minimization)
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
            Instead of granting blanket transcript access, mint a time-bound, single-use cryptographic token scoped to a specific Verifier Organization, Purpose, and Attribute Set.
          </p>
        </div>
        <div class="shrink-0">
          <span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold bg-slate-100 text-slate-800 px-3 py-1.5 rounded border border-slate-300">
            <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>SHA-256 Signed Token Ledger</span>
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left: Token Minting Form -->
        <div class="lg:col-span-5 bg-slate-50 border border-slate-200 rounded p-4 sm:p-5 space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-[#0F2942] border-b border-slate-200 pb-2 flex items-center justify-between">
            <span>Mint New Purpose-Scoped Token</span>
            <span class="font-mono text-[11px] text-slate-500">POST /api/student/token</span>
          </div>

          <!-- Clickable Example Presets -->
          <div class="bg-white border border-slate-200 rounded p-2.5">
            <div class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5">
              Quick Consent Presets (Click to Populate):
            </div>
            <div class="flex flex-wrap gap-1.5">
              <button
                type="button"
                class="token-preset-chip text-[11px] font-mono font-semibold px-2 py-1 rounded bg-blue-50 hover:bg-blue-100 text-[#1E40AF] border border-blue-200 transition-colors cursor-pointer"
                data-org="UPSC Civil Services Board"
                data-purpose="Degree & Eligibility Verification"
                data-scope="degree_status,cgpa_threshold"
                data-ttl="24"
              >
                UPSC Minimal Proof
              </button>
              <button
                type="button"
                class="token-preset-chip text-[11px] font-mono font-semibold px-2 py-1 rounded bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition-colors cursor-pointer"
                data-org="TCS Background Verification"
                data-purpose="Zero-Knowledge CGPA >= 7.5 Check"
                data-scope="degree_status,cgpa_threshold"
                data-ttl="24"
              >
                TCS ZKP CGPA &gt;= 7.5
              </button>
              <button
                type="button"
                class="token-preset-chip text-[11px] font-mono font-semibold px-2 py-1 rounded bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition-colors cursor-pointer"
                data-org="GATE Admissions Committee (IIT Roorkee)"
                data-purpose="NEP 2020 ABC Credit & Lateral-Entry Audit"
                data-scope="degree_status,cgpa_threshold,abc_credits"
                data-ttl="1"
              >
                GATE 160-Credit Audit
              </button>
            </div>
          </div>

          <div>
            <label for="tokenVerifierOrg" class="block text-xs font-semibold text-slate-700 mb-1">
              Target Verifier Organization:
            </label>
            <select
              id="tokenVerifierOrg"
              class="w-full h-9 bg-white border border-slate-300 rounded px-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
            >
              <option value="">-- Select Target Verifier Organization --</option>
              <option value="UPSC Civil Services Board">UPSC Civil Services Board</option>
              <option value="TCS Background Verification">TCS Background Verification</option>
              <option value="GATE Admissions Committee (IIT Roorkee)">GATE Admissions Committee (IIT Roorkee)</option>
              <option value="DRDO Scientist Entry Recruitment Board">DRDO Scientist Entry Recruitment Board</option>
              <option value="National Scholarship Portal (NSP) Nodal Cell">National Scholarship Portal (NSP) Nodal Cell</option>
            </select>
          </div>

          <div>
            <label for="tokenPurpose" class="block text-xs font-semibold text-slate-700 mb-1">
              Statutory Verification Purpose:
            </label>
            <select
              id="tokenPurpose"
              class="w-full h-9 bg-white border border-slate-300 rounded px-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
            >
              <option value="">-- Select Statutory Verification Purpose --</option>
              <option value="Degree & Eligibility Verification">Degree &amp; Eligibility Verification</option>
              <option value="Zero-Knowledge CGPA >= 7.5 Check">Zero-Knowledge CGPA &gt;= 7.5 Check</option>
              <option value="NEP 2020 ABC Credit & Lateral-Entry Audit">NEP 2020 ABC Credit &amp; Lateral-Entry Audit</option>
              <option value="Pre-Employment Credential Authenticity Check">Pre-Employment Credential Authenticity Check</option>
            </select>
          </div>

          <div>
            <label for="tokenScope" class="block text-xs font-semibold text-slate-700 mb-1">
              Disclosed Attribute Scope (Data Minimization):
            </label>
            <select
              id="tokenScope"
              class="w-full h-9 bg-white border border-slate-300 rounded px-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
            >
              <option value="degree_status,cgpa_threshold">Minimal Proof: Degree Status + CGPA &gt;= 7.5 Only (Hide Marks)</option>
              <option value="degree_status,cgpa_threshold,abc_credits">Academic Credit Proof: Degree Status + ABC Credits (160 Cr)</option>
              <option value="full_transcript">Full Disclosure: Complete Semester Transcript &amp; Signature</option>
            </select>
          </div>

          <div>
            <label for="tokenTtl" class="block text-xs font-semibold text-slate-700 mb-1">
              Token Validity &amp; Usage Policy (TTL):
            </label>
            <select
              id="tokenTtl"
              class="w-full h-9 bg-white border border-slate-300 rounded px-2.5 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
            >
              <option value="24" data-single="true">24 Hours — Single-Use Auto-Burn (Recommended)</option>
              <option value="1" data-single="true">1 Hour — Single-Use High-Security Window</option>
              <option value="24" data-single="false">24 Hours — Multi-Query Audit Window</option>
            </select>
          </div>

          <button
            type="button"
            id="mintTokenBtn"
            class="w-full h-10 px-4 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold text-xs sm:text-sm transition-colors flex items-center justify-center gap-2 shadow-xs"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Mint Purpose-Scoped Consent Token</span>
          </button>

          <!-- Newly Minted Token Banner -->
          <div id="mintedTokenBanner" role="status" aria-live="polite" class="hidden p-3.5 rounded bg-emerald-50 border border-emerald-300 text-xs space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-emerald-900 uppercase tracking-wider text-[11px]">Minted One-Time Token</span>
              <span class="text-[10px] font-mono text-emerald-700 font-semibold">Single-Use Active</span>
            </div>
            <div class="flex items-center justify-between gap-2 bg-white px-3 py-2 rounded border border-emerald-200">
              <code id="mintedTokenCode" class="font-mono font-bold text-sm text-[#0F2942]">VIDYA-DPDP-0000-0000</code>
              <button
                type="button"
                id="copyMintedTokenBtn"
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs transition-colors"
              >
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Copy Token</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right: Active Scoped Tokens List with Instant Revoke -->
        <div class="lg:col-span-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-3">
