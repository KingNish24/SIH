---
import Layout from '../layouts/Layout.astro';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langPrefix = lang === 'en' ? '' : '/' + lang;
const t = getUIDictionary(lang);

const user = Astro.locals.user;
const url = Astro.url;
const redirectParam = url.searchParams.get('redirect') || '';
const reason = url.searchParams.get('reason') || '';
const errorParam = url.searchParams.get('error') || '';

// Smart redirector: if ?redirect= points to a specific portal, route straight to /login/<portal>
if (redirectParam && redirectParam.startsWith('/')) {
  const segs = redirectParam.split('/').filter(Boolean);
  const firstSeg = segs[0] || '';
  const targetSeg = isSupportedLang(firstSeg) ? segs[1] || '' : firstSeg;

  const portalMap: Record<string, string> = {
    institution: 'college',
    college: 'college',
    aicte: 'aicte',
    university: 'university',
    student: 'student',
  };

  const mappedPortal = portalMap[targetSeg];
  if (mappedPortal) {
    const query = new URLSearchParams();
    query.set('redirect', redirectParam);
    if (reason) query.set('reason', reason);
    if (errorParam) query.set('error', errorParam);
    return Astro.redirect(`${langPrefix}/login/${mappedPortal}?${query.toString()}`, 302);
  }
}

const roleTargetMap: Record<string, string> = {
  INSTITUTE_ADMIN: `${langPrefix}/institution`,
  AICTE_ADMIN: `${langPrefix}/aicte`,
  UNIVERSITY_ADMIN: `${langPrefix}/university`,
  STUDENT: `${langPrefix}/student`,
  VERIFIER: `${langPrefix}/verifier`,
};

const portalGateways = [
  {
    id: 'college',
    title: t.portal1Title || 'Colleges',
    badge: 'Nodal Officer',
    subtitle: 'Register admitted students and verify remaining AICTE approved seats.',
    href: `${langPrefix}/login/college`,
    gradient: 'bg-gradient-to-br from-[#1E40AF] to-[#072F6B] hover:from-[#1D4ED8] hover:to-[#093A82]',
    shadow: 'shadow-[0_14px_30px_-8px_rgba(30,64,175,0.38)]',
    iconColor: 'text-[#1E40AF]',
    ctaText: 'College Sign In',
  },
  {
    id: 'aicte',
    title: t.portal2Title || 'AICTE Portal',
    badge: 'Regulator',
    subtitle: 'Audit colleges exceeding approved seat limits and flag duplicate student IDs.',
    href: `${langPrefix}/login/aicte`,
    gradient: 'bg-gradient-to-br from-[#B45309] to-[#78350F] hover:from-[#D97706] hover:to-[#8A3E12]',
    shadow: 'shadow-[0_14px_30px_-8px_rgba(180,83,9,0.38)]',
    iconColor: 'text-[#B45309]',
    ctaText: 'AICTE Sign In',
  },
  {
    id: 'university',
    title: t.nav_university || 'University Portal',
    badge: 'Registrar / COE',
    subtitle: 'Verify seat approval compliance and issue signed digital degrees to NAD.',
    href: `${langPrefix}/login/university`,
    gradient: 'bg-gradient-to-br from-[#4338CA] to-[#27206B] hover:from-[#4F46E5] hover:to-[#312885]',
    shadow: 'shadow-[0_14px_30px_-8px_rgba(67,56,202,0.38)]',
    iconColor: 'text-[#4338CA]',
    ctaText: 'University Sign In',
  },
  {
    id: 'student',
    title: t.portal4Title || 'Students',
    badge: 'Sign In & Sign Up',
    subtitle: 'View your 12-digit APAAR record, seat approval status, or register a new ID.',
    href: `${langPrefix}/login/student`,
    gradient: 'bg-gradient-to-br from-[#047857] to-[#064E3B] hover:from-[#059669] hover:to-[#075C46]',
    shadow: 'shadow-[0_14px_30px_-8px_rgba(4,120,87,0.38)]',
    iconColor: 'text-[#047857]',
    ctaText: 'Student Sign In / Sign Up',
  },
];
---

<Layout
  title={`SIH 2026 | ${t.login_page_title}`}
  activeRole="login"
  breadcrumb={t.crumb_login}
  lang={lang}
>
  <div class="max-w-6xl mx-auto py-4">
    {reason === 'logged_out' && (
      <div class="mb-6 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-950 text-xs flex items-center gap-3">
        <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>
          <strong>You Have Signed Out:</strong> Your session has ended safely. Select your portal below to sign in again.
        </span>
      </div>
    )}

    {user && (
      <div class="mb-6 p-4 rounded-xl bg-blue-50 border border-blue-200 text-blue-950 text-xs flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>
            Signed in as <strong class="font-mono text-[#0F2942]">{user.username}</strong> ({user.full_name})
          </span>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={roleTargetMap[user.role] || (langPrefix || '/')}
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold transition-colors text-xs"
          >
            <span>Open Active Portal</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
            </svg>
          </a>
          <a
            href="/api/auth/logout"
            class="px-3 py-2 rounded-lg bg-white hover:bg-red-50 text-red-700 border border-red-200 font-bold transition-colors text-xs"
          >
            {t.signOut}
          </a>
        </div>
      </div>
    )}

    <!-- Clean Section Heading (No Box Wrapper, Matches Home Page) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#040E29] tracking-tight">
          Choose Your Sign-In Portal
        </h1>
        <p class="text-sm text-slate-600 mt-1">
          Select your dedicated portal below to sign in with your official credentials or 1-click evaluator demo.
        </p>
      </div>

      <a
        href={`${langPrefix}/verifier`}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-emerald-50 border border-slate-200 hover:border-emerald-200 text-[#047857] text-xs font-extrabold transition-all self-start sm:self-auto shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Public Verifier (No Login Required)</span>
      </a>
    </div>

    <!-- 4 Dedicated Portal Login Cards (Matching Approved Home Page Variant C) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {portalGateways.map((item) => (
        <a
          href={item.href}
          class={`group relative rounded-2xl ${item.gradient} text-white p-6 ${item.shadow} hover:-translate-y-0.5 transition-all flex flex-col justify-between overflow-hidden`}
        >
          <svg class="absolute -right-6 -bottom-6 w-28 h-28 text-white/[0.06] pointer-events-none" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <circle cx="50" cy="50" r="50" />
          </svg>

          <div>
            <div class="flex items-center justify-between gap-2 mb-6">
              <div class={`w-12 h-12 rounded-full bg-white ${item.iconColor} flex items-center justify-center shadow-xs shrink-0`}>
                {item.id === 'college' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                {item.id === 'aicte' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                )}
                {item.id === 'university' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {item.id === 'student' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  </svg>
                )}
              </div>

              <span class="px-2.5 py-1 rounded-full bg-white/15 text-[11px] font-bold text-white">
                {item.badge}
              </span>
            </div>

            <h2 class="text-xl font-extrabold text-white mb-2">
              {item.title}
            </h2>
            <p class="text-xs sm:text-[13px] text-white/85 leading-relaxed mb-7">
              {item.subtitle}
            </p>
          </div>

          <div class="pt-4 border-t border-white/15 flex items-center justify-between text-xs font-extrabold text-[#FFAE19] group-hover:text-white transition-colors">
            <span>{item.ctaText}</span>
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
