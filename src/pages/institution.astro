      const capUiVal = parseInt(selectedOpt?.getAttribute('data-sanctioned') || '180', 10);
      let nextEnrollment = Math.max(0, currentUiVal - 1);

      try {
        const res = await fetch('/api/roster/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'withdraw_admission',
            admissionId,
            apaar_id: apaarId,
            institutionId: instId,
          }),
        });
        const data = await res.json().catch(() => null);
        if (data && typeof data.new_enrollment === 'number') {
          nextEnrollment = data.new_enrollment;
        }
      } catch {
        // Fallback to local seat decrement
      }

      const row = target.closest('tr');
      row?.remove();

      enrolledList = enrolledList.filter((item) => item.apaar_id !== apaarId && item.id !== admissionId);
      if (enrolledCountPill) enrolledCountPill.textContent = String(enrolledList.length);

      if (selectedOpt) {
