      const statusFilter = rosterStatusFilter?.value || 'ALL';
      const rows = enrolledTableBody.querySelectorAll<HTMLTableRowElement>('tr[data-row-apaar]');

      rows.forEach((row) => {
        const apaar = (row.getAttribute('data-row-apaar') || '').toLowerCase();
