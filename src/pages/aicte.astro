                      <span
                        class={`px-2.5 py-0.5 rounded-full text-xs font-bold whitespace-nowrap ${
                          log.result_status === 'VERIFIED'
                            ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                            : 'bg-red-100 text-red-800 border border-red-200'
                        }`}
                      >
                        {log.result_status}
                      </span>
                    </td>
                  </tr>
                ))}
