---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import { maskApaar, type Institution, type Student, type Admission, type AdmissionQuota, type BranchSeatMatrixRow } from '../lib/types';
import { getUIDictionary, type LangCode, isSupportedLang } from '../lib/i18n';

const lang: LangCode = isSupportedLang(Astro.locals.lang) ? Astro.locals.lang : 'en';
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = getUIDictionary(lang);

const db = getDB(Astro.locals);
const user = Astro.locals.user;

const isTenantLocked = user?.role === 'INSTITUTE_ADMIN' && !!user?.institution_id;
const targetInstId = isTenantLocked ? user.institution_id : null;

const allInstRes = await db.prepare('SELECT * FROM institutions ORDER BY id ASC').bind().all<Institution>();
const allInstitutions = allInstRes.results || [];

let institutions: Institution[] = [];
if (targetInstId) {
  const instRes = await db.prepare('SELECT * FROM institutions WHERE id = ?').bind(targetInstId).all<Institution>();
  institutions = instRes.results || [];
} else {
  institutions = allInstitutions;
}

const collegeA = institutions.find((i) => i.id === (targetInstId || 'INST-001')) || institutions[0] || {
  id: targetInstId || 'INST-001',
  name: 'Apex Institute of Engineering, Pune',
  code: 'TCA-1049',
  sanctioned_intake: 180,
  current_enrollment: 12,
  status: 'NORMAL',
  risk_score: 14.2,
  state: 'Maharashtra',
  district: 'Pune',
};

const instAdmissionsRes = await db
  .prepare('SELECT * FROM admissions WHERE institution_id = ?')
  .bind(collegeA.id)
  .all<Admission>();
const rawInstAdmissions = instAdmissionsRes.results || [];

const allStudentsRes = await db.prepare('SELECT * FROM students').bind().all<Student>();
const allStudents = allStudentsRes.results || [];
const studentByApaar = new Map<string, Student>(allStudents.map((s) => [s.apaar_id, s]));

const allAdmissionsRes = await db.prepare('SELECT * FROM admissions').bind().all<Admission>();
const allAdmissions = allAdmissionsRes.results || [];
const instMap = new Map<string, Institution>(allInstitutions.map((i) => [i.id, i]));

const APPROVED_BRANCHES = [
  { branch: 'B.Tech Computer Science', code: 'CSE-101', short: 'CSE', sanctioned: 60 },
  { branch: 'B.Tech Electronics & Comm.', code: 'ECE-102', short: 'ECE', sanctioned: 60 },
  { branch: 'B.Tech Mechanical Engg', code: 'MECH-103', short: 'MECH', sanctioned: 60 },
] as const;

function normalizeBranchName(rawProgram?: string): (typeof APPROVED_BRANCHES)[number]['branch'] {
  const p = (rawProgram || '').toLowerCase();
  if (p.includes('mech')) return 'B.Tech Mechanical Engg';
  if (p.includes('elec') || p.includes('comm') || p.includes('ece') || p.includes('entc')) {
    return 'B.Tech Electronics & Comm.';
  }
  return 'B.Tech Computer Science';
}

function normalizeQuotaCode(rawQuota?: string, fallbackIdx = 0): AdmissionQuota {
  const q = (rawQuota || '').toUpperCase().trim();
  if (q === 'SUPERNUMERARY' || q.includes('TFW') || q.includes('EWS') || q.includes('PMSSS')) return 'SUPERNUMERARY';
  if (q === 'NRI' || q.includes('NRI')) return 'NRI';
  if (q === 'OCI' || q.includes('OCI') || q.includes('PIO')) return 'OCI';
  if (q === 'FN' || q.includes('FOREIGN')) return 'FN';
  if (q === 'APPROVED_INTAKE' || q.includes('MERIT') || q.includes('JOSAA') || q.includes('CAP') || q.includes('REGULAR')) return 'APPROVED_INTAKE';
  if (fallbackIdx % 5 === 1) return 'SUPERNUMERARY';
  if (fallbackIdx % 7 === 2) return 'NRI';
  return 'APPROVED_INTAKE';
}

function getQuotaLabel(quota: AdmissionQuota): string {
  switch (quota) {
    case 'SUPERNUMERARY':
      return 'TFW / EWS Quota';
    case 'NRI':
      return 'NRI Quota';
    case 'OCI':
      return 'OCI / PIO Quota';
    case 'FN':
      return 'Foreign National Quota';
    default:
      return 'Regular Merit';
  }
}

const initialAdmissions = rawInstAdmissions.map((adm, idx) => {
  const st = studentByApaar.get(adm.apaar_id);
  const otherColleges = allAdmissions
    .filter((other) => other.apaar_id === adm.apaar_id && other.institution_id !== adm.institution_id)
    .map((other) => {
      const otherInst = instMap.get(other.institution_id);
      return otherInst ? otherInst.name.split('(')[0].trim() : other.institution_id;
    });
  const isCrossDuplicate = Boolean(adm.is_duplicate) || adm.status === 'FLAGGED_DUPLICATE' || otherColleges.length > 0;
  const canonicalBranch = normalizeBranchName(adm.program);
  const branchMeta = APPROVED_BRANCHES.find((b) => b.branch === canonicalBranch) || APPROVED_BRANCHES[0];

  const rollId =
    adm.roll_number ||
    (adm as any).student_roll_id ||
    `TCA24${branchMeta.short === 'CSE' ? 'CS' : branchMeta.short === 'ECE' ? 'EC' : 'ME'}${String(idx + 1).padStart(3, '0')}`;

  const fullName = st?.full_name || adm.student_name || `Candidate ${idx + 1}`;
  const initials = fullName
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() || '')
    .join('');

  const quotaCode = normalizeQuotaCode(adm.admission_quota || (adm as any).admission_category, idx);
  const quotaLabel = getQuotaLabel(quotaCode);
  const allotmentRef = adm.allotment_ref || `CET-2024-MH-${88210 + idx}`;

  const formattedApaar =
    adm.apaar_id && adm.apaar_id.length === 12
      ? `${adm.apaar_id.slice(0, 4)}-${adm.apaar_id.slice(4, 8)}-${adm.apaar_id.slice(8, 12)}`
      : adm.apaar_id;

  return {
    id: adm.id,
    apaar_id: adm.apaar_id,
    formatted_apaar: formattedApaar,
    masked_apaar: maskApaar(adm.apaar_id),
    roll_id: rollId,
    full_name: fullName,
    initials: initials || 'ST',
    email: st?.email || `${adm.apaar_id.slice(-4)}@college.edu.in`,
    dpdp_consent_status: st?.dpdp_consent_status || 'GRANTED',
    program: canonicalBranch,
    branch_code: branchMeta.code,
    batch_year: adm.batch_year || 2026,
    enrollment_date: adm.enrollment_date || '2026-08-14',
    status: isCrossDuplicate ? 'FLAGGED_DUPLICATE' : adm.status || 'ENROLLED',
    is_duplicate: isCrossDuplicate,
    other_colleges: otherColleges,
    admission_quota: quotaCode,
    quota_label: quotaLabel,
    allotment_ref: allotmentRef,
  };
});

const sanctionedCap = collegeA.sanctioned_intake || 180;
const actualAdmittedCount = initialAdmissions.length;
if (collegeA.current_enrollment !== actualAdmittedCount) {
  await db
    .prepare('UPDATE institutions SET current_enrollment = ?, status = ? WHERE id = ?')
    .bind(actualAdmittedCount, actualAdmittedCount > sanctionedCap ? 'OVERRUN_RISK' : 'NORMAL', collegeA.id)
    .run();
  collegeA.current_enrollment = actualAdmittedCount;
  collegeA.status = actualAdmittedCount > sanctionedCap ? 'OVERRUN_RISK' : 'NORMAL';
}
const vacantSeatsCount = Math.max(0, sanctionedCap - actualAdmittedCount);
const duplicateCount = initialAdmissions.filter((a) => a.is_duplicate).length;

const quotaCounts = {
  APPROVED_INTAKE: initialAdmissions.filter((a) => a.admission_quota === 'APPROVED_INTAKE').length,
  SUPERNUMERARY: initialAdmissions.filter((a) => a.admission_quota === 'SUPERNUMERARY').length,
  NRI: initialAdmissions.filter((a) => a.admission_quota === 'NRI').length,
  OCI: initialAdmissions.filter((a) => a.admission_quota === 'OCI').length,
  FN: initialAdmissions.filter((a) => a.admission_quota === 'FN').length,
};

const quotaCeilings = {
  SUPERNUMERARY: Math.round(sanctionedCap * 0.15), // 27
  NRI: Math.round(sanctionedCap * 0.05), // 9
  OCI: Math.max(1, Math.round(sanctionedCap * 0.02)), // 4
  FN: Math.max(1, Math.round(sanctionedCap * 0.03)), // 5
};

const branchMatrix: BranchSeatMatrixRow[] = APPROVED_BRANCHES.map((b) => {
  const rows = initialAdmissions.filter((a) => a.program === b.branch);
  const admitted = rows.length;
  const approved_intake = rows.filter((a) => a.admission_quota === 'APPROVED_INTAKE').length;
  const supernumerary = rows.filter((a) => a.admission_quota === 'SUPERNUMERARY').length;
  const nri_oci_fn = rows.filter((a) => a.admission_quota === 'NRI' || a.admission_quota === 'OCI' || a.admission_quota === 'FN').length;
  const duplicates = rows.filter((a) => a.is_duplicate).length;
  const vacant = Math.max(0, b.sanctioned - admitted);
  const utilization_pct = Number(((admitted / Math.max(1, b.sanctioned)) * 100).toFixed(1));
  return {
    branch: b.branch,
    code: b.code,
    sanctioned: b.sanctioned,
    admitted,
    approved_intake,
    supernumerary,
    nri_oci_fn,
    duplicates,
    vacant,
    utilization_pct,
  };
});

const initialPct = ((actualAdmittedCount / Math.max(1, sanctionedCap)) * 100).toFixed(1);

const clientI18n = {
  langPrefix,
  statusCompliant: t.inst_status_compliant,
  statusOverrun: t.inst_status_overrun,
  kpiSanctioned: t.inst_kpi_sanctioned,
  validApaar: t.inst_triage_valid,
  missingApaar: t.inst_triage_missing,
  malformedApaar: t.inst_triage_malformed,
  syncBtn: t.inst_sync_btn,
  catSupernumerary: t.inst_cat_supernumerary,
  catNri: t.inst_cat_nri,
  catOci: t.inst_cat_oci,
  catFn: t.inst_cat_fn,
};
---

<Layout title={`SIH 2026 | ${t.inst_page_title}`} activeRole="institution" lang={lang} breadcrumb={t.crumb_institution}>
  <div
    class="space-y-6"
    id="instPageRoot"
    data-i18n-client={JSON.stringify(clientI18n)}
    data-initial-admissions={JSON.stringify(initialAdmissions)}
    data-college-id={collegeA.id}
  >
    <!-- Hidden Tenant Input for Script Compatibility -->
    <input
      type="hidden"
      id="activeCollege"
      value={collegeA.id}
      data-institution-id={collegeA.id}
      data-sanctioned={collegeA.sanctioned_intake}
      data-current={initialAdmissions.length}
      data-code={collegeA.code}
      data-name={collegeA.name}
    />

    <!-- Dynamic Feedback Banner -->
    <div id="syncFeedbackAlert" class="hidden rounded-xl border p-4 text-sm" role="alert" aria-live="assertive"></div>

    <!-- INDIAN GOVERNMENT PORTAL 2-COLUMN LEFT SIDEBAR + RIGHT MAIN CONTENT LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- 1. LEFT SIDEBAR (NIC / Samarth eGov / AISHE / Parakh Style) -->
      <aside class="lg:col-span-3 lg:sticky lg:top-6">
        <div class="rounded-2xl bg-white border border-slate-200 overflow-hidden">
          <!-- Top College Identity Block inside Sidebar -->
          <div class="bg-[#0B1E48] text-white p-5">
            <div class="text-[11px] font-mono uppercase tracking-wider text-blue-200">
              AISHE CODE: <span id="meterCollegeCode">{collegeA.code || 'TCA-1049'}</span>
            </div>
            <h1 id="meterCollegeName" class="text-base font-bold text-white mt-1 leading-snug">
              {collegeA.name}
            </h1>
            <p class="text-xs text-blue-200 mt-1">
              <span id="meterLocationText">{collegeA.district || 'Pune'}, {collegeA.state || 'Maharashtra'}</span> · Session 2026–27
            </p>
            <div class="mt-3 pt-3 border-t border-white/15 text-xs text-blue-100 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
              <span>Dr. Ramesh Joshi (Principal)</span>
            </div>
          </div>

          <!-- Vertical Navigation Menu -->
          <div
            class="p-3 space-y-1"
            role="tablist"
            aria-label="Admission Office Menu"
          >
            <div class="px-3 pt-1 pb-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">
              ADMISSION OFFICE MENU
            </div>

            <!-- Menu Item 1 (Default Active) -->
            <button
              type="button"
              id="viewEnrolledTabBtn"
              role="tab"
              aria-selected="true"
              aria-controls="enrolledRosterPanel"
              class="w-full text-left px-3.5 py-3 rounded-xl text-sm font-bold bg-[#0B4EA2] text-white flex items-center justify-between cursor-pointer transition-colors"
            >
              <span class="inline-flex items-center gap-2.5">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>Admitted Students</span>
              </span>
              <span
                id="enrolledCountPill"
                data-sidebar-badge
                class="px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-white/20 text-white"
              >
                {actualAdmittedCount}
              </span>
            </button>

            <!-- Menu Item 2 -->
            <button
              type="button"
              id="tabSingleEntryBtn"
              role="tab"
              aria-selected="false"
              aria-controls="panelSingleEntry"
              class="w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between cursor-pointer transition-colors"
            >
              <span class="inline-flex items-center gap-2.5">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
                <span>Admit New Student</span>
              </span>
              <span
                data-sidebar-badge
                class="px-2 py-0.5 rounded-full text-[11px] font-mono font-bold bg-slate-100 text-slate-600"
              >
                APAAR
              </span>
            </button>

            <!-- Menu Item 3 -->
            <button
              type="button"
              id="tabBulkCsvBtn"
              role="tab"
              aria-selected="false"
              aria-controls="panelBulkCsv"
              class="w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between cursor-pointer transition-colors"
            >
              <span class="inline-flex items-center gap-2.5">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <span>Bulk Excel / CSV Upload</span>
              </span>
            </button>

            <!-- Menu Item 4 -->
            <button
              type="button"
              id="viewBranchMatrixTabBtn"
              role="tab"
              aria-selected="false"
              aria-controls="branchMatrixPanel"
              class="w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between cursor-pointer transition-colors"
            >
              <span class="inline-flex items-center gap-2.5">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
                <span>Branch &amp; Seat Matrix</span>
              </span>
              <span
                data-sidebar-badge
                class="px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-600"
              >
                {sanctionedCap}
              </span>
            </button>
          </div>

          <!-- Bottom Quick Help / Helpline Box inside Sidebar -->
          <div class="p-4 bg-slate-50 border-t border-slate-200 text-xs text-slate-600 space-y-1">
            <div class="font-bold text-[#0B1E48]">NIC / AICTE Nodal Helpdesk</div>
            <div class="font-mono text-slate-500">Toll-Free: 1800-889-3511</div>
          </div>
        </div>
      </aside>

      <!-- 2. RIGHT MAIN CONTENT AREA -->
      <div class="lg:col-span-9 space-y-5 min-w-0">
        <!-- Top Row inside Right Area: 4 Compact, Clear Summary Cards -->
        <section aria-label="College Seat Summary" class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <!-- Card 1: Approved Seats -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Approved Seats</div>
            <div class="text-2xl font-extrabold text-[#0B1E48] mt-1">
              <span id="meterSanctioned">{sanctionedCap}</span>
              <span id="meterCap" class="sr-only">{sanctionedCap}</span>
            </div>
            <div class="text-xs text-slate-500 mt-0.5">3 B.Tech Branches</div>
          </div>

          <!-- Card 2: Students Admitted -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Students Admitted</div>
            <div id="meterEnrolled" class="text-2xl font-extrabold text-[#0B4EA2] mt-1">
              {actualAdmittedCount}
            </div>
            <div id="meterPercent" class="text-xs text-slate-500 mt-0.5">
              {initialPct}% seats filled
            </div>
          </div>

          <!-- Card 3: Vacant Seats -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Vacant Seats</div>
            <div class="text-2xl font-extrabold text-emerald-700 mt-1">
              <span id="meterVacant">{vacantSeatsCount}</span>
              <span id="meterVacantCount" class="sr-only">{vacantSeatsCount}</span>
            </div>
            <div class="text-xs text-slate-500 mt-0.5">Open for admission</div>
          </div>

          <!-- Card 4: Duplicate Alerts -->
          <div class="rounded-xl bg-white border border-slate-200 p-4">
            <div class="text-xs font-semibold text-slate-600">Duplicate Alerts</div>
            <div class="text-2xl font-extrabold text-amber-700 mt-1">
              <span id="meterDuplicates">{duplicateCount}</span>
              <span id="meterDuplicateCount" class="sr-only">{duplicateCount}</span>
            </div>
            <div class="text-xs text-amber-800 font-medium mt-0.5">2 colleges at once</div>
          </div>
        </section>

        <!-- Active View Card -->
        <div class="rounded-2xl bg-white border border-slate-200 overflow-hidden">
          <!-- PANEL 1 (Default Visible): ADMITTED STUDENTS REGISTER -->
          <div
            id="enrolledRosterPanel"
            role="tabpanel"
            aria-labelledby="viewEnrolledTabBtn"
          >
            <!-- Card Header Bar -->
            <div class="px-5 py-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-base font-bold text-[#0B1E48]">
                Admitted Students Register (2026–27)
              </h2>

              <div class="flex flex-wrap items-center gap-2.5">
                <button
                  type="button"
                  id="exportRosterCsvBtn"
                  class="h-9 px-3.5 rounded-lg bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 text-xs font-bold transition-colors inline-flex items-center gap-2 cursor-pointer"
                >
                  <svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  <span>Download Excel / CSV</span>
                </button>

                <button
                  type="button"
                  id="openAdmitTabBtn"
                  class="h-9 px-3.5 rounded-lg bg-[#0B4EA2] hover:bg-[#083B7E] text-white text-xs font-bold transition-colors inline-flex items-center gap-1.5 cursor-pointer"
                >
                  <span>+ Admit New Student</span>
                </button>
              </div>
            </div>

            <!-- Filter Bar -->
            <div class="px-5 py-3 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center gap-3">
              <div class="relative flex-1 min-w-[220px]">
                <svg
                  class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input
                  type="search"
                  id="rosterSearchInput"
                  placeholder="Search by Student Name, APAAR ID, or Roll No..."
                  aria-label="Search by Student Name, APAAR ID, or Roll No"
                  class="w-full h-9 pl-9 pr-3 rounded-lg bg-white border border-slate-300 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                />
              </div>

              <select
                id="rosterBranchFilter"
                aria-label="Filter by Branch"
                class="h-9 px-3 rounded-lg bg-white border border-slate-300 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
              >
                <option value="ALL">All Branches</option>
                <option value="B.Tech Computer Science">B.Tech Computer Science</option>
                <option value="B.Tech Electronics & Comm.">B.Tech Electronics &amp; Comm.</option>
                <option value="B.Tech Mechanical Engg">B.Tech Mechanical Engg</option>
              </select>

              <select
                id="rosterStatusFilter"
                aria-label="Filter by Verification Status"
                class="h-9 px-3 rounded-lg bg-white border border-slate-300 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
              >
                <option value="ALL">All Students</option>
                <option value="VERIFIED">Verified Students</option>
                <option value="DUPLICATE" id="filterDuplicateOption">Duplicate Alerts ({duplicateCount})</option>
              </select>
            </div>

            <!-- Clean Table -->
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs sm:text-sm border-collapse">
                <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                  <tr>
                    <th class="py-3 px-3 whitespace-nowrap">Student &amp; Roll No.</th>
                    <th class="py-3 px-3 whitespace-nowrap">12-Digit APAAR ID</th>
                    <th class="py-3 px-3 whitespace-nowrap">Branch &amp; Quota</th>
                    <th class="py-3 px-3 whitespace-nowrap">Status</th>
                    <th class="py-3 px-3 text-right whitespace-nowrap">Action</th>
                  </tr>
                </thead>
                <tbody id="enrolledTableBody" class="divide-y divide-slate-200 text-slate-800">
                  {initialAdmissions.map((adm) => (
                    <tr
                      class="hover:bg-slate-50/90 transition-colors"
                      data-row-apaar={adm.apaar_id}
                      data-row-name={adm.full_name.toLowerCase()}
                      data-row-roll={adm.roll_id.toLowerCase()}
                      data-row-branch={adm.program}
                      data-row-status={adm.is_duplicate ? 'DUPLICATE' : 'VERIFIED'}
                    >
                      <td class="py-3 px-3 whitespace-nowrap">
                        <div class="font-bold text-slate-900">{adm.full_name}</div>
                        <div class="font-mono text-xs text-slate-500 mt-0.5">Roll: {adm.roll_id}</div>
                      </td>
                      <td class="py-3 px-3 whitespace-nowrap">
                        <span class="font-mono font-bold text-[#0B1E48]">{adm.formatted_apaar}</span>
                      </td>
                      <td class="py-3 px-3 whitespace-nowrap">
                        <div class="font-semibold text-slate-900">{adm.program}</div>
                        <div class="text-xs text-slate-500 mt-0.5">{adm.quota_label} · <span class="font-mono">{adm.allotment_ref}</span></div>
                      </td>
                      <td class="py-3 px-3">
                        {adm.is_duplicate ? (
                          <div class="space-y-0.5 max-w-[9.5rem]">
                            <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 px-2 py-0.5 rounded-full border border-amber-300 font-bold text-xs whitespace-nowrap">
                              <span>⚠ Duplicate Alert</span>
                            </span>
                            <div class="text-[11px] text-amber-800 font-medium truncate" title={`Also at ${adm.other_colleges.length > 0 ? adm.other_colleges.join(', ') : 'Metro Institute of Technology, Bengaluru'}`}>
                              Also at {adm.other_colleges.length > 0 ? adm.other_colleges.join(', ') : 'Metro Institute of Technology, Bengaluru'}
                            </div>
                          </div>
                        ) : (
                          <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-800 px-2.5 py-0.5 rounded-full border border-emerald-200 font-bold text-xs whitespace-nowrap">
                            <span>✓ Verified</span>
                          </span>
                        )}
                      </td>
                      <td class="py-3 px-3 text-right whitespace-nowrap">
                        <button
                          type="button"
                          data-withdraw-id={adm.id}
                          data-withdraw-apaar={adm.apaar_id}
                          data-withdraw-name={adm.full_name}
                          class="px-2.5 py-1.5 rounded-lg bg-white hover:bg-red-50 text-slate-700 hover:text-red-700 border border-slate-300 hover:border-red-300 text-xs font-bold transition-colors cursor-pointer whitespace-nowrap"
                        >
                          Cancel Seat
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- PANEL 2 (Hidden until clicked): SPACIOUS "+ ADMIT NEW STUDENT" FORM -->
          <div
            id="panelSingleEntry"
            role="tabpanel"
            aria-labelledby="tabSingleEntryBtn"
            class="hidden"
          >
            <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between gap-3">
              <div>
                <h2 class="text-base font-bold text-[#0B1E48]">Admit New Student</h2>
                <p class="text-xs text-slate-600 mt-0.5">
                  Check the student's 12-digit APAAR ID first, then select their branch and seat quota to confirm admission.
                </p>
              </div>
            </div>

            <div class="p-5 sm:p-6">
              <form id="singleStudentForm" class="space-y-5">
                <!-- Step 1 Box -->
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-4">
                  <h3 class="text-base font-bold text-[#0B1E48]">
                    Step 1: Check Student's 12-Digit APAAR ID
                  </h3>

                  <div>
                    <label for="singleApaarInput" class="block text-sm font-semibold text-slate-800 mb-1.5">
                      12-Digit APAAR ID
                    </label>
                    <div class="flex flex-col sm:flex-row gap-3">
                      <input
                        type="text"
                        id="singleApaarInput"
                        name="apaar_id"
                        required
                        pattern="\d{12}"
                        maxlength="12"
                        inputmode="numeric"
                        placeholder="Enter 12-digit APAAR number (e.g. 901238471920)"
                        class="flex-1 h-11 bg-white border border-slate-300 rounded-lg px-4 font-mono text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                      />
                      <button
                        type="button"
                        id="btnVerifyApaar"
                        class="h-11 px-5 rounded-lg bg-[#0B1E48] hover:bg-[#1E3A8A] text-white font-bold text-sm transition-colors inline-flex items-center justify-center gap-2 shrink-0 cursor-pointer"
                      >
                        <span>Check APAAR ID</span>
                      </button>
                    </div>
                  </div>

                  <!-- Result Card -->
                  <div
                    id="apaarVerifyCard"
                    class="hidden rounded-lg border p-4 text-sm space-y-1.5"
                    role="status"
                    aria-live="polite"
                  ></div>
                </div>

                <!-- Step 2 Box -->
                <div class="bg-white p-5 rounded-xl border border-slate-200 space-y-4">
                  <h3 class="text-base font-bold text-[#0B1E48]">
                    Step 2: Select Branch &amp; Seat Quota
                  </h3>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                      <label for="singleNameInput" class="block text-sm font-semibold text-slate-800 mb-1.5">
                        Student Full Name
                      </label>
                      <input
                        type="text"
                        id="singleNameInput"
                        name="full_name"
                        required
                        placeholder="Enter student's full name as per 12th marksheet / Aadhaar"
                        class="w-full h-11 bg-slate-50 border border-slate-300 rounded-lg px-4 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                      />
                    </div>

                    <div>
                      <label for="singleProgramSelect" class="block text-sm font-semibold text-slate-800 mb-1.5">
                        Branch / Department
                      </label>
                      <select
                        id="singleProgramSelect"
                        name="program"
                        class="w-full h-11 bg-slate-50 border border-slate-300 rounded-lg px-3.5 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                      >
                        <option value="B.Tech Computer Science">B.Tech Computer Science (60 Seats)</option>
                        <option value="B.Tech Electronics & Comm.">B.Tech Electronics &amp; Comm. (60 Seats)</option>
                        <option value="B.Tech Mechanical Engg">B.Tech Mechanical Engg (60 Seats)</option>
                      </select>
                    </div>

                    <div>
                      <label for="singleQuotaSelect" class="block text-sm font-semibold text-slate-800 mb-1.5">
                        Seat Quota
                      </label>
                      <select
                        id="singleQuotaSelect"
                        name="admission_quota"
                        class="w-full h-11 bg-slate-50 border border-slate-300 rounded-lg px-3.5 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                      >
                        <option value="APPROVED_INTAKE">Regular Merit Seat</option>
                        <option value="SUPERNUMERARY">TFW / EWS / PMSSS Quota</option>
                        <option value="NRI">NRI Quota</option>
                        <option value="OCI">OCI / PIO Quota</option>
                        <option value="FN">Foreign National Quota</option>
                      </select>
                    </div>

                    <div>
                      <label for="singleAllotmentInput" class="block text-sm font-semibold text-slate-800 mb-1.5">
                        CET / JoSAA Allotment No.
                      </label>
                      <input
                        type="text"
                        id="singleAllotmentInput"
                        name="allotment_ref"
                        placeholder="e.g. CET-2026-MH-88412"
                        class="w-full h-11 bg-slate-50 border border-slate-300 rounded-lg px-4 font-mono text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                      />
                    </div>

                    <div>
                      <label for="singleSessionSelect" class="block text-sm font-semibold text-slate-800 mb-1.5">
                        Admission Year
                      </label>
                      <select
                        id="singleSessionSelect"
                        name="batch_year"
                        class="w-full h-11 bg-slate-50 border border-slate-300 rounded-lg px-3.5 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                      >
                        <option value="2026" selected>2026–27 (1st Year Regular)</option>
                        <option value="2025">2026–27 (2nd Year Lateral Entry)</option>
                      </select>
                    </div>
                  </div>

                  <div class="pt-3">
                    <button
                      type="submit"
                      id="singleSubmitBtn"
                      class="w-full h-12 rounded-xl bg-[#0B4EA2] hover:bg-[#083B7E] text-white font-bold text-base transition-colors flex items-center justify-center gap-2 cursor-pointer"
                    >
                      <span>Confirm &amp; Admit Student</span>
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <!-- PANEL 3 (Hidden until clicked): SIMPLE "BULK EXCEL / CSV UPLOAD" -->
          <div
            id="panelBulkCsv"
            role="tabpanel"
            aria-labelledby="tabBulkCsvBtn"
            class="hidden"
          >
            <div class="px-5 py-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-base font-bold text-[#0B1E48]">Bulk Excel / CSV Upload</h2>
                <p class="text-xs text-slate-600 mt-0.5">
                  Upload a CSV file or paste rows directly from Microsoft Excel to verify 12-digit APAAR IDs and admit students in bulk.
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <button
                  type="button"
                  id="downloadSampleCsvBtn"
                  class="h-9 px-3.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0B1E48] border border-slate-300 text-xs font-bold transition-colors inline-flex items-center gap-2 shrink-0 cursor-pointer"
                >
                  <svg class="w-4 h-4 text-[#0B4EA2] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  <span>Download Excel / CSV Format</span>
                </button>

                <button
                  type="button"
                  id="loadSamplePreviewBtn"
                  class="h-9 px-3.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-[#0B4EA2] border border-blue-200 text-xs font-bold transition-colors inline-flex items-center gap-1.5 shrink-0 cursor-pointer"
                >
                  <span>Load 5-Row Sample Preview</span>
                </button>

                <button
                  type="button"
                  id="toggleExcelPasteBtn"
                  aria-expanded="false"
                  aria-controls="excelPasteBox"
                  class="h-9 px-3.5 rounded-lg bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 text-xs font-bold transition-colors inline-flex items-center gap-1.5 shrink-0 cursor-pointer"
                >
                  <span>Paste from Excel</span>
                </button>
              </div>
            </div>

            <div class="p-5 sm:p-6 space-y-5">
              <!-- Top 3-Step Visual Strip -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs">
                <div class="flex items-center gap-2.5">
                  <span class="w-6 h-6 rounded-full bg-[#0B1E48] text-white font-mono font-bold inline-flex items-center justify-center shrink-0">1</span>
                  <div>
                    <div class="font-bold text-[#0B1E48]">1. Download Format</div>
                    <div class="text-slate-600">Use standard 6-column sheet or sample</div>
                  </div>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="w-6 h-6 rounded-full bg-[#0B4EA2] text-white font-mono font-bold inline-flex items-center justify-center shrink-0">2</span>
                  <div>
                    <div class="font-bold text-[#0B1E48]">2. Drop CSV or Paste from Excel</div>
                    <div class="text-slate-600">Supports comma, tab, or semicolon rows</div>
                  </div>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="w-6 h-6 rounded-full bg-emerald-700 text-white font-mono font-bold inline-flex items-center justify-center shrink-0">3</span>
                  <div>
                    <div class="font-bold text-[#0B1E48]">3. Review &amp; Save Valid Rows</div>
                    <div class="text-slate-600">Check status &amp; save valid students</div>
                  </div>
                </div>
              </div>

              <!-- Upload Box -->
              <label
                for="csvFileInput"
                id="csvDropzoneLabel"
                tabindex="0"
                aria-describedby="csvSchemaHint"
                class="border-2 border-dashed border-slate-300 hover:border-[#0B4EA2] hover:bg-blue-50/30 rounded-xl p-7 text-center cursor-pointer flex flex-col items-center justify-center bg-slate-50 transition-colors"
              >
                <svg class="w-8 h-8 text-[#0B4EA2] mb-2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <span id="csvDropzoneTitle" class="text-base font-bold text-[#0B1E48] pointer-events-none">
                  Drag &amp; drop your CSV file here, or click to browse
                </span>
                <span id="csvSchemaHint" class="text-xs font-mono text-slate-500 mt-1 pointer-events-none">
                  Columns: apaar_id, full_name, program, admission_quota, allotment_ref, batch_year
                </span>
                <input type="file" id="csvFileInput" accept=".csv,text/csv" class="hidden" />
              </label>

              <!-- Collapsible Paste Directly from Excel Box -->
              <div id="excelPasteBox" class="hidden rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <label for="excelPasteInput" class="text-xs font-bold text-[#0B1E48]">
                    Paste Rows Directly from Microsoft Excel or CSV
                  </label>
                  <span class="text-xs text-slate-500 font-mono">Tab or comma separated</span>
                </div>
                <textarea
                  id="excelPasteInput"
                  rows="4"
                  placeholder="Paste rows copied from Excel or CSV here (APAAR ID, Full Name, Branch, Quota, Allotment No., Year)..."
                  class="w-full rounded-lg bg-white border border-slate-300 p-3 font-mono text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0B4EA2]"
                ></textarea>
                <div class="flex justify-end">
                  <button
                    type="button"
                    id="parseExcelPasteBtn"
                    class="h-9 px-4 rounded-lg bg-[#0B1E48] hover:bg-[#1E3A8A] text-white text-xs font-bold transition-colors cursor-pointer"
                  >
                    Preview Pasted Rows
                  </button>
                </div>
              </div>

              <!-- Upgraded Preview Table (#triagePanel) -->
              <div id="triagePanel" class="rounded-xl border border-slate-200 overflow-hidden bg-white">
                <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4">
                  <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm" id="triageSummaryStrip">
                    <button
                      type="button"
                      id="viewTriageTabBtn"
                      class="font-bold text-[#0B1E48] inline-flex items-center gap-1.5 cursor-pointer"
                    >
                      <span>Total Rows:</span>
                      <strong id="stagedCountPill" class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-800 font-mono text-xs">0</strong>
                    </button>
                    <span>Valid (Ready): <strong id="countValid" class="text-emerald-700 font-mono">0</strong></span>
                    <span>Invalid APAAR: <strong id="countMalformed" class="text-red-700 font-mono">0</strong></span>
                    <span>Missing APAAR: <strong id="countMissing" class="text-amber-700 font-mono">0</strong></span>
                    <span>Seats After Upload: <strong id="projectedSeatsAfterUpload" class="text-[#0B4EA2] font-mono">{actualAdmittedCount} / {sanctionedCap}</strong></span>
                  </div>

                  <div class="flex items-center gap-2.5">
                    <button
                      type="button"
                      id="clearTriageBtn"
                      class="hidden h-10 px-3.5 rounded-lg bg-white hover:bg-red-50 text-slate-700 hover:text-red-700 border border-slate-300 hover:border-red-300 text-xs font-bold transition-colors cursor-pointer"
                    >
                      Clear List
                    </button>

                    <button
                      type="button"
                      id="commitSyncBtn"
                      disabled
                      class="h-10 px-5 rounded-lg bg-[#0B4EA2] hover:bg-[#083B7E] disabled:bg-slate-200 disabled:text-slate-500 disabled:cursor-not-allowed text-white text-sm font-bold transition-colors inline-flex items-center gap-2 cursor-pointer"
                    >
                      <span>Save Valid Students</span>
                    </button>
                  </div>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full text-left text-xs sm:text-sm border-collapse">
                    <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                      <tr>
                        <th class="py-3 px-4">#</th>
                        <th class="py-3 px-4">12-Digit APAAR ID</th>
                        <th class="py-3 px-4">Student Name</th>
                        <th class="py-3 px-4">Branch &amp; Quota</th>
                        <th class="py-3 px-4">Pre-Check Status</th>
                        <th class="py-3 px-4 text-right">Action</th>
                      </tr>
                    </thead>
                    <tbody id="triageTableBody" class="divide-y divide-slate-200 text-slate-800">
                      <tr>
                        <td colspan="6" class="py-10 px-4 text-center text-slate-500 text-sm">
                          No rows queued yet. Drop a CSV file, paste from Excel, or click "Load 5-Row Sample Preview" above.
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

          <!-- PANEL 4 (Hidden until clicked): SIMPLE "BRANCH & SEAT MATRIX" -->
          <div
            id="branchMatrixPanel"
            role="tabpanel"
            aria-labelledby="viewBranchMatrixTabBtn"
            class="hidden"
          >
            <div class="px-5 py-4 border-b border-slate-200">
              <h2 class="text-base font-bold text-[#0B1E48]">Branch-Wise Approved Seats &amp; Vacancies</h2>
              <p class="text-xs text-slate-600 mt-0.5">
                Live count of admitted students and remaining vacant seats across all approved B.Tech branches.
              </p>
            </div>

            <div class="p-5 sm:p-6 space-y-6">
              <div class="overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full text-left text-sm border-collapse">
                  <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                    <tr>
                      <th class="py-3.5 px-5">Branch / Department</th>
                      <th class="py-3.5 px-5 text-right">Approved Seats</th>
                      <th class="py-3.5 px-5 text-right">Regular Merit</th>
                      <th class="py-3.5 px-5 text-right">TFW / EWS / NRI</th>
                      <th class="py-3.5 px-5 text-right">Total Admitted</th>
                      <th class="py-3.5 px-5 text-right">Vacant Seats</th>
                      <th class="py-3.5 px-5 text-right">Status</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200 text-slate-800">
                    {branchMatrix.map((row) => (
                      <tr class="hover:bg-slate-50 transition-colors" data-branch-row={row.branch}>
                        <td class="py-4 px-5 font-bold text-[#0B1E48]">
                          <span>{row.branch}</span>
                          <span class="ml-2 font-mono text-xs font-normal text-slate-500">({row.code})</span>
                        </td>
                        <td class="py-4 px-5 text-right font-mono font-semibold text-slate-700" data-cell="sanctioned">
                          {row.sanctioned}
                        </td>
                        <td class="py-4 px-5 text-right font-mono text-slate-700" data-cell="approved">
                          {row.approved_intake}
                        </td>
                        <td class="py-4 px-5 text-right font-mono text-slate-700" data-cell="super_nri">
                          {row.supernumerary + row.nri_oci_fn}
                        </td>
                        <td class="py-4 px-5 text-right font-mono font-bold text-[#0B4EA2]" data-cell="admitted">
                          {row.admitted}
                        </td>
                        <td class="py-4 px-5 text-right font-mono font-bold text-emerald-700" data-cell="vacant">
                          {row.vacant}
                        </td>
                        <td class="py-4 px-5 text-right" data-cell="status">
                          {row.duplicates > 0 ? (
                            <span class="inline-flex items-center px-3 py-1 rounded-full bg-amber-50 text-amber-900 border border-amber-300 font-bold text-xs">
                              Duplicate Alert ({row.duplicates})
                            </span>
                          ) : (
                            <span class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold text-xs">
                              {row.vacant} Seats Open
                            </span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <!-- 5 Quota Summary Cards -->
              <div>
                <div class="mb-3">
                  <h3 class="text-base font-bold text-[#0B1E48]">Quota-Wise Seat Summary</h3>
                  <p class="text-xs text-slate-600 mt-0.5">
                    Breakdown of admitted students by AICTE seat category.
                  </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                  <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                    <div class="text-sm font-semibold text-slate-700">Regular Merit Seats</div>
                    <div class="text-2xl font-extrabold font-mono text-[#0B1E48] mt-1">
                      <span id="catMeritCount">{quotaCounts.APPROVED_INTAKE}</span>
                      <span class="text-sm font-normal text-slate-500">/ <span id="catApprovedIntake">{sanctionedCap}</span></span>
                    </div>
                    <div id="catActualEnrolment" class="text-xs text-slate-500 mt-1">
                      Total Admitted: {actualAdmittedCount} / {sanctionedCap}
                    </div>
                  </div>

                  <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                    <div class="text-sm font-semibold text-slate-700">TFW / EWS / PMSSS (15%)</div>
                    <div id="catSupernumerary" class="text-2xl font-extrabold font-mono text-[#0B4EA2] mt-1">
                      {quotaCounts.SUPERNUMERARY} <span class="text-sm font-normal text-slate-500">/ {quotaCeilings.SUPERNUMERARY}</span>
                    </div>
                    <div class="text-xs text-slate-500 mt-1">Supernumerary Quota</div>
                  </div>

                  <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                    <div class="text-sm font-semibold text-slate-700">NRI Quota (5%)</div>
                    <div id="catNri" class="text-2xl font-extrabold font-mono text-amber-800 mt-1">
                      {quotaCounts.NRI} <span class="text-sm font-normal text-slate-500">/ {quotaCeilings.NRI}</span>
                    </div>
                    <div class="text-xs text-slate-500 mt-1">Non-Resident Indian</div>
                  </div>

                  <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                    <div class="text-sm font-semibold text-slate-700">OCI / PIO Quota (2%)</div>
                    <div id="catOci" class="text-2xl font-extrabold font-mono text-[#0B1E48] mt-1">
                      {quotaCounts.OCI} <span class="text-sm font-normal text-slate-500">/ {quotaCeilings.OCI}</span>
                    </div>
                    <div class="text-xs text-slate-500 mt-1">Overseas Citizen of India</div>
                  </div>

                  <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                    <div class="text-sm font-semibold text-slate-700">Foreign National (3%)</div>
                    <div id="catFn" class="text-2xl font-extrabold font-mono text-emerald-800 mt-1">
                      {quotaCounts.FN} <span class="text-sm font-normal text-slate-500">/ {quotaCeilings.FN}</span>
                    </div>
                    <div class="text-xs text-slate-500 mt-1">International Students</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentTriageData: any[] = [];

    const rootEl = document.getElementById('instPageRoot');
    const i18nClient = JSON.parse(rootEl?.getAttribute('data-i18n-client') || '{}');
    let enrolledList: any[] = JSON.parse(rootEl?.getAttribute('data-initial-admissions') || '[]');

    const activeCollegeEl = document.getElementById('activeCollege') as HTMLInputElement | null;
    const csvFileInput = document.getElementById('csvFileInput') as HTMLInputElement | null;
    const downloadSampleCsvBtn = document.getElementById('downloadSampleCsvBtn');
    const commitBtn = document.getElementById('commitSyncBtn') as HTMLButtonElement | null;
    const tableBody = document.getElementById('triageTableBody')!;
    const enrolledTableBody = document.getElementById('enrolledTableBody')!;
    const feedbackAlert = document.getElementById('syncFeedbackAlert');

    const BRANCH_CONFIG = [
      { branch: 'B.Tech Computer Science', code: 'CSE-101', short: 'CS', sanctioned: 60 },
      { branch: 'B.Tech Electronics & Comm.', code: 'ECE-102', short: 'EC', sanctioned: 60 },
      { branch: 'B.Tech Mechanical Engg', code: 'MECH-103', short: 'ME', sanctioned: 60 },
    ];

    function normalizeBranchClient(rawProgram?: string): string {
      const p = (rawProgram || '').toLowerCase();
      if (p.includes('mech')) return 'B.Tech Mechanical Engg';
      if (p.includes('elec') || p.includes('comm') || p.includes('ece') || p.includes('entc')) {
        return 'B.Tech Electronics & Comm.';
      }
      return 'B.Tech Computer Science';
    }

    function normalizeQuotaClient(rawQuota?: string): string {
      const q = (rawQuota || '').toUpperCase().trim();
      if (q.includes('SUPERNUMERARY') || q.includes('TFW') || q.includes('EWS') || q.includes('PMSSS')) return 'SUPERNUMERARY';
      if (q.includes('NRI')) return 'NRI';
      if (q.includes('OCI') || q.includes('PIO')) return 'OCI';
      if (q === 'FN' || q.includes('FOREIGN')) return 'FN';
      return 'APPROVED_INTAKE';
    }

    function formatQuotaHuman(code: string): string {
      const c = normalizeQuotaClient(code);
      if (c === 'SUPERNUMERARY') return 'TFW / EWS Quota';
      if (c === 'NRI') return 'NRI Quota';
      if (c === 'OCI') return 'OCI / PIO Quota';
      if (c === 'FN') return 'Foreign National Quota';
      return 'Regular Merit';
    }

    // 4 Full-Width Workspace Tabs
    const viewEnrolledTabBtn = document.getElementById('viewEnrolledTabBtn');
    const tabSingleEntryBtn = document.getElementById('tabSingleEntryBtn');
    const tabBulkCsvBtn = document.getElementById('tabBulkCsvBtn');
    const viewBranchMatrixTabBtn = document.getElementById('viewBranchMatrixTabBtn');
    const viewTriageTabBtn = document.getElementById('viewTriageTabBtn');

    const openAdmitTabBtn = document.getElementById('openAdmitTabBtn');
    const openCsvTabBtn = document.getElementById('openCsvTabBtn');
    const rosterInlineAdmitBtn = document.getElementById('rosterInlineAdmitBtn');

    const enrolledRosterPanel = document.getElementById('enrolledRosterPanel');
    const panelSingleEntry = document.getElementById('panelSingleEntry');
    const panelBulkCsv = document.getElementById('panelBulkCsv');
    const branchMatrixPanel = document.getElementById('branchMatrixPanel');

    const enrolledCountPill = document.getElementById('enrolledCountPill');
    const stagedCountPill = document.getElementById('stagedCountPill');

    type WorkspaceTab = 'enrolled' | 'single' | 'csv' | 'matrix';

    function switchWorkspaceTab(activeTab: WorkspaceTab) {
      const tabs: Array<{ key: WorkspaceTab; btn: HTMLElement | null; panel: HTMLElement | null }> = [
        { key: 'enrolled', btn: viewEnrolledTabBtn, panel: enrolledRosterPanel },
        { key: 'single', btn: tabSingleEntryBtn, panel: panelSingleEntry },
        { key: 'csv', btn: tabBulkCsvBtn, panel: panelBulkCsv },
        { key: 'matrix', btn: viewBranchMatrixTabBtn, panel: branchMatrixPanel },
      ];

      tabs.forEach(({ key, btn, panel }) => {
        const isActive = key === activeTab;
        if (btn) {
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          btn.className = isActive
            ? 'w-full text-left px-3.5 py-3 rounded-xl text-sm font-bold bg-[#0B4EA2] text-white flex items-center justify-between cursor-pointer transition-colors'
            : 'w-full text-left px-3.5 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#0B1E48] flex items-center justify-between cursor-pointer transition-colors';
          const badge = btn.querySelector<HTMLElement>('[data-sidebar-badge]');
          if (badge) {
            badge.className = isActive
              ? 'px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-white/20 text-white'
              : 'px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-600';
          }
        }
        if (panel) {
          panel.classList.toggle('hidden', !isActive);
        }
      });
    }

    viewEnrolledTabBtn?.addEventListener('click', () => switchWorkspaceTab('enrolled'));
    tabSingleEntryBtn?.addEventListener('click', () => switchWorkspaceTab('single'));
    tabBulkCsvBtn?.addEventListener('click', () => switchWorkspaceTab('csv'));
    viewBranchMatrixTabBtn?.addEventListener('click', () => switchWorkspaceTab('matrix'));
    viewTriageTabBtn?.addEventListener('click', () => switchWorkspaceTab('csv'));

    openAdmitTabBtn?.addEventListener('click', () => {
      switchWorkspaceTab('single');
      document.getElementById('singleApaarInput')?.focus();
    });
    rosterInlineAdmitBtn?.addEventListener('click', () => {
      switchWorkspaceTab('single');
      document.getElementById('singleApaarInput')?.focus();
    });
    openCsvTabBtn?.addEventListener('click', () => {
      switchWorkspaceTab('csv');
    });

    function showFeedbackBanner(html: string, tone: 'error' | 'warning' | 'success') {
      if (!feedbackAlert) return;
      feedbackAlert.classList.remove(
        'hidden',
        'bg-red-50',
        'border-red-300',
        'text-red-900',
        'bg-amber-50',
        'border-amber-300',
        'text-amber-900',
        'bg-emerald-50',
        'border-emerald-300',
        'text-emerald-900'
      );
      if (tone === 'error') {
        feedbackAlert.classList.add('bg-red-50', 'border-red-300', 'text-red-900');
      } else if (tone === 'warning') {
        feedbackAlert.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-900');
      } else {
        feedbackAlert.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-900');
      }
      feedbackAlert.innerHTML = html;
    }

    function recomputeAllTelemetryFromRoster() {
      const sanctioned = parseInt(activeCollegeEl?.getAttribute('data-sanctioned') || '180', 10);
      const totalAdmitted = enrolledList.length;
      const vacant = Math.max(0, sanctioned - totalAdmitted);
      const dupes = enrolledList.filter((item) => Boolean(item.is_duplicate)).length;
      const pct = ((totalAdmitted / Math.max(1, sanctioned)) * 100).toFixed(1);

      if (activeCollegeEl) {
        activeCollegeEl.setAttribute('data-current', String(totalAdmitted));
      }
      if (enrolledCountPill) {
        enrolledCountPill.textContent = String(totalAdmitted);
      }

      const enrolledEl = document.getElementById('meterEnrolled');
      const vacantEl = document.getElementById('meterVacant');
      const vacantCountEl = document.getElementById('meterVacantCount');
      const dupeEl = document.getElementById('meterDuplicates');
      const dupeCountEl = document.getElementById('meterDuplicateCount');
      const pctEl = document.getElementById('meterPercent');
      const filterDupeOpt = document.getElementById('filterDuplicateOption');

      if (enrolledEl) enrolledEl.textContent = String(totalAdmitted);
      if (vacantEl) vacantEl.textContent = String(vacant);
      if (vacantCountEl) vacantCountEl.textContent = String(vacant);
      if (dupeEl) dupeEl.textContent = String(dupes);
      if (dupeCountEl) dupeCountEl.textContent = String(dupes);
      if (filterDupeOpt) {
        filterDupeOpt.textContent = `Duplicate Alerts (${dupes})`;
      }
      if (pctEl) pctEl.textContent = `${pct}% seats filled`;
      const projSeatsNode = document.getElementById('projectedSeatsAfterUpload');
      if (projSeatsNode) {
        const netValidQueued = currentTriageData.filter(
          (r) => /^[0-9]{12}$/.test((r.apaar_id || '').trim()) && !enrolledList.some((e) => e.apaar_id === (r.apaar_id || '').trim())
        ).length;
        projSeatsNode.textContent = `${totalAdmitted + netValidQueued} / ${sanctioned}`;
      }

      // Quota counts
      const countMerit = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'APPROVED_INTAKE').length;
      const countSuper = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'SUPERNUMERARY').length;
      const countNri = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'NRI').length;
      const countOci = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'OCI').length;
      const countFn = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'FN').length;

      const ceilSuper = Math.round(sanctioned * 0.15);
      const ceilNri = Math.round(sanctioned * 0.05);
      const ceilOci = Math.max(1, Math.round(sanctioned * 0.02));
      const ceilFn = Math.max(1, Math.round(sanctioned * 0.03));

      const catMeritEl = document.getElementById('catMeritCount');
      const catActualEl = document.getElementById('catActualEnrolment');
      const catSuperEl = document.getElementById('catSupernumerary');
      const catNriEl = document.getElementById('catNri');
      const catOciEl = document.getElementById('catOci');
      const catFnEl = document.getElementById('catFn');

      if (catMeritEl) catMeritEl.textContent = String(countMerit);
      if (catActualEl) {
        catActualEl.textContent = `Total Admitted: ${totalAdmitted} / ${sanctioned}`;
      }
      if (catSuperEl) {
        catSuperEl.innerHTML = `${countSuper} <span class="text-sm font-normal text-slate-500">/ ${ceilSuper}</span>`;
      }
      if (catNriEl) {
        catNriEl.innerHTML = `${countNri} <span class="text-sm font-normal text-slate-500">/ ${ceilNri}</span>`;
      }
      if (catOciEl) {
        catOciEl.innerHTML = `${countOci} <span class="text-sm font-normal text-slate-500">/ ${ceilOci}</span>`;
      }
      if (catFnEl) {
        catFnEl.innerHTML = `${countFn} <span class="text-sm font-normal text-slate-500">/ ${ceilFn}</span>`;
      }

      // Update Branch Seat Matrix rows
      BRANCH_CONFIG.forEach((b) => {
        const rowEl = document.querySelector<HTMLTableRowElement>(`tr[data-branch-row="${b.branch}"]`);
        if (!rowEl) return;
        const branchItems = enrolledList.filter((item) => normalizeBranchClient(item.program) === b.branch);
        const bAdmitted = branchItems.length;
        const bApproved = branchItems.filter((item) => normalizeQuotaClient(item.admission_quota || item.quota_label) === 'APPROVED_INTAKE').length;
        const bSuperNri = branchItems.filter((item) => normalizeQuotaClient(item.admission_quota || item.quota_label) !== 'APPROVED_INTAKE').length;
        const bDupes = branchItems.filter((item) => Boolean(item.is_duplicate)).length;
        const bVacant = Math.max(0, b.sanctioned - bAdmitted);

        const cellApproved = rowEl.querySelector('[data-cell="approved"]');
        const cellSuperNri = rowEl.querySelector('[data-cell="super_nri"]');
        const cellAdmitted = rowEl.querySelector('[data-cell="admitted"]');
        const cellVacant = rowEl.querySelector('[data-cell="vacant"]');
        const cellStatus = rowEl.querySelector('[data-cell="status"]');

        if (cellApproved) cellApproved.textContent = String(bApproved);
        if (cellSuperNri) cellSuperNri.textContent = String(bSuperNri);
        if (cellAdmitted) cellAdmitted.textContent = String(bAdmitted);
        if (cellVacant) cellVacant.textContent = String(bVacant);
        if (cellStatus) {
          cellStatus.innerHTML =
            bDupes > 0
              ? `<span class="inline-flex items-center px-3 py-1 rounded-full bg-amber-50 text-amber-900 border border-amber-300 font-bold text-xs">Duplicate Alert (${bDupes})</span>`
              : `<span class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold text-xs">${bVacant} Seats Open</span>`;
        }
      });
    }

    // Step 1: Check Student's 12-Digit APAAR ID
    const btnVerifyApaar = document.getElementById('btnVerifyApaar') as HTMLButtonElement | null;
    const apaarVerifyCard = document.getElementById('apaarVerifyCard');
    const singleApaarInput = document.getElementById('singleApaarInput') as HTMLInputElement | null;
    const singleNameInput = document.getElementById('singleNameInput') as HTMLInputElement | null;
    const singleProgramSelect = document.getElementById('singleProgramSelect') as HTMLSelectElement | null;
    const singleQuotaSelect = document.getElementById('singleQuotaSelect') as HTMLSelectElement | null;
    const singleAllotmentInput = document.getElementById('singleAllotmentInput') as HTMLInputElement | null;
    const singleSessionSelect = document.getElementById('singleSessionSelect') as HTMLSelectElement | null;
    const singleStudentForm = document.getElementById('singleStudentForm') as HTMLFormElement | null;
    const singleSubmitBtn = document.getElementById('singleSubmitBtn') as HTMLButtonElement | null;

    async function verifyApaarId(apaarRaw?: string) {
      const apaar = (apaarRaw ?? singleApaarInput?.value ?? '').trim();
      if (!/^\d{12}$/.test(apaar)) {
        (window as any).showToast?.('Please enter a valid 12-digit APAAR number.', 'error');
        singleApaarInput?.focus();
        return;
      }

      if (btnVerifyApaar) btnVerifyApaar.disabled = true;

      let verifiedName = singleNameInput?.value.trim() || '';
      let verifiedDob = '2005-05-14';
      let verifiedBoard = 'CBSE Class XII (10+2 PCM)';
      let hasConcurrent = false;
      let concurrentColleges: string[] = [];

      try {
        const res = await fetch(`/api/roster/lookup?apaar_id=${encodeURIComponent(apaar)}`);
        if (res.ok) {
          const data = await res.json();
          const st = data.student || data;
          if (st?.full_name || st?.name) verifiedName = st.full_name || st.name;
          if (st?.dob) verifiedDob = st.dob;
          if (st?.qualification) verifiedBoard = st.qualification;
          if (typeof data.has_concurrent_admission === 'boolean') {
            hasConcurrent = data.has_concurrent_admission;
          } else if (Array.isArray(data.active_admissions) && data.active_admissions.length > 0) {
            hasConcurrent = true;
          }
          if (Array.isArray(data.active_admissions)) {
            concurrentColleges = data.active_admissions.map(
              (a: any) => (a.institution_name || a.institution_id || 'Metro Institute of Technology, Bengaluru').split('(')[0].trim()
            );
          }
        } else {
          throw new Error('Fallback to local roster lookup');
        }
      } catch {
        const existingMatch = enrolledList.find((item) => item.apaar_id === apaar);
        if (existingMatch) {
          verifiedName = existingMatch.full_name;
          hasConcurrent = Boolean(existingMatch.is_duplicate) || existingMatch.other_colleges?.length > 0;
          concurrentColleges = existingMatch.other_colleges?.length
            ? existingMatch.other_colleges
            : ['Metro Institute of Technology, Bengaluru'];
        }
      } finally {
        if (btnVerifyApaar) btnVerifyApaar.disabled = false;
      }

      if (singleNameInput && verifiedName) {
        singleNameInput.value = verifiedName;
      }

      if (apaarVerifyCard) {
        apaarVerifyCard.classList.remove(
          'hidden',
          'bg-emerald-50',
          'border-emerald-200',
          'text-emerald-950',
          'bg-amber-50',
          'border-amber-300',
          'text-amber-950'
        );

        if (hasConcurrent) {
          apaarVerifyCard.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-950');
          const conflictText =
            concurrentColleges.length > 0 ? concurrentColleges.join(', ') : 'Metro Institute of Technology, Bengaluru';
          apaarVerifyCard.innerHTML = `
            <div class="font-bold text-amber-900">
              ⚠ Duplicate Seat Alert: Student is already admitted in ${conflictText}
            </div>
            <div class="text-xs text-amber-900 mt-1">
              <strong>Student Name:</strong> ${verifiedName || apaar} · <strong>DOB:</strong> ${verifiedDob} · <strong>12th Board:</strong> ${verifiedBoard}
            </div>
          `;
        } else {
          apaarVerifyCard.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-950');
          apaarVerifyCard.innerHTML = `
            <div class="font-bold text-emerald-900">
              ✓ APAAR ID Verified — Eligible for Admission (No duplicate college seat found)
            </div>
            <div class="text-xs text-emerald-800 mt-1">
              <strong>Student Name:</strong> ${verifiedName || 'Verified Student'} · <strong>DOB:</strong> ${verifiedDob} · <strong>12th Board:</strong> ${verifiedBoard}
            </div>
          `;
        }
      }
    }

    btnVerifyApaar?.addEventListener('click', () => verifyApaarId());

    function formatApaarDisplay(apaar: string): string {
      if (!apaar || apaar.length !== 12) return apaar;
      return `${apaar.slice(0, 4)}-${apaar.slice(4, 8)}-${apaar.slice(8, 12)}`;
    }

    function appendToEnrolledTable(student: {
      id?: string;
      apaar_id: string;
      roll_id: string;
      full_name: string;
      program: string;
      batch_year: number;
      admission_quota: string;
      allotment_ref?: string;
      is_duplicate: boolean;
      other_colleges?: string[];
    }) {
      const admId = student.id || `ADM-${Date.now()}`;
      const canonicalBranch = normalizeBranchClient(student.program);
      const quotaCode = normalizeQuotaClient(student.admission_quota);
      const humanQuota = formatQuotaHuman(quotaCode);
      const formattedApaar = formatApaarDisplay(student.apaar_id);
      const allotmentRef = student.allotment_ref || `CET-2026-MH-${88410 + enrolledList.length + 1}`;

      enrolledList = enrolledList.filter((item) => item.apaar_id !== student.apaar_id);
      const existingRow = enrolledTableBody?.querySelector(`tr[data-row-apaar="${student.apaar_id}"]`);
      existingRow?.remove();

      enrolledList.unshift({
        ...student,
        id: admId,
        program: canonicalBranch,
        admission_quota: quotaCode,
        quota_label: humanQuota,
        allotment_ref: allotmentRef,
        formatted_apaar: formattedApaar,
      });

      if (enrolledTableBody) {
        const row = document.createElement('tr');
        row.className = 'bg-emerald-50/70 hover:bg-slate-50/90 transition-colors';
        row.setAttribute('data-row-apaar', student.apaar_id);
        row.setAttribute('data-row-name', student.full_name.toLowerCase());
        row.setAttribute('data-row-roll', student.roll_id.toLowerCase());
        row.setAttribute('data-row-branch', canonicalBranch);
        row.setAttribute('data-row-status', student.is_duplicate ? 'DUPLICATE' : 'VERIFIED');

        const statusBadge = student.is_duplicate
          ? `<span class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-900 px-2.5 py-0.5 rounded-full border border-amber-300 font-bold text-xs whitespace-nowrap">
               <span>⚠ Duplicate Alert</span>
             </span>`
          : `<span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 px-2.5 py-0.5 rounded-full border border-emerald-200 font-bold text-xs whitespace-nowrap">
               <span>✓ Verified</span>
             </span>`;

        row.innerHTML = `
          <td class="py-3.5 px-4 whitespace-nowrap">
            <div class="font-bold text-slate-900">${student.full_name}</div>
            <div class="font-mono text-xs text-slate-500 mt-0.5">Roll: ${student.roll_id}</div>
          </td>
          <td class="py-3.5 px-4 whitespace-nowrap">
            <span class="font-mono font-bold text-[#0B1E48]">${formattedApaar}</span>
          </td>
          <td class="py-3.5 px-4 whitespace-nowrap">
            <div class="font-semibold text-slate-900">${canonicalBranch}</div>
            <div class="text-xs text-slate-500 mt-0.5">${humanQuota} · <span class="font-mono">${allotmentRef}</span></div>
          </td>
          <td class="py-3.5 px-4 whitespace-nowrap">${statusBadge}</td>
          <td class="py-3.5 px-4 text-right whitespace-nowrap">
            <button
              type="button"
              data-withdraw-id="${admId}"
              data-withdraw-apaar="${student.apaar_id}"
              data-withdraw-name="${student.full_name}"
              class="px-3 py-1.5 rounded-lg bg-white hover:bg-red-50 text-slate-700 hover:text-red-700 border border-slate-300 hover:border-red-300 text-xs font-bold transition-colors cursor-pointer whitespace-nowrap"
            >
              Cancel Seat
            </button>
          </td>
        `;
        enrolledTableBody.prepend(row);
      }

      recomputeAllTelemetryFromRoster();
    }

    // Filter Admitted Students Table
    const rosterSearchInput = document.getElementById('rosterSearchInput') as HTMLInputElement | null;
    const rosterBranchFilter = document.getElementById('rosterBranchFilter') as HTMLSelectElement | null;
    const rosterStatusFilter = document.getElementById('rosterStatusFilter') as HTMLSelectElement | null;

    function filterEnrolledTable() {
      if (!enrolledTableBody) return;
      const query = (rosterSearchInput?.value || '').trim().toLowerCase();
      const branchFilter = rosterBranchFilter?.value || 'ALL';
      const statusFilter = rosterStatusFilter?.value || 'ALL';
      const rows = enrolledTableBody.querySelectorAll<HTMLTableRowElement>('tr[data-row-apaar]');

      rows.forEach((row) => {
        const apaar = (row.getAttribute('data-row-apaar') || '').toLowerCase();
        const name = (row.getAttribute('data-row-name') || '').toLowerCase();
        const roll = (row.getAttribute('data-row-roll') || '').toLowerCase();
        const branch = row.getAttribute('data-row-branch') || '';
        const status = row.getAttribute('data-row-status') || 'VERIFIED';

        const matchesQuery = !query || apaar.includes(query) || name.includes(query) || roll.includes(query);
        const matchesBranch = branchFilter === 'ALL' || branch === branchFilter;
        const matchesStatus = statusFilter === 'ALL' || status === statusFilter;

        row.classList.toggle('hidden', !(matchesQuery && matchesBranch && matchesStatus));
      });
    }

    rosterSearchInput?.addEventListener('input', filterEnrolledTable);
    rosterBranchFilter?.addEventListener('change', filterEnrolledTable);
    rosterStatusFilter?.addEventListener('change', filterEnrolledTable);

    // Download Excel / CSV
    const exportRosterCsvBtn = document.getElementById('exportRosterCsvBtn');
    exportRosterCsvBtn?.addEventListener('click', () => {
