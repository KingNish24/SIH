---
import PolicyPage, { type PolicySection } from '../../components/PolicyPage.astro';
import {
  getLanguageInfo,
  getUIDictionary,
  isSupportedLang,
  type LangCode,
} from '../../lib/i18n';

const { lang, policy } = Astro.params;

if (!isSupportedLang(lang)) {
  return new Response('Not Found', { status: 404 });
}

const VALID_POLICIES = ['privacy', 'terms', 'accessibility', 'hyperlinking-policy'] as const;
type PolicySlug = (typeof VALID_POLICIES)[number];

if (!policy || !VALID_POLICIES.includes(policy as PolicySlug)) {
  return new Response('Not Found', { status: 404 });
}

if (lang === 'en') {
  return Astro.redirect(`/${policy}`, 302);
}

const resolvedLang: LangCode = lang;
const langInfo = getLanguageInfo(resolvedLang);
const t = getUIDictionary(resolvedLang);
const slug = policy as PolicySlug;

const titleMap: Record<PolicySlug, string> = {
  privacy: t.footerPrivacy,
  terms: t.footerTerms,
  accessibility: t.footerAccessibility,
  'hyperlinking-policy': t.footerHyperlink,
};

const hiPolicyDataMap: Record<PolicySlug, { intro: string; sections: PolicySection[] }> = {
  privacy: {
    intro:
      'यह नीति बताती है कि यह पोर्टल कौन-सा व्यक्तिगत डेटा एकत्र करता है, क्यों करता है, कितने समय तक रखता है और आपके अधिकार क्या हैं। यह डिजिटल व्यक्तिगत डेटा संरक्षण अधिनियम, 2023 के अनुरूप है।',
    sections: [
      {
        heading: 'हम कौन हैं',
        paragraphs: [
          'यह पोर्टल राष्ट्रीय छात्र रजिस्ट्री एवं सत्यापन पोर्टल है। यह अखिल भारतीय तकनीकी शिक्षा परिषद (एआईसीटीई) के लिए स्मार्ट इंडिया हैकाथॉन 2026 की परियोजना है। डिजिटल व्यक्तिगत डेटा संरक्षण अधिनियम, 2023 (डीपीडीपी अधिनियम) के अंतर्गत इस पोर्टल के लिए एआईसीटीई डेटा न्यासी (Data Fiduciary) है।',
        ],
      },
      {
        heading: 'हम कौन-सा डेटा एकत्र करते हैं',
        items: [
          'संस्थानों से छात्र डेटा: नाम, अपार (APAAR) आईडी, कार्यक्रम, प्रवेश वर्ष, संस्थान कोड और नामांकन स्थिति।',
          'संपर्क डेटा, यदि संस्थान देता है: ई-मेल पता और मोबाइल नंबर।',
          'विश्वविद्यालयों से डिग्री डेटा: डिग्री का प्रकार, वर्ष, परिणाम और रद्दीकरण स्थिति।',
          'अधिकारियों और छात्रों का खाता डेटा: उपयोगकर्ता नाम, भूमिका, संस्थान कोड और पासवर्ड का सुरक्षित हैश। हम आपका पासवर्ड सादे रूप में नहीं रखते।',
