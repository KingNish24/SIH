        orgInput.value = queryInstParam?.trim()
          ? `Institutional Audit (${queryInstParam.trim()}) — National Recruitment / Admissions`
          : 'Union Public Service Commission (UPSC) / Corporate Verification Gateway';
      }
      setTimeout(() => {
        form?.dispatchEvent(new Event('submit'));
