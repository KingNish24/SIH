---
interface VariantOption {
  key: string;
  name: string;
}

interface Props {
  variants: VariantOption[];
  current: string;
}

const { variants, current } = Astro.props;
const isDev = !import.meta.env.PROD;
---

{isDev && (
  <div
    id="prototype-switcher-bar"
    class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 bg-[#09152E]/95 text-white px-3 py-2 rounded-full shadow-2xl border border-white/20 backdrop-blur-md select-none"
    role="region"
    aria-label="UI Prototype Variant Switcher"
  >
    <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#FFAE19] text-[#09152E] text-[10px] font-extrabold uppercase tracking-wider">
      Prototype
    </span>

    <button
      type="button"
      id="proto-prev-btn"
      class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors cursor-pointer"
      title="Previous Variant (←)"
      aria-label="Previous Variant"
    >
      &larr;
    </button>

    <div class="flex items-center gap-1 px-1">
      {variants.map((v) => (
        <button
          type="button"
          data-proto-variant-btn={v.key}
          data-proto-variant-name={v.name}
          class={`px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer ${
            v.key === current
              ? 'bg-white text-[#09152E] shadow-xs'
              : 'text-slate-300 hover:text-white hover:bg-white/10'
          }`}
        >
          {v.key}: {v.name}
        </button>
      ))}
    </div>

    <button
      type="button"
      id="proto-next-btn"
      class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors cursor-pointer"
      title="Next Variant (→)"
      aria-label="Next Variant"
    >
      &rarr;
    </button>
  </div>
)}

<script is:inline>
  (function () {
    const bar = document.getElementById('prototype-switcher-bar');
    if (!bar) return;

    const buttons = Array.from(bar.querySelectorAll('[data-proto-variant-btn]'));
    const keys = buttons.map((b) => b.getAttribute('data-proto-variant-btn'));
    const panels = Array.from(document.querySelectorAll('[data-proto-variant-panel]'));

    function getActiveKey() {
      const params = new URLSearchParams(window.location.search);
      const q = (params.get('variant') || 'A').toUpperCase();
      return keys.includes(q) ? q : keys[0];
    }

    function setVariant(nextKey, pushUrl = true) {
      if (!keys.includes(nextKey)) return;

      panels.forEach((panel) => {
        const k = panel.getAttribute('data-proto-variant-panel');
        if (k === nextKey) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      buttons.forEach((btn) => {
        const k = btn.getAttribute('data-proto-variant-btn');
        if (k === nextKey) {
          btn.className = 'px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer bg-white text-[#09152E] shadow-xs';
        } else {
          btn.className = 'px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer text-slate-300 hover:text-white hover:bg-white/10';
        }
      });

      if (pushUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', nextKey);
        window.history.replaceState({}, '', url.toString());
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const k = btn.getAttribute('data-proto-variant-btn');
        if (k) setVariant(k, true);
      });
    });

    const prevBtn = document.getElementById('proto-prev-btn');
    const nextBtn = document.getElementById('proto-next-btn');

    function cycle(delta) {
      const cur = getActiveKey();
      const idx = keys.indexOf(cur);
      const nextIdx = (idx + delta + keys.length) % keys.length;
      setVariant(keys[nextIdx], true);
    }

    if (prevBtn) prevBtn.addEventListener('click', () => cycle(-1));
    if (nextBtn) nextBtn.addEventListener('click', () => cycle(1));

    window.addEventListener('keydown', (e) => {
      const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
      if (tag === 'input' || tag === 'textarea' || tag === 'select' || (e.target && e.target.isContentEditable)) {
        return;
      }
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        cycle(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        cycle(1);
      }
    });

    // Initialize from URL search param immediately
    setVariant(getActiveKey(), false);
  })();
</script>
