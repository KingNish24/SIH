                </svg>
                <span>Export CSV</span>
              </button>

              <button
                type="button"
                id="commitSyncBtn"
                disabled
                class="hidden h-8 px-3 rounded-lg bg-[#0B4EA2] hover:bg-[#093A82] disabled:bg-slate-200 disabled:text-slate-500 disabled:cursor-not-allowed text-white text-xs font-extrabold transition-colors cursor-pointer items-center gap-1.5 whitespace-nowrap"
              >
                <span>{t.inst_sync_btn}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Triage Summary Strip (Shown in CSV Import Queue view) -->
          <div
            id="triageSummaryStrip"
            class="hidden grid-cols-3 divide-x divide-slate-200 border-b border-slate-200 text-center py-2.5 bg-slate-50 text-xs"
            role="status"
            aria-live="polite"
          >
            <div>
              <span class="text-slate-600 font-semibold">{t.inst_triage_valid}:</span>
              <strong id="countValid" class="ml-1.5 text-emerald-700 font-mono text-sm">
                0
              </strong>
            </div>
            <div>
              <span class="text-slate-600 font-semibold">{t.inst_triage_malformed}:</span>
              <strong id="countMalformed" class="ml-1.5 text-red-700 font-mono text-sm">0</strong>
            </div>
            <div>
              <span class="text-slate-600 font-semibold">{t.inst_triage_missing}:</span>
              <strong id="countMissing" class="ml-1.5 text-amber-700 font-mono text-sm">0</strong>
            </div>
          </div>

          <!-- VIEW 1: Admitted Students Registry Table (Fits 1440px with zero horizontal scrollbar) -->
          <div
            id="enrolledRosterPanel"
            class="overflow-x-auto max-h-[36rem]"
            role="region"
            aria-label="Admitted Student Registry"
            tabindex="0"
          >
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-100/90 text-slate-700 font-bold sticky top-0 border-b border-slate-200 z-10">
                <tr>
                  <th class="py-3 px-2.5 whitespace-nowrap">Student &amp; DPDP Consent</th>
                  <th class="py-3 px-2.5 whitespace-nowrap">APAAR &amp; Roll No.</th>
                  <th class="py-3 px-2.5 whitespace-nowrap">Branch, Quota &amp; Allotment</th>
                  <th class="py-3 px-2.5 whitespace-nowrap">Compliance Status</th>
                  <th class="py-3 px-2.5 text-right whitespace-nowrap">Action</th>
                </tr>
              </thead>
              <tbody id="enrolledTableBody" class="divide-y divide-slate-200 text-slate-800">
                {initialAdmissions.map((adm) => (
                  <tr
                    class="hover:bg-slate-50/80 transition-colors"
                    data-row-apaar={adm.apaar_id}
                    data-row-name={adm.full_name.toLowerCase()}
                    data-row-roll={adm.roll_id.toLowerCase()}
                    data-row-branch={adm.program}
                    data-row-status={adm.is_duplicate ? 'DUPLICATE' : 'VERIFIED'}
                  >
                    <td class="py-3 px-2.5">
                      <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-full bg-[#EEF4FF] text-[#0B4EA2] border border-blue-200 font-extrabold text-[11px] flex items-center justify-center shrink-0">
                          {adm.initials}
                        </div>
                        <div class="min-w-0">
                          <div class="font-bold text-slate-900 whitespace-nowrap">{adm.full_name}</div>
                          <div class="mt-0.5 flex items-center gap-1">
                            <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] font-semibold whitespace-nowrap">
                              DPDP: {adm.dpdp_consent_status}
                            </span>
                          </div>
                        </div>
                      </div>
                    </td>
                    <td class="py-3 px-2.5 whitespace-nowrap">
                      <div class="font-mono font-bold text-[#0B1E48]">{adm.formatted_apaar}</div>
                      <div class="font-mono text-[10px] text-slate-500 mt-0.5">{adm.roll_id}</div>
                    </td>
                    <td class="py-3 px-2.5">
                      <div class="font-semibold text-slate-800 whitespace-nowrap">{adm.program}</div>
                      <div class="mt-0.5 flex flex-wrap items-center gap-1">
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-medium whitespace-nowrap">
                          {adm.quota_label}
                        </span>
                        <span class="font-mono text-[10px] text-slate-500 whitespace-nowrap">
                          · {adm.allotment_ref}
                        </span>
                      </div>
                    </td>
                    <td class="py-3 px-2.5">
                      {adm.is_duplicate ? (
                        <div class="space-y-0.5 max-w-[12rem]">
                          <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 px-2 py-0.5 rounded-md border border-amber-300 font-bold text-[10px] whitespace-nowrap">
                            <svg class="w-3 h-3 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <span>Cross-Campus Duplicate</span>
                          </span>
                          <div class="text-[10px] text-amber-800 font-medium truncate" title={`Also at ${adm.other_colleges.length > 0 ? adm.other_colleges.join(', ') : 'Technical College B (INST-002)'}`}>
                            Also at {adm.other_colleges.length > 0 ? adm.other_colleges.join(', ') : 'Technical College B (INST-002)'}
                          </div>
                        </div>
                      ) : (
                        <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-800 px-2 py-0.5 rounded-md border border-emerald-200 font-bold text-[10px] whitespace-nowrap">
                          <svg class="w-3 h-3 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>Verified Within Cap</span>
                        </span>
                      )}
                    </td>
                    <td class="py-3 px-2.5 text-right">
                      <button
                        type="button"
                        data-withdraw-id={adm.id}
                        data-withdraw-apaar={adm.apaar_id}
                        data-withdraw-name={adm.full_name}
                        class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-white hover:bg-red-50 text-slate-700 hover:text-red-700 border border-slate-200 hover:border-red-200 text-[10px] font-bold transition-colors cursor-pointer whitespace-nowrap"
                      >
                        <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        <span>Release</span>
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- VIEW 2: CSV Import Queue Panel -->
          <div
            id="triagePanel"
            class="hidden overflow-x-auto max-h-[36rem]"
            role="region"
            aria-label={t.inst_triage_heading}
            tabindex="0"
          >
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-100/90 text-slate-700 font-bold sticky top-0 border-b border-slate-200">
                <tr>
                  <th class="py-3 px-3">#</th>
                  <th class="py-3 px-3">{t.univ_apaar_id}</th>
                  <th class="py-3 px-3">{t.univ_student_name}</th>
                  <th class="py-3 px-3">{t.univ_specialization}</th>
                  <th class="py-3 px-3">Quota &amp; Allotment</th>
                  <th class="py-3 px-3">{t.aicte_col_status}</th>
                </tr>
              </thead>
              <tbody id="triageTableBody" class="divide-y divide-slate-200 text-slate-800">
                <tr>
                  <td colspan="6" class="py-10 px-4 text-center text-slate-500 text-xs">
                    Upload an AICTE CSV file under the CSV Batch Import tab to inspect records before ledger commit.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentTriageData: any[] = [];

    const rootEl = document.getElementById('instPageRoot');
    const i18nClient = JSON.parse(rootEl?.getAttribute('data-i18n-client') || '{}');
    let enrolledList: any[] = JSON.parse(rootEl?.getAttribute('data-initial-admissions') || '[]');

    const activeCollegeEl = document.getElementById('activeCollege') as HTMLInputElement | null;
    const csvFileInput = document.getElementById('csvFileInput') as HTMLInputElement | null;
    const downloadSampleCsvBtn = document.getElementById('downloadSampleCsvBtn');
    const commitBtn = document.getElementById('commitSyncBtn') as HTMLButtonElement | null;
    const tableBody = document.getElementById('triageTableBody')!;
    const enrolledTableBody = document.getElementById('enrolledTableBody')!;
    const feedbackAlert = document.getElementById('syncFeedbackAlert');

    const BRANCH_CONFIG = [
      { branch: 'B.Tech Computer Science', code: 'CSE-101', short: 'CSE', sanctioned: 60 },
      { branch: 'B.Tech Electronics & Comm.', code: 'ECE-102', short: 'ECE', sanctioned: 60 },
      { branch: 'B.Tech Mechanical Engg', code: 'MECH-103', short: 'MECH', sanctioned: 60 },
    ];

    function normalizeBranchClient(rawProgram?: string): string {
      const p = (rawProgram || '').toLowerCase();
      if (p.includes('mech')) return 'B.Tech Mechanical Engg';
      if (p.includes('elec') || p.includes('comm') || p.includes('ece') || p.includes('entc')) {
        return 'B.Tech Electronics & Comm.';
      }
      return 'B.Tech Computer Science';
    }

    function normalizeQuotaClient(rawQuota?: string): string {
      const q = (rawQuota || '').toUpperCase().trim();
      if (q.includes('SUPERNUMERARY') || q.includes('TFW') || q.includes('EWS') || q.includes('PMSSS')) return 'SUPERNUMERARY';
      if (q.includes('NRI')) return 'NRI';
      if (q.includes('OCI') || q.includes('PIO')) return 'OCI';
      if (q === 'FN' || q.includes('FOREIGN')) return 'FN';
      return 'APPROVED_INTAKE';
    }

    function formatQuotaHuman(code: string): string {
      const c = normalizeQuotaClient(code);
      if (c === 'SUPERNUMERARY') return 'Supernumerary (15% TFW/EWS)';
      if (c === 'NRI') return 'NRI Quota (5%)';
      if (c === 'OCI') return 'OCI / PIO (2%)';
      if (c === 'FN') return 'Foreign National (3%)';
      return 'Approved Intake (Merit)';
    }

    // Left Card Tabs (Admit Student vs CSV Batch Import)
    const tabSingleEntryBtn = document.getElementById('tabSingleEntryBtn');
    const tabBulkCsvBtn = document.getElementById('tabBulkCsvBtn');
    const panelSingleEntry = document.getElementById('panelSingleEntry');
    const panelBulkCsv = document.getElementById('panelBulkCsv');

    function switchLeftMode(mode: 'single' | 'bulk') {
      if (!tabSingleEntryBtn || !tabBulkCsvBtn || !panelSingleEntry || !panelBulkCsv) return;
      if (mode === 'single') {
        tabSingleEntryBtn.setAttribute('aria-selected', 'true');
        tabBulkCsvBtn.setAttribute('aria-selected', 'false');
        tabSingleEntryBtn.className =
          'py-2 px-3 rounded-lg text-xs font-extrabold transition-all bg-white text-[#0B1E48] shadow-2xs cursor-pointer flex items-center justify-center gap-1.5';
        tabBulkCsvBtn.className =
          'py-2 px-3 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center justify-center gap-1.5';
        panelSingleEntry.classList.remove('hidden');
        panelBulkCsv.classList.add('hidden');
      } else {
        tabSingleEntryBtn.setAttribute('aria-selected', 'false');
        tabBulkCsvBtn.setAttribute('aria-selected', 'true');
        tabBulkCsvBtn.className =
          'py-2 px-3 rounded-lg text-xs font-extrabold transition-all bg-white text-[#0B1E48] shadow-2xs cursor-pointer flex items-center justify-center gap-1.5';
        tabSingleEntryBtn.className =
          'py-2 px-3 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center justify-center gap-1.5';
        panelSingleEntry.classList.add('hidden');
        panelBulkCsv.classList.remove('hidden');
      }
    }

    tabSingleEntryBtn?.addEventListener('click', () => switchLeftMode('single'));
    tabBulkCsvBtn?.addEventListener('click', () => switchLeftMode('bulk'));

    // Right Table View Switcher (Admitted Students vs CSV Import Queue)
    const viewEnrolledTabBtn = document.getElementById('viewEnrolledTabBtn');
    const viewTriageTabBtn = document.getElementById('viewTriageTabBtn');
    const enrolledRosterPanel = document.getElementById('enrolledRosterPanel');
    const triagePanel = document.getElementById('triagePanel');
    const triageSummaryStrip = document.getElementById('triageSummaryStrip');
    const enrolledCountPill = document.getElementById('enrolledCountPill');
    const stagedCountPill = document.getElementById('stagedCountPill');

    function switchTableView(view: 'enrolled' | 'triage') {
      if (!viewEnrolledTabBtn || !viewTriageTabBtn || !enrolledRosterPanel || !triagePanel) return;
      if (view === 'enrolled') {
        viewEnrolledTabBtn.setAttribute('aria-selected', 'true');
        viewTriageTabBtn.setAttribute('aria-selected', 'false');
        viewEnrolledTabBtn.className =
          'px-2.5 py-1.5 rounded-lg text-xs font-extrabold transition-all bg-[#0B1E48] text-white cursor-pointer flex items-center gap-1.5 whitespace-nowrap';
        viewTriageTabBtn.className =
          'px-2.5 py-1.5 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center gap-1.5 whitespace-nowrap';
        enrolledRosterPanel.classList.remove('hidden');
        triagePanel.classList.add('hidden');
        triageSummaryStrip?.classList.add('hidden');
        triageSummaryStrip?.classList.remove('grid');
        commitBtn?.classList.add('hidden');
        commitBtn?.classList.remove('inline-flex');
      } else {
        viewEnrolledTabBtn.setAttribute('aria-selected', 'false');
        viewTriageTabBtn.setAttribute('aria-selected', 'true');
        viewTriageTabBtn.className =
          'px-2.5 py-1.5 rounded-lg text-xs font-extrabold transition-all bg-[#0B1E48] text-white cursor-pointer flex items-center gap-1.5 whitespace-nowrap';
        viewEnrolledTabBtn.className =
          'px-2.5 py-1.5 rounded-lg text-xs font-extrabold transition-all text-slate-600 hover:text-[#0B1E48] cursor-pointer flex items-center gap-1.5 whitespace-nowrap';
        triagePanel.classList.remove('hidden');
        enrolledRosterPanel.classList.add('hidden');
        triageSummaryStrip?.classList.remove('hidden');
        triageSummaryStrip?.classList.add('grid');
        commitBtn?.classList.remove('hidden');
        commitBtn?.classList.add('inline-flex');
      }
    }

    viewEnrolledTabBtn?.addEventListener('click', () => switchTableView('enrolled'));
    viewTriageTabBtn?.addEventListener('click', () => switchTableView('triage'));

    function showFeedbackBanner(html: string, tone: 'error' | 'warning' | 'success') {
      if (!feedbackAlert) return;
      feedbackAlert.classList.remove(
        'hidden',
        'bg-red-50',
        'border-red-300',
        'text-red-900',
        'bg-amber-50',
        'border-amber-300',
        'text-amber-900',
        'bg-emerald-50',
        'border-emerald-300',
        'text-emerald-900'
      );
      if (tone === 'error') {
        feedbackAlert.classList.add('bg-red-50', 'border-red-300', 'text-red-900');
      } else if (tone === 'warning') {
        feedbackAlert.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-900');
      } else {
        feedbackAlert.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-900');
      }
      feedbackAlert.innerHTML = html;
    }

    /**
     * Recomputes 100% of top KPIs, branch matrix cells, quota strip cells, and filter pills
     * directly from `enrolledList` so Table Row Count === Seats Used Counter === Branch Matrix === Quota Strip.
     */
    function recomputeAllTelemetryFromRoster() {
      const sanctioned = parseInt(activeCollegeEl?.getAttribute('data-sanctioned') || '180', 10);
      const totalAdmitted = enrolledList.length;
      const vacant = Math.max(0, sanctioned - totalAdmitted);
      const dupes = enrolledList.filter((item) => Boolean(item.is_duplicate)).length;
      const pct = ((totalAdmitted / Math.max(1, sanctioned)) * 100).toFixed(1);
      const barWidth = Math.min(100, (totalAdmitted / Math.max(1, sanctioned)) * 100).toFixed(1);

      if (activeCollegeEl) {
        activeCollegeEl.setAttribute('data-current', String(totalAdmitted));
      }
      if (enrolledCountPill) {
        enrolledCountPill.textContent = String(totalAdmitted);
      }

      const enrolledEl = document.getElementById('meterEnrolled');
      const vacantEl = document.getElementById('meterVacantCount');
      const dupeEl = document.getElementById('meterDuplicateCount');
      const badgeEl = document.getElementById('meterBadge');
      const pctEl = document.getElementById('meterPercent');
      const barEl = document.getElementById('meterProgressBar');
      const filterDupeOpt = document.getElementById('filterDuplicateOption');

      if (enrolledEl) enrolledEl.textContent = String(totalAdmitted);
      if (vacantEl) vacantEl.textContent = String(vacant);
      if (dupeEl) {
        dupeEl.textContent = String(dupes);
        dupeEl.className = `text-2xl font-extrabold font-mono ${dupes > 0 ? 'text-amber-700' : 'text-slate-800'}`;
      }
      if (filterDupeOpt) {
        filterDupeOpt.textContent = `Cross-Campus Duplicates (${dupes})`;
      }
      if (badgeEl) {
        if (dupes > 0) {
          badgeEl.textContent = `Duplicate Conflict Flagged (${dupes})`;
          badgeEl.className = 'text-xs font-extrabold px-3.5 py-1.5 rounded-full border bg-amber-100 text-amber-950 border-amber-300';
        } else {
          badgeEl.textContent = `EoA Compliant (${vacant} Vacant)`;
          badgeEl.className = 'text-xs font-extrabold px-3.5 py-1.5 rounded-full border bg-emerald-100 text-emerald-950 border-emerald-300';
        }
      }
      if (pctEl) pctEl.textContent = `${pct}% Filled`;
      if (barEl) {
        barEl.style.width = `${barWidth}%`;
        barEl.setAttribute('aria-valuenow', String(pct));
      }

      // Quota counts derived from `enrolledList`
      const countMerit = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'APPROVED_INTAKE').length;
      const countSuper = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'SUPERNUMERARY').length;
      const countNri = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'NRI').length;
      const countOci = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'OCI').length;
      const countFn = enrolledList.filter((a) => normalizeQuotaClient(a.admission_quota || a.quota_label) === 'FN').length;

      const ceilSuper = Math.round(sanctioned * 0.15);
      const ceilNri = Math.round(sanctioned * 0.05);
      const ceilOci = Math.max(1, Math.round(sanctioned * 0.02));
      const ceilFn = Math.max(1, Math.round(sanctioned * 0.03));

      const catMeritEl = document.getElementById('catMeritCount');
      const catActualEl = document.getElementById('catActualEnrolment');
      const catSuperEl = document.getElementById('catSupernumerary');
      const catNriEl = document.getElementById('catNri');
      const catOciEl = document.getElementById('catOci');
      const catFnEl = document.getElementById('catFn');

      if (catMeritEl) catMeritEl.textContent = String(countMerit);
      if (catActualEl) {
        catActualEl.innerHTML = `${totalAdmitted} <span class="text-xs font-normal text-slate-500">/ ${sanctioned}</span>`;
      }
      if (catSuperEl) {
        catSuperEl.innerHTML = `${countSuper} <span class="text-xs font-normal text-slate-500">/ ${ceilSuper}</span>`;
      }
      if (catNriEl) {
        catNriEl.innerHTML = `${countNri} <span class="text-xs font-normal text-slate-500">/ ${ceilNri}</span>`;
      }
      if (catOciEl) {
        catOciEl.innerHTML = `${countOci} <span class="text-xs font-normal text-slate-500">/ ${ceilOci}</span>`;
      }
      if (catFnEl) {
        catFnEl.innerHTML = `${countFn} <span class="text-xs font-normal text-slate-500">/ ${ceilFn}</span>`;
      }

      // Update 3-Branch AICTE EoA Seat Matrix rows
      BRANCH_CONFIG.forEach((b) => {
        const rowEl = document.querySelector<HTMLTableRowElement>(`tr[data-branch-row="${b.branch}"]`);
        if (!rowEl) return;
        const branchItems = enrolledList.filter((item) => normalizeBranchClient(item.program) === b.branch);
        const bAdmitted = branchItems.length;
        const bApproved = branchItems.filter((item) => normalizeQuotaClient(item.admission_quota || item.quota_label) === 'APPROVED_INTAKE').length;
        const bSuperNri = branchItems.filter((item) => normalizeQuotaClient(item.admission_quota || item.quota_label) !== 'APPROVED_INTAKE').length;
        const bDupes = branchItems.filter((item) => Boolean(item.is_duplicate)).length;
        const bVacant = Math.max(0, b.sanctioned - bAdmitted);

        const cellApproved = rowEl.querySelector('[data-cell="approved"]');
        const cellSuperNri = rowEl.querySelector('[data-cell="super_nri"]');
        const cellAdmitted = rowEl.querySelector('[data-cell="admitted"]');
        const cellVacant = rowEl.querySelector('[data-cell="vacant"]');
        const cellDupes = rowEl.querySelector('[data-cell="duplicates"]');
        const cellStatus = rowEl.querySelector('[data-cell="status"]');

        if (cellApproved) cellApproved.textContent = String(bApproved);
        if (cellSuperNri) cellSuperNri.textContent = String(bSuperNri);
        if (cellAdmitted) cellAdmitted.textContent = String(bAdmitted);
        if (cellVacant) cellVacant.textContent = String(bVacant);
        if (cellDupes) {
          cellDupes.innerHTML = `<span class="${bDupes > 0 ? 'text-amber-800 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded' : 'text-slate-500'}">${bDupes}</span>`;
        }
        if (cellStatus) {
          cellStatus.innerHTML =
            bDupes > 0
              ? `<span class="inline-flex items-center px-2 py-0.5 rounded-md bg-amber-50 text-amber-900 border border-amber-300 font-bold text-[10px]">Duplicate Alert (${bDupes})</span>`
              : `<span class="inline-flex items-center px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold text-[10px]">Within Cap (${bVacant} Open)</span>`;
        }
      });
    }

    // Step 1: NDEAR / DigiLocker Live Verification (`GET /api/roster/lookup?apaar_id=...`)
    const btnVerifyApaar = document.getElementById('btnVerifyApaar') as HTMLButtonElement | null;
    const apaarVerifyCard = document.getElementById('apaarVerifyCard');
    const singleApaarInput = document.getElementById('singleApaarInput') as HTMLInputElement | null;
    const singleNameInput = document.getElementById('singleNameInput') as HTMLInputElement | null;
    const singleProgramSelect = document.getElementById('singleProgramSelect') as HTMLSelectElement | null;
    const singleQuotaSelect = document.getElementById('singleQuotaSelect') as HTMLSelectElement | null;
    const singleAllotmentInput = document.getElementById('singleAllotmentInput') as HTMLInputElement | null;
    const singleSessionSelect = document.getElementById('singleSessionSelect') as HTMLSelectElement | null;
    const singleStudentForm = document.getElementById('singleStudentForm') as HTMLFormElement | null;
    const singleSubmitBtn = document.getElementById('singleSubmitBtn') as HTMLButtonElement | null;

    async function verifyApaarId(apaarRaw?: string) {
      const apaar = (apaarRaw ?? singleApaarInput?.value ?? '').trim();
      if (!/^\d{12}$/.test(apaar)) {
        (window as any).showToast?.('Enter a valid 12-digit numeric APAAR ID to query NDEAR.', 'error');
        singleApaarInput?.focus();
        return;
      }

      if (btnVerifyApaar) btnVerifyApaar.disabled = true;

      let verifiedName = singleNameInput?.value.trim() || '';
      let verifiedBoard = 'CBSE Class XII (10+2 PCM — Verified)';
      let dpdpConsent = 'GRANTED';
      let hasConcurrent = false;
      let concurrentColleges: string[] = [];

      try {
        const res = await fetch(`/api/roster/lookup?apaar_id=${encodeURIComponent(apaar)}`);
        if (res.ok) {
          const data = await res.json();
          const st = data.student || data;
          if (st?.full_name || st?.name) verifiedName = st.full_name || st.name;
          if (st?.qualification) verifiedBoard = st.qualification;
          if (st?.dpdp_consent_status) dpdpConsent = st.dpdp_consent_status;
          if (typeof data.has_concurrent_admission === 'boolean') {
            hasConcurrent = data.has_concurrent_admission;
          } else if (Array.isArray(data.active_admissions) && data.active_admissions.length > 0) {
            hasConcurrent = true;
          }
          if (Array.isArray(data.active_admissions)) {
            concurrentColleges = data.active_admissions.map(
              (a: any) => a.institution_name || a.institution_id || 'Technical College B (INST-002)'
            );
          }
        } else {
          throw new Error('Fallback to local roster lookup');
        }
      } catch {
        const existingMatch = enrolledList.find((item) => item.apaar_id === apaar);
        if (existingMatch) {
          verifiedName = existingMatch.full_name;
          hasConcurrent = Boolean(existingMatch.is_duplicate) || existingMatch.other_colleges?.length > 0;
          concurrentColleges = existingMatch.other_colleges?.length
            ? existingMatch.other_colleges
            : ['Technical College B (INST-002)'];
        }
      } finally {
        if (btnVerifyApaar) btnVerifyApaar.disabled = false;
      }

      if (singleNameInput && verifiedName) {
        singleNameInput.value = verifiedName;
      }

      if (apaarVerifyCard) {
        apaarVerifyCard.classList.remove(
          'hidden',
          'bg-emerald-50',
          'border-emerald-200',
          'text-emerald-950',
          'bg-amber-50',
          'border-amber-300',
          'text-amber-950'
        );

        if (hasConcurrent) {
          apaarVerifyCard.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-950');
          const conflictText =
            concurrentColleges.length > 0 ? concurrentColleges.join(', ') : 'Technical College B (INST-002)';
          apaarVerifyCard.innerHTML = `
            <div class="flex items-center justify-between gap-2 font-extrabold text-amber-900">
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>Cross-Campus Seat Conflict Detected</span>
              </span>
              <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-amber-100 border border-amber-300">DUPLICATE FLAG</span>
            </div>
            <div class="text-[11px] text-amber-900/90 font-medium">
              Candidate <strong>${verifiedName || apaar}</strong> (${verifiedBoard}) holds an active seat at <strong>${conflictText}</strong>.
            </div>
          `;
        } else {
          apaarVerifyCard.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-950');
          apaarVerifyCard.innerHTML = `
            <div class="flex items-center justify-between gap-2 font-extrabold text-emerald-900">
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                </svg>
                <span>NDEAR / DigiLocker Verified · DPDP: ${dpdpConsent}</span>
              </span>
              <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 border border-emerald-200">ELIGIBLE</span>
            </div>
            <div class="text-[11px] text-emerald-800 font-medium">
              Candidate: <strong>${verifiedName || 'Verified Candidate'}</strong> · Board: <span>${verifiedBoard}</span>
            </div>
          `;
        }
      }
    }

    btnVerifyApaar?.addEventListener('click', () => verifyApaarId());

    function formatApaarDisplay(apaar: string): string {
      if (!apaar || apaar.length !== 12) return apaar;
      return `${apaar.slice(0, 4)}-${apaar.slice(4, 8)}-${apaar.slice(8, 12)}`;
    }

    function getInitials(name: string): string {
      return (
        name
          .split(' ')
          .filter(Boolean)
          .slice(0, 2)
          .map((p) => p[0]?.toUpperCase() || '')
          .join('') || 'ST'
      );
    }

    function appendToEnrolledTable(student: {
      id?: string;
      apaar_id: string;
      roll_id: string;
      full_name: string;
      program: string;
      batch_year: number;
      admission_quota: string;
      allotment_ref?: string;
      is_duplicate: boolean;
      other_colleges?: string[];
    }) {
      const admId = student.id || `ADM-${Date.now()}`;
      const canonicalBranch = normalizeBranchClient(student.program);
      const quotaCode = normalizeQuotaClient(student.admission_quota);
      const humanQuota = formatQuotaHuman(quotaCode);
      const formattedApaar = formatApaarDisplay(student.apaar_id);
      const initials = getInitials(student.full_name);
      const allotmentRef = student.allotment_ref || `MHT-CET/CAP-I/${88410 + enrolledList.length + 1}`;

      // Avoid duplicate DOM rows if same APAAR is re-synced
      enrolledList = enrolledList.filter((item) => item.apaar_id !== student.apaar_id);
      const existingRow = enrolledTableBody?.querySelector(`tr[data-row-apaar="${student.apaar_id}"]`);
      existingRow?.remove();

      enrolledList.unshift({
        ...student,
        id: admId,
        program: canonicalBranch,
        admission_quota: quotaCode,
        quota_label: humanQuota,
        allotment_ref: allotmentRef,
        formatted_apaar: formattedApaar,
        initials,
        dpdp_consent_status: 'GRANTED',
      });

      if (enrolledTableBody) {
        const row = document.createElement('tr');
        row.className = 'bg-emerald-50/40 hover:bg-slate-50/80 transition-colors';
        row.setAttribute('data-row-apaar', student.apaar_id);
        row.setAttribute('data-row-name', student.full_name.toLowerCase());
        row.setAttribute('data-row-roll', student.roll_id.toLowerCase());
        row.setAttribute('data-row-branch', canonicalBranch);
        row.setAttribute('data-row-status', student.is_duplicate ? 'DUPLICATE' : 'VERIFIED');

        const statusBadge = student.is_duplicate
          ? `<div class="space-y-0.5 max-w-[12rem]">
               <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 px-2 py-0.5 rounded-md border border-amber-300 font-bold text-[10px] whitespace-nowrap">
                 <svg class="w-3 h-3 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                 </svg>
                 <span>Cross-Campus Duplicate</span>
               </span>
               <div class="text-[10px] text-amber-800 font-medium truncate">
                 Also at ${student.other_colleges?.join(', ') || 'Technical College B (INST-002)'}
               </div>
             </div>`
          : `<span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-800 px-2 py-0.5 rounded-md border border-emerald-200 font-bold text-[10px] whitespace-nowrap">
               <svg class="w-3 h-3 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
               </svg>
               <span>Verified Within Cap</span>
             </span>`;

        row.innerHTML = `
          <td class="py-3 px-2.5">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-[#EEF4FF] text-[#0B4EA2] border border-blue-200 font-extrabold text-[11px] flex items-center justify-center shrink-0">
                ${initials}
              </div>
              <div class="min-w-0">
                <div class="font-bold text-slate-900 whitespace-nowrap">${student.full_name}</div>
                <div class="mt-0.5 flex items-center gap-1">
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] font-semibold whitespace-nowrap">
                    DPDP: GRANTED
                  </span>
                </div>
              </div>
            </div>
          </td>
          <td class="py-3 px-2.5 whitespace-nowrap">
            <div class="font-mono font-bold text-[#0B1E48]">${formattedApaar}</div>
            <div class="font-mono text-[10px] text-slate-500 mt-0.5">${student.roll_id}</div>
          </td>
          <td class="py-3 px-2.5">
            <div class="font-semibold text-slate-800 whitespace-nowrap">${canonicalBranch}</div>
            <div class="mt-0.5 flex flex-wrap items-center gap-1">
              <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-medium whitespace-nowrap">
                ${humanQuota}
              </span>
              <span class="font-mono text-[10px] text-slate-500 whitespace-nowrap">
                · ${allotmentRef}
              </span>
            </div>
          </td>
          <td class="py-3 px-2.5">${statusBadge}</td>
          <td class="py-3 px-2.5 text-right">
            <button
              type="button"
              data-withdraw-id="${admId}"
              data-withdraw-apaar="${student.apaar_id}"
              data-withdraw-name="${student.full_name}"
              class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-white hover:bg-red-50 text-slate-700 hover:text-red-700 border border-slate-200 hover:border-red-200 text-[10px] font-bold transition-colors cursor-pointer whitespace-nowrap"
            >
              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>Release</span>
            </button>
          </td>
        `;
        enrolledTableBody.prepend(row);
      }

      recomputeAllTelemetryFromRoster();
    }

    // Live Search, Branch Filter & Compliance Filter on Admitted Students Table
    const rosterSearchInput = document.getElementById('rosterSearchInput') as HTMLInputElement | null;
    const rosterBranchFilter = document.getElementById('rosterBranchFilter') as HTMLSelectElement | null;
    const rosterStatusFilter = document.getElementById('rosterStatusFilter') as HTMLSelectElement | null;

    function filterEnrolledTable() {
      if (!enrolledTableBody) return;
      const query = (rosterSearchInput?.value || '').trim().toLowerCase();
      const branchFilter = rosterBranchFilter?.value || 'ALL';
      const statusFilter = rosterStatusFilter?.value || 'ALL';
      const rows = enrolledTableBody.querySelectorAll<HTMLTableRowElement>('tr[data-row-apaar]');

      rows.forEach((row) => {
        const apaar = (row.getAttribute('data-row-apaar') || '').toLowerCase();
        const name = (row.getAttribute('data-row-name') || '').toLowerCase();
        const roll = (row.getAttribute('data-row-roll') || '').toLowerCase();
        const branch = row.getAttribute('data-row-branch') || '';
        const status = row.getAttribute('data-row-status') || 'VERIFIED';

        const matchesQuery = !query || apaar.includes(query) || name.includes(query) || roll.includes(query);
        const matchesBranch = branchFilter === 'ALL' || branch === branchFilter;
        const matchesStatus = statusFilter === 'ALL' || status === statusFilter;

        row.classList.toggle('hidden', !(matchesQuery && matchesBranch && matchesStatus));
      });
    }

    rosterSearchInput?.addEventListener('input', filterEnrolledTable);
    rosterBranchFilter?.addEventListener('change', filterEnrolledTable);
    rosterStatusFilter?.addEventListener('change', filterEnrolledTable);

    // Export Enrolled Roster to CSV
    const exportRosterCsvBtn = document.getElementById('exportRosterCsvBtn');
    exportRosterCsvBtn?.addEventListener('click', () => {
      const headers = ['apaar_id', 'roll_number', 'full_name', 'program', 'admission_quota', 'allotment_ref', 'compliance_status'];
      const lines = [headers.join(',')];
      enrolledList.forEach((item) => {
        const row = [
          item.apaar_id,
          item.roll_id,
          `"${(item.full_name || '').replace(/"/g, '""')}"`,
          `"${(item.program || '').replace(/"/g, '""')}"`,
          item.admission_quota || 'APPROVED_INTAKE',
          `"${(item.allotment_ref || '').replace(/"/g, '""')}"`,
          item.is_duplicate ? 'FLAGGED_DUPLICATE' : 'VERIFIED_WITHIN_CAP',
        ];
        lines.push(row.join(','));
      });
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `aicte_admitted_roster_${activeCollegeEl?.value || 'INST-001'}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      (window as any).showToast?.(`Exported ${enrolledList.length} admitted student records to CSV.`, 'info');
    });

    // Event Delegation for Row Action: Release Seat
    enrolledTableBody?.addEventListener('click', async (e) => {
      const target = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-withdraw-apaar]');
      if (!target) return;

      const admissionId = target.getAttribute('data-withdraw-id') || '';
      const apaarId = target.getAttribute('data-withdraw-apaar') || '';
      const studentName = target.getAttribute('data-withdraw-name') || apaarId;
      const instId = activeCollegeEl?.value || 'INST-001';
      const capUiVal = parseInt(activeCollegeEl?.getAttribute('data-sanctioned') || '180', 10);

      target.disabled = true;

      try {
        await fetch('/api/roster/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'withdraw_admission',
            admissionId,
            apaar_id: apaarId,
            institutionId: instId,
          }),
        });
      } catch {
        // Proceed with client state update
      }

      const row = target.closest('tr');
      row?.remove();

      enrolledList = enrolledList.filter((item) => item.apaar_id !== apaarId && item.id !== admissionId);
      recomputeAllTelemetryFromRoster();

      showFeedbackBanner(
        `<div><strong>Seat Released &amp; Admission Withdrawn:</strong> <span class="font-mono font-bold">${studentName}</span> (APAAR: <span class="font-mono">${apaarId}</span>) removed from active roster. Active Roster Admitted: <strong>${enrolledList.length} / ${capUiVal}</strong>.</div>`,
        'success'
      );
      (window as any).showToast?.(`Released seat for ${studentName} (${enrolledList.length}/${capUiVal}).`, 'info');
    });

    // Single Student Admission Submit
    singleStudentForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const apaar = (singleApaarInput?.value || '').trim();
      const fullName = (singleNameInput?.value || '').trim();
      const program = normalizeBranchClient(singleProgramSelect?.value || 'B.Tech Computer Science');
      const quota = normalizeQuotaClient(singleQuotaSelect?.value || 'APPROVED_INTAKE');
      const allotmentRef = (singleAllotmentInput?.value || '').trim() || `MHT-CET/CAP-I/${88410 + enrolledList.length + 1}`;
      const batchYear = parseInt(singleSessionSelect?.value || '2026', 10) || 2026;
      const instId = activeCollegeEl?.value || 'INST-001';
      const capUiVal = parseInt(activeCollegeEl?.getAttribute('data-sanctioned') || '180', 10);

      if (!/^\d{12}$/.test(apaar)) {
        (window as any).showToast?.('Please enter a valid 12-digit numeric APAAR ID.', 'error');
        singleApaarInput?.focus();
        return;
      }
      if (!fullName) {
        (window as any).showToast?.('Please enter the verified candidate full name.', 'error');
        singleNameInput?.focus();
        return;
      }

      const branchMeta = BRANCH_CONFIG.find((b) => b.branch === program) || BRANCH_CONFIG[0];
      const rollId = `TCA-1049-${batchYear}-${branchMeta.short}-${String(enrolledList.length + 1).padStart(3, '0')}`;
      if (singleSubmitBtn) {
        singleSubmitBtn.disabled = true;
      }

      try {
        const res = await fetch('/api/roster/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            institutionId: instId,
            students: [
              {
                apaar_id: apaar,
                roll_number: rollId,
                student_roll_id: rollId,
                full_name: fullName,
                program,
                batch_year: batchYear,
                admission_quota: quota,
                admission_category: quota,
                allotment_ref: allotmentRef,
              },
            ],
          }),
        });
        const data = await res.json();

        if (res.ok && data.success) {
          const isDupe = (data.duplicates_flagged ?? 0) > 0;
          appendToEnrolledTable({
            apaar_id: apaar,
            roll_id: rollId,
            full_name: fullName,
            program,
            batch_year: batchYear,
            admission_quota: quota,
            allotment_ref: allotmentRef,
            is_duplicate: isDupe,
          });
          switchTableView('enrolled');
          showFeedbackBanner(
            `<div><strong>Admission Committed to Ledger:</strong> <span class="font-mono font-bold">${fullName}</span> (APAAR: <span class="font-mono">${apaar}</span>) locked in <strong>${program}</strong> under <strong>${formatQuotaHuman(quota)}</strong> (${allotmentRef}). Active Roster Admitted: <strong>${enrolledList.length} / ${capUiVal}</strong>.</div>`,
            isDupe ? 'warning' : 'success'
          );
          (window as any).showToast?.(`Admitted ${fullName} (${enrolledList.length}/${capUiVal}).`, 'success');
          if (singleApaarInput) singleApaarInput.value = '';
          if (singleNameInput) singleNameInput.value = '';
          if (singleAllotmentInput) singleAllotmentInput.value = '';
          apaarVerifyCard?.classList.add('hidden');
        } else {
          const errMsg = data.error || 'Sanctioned EoA intake ceiling reached';
          showFeedbackBanner(
            `<div><strong>Statutory Cap / Validation Exception (HTTP ${res.status}):</strong> ${errMsg}</div>`,
            'error'
          );
          (window as any).showToast?.(errMsg, 'error');
        }
      } catch {
        (window as any).showToast?.('Network error while committing admission.', 'error');
      } finally {
        if (singleSubmitBtn) singleSubmitBtn.disabled = false;
      }
    });

    // Keyboard support for dropzone label
    const dropzoneLabel = document.querySelector('label[for="csvFileInput"]') as HTMLElement | null;
    dropzoneLabel?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        csvFileInput?.click();
      }
    });

    // Download Official AICTE CSV Template
    downloadSampleCsvBtn?.addEventListener('click', () => {
      const csvContent = [
        'apaar_id,full_name,program,admission_quota,allotment_ref,batch_year',
        '901238471920,Aaditya Patel,B.Tech Computer Science,APPROVED_INTAKE,MHT-CET/CAP-I/88412,2026',
        '812349582031,Priya Nair,B.Tech Electronics & Comm.,SUPERNUMERARY,MHT-CET/TFW/88419,2026',
        '723450693142,Rohan Deshmukh,B.Tech Mechanical Engg,NRI,INST-NRI/2026/004,2026',
        '634561704253,Ananya Kulkarni,B.Tech Computer Science,OCI,JOSAA/OCI/2026/112,2026',
        '545672815364,Vikramaditya Joshi,B.Tech Electronics & Comm.,FN,ICCR/FN/2026/019,2026',
      ].join('\n');

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'aicte_eoa_admission_template_2026.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      (window as any).showToast?.('Downloaded Official AICTE CSV Template.', 'info');
    });

    function maskApaarClient(val: string): string {
      if (!val || val.length !== 12) return 'INVALID';
      return `${val.slice(0, 4)}-${val.slice(4, 8)}-${val.slice(8, 12)}`;
    }

    function renderCategoryBadge(cat: string): string {
      const c = normalizeQuotaClient(cat);
      if (c === 'SUPERNUMERARY') {
        return `<span class="bg-blue-50 text-blue-800 px-2 py-0.5 rounded-md border border-blue-200 font-semibold text-[11px]">SUPERNUMERARY</span>`;
      }
      if (c === 'NRI') {
        return `<span class="bg-amber-50 text-amber-800 px-2 py-0.5 rounded-md border border-amber-200 font-semibold text-[11px]">NRI</span>`;
      }
      if (c === 'OCI') {
        return `<span class="bg-indigo-50 text-indigo-800 px-2 py-0.5 rounded-md border border-indigo-200 font-semibold text-[11px]">OCI</span>`;
      }
      if (c === 'FN') {
        return `<span class="bg-emerald-50 text-emerald-800 px-2 py-0.5 rounded-md border border-emerald-200 font-semibold text-[11px]">FN</span>`;
      }
      return `<span class="bg-slate-100 text-slate-800 px-2 py-0.5 rounded-md border border-slate-200 font-semibold text-[11px]">APPROVED_INTAKE</span>`;
    }

    function renderTriageRows(rows: any[]) {
      currentTriageData = rows;
      if (stagedCountPill) stagedCountPill.textContent = String(rows.length);
      switchTableView('triage');

      if (!rows.length) {
        tableBody.innerHTML = `<tr><td colspan="6" class="py-10 px-4 text-center text-slate-500">0 records queued</td></tr>`;
        if (commitBtn) commitBtn.disabled = true;
        return;
      }

      let valid = 0,
        malformed = 0,
        missing = 0;
      let html = '';

      rows.forEach((r, idx) => {
        const is12 = /^[0-9]{12}$/.test(r.apaar_id || '');
        const isMissing = !r.apaar_id || r.apaar_id.trim() === '';
        const allotmentRef = r.allotment_ref || `MHT-CET/CAP-I/${88500 + idx}`;

        let statusTag = '';
        if (is12) {
          valid++;
          statusTag = `<span class="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-md border border-emerald-200 font-semibold text-[11px]">${i18nClient.validApaar || 'Valid APAAR'}</span>`;
        } else if (isMissing) {
          missing++;
          statusTag = `<span class="bg-amber-50 text-amber-700 px-2 py-0.5 rounded-md border border-amber-200 font-semibold text-[11px]">${i18nClient.missingApaar || 'Missing APAAR'}</span>`;
        } else {
          malformed++;
          statusTag = `<span class="bg-red-50 text-red-700 px-2 py-0.5 rounded-md border border-red-200 font-semibold text-[11px]">${i18nClient.malformedApaar || 'Format Error'}</span>`;
        }

        html += `
          <tr class="hover:bg-slate-50">
            <td class="py-2.5 px-3 font-mono text-slate-500">${idx + 1}</td>
            <td class="py-2.5 px-3 font-mono font-semibold text-slate-900">${maskApaarClient(r.apaar_id)}</td>
            <td class="py-2.5 px-3 text-slate-800 font-semibold">${r.full_name || r.name || 'Candidate'}</td>
            <td class="py-2.5 px-3 text-slate-700">${normalizeBranchClient(r.program)}</td>
            <td class="py-2.5 px-3">
              <div class="flex flex-wrap items-center gap-1">
                ${renderCategoryBadge(r.admission_quota || r.admission_category)}
                <span class="font-mono text-[10px] text-slate-500">· ${allotmentRef}</span>
              </div>
            </td>
            <td class="py-2.5 px-3">${statusTag}</td>
          </tr>
        `;
      });

      tableBody.innerHTML = html;
      document.getElementById('countValid')!.textContent = String(valid);
      document.getElementById('countMalformed')!.textContent = String(malformed);
      document.getElementById('countMissing')!.textContent = String(missing);
      if (commitBtn) commitBtn.disabled = valid === 0;
    }

    csvFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const text = evt.target?.result as string;
          if (!text) return;

          const lines = text
            .split(/\r?\n/)
            .map((l) => l.trim())
            .filter((l) => l.length > 0);
          if (lines.length === 0) return;

          const parseCols = (line: string) => {
            return line.split(',').map((c) => c.trim().replace(/^["']|["']$/g, ''));
          };

          const headerCols = parseCols(lines[0]).map((h) => h.toLowerCase());
          const apaarIdx = headerCols.findIndex((h) => h.includes('apaar'));
          const nameIdx = headerCols.findIndex((h) => h.includes('name'));
          const progIdx = headerCols.findIndex((h) => h.includes('prog') || h.includes('branch'));
          const quotaIdx = headerCols.findIndex((h) => h.includes('quota') || h.includes('cat'));
          const allotIdx = headerCols.findIndex((h) => h.includes('allot') || h.includes('ref'));
          const batchIdx = headerCols.findIndex((h) => h.includes('batch') || h.includes('year'));

          const hasHeader = apaarIdx !== -1 || nameIdx !== -1;
          const startIdx = hasHeader ? 1 : 0;
          const parsedRows: any[] = [];

          for (let i = startIdx; i < lines.length; i++) {
            const cols = parseCols(lines[i]);
            if (!cols || cols.length === 0 || (cols.length === 1 && !cols[0])) continue;

            const apaar = apaarIdx !== -1 ? cols[apaarIdx] : cols[0];
            const name = nameIdx !== -1 ? cols[nameIdx] : cols[1] || `Candidate ${i}`;
            const prog = progIdx !== -1 ? cols[progIdx] : cols[2] || 'B.Tech Computer Science';
            const quota = quotaIdx !== -1 ? cols[quotaIdx] : cols[3] || 'APPROVED_INTAKE';
            const allotment = allotIdx !== -1 ? cols[allotIdx] : cols[4] || `MHT-CET/CAP-I/${88500 + i}`;
            const batchRaw = batchIdx !== -1 ? cols[batchIdx] : cols[5];
            const batchYear = parseInt(batchRaw, 10) || 2026;

            parsedRows.push({
              apaar_id: (apaar || '').trim(),
              full_name: (name || 'Candidate').trim(),
              program: normalizeBranchClient(prog),
              admission_quota: normalizeQuotaClient(quota),
              allotment_ref: (allotment || `MHT-CET/CAP-I/${88500 + i}`).trim(),
              batch_year: batchYear,
            });
          }

          if (parsedRows.length > 0) {
            renderTriageRows(parsedRows);
            (window as any).showToast?.(`CSV: ${parsedRows.length} records staged in import queue.`, 'info');
          } else {
            (window as any).showToast?.('0 valid records found in CSV.', 'warning');
          }
        } catch (err: any) {
          (window as any).showToast?.('CSV Error: ' + err.message, 'error');
        } finally {
          (e.target as HTMLInputElement).value = '';
        }
      };
      reader.readAsText(file);
    });

    commitBtn?.addEventListener('click', async () => {
      if (!commitBtn) return;
      commitBtn.disabled = true;
      const instId = activeCollegeEl?.value || 'INST-001';
      const capUiVal = parseInt(activeCollegeEl?.getAttribute('data-sanctioned') || '180', 10);

      try {
        const validPayload = currentTriageData
          .filter((s) => /^[0-9]{12}$/.test(s.apaar_id))
          .map((s, idx) => {
            const branch = normalizeBranchClient(s.program);
            const branchMeta = BRANCH_CONFIG.find((b) => b.branch === branch) || BRANCH_CONFIG[0];
            return {
              apaar_id: s.apaar_id,
              roll_number: `TCA-1049-2026-${branchMeta.short}-${String(enrolledList.length + idx + 1).padStart(3, '0')}`,
              full_name: s.full_name || s.name || 'Candidate',
              program: branch,
              batch_year: s.batch_year || 2026,
              admission_quota: normalizeQuotaClient(s.admission_quota),
              allotment_ref: s.allotment_ref || `MHT-CET/CAP-I/${88500 + idx}`,
            };
          });

        const res = await fetch('/api/roster/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            institutionId: instId,
            students: validPayload,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          const inserted = data.inserted ?? validPayload.length;
          const dupes = data.duplicates_flagged ?? 0;

          validPayload.forEach((st, idx) => {
            const createdMatch = Array.isArray(data.created_admissions) ? data.created_admissions[idx] : null;
            appendToEnrolledTable({
              id: createdMatch?.id,
              apaar_id: st.apaar_id,
              roll_id: st.roll_number,
              full_name: st.full_name,
              program: st.program,
              batch_year: st.batch_year,
              admission_quota: st.admission_quota,
              allotment_ref: st.allotment_ref,
              is_duplicate: Boolean(createdMatch?.is_duplicate) || createdMatch?.status === 'FLAGGED_DUPLICATE',
            });
          });

          switchTableView('enrolled');
          showFeedbackBanner(
            `<div><strong>CSV Batch Committed to Ledger:</strong> Added <strong>${inserted}</strong> verified student records (${dupes} cross-campus duplicate flags). Active Roster Admitted: <strong>${enrolledList.length} / ${capUiVal}</strong>.</div>`,
            dupes > 0 ? 'warning' : 'success'
          );
          (window as any).showToast?.(`Committed ${inserted} student records (${enrolledList.length}/${capUiVal}).`, 'success');
        } else {
          const errMsg = data.error || 'Server rejected CSV batch';
          showFeedbackBanner(
            `<div><strong>Statutory Cap / Batch Exception (HTTP ${res.status}):</strong> ${errMsg}</div>`,
            'error'
          );
          (window as any).showToast?.(errMsg, 'error');
        }
      } catch {
        (window as any).showToast?.('Network synchronization error.', 'error');
      } finally {
        commitBtn.disabled = false;
      }
    });
  </script>
</Layout>
