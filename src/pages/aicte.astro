                      {log.apaar_id}
                    </td>
                    <td class="py-3.5 px-4 text-slate-700">
                      {log.purpose}
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-900 border border-blue-200 whitespace-nowrap">
                        {log.consent_status}
                      </span>
