---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import type { Institution } from '../lib/types';
import { EIGHTH_SCHEDULE_LANGUAGES } from '../lib/i18n';

const db = getDB(Astro.locals);
const instRes = await db.prepare('SELECT * FROM institutions ORDER BY name ASC').bind().all<Institution>();
const institutions = instRes.results || [];
const user = Astro.locals.user;

const totalApprovedIntake = institutions.reduce((sum, i) => sum + i.sanctioned_intake, 0);
const totalActualEnrolment = institutions.reduce((sum, i) => sum + i.current_enrollment, 0);
const totalSupernumerarySeats = institutions.reduce((sum, i) => sum + Math.round(i.sanctioned_intake * 0.15), 0);
const totalNriCategory = institutions.reduce((sum, i) => sum + Math.round(i.sanctioned_intake * 0.05), 0);
const totalOciStatus = institutions.reduce((sum, i) => sum + Math.max(1, Math.round(i.sanctioned_intake * 0.02)), 0);
const totalFnStatus = institutions.reduce((sum, i) => sum + Math.max(1, Math.round(i.sanctioned_intake * 0.03)), 0);

const portals = [
  {
    role: 'institution',
    title: '1. Approved Institution Portal',
    code: 'INST-01',
    description:
      'Statutory student roster submission channel. Features in-browser client-side memory triage (zero PII cloud leakage) to isolate valid, missing, and malformed 12-digit APAAR IDs before transmission. Enforces AICTE Approval Process Handbook (2024–2027) dynamic intake caps (60 / 120 / 180 / 240 seats).',
    path: '/institution',
    stats: 'Dynamic Intake Cap Enforcement',
    isPublic: false,
  },
  {
    role: 'aicte',
    title: '2. AICTE Regulatory Oversight',
    code: 'REG-02',
    description:
      'National regulatory surveillance and audit dashboard. Automatically flags technical institutions exceeding approved program intake limits under AICTE APH 2024–2027 norms and identifies concurrent cross-campus duplicate enrollments across states.',
    path: '/aicte',
    stats: 'National Quota & Duplicate Audit',
    isPublic: false,
  },
  {
    role: 'university',
    title: '3. Affiliating University Ledger',
    code: 'UNIV-03',
    description:
      'State and central affiliating universities verify affiliated college rosters, issue tamper-evident Ed25519 cryptographically signed academic degrees anchored to student APAAR IDs, and maintain an immutable revocation ledger.',
    path: '/university',
    stats: 'Ed25519 Signed Degree Ledger',
    isPublic: false,
  },
  {
    role: 'student',
    title: '4. Student Consent Authority (DPDP)',
    code: 'STU-04',
    description:
      'Statutory student consent vault compliant with Section 6 of the Digital Personal Data Protection (DPDP) Act, 2023. Enables students to grant, audit, or revoke time-bound digital consent using W3C WebAuthn hardware passkeys.',
    path: '/student',
    stats: 'Section 6 DPDP & FIDO2 Passkey',
    isPublic: false,
  },
  {
    role: 'verifier',
    title: '5. Public Credential Verification Terminal',
    code: 'VRF-05',
    description:
      'Open public verification gateway for government recruiters, employers, and higher education admissions. Enables instant 12-digit APAAR credential verification and cryptographic signature checks with zero login barrier.',
    path: '/verifier',
    stats: '< 50 ms Edge Verification',
    isPublic: true,
  },
];
---

<Layout
  title="National Student Registry & Verification Portal | AICTE | Ministry of Education"
  activeRole="overview"
  breadcrumb="National Overview & Institution Directory"
>
  <!-- 1. Authoritative UX4G Hero / Statutory Header Card -->
  <section class="bg-gradient-to-br from-[#0F2942] via-[#133251] to-[#0B1E32] text-white rounded-lg border-t-4 border-[#FF9933] shadow-md p-6 sm:p-8 mb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
      <!-- Left Column: Statutory Mandate & Primary CTAs -->
      <div class="lg:col-span-7 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="bg-[#FF9933] text-slate-950 font-bold text-xs uppercase px-2.5 py-0.5 rounded tracking-wide">
            AICTE APH 2024–2027 Mandate
          </span>
          <span class="bg-white/10 border border-white/20 text-slate-100 text-xs font-medium px-2.5 py-0.5 rounded">
            NEP 2020 | APAAR & ABC Registry
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white leading-tight">
          National Student Registry &amp; Cryptographic Credential Verification Portal
        </h1>

        <p class="text-sm text-slate-200 leading-relaxed">
          Official statutory gateway establishing a single source of truth across AICTE-approved technical institutions, affiliating universities, and public verifiers. Enforces sanctioned dynamic intake caps (<strong class="text-white">60 / 120 / 180 / 240 seats</strong>), 12-digit APAAR identity binding, and student-controlled consent under the <strong class="text-white">DPDP Act, 2023</strong>.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="/verifier"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[#138808] hover:bg-[#0E6506] text-white text-xs sm:text-sm font-bold shadow-xs transition-colors"
          >
            <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Verify Credential</span>
          </a>
          <a
            href="/login"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[#FF9933] hover:bg-[#F28500] text-slate-950 text-xs sm:text-sm font-bold shadow-xs transition-colors"
          >
            <span>Officer Sign In</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a
            href="#institution-search"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded bg-white/10 hover:bg-white/20 text-white border border-white/20 text-xs sm:text-sm font-semibold transition-colors"
          >
            <span>Browse Approved Institutions</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Quick Inline 12-Digit APAAR Verification Card -->
      <div class="lg:col-span-5">
        <div class="bg-white text-slate-900 rounded-lg p-5 shadow-lg border border-slate-200">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-4">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 block">
                Instant Public Gateway
              </span>
              <h2 class="text-base font-bold text-[#0F2942]">
                Quick 12-Digit APAAR Verification
              </h2>
            </div>
            <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold px-2.5 py-0.5 rounded">
              Open Access
            </span>
          </div>

          <form action="/verifier" method="GET" class="space-y-3">
            <div>
              <label for="quickApaarInput" class="block text-xs font-bold text-slate-700 mb-1.5">
                Student APAAR / ABC Identifier (12 Digits)
              </label>
              <input
                type="text"
                id="quickApaarInput"
                name="apaar"
                pattern="[0-9]{12}"
                maxlength="12"
                placeholder="e.g. 412398471029"
                class="w-full bg-slate-50 border border-slate-300 rounded px-3.5 py-2.5 font-mono text-sm text-slate-900 tracking-wider focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0F2942]"
              />
            </div>
            <button
              type="submit"
              class="w-full py-2.5 px-4 bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold rounded text-xs sm:text-sm transition-colors shadow-xs flex items-center justify-center gap-2"
            >
              <span>Verify Academic Record</span>
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </button>
          </form>

          <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Sample ID: <code class="font-mono font-bold text-slate-700">102938475610</code></span>
            <a href="/verifier" class="text-blue-700 hover:underline font-semibold inline-flex items-center gap-1">
              <span>Advanced Search</span>
              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 4 KPI Benchmark Cards (All 4 with Bold Numerical Metrics) -->
  <section aria-label="National Regulatory Benchmarks" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#0F2942] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Approved Technical Institutions</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5">8,500+</div>
      <div class="text-xs text-slate-600 mt-1">Nationally monitored under AICTE</div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#FF9933] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Sanctioned Annual Intake</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5">3.2M+</div>
      <div class="text-xs text-slate-600 mt-1">Dynamic caps: 60 / 120 / 180 / 240 seats</div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-[#138808] shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">APAAR &amp; DPDP Act Compliance</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5">100%</div>
      <div class="text-xs text-slate-600 mt-1">12-digit ID &amp; WebAuthn passkey consent</div>
    </div>

    <div class="bg-white p-5 rounded-lg border border-slate-200 border-l-4 border-l-blue-600 shadow-xs">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Cryptographic Degree Verification</div>
      <div class="text-2xl sm:text-3xl font-bold text-[#0F2942] mt-1.5">&lt; 50 ms</div>
      <div class="text-xs text-slate-600 mt-1">Ed25519 signed ledger at edge</div>
    </div>
  </section>

  <!-- 3. Public Institution Directory & Regulatory Compliance Table -->
  <section class="bg-white rounded-lg border border-slate-200 shadow-xs p-5 sm:p-6 mb-8" id="institution-search">
    <div class="border-b border-slate-200 pb-4 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Public Directory &amp; Intake Surveillance</span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold text-[#0F2942] mt-0.5">
          AICTE Approved Technical Institutions &amp; Live Intake Status
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          Filter institutions by name, AICTE code, district, or state to inspect sanctioned intake limits and verify student records.
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/verifier"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded bg-[#0F2942] hover:bg-[#1E3A8A] text-white text-xs font-bold shadow-xs transition-colors"
        >
          <span>Open Verification Terminal</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>

    <!-- Search & Filter Controls for Directory -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-4">
      <div class="md:col-span-8 relative">
        <label for="instSearchInput" class="sr-only">Search Institutions</label>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="instSearchInput"
          placeholder="Filter institutions by name, AICTE code, district, or state..."
          class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-300 rounded text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600"
        />
      </div>

      <div class="md:col-span-4">
        <label for="stateFilterSelect" class="sr-only">Filter by State</label>
        <select
          id="stateFilterSelect"
          class="w-full py-2 px-3 bg-slate-50 border border-slate-300 rounded text-xs sm:text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600"
        >
          <option value="">All States / Union Territories</option>
          {Array.from(new Set(institutions.map((i) => i.state).filter(Boolean))).sort().map((st) => (
            <option value={st}>{st}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Statutory Seat & Admission Category Breakdown (AICTE APH Norms) — 6-Column Strip -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 mb-4 text-xs">
      <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
        <div class="text-[10px] font-bold uppercase text-slate-500 tracking-wider">Approved Intake</div>
        <div class="text-sm sm:text-base font-bold font-mono text-[#0F2942] mt-0.5">{totalApprovedIntake}</div>
      </div>
      <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
        <div class="text-[10px] font-bold uppercase text-slate-500 tracking-wider">Actual Enrolment</div>
        <div class="text-sm sm:text-base font-bold font-mono text-emerald-700 mt-0.5">{totalActualEnrolment}</div>
      </div>
      <div class="p-2.5 rounded bg-blue-50/50 border border-blue-200">
        <div class="text-[10px] font-bold uppercase text-blue-800 tracking-wider">Supernumerary Seats</div>
        <div class="text-sm sm:text-base font-bold font-mono text-blue-900 mt-0.5">{totalSupernumerarySeats} <span class="text-[10px] font-normal">(TFW/EWS)</span></div>
      </div>
      <div class="p-2.5 rounded bg-amber-50/50 border border-amber-200">
        <div class="text-[10px] font-bold uppercase text-amber-900 tracking-wider">NRI Category</div>
        <div class="text-sm sm:text-base font-bold font-mono text-amber-900 mt-0.5">{totalNriCategory}</div>
      </div>
      <div class="p-2.5 rounded bg-indigo-50/50 border border-indigo-200">
        <div class="text-[10px] font-bold uppercase text-indigo-900 tracking-wider">OCI Status</div>
        <div class="text-sm sm:text-base font-bold font-mono text-indigo-900 mt-0.5">{totalOciStatus}</div>
      </div>
      <div class="p-2.5 rounded bg-emerald-50/50 border border-emerald-200">
        <div class="text-[10px] font-bold uppercase text-emerald-900 tracking-wider">Foreign National (FN)</div>
        <div class="text-sm sm:text-base font-bold font-mono text-emerald-900 mt-0.5">{totalFnStatus}</div>
      </div>
    </div>

    <!-- Interactive Directory Table -->
    <div class="overflow-x-auto border border-slate-200 rounded-lg">
      <table class="w-full text-left text-xs sm:text-sm" id="institutionsTable">
        <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200 uppercase tracking-wider text-xs">
          <tr>
            <th class="py-3 px-4">Institution Code &amp; Name</th>
            <th class="py-3 px-4">State / District</th>
            <th class="py-3 px-4">Sanctioned Intake</th>
            <th class="py-3 px-4">Active Enrollment</th>
            <th class="py-3 px-4">Regulatory Status</th>
            <th class="py-3 px-4 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 font-medium text-slate-700" id="instTableBody">
          {institutions.map((inst) => {
            const isOverrun = inst.current_enrollment > inst.sanctioned_intake;
            const excessSeats = inst.current_enrollment - inst.sanctioned_intake;

            return (
              <tr
                class={`transition-colors inst-row ${isOverrun ? 'bg-red-50/30 hover:bg-red-50/60' : 'hover:bg-slate-50'}`}
                data-name={inst.name.toLowerCase()}
                data-code={inst.code.toLowerCase()}
                data-id={inst.id.toLowerCase()}
                data-state={inst.state.toLowerCase()}
                data-district={inst.district.toLowerCase()}
              >
                <td class="py-3.5 px-4">
                  <div class="font-bold text-[#0F2942] text-sm">{inst.name}</div>
                  <div class="text-xs font-mono text-slate-500 mt-0.5">
                    Code: {inst.code} &bull; ID: {inst.id}
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-800">{inst.district}</div>
                  <div class="text-xs text-slate-500">{inst.state}</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-bold text-slate-900 font-mono">{inst.sanctioned_intake}</span>
                  <span class="text-xs text-slate-500 ml-1">Sanctioned Seats</span>
                </td>
                <td class="py-3.5 px-4">
                  {isOverrun ? (
                    <span class="font-mono font-bold text-red-700">
                      {inst.current_enrollment} / {inst.sanctioned_intake}
                    </span>
                  ) : (
                    <span class="font-mono font-semibold text-slate-800">
                      {inst.current_enrollment} / {inst.sanctioned_intake}
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4">
                  {isOverrun ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold bg-red-50 text-red-800 border border-red-200">
                      <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
                      <span>Quota Overrun (+{excessSeats} Excess)</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                      <span>Compliant (AICTE Approved)</span>
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href={`/verifier?institution=${encodeURIComponent(inst.id)}&code=${encodeURIComponent(inst.code)}`}
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-slate-100 hover:bg-[#0F2942] text-[#0F2942] hover:text-white border border-slate-300 text-xs font-bold transition-colors"
                  >
                    <span>Verify Records</span>
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div id="noResultsMsg" class="hidden p-6 text-center text-sm text-slate-500">
        No technical institutions found matching the selected filter criteria.
      </div>
    </div>
  </section>

  <!-- 4. 5 Stakeholder Portals Grid (Balanced 6-Col Layout: 3 Top Row, 2 Bottom Row) -->
  <section class="mb-8" aria-labelledby="stakeholder-portals-heading">
    <div class="border-b border-slate-200 pb-3 mb-5 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 id="stakeholder-portals-heading" class="text-lg sm:text-xl font-bold text-[#0F2942]">
          Stakeholder Portals &amp; Operational Modules
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          Select an operational authority to access role-isolated data management functions or open public verification.
        </p>
      </div>
      <span class="text-xs font-mono font-semibold bg-slate-100 text-slate-700 px-3 py-1 rounded border border-slate-300">
        5 Statutory Modules
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5">
      {portals.map((p, index) => {
        const isPublic = p.isPublic;
        const targetUrl = user
          ? p.path
          : isPublic
          ? '/verifier'
          : `/login?redirect=${encodeURIComponent(p.path)}`;
        const actionText = user
          ? 'Enter Portal'
          : isPublic
          ? 'Launch Verification Terminal'
          : 'Officer Sign In';

        // Top 3 cards take 2 cols each (3x2=6), bottom 2 cards take 3 cols each (2x3=6) on lg screens
        const colSpanClass = index < 3 ? 'lg:col-span-2' : 'lg:col-span-3';

        return (
          <div
            class={`${colSpanClass} bg-white rounded-lg border shadow-xs flex flex-col justify-between transition-all ${
              isPublic
                ? 'border-emerald-600 ring-1 ring-emerald-500/30 hover:border-emerald-700'
                : 'border-slate-200 hover:border-[#0F2942]'
            }`}
          >
            <div class="p-5 sm:p-6">
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono font-bold bg-slate-100 text-[#0F2942] px-2.5 py-0.5 rounded border border-slate-300">
                  {p.code}
                </span>
                {isPublic ? (
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200">
                    Public Open Access
                  </span>
                ) : (
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-amber-50 text-amber-900 border border-amber-200">
                    Officer Auth Required
                  </span>
                )}
              </div>

              <h3 class="text-base font-bold text-[#0F2942] mb-2 leading-snug">
                {p.title}
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                {p.description}
              </p>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500 font-medium">Statutory Capability:</span>
                <span class="font-bold text-slate-800">{p.stats}</span>
              </div>
            </div>

            <div class={`p-4 border-t mt-auto ${isPublic ? 'bg-emerald-50/50 border-emerald-100' : 'bg-slate-50 border-slate-100'}`}>
              <a
                href={targetUrl}
                class={`inline-flex items-center justify-center gap-2 w-full text-center text-xs sm:text-sm font-bold py-2.5 px-4 rounded transition-colors shadow-xs ${
                  isPublic
                    ? 'bg-[#138808] hover:bg-[#0E6506] text-white'
