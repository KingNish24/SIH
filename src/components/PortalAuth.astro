---
import { getUIDictionary, isSupportedLang, type LangCode } from '../lib/i18n';

interface Props {
  portal: 'college' | 'aicte' | 'university' | 'student';
  lang?: LangCode;
}

const { portal, lang: propLang } = Astro.props;
const lang: LangCode = isSupportedLang(propLang)
  ? propLang
  : isSupportedLang(Astro.locals.lang)
    ? Astro.locals.lang
    : 'en';
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = getUIDictionary(lang);

const user = Astro.locals.user;
const url = Astro.url;
const redirectParam = url.searchParams.get('redirect') || '';
const reason = url.searchParams.get('reason') || '';
const errorParam = url.searchParams.get('error') || '';

const isLoginRedirect =
  redirectParam.startsWith('/login') || /^\/[a-z]{2,3}\/login(\/|$|\?)/.test(redirectParam);
const rawRedirect = redirectParam && redirectParam.startsWith('/') && !isLoginRedirect ? redirectParam : '';
const firstRedirectSeg = rawRedirect.split('/').filter(Boolean)[0];

interface PortalMeta {
  id: 'college' | 'aicte' | 'university' | 'student';
  role: 'INSTITUTE_ADMIN' | 'AICTE_ADMIN' | 'UNIVERSITY_ADMIN' | 'STUDENT';
  title: string;
  authority: string;
  subtitle: string;
  defaultPath: string;
  gradientClass: string;
  accentBgClass: string;
  accentHoverClass: string;
  accentRingClass: string;
  accentTextClass: string;
  usernameLabel: string;
  usernamePlaceholder: string;
  demoUsername: string;
  demoOfficerName: string;
  demoSubtitle: string;
  bullets: string[];
  provisioningNote: string;
}

const PORTAL_META: Record<'college' | 'aicte' | 'university' | 'student', PortalMeta> = {
  college: {
    id: 'college',
    role: 'INSTITUTE_ADMIN',
    title: 'College Nodal Portal',
    authority: 'AICTE Approved Technical Institutions',
    subtitle: 'Sign in with your AISHE Nodal Officer ID to manage admitted student rosters and verify sanctioned seat intake limits.',
    defaultPath: `${langPrefix}/institution`,
    gradientClass: 'bg-gradient-to-br from-[#1E40AF] to-[#0A2760]',
    accentBgClass: 'bg-[#1E40AF]',
    accentHoverClass: 'hover:bg-[#1D4ED8]',
    accentRingClass: 'focus:ring-[#1E40AF]',
    accentTextClass: 'text-[#1E40AF]',
    usernameLabel: 'Nodal Officer ID / AISHE Username',
    usernamePlaceholder: 'principal.pune',
    demoUsername: 'principal.pune',
    demoOfficerName: 'Dr. Ramesh Joshi',
    demoSubtitle: 'Principal · Technical College A (INST-001)',
    bullets: [
      'Register admitted students against AICTE sanctioned intake caps',
      'Verify 12-digit APAAR IDs and check real-time remaining seats',
      'Block duplicate cross-campus or over-capacity admissions',
    ],
    provisioningNote:
      'College Nodal Officer accounts are issued via the AICTE Approval Bureau upon Extension of Approval (EoA).',
  },
  aicte: {
    id: 'aicte',
    role: 'AICTE_ADMIN',
    title: 'AICTE Regulatory Portal',
    authority: 'All India Council for Technical Education',
    subtitle: 'National intake surveillance, sanctioned seat capacity enforcement, and cross-institution duplicate enrollment audits.',
    defaultPath: `${langPrefix}/aicte`,
    gradientClass: 'bg-gradient-to-br from-[#B45309] to-[#78350F]',
    accentBgClass: 'bg-[#B45309]',
    accentHoverClass: 'hover:bg-[#D97706]',
    accentRingClass: 'focus:ring-[#B45309]',
    accentTextClass: 'text-[#B45309]',
    usernameLabel: 'Regulatory Officer ID',
    usernamePlaceholder: 'aicte.officer',
    demoUsername: 'aicte.officer',
    demoOfficerName: 'Dr. S. K. Mahajan',
    demoSubtitle: 'Chief Regulatory Officer · AICTE HQ',
    bullets: [
      'Monitor all-India engineering colleges against sanctioned intake',
      'Flag over-capacity seat violations and duplicate APAAR IDs',
      'Update sanctioned program caps and review Merkle audit trails',
    ],
    provisioningNote:
      'AICTE Regulatory Officer credentials are managed by the AICTE Vigilance Cell via Parichay Directory.',
  },
  university: {
    id: 'university',
    role: 'UNIVERSITY_ADMIN',
    title: 'Affiliating University Portal',
    authority: 'Controller of Examinations & Degree Registry',
    subtitle: 'Verify AICTE within-cap seat compliance and issue Ed25519 cryptographically signed digital degrees to NAD.',
    defaultPath: `${langPrefix}/university`,
    gradientClass: 'bg-gradient-to-br from-[#4338CA] to-[#27206B]',
    accentBgClass: 'bg-[#4338CA]',
    accentHoverClass: 'hover:bg-[#4F46E5]',
    accentRingClass: 'focus:ring-[#4338CA]',
    accentTextClass: 'text-[#4338CA]',
    usernameLabel: 'University Registrar / COE ID',
    usernamePlaceholder: 'registrar.univ',
    demoUsername: 'registrar.univ',
    demoOfficerName: 'Prof. K. Venkatesh',
    demoSubtitle: 'Registrar · State Affiliating University',
    bullets: [
      'Verify graduating students hold valid AICTE within-cap seats',
      'Sign and issue Ed25519 digital degrees to National Academic Depository',
      'Prevent degree issuance for unapproved or over-cap enrollments',
    ],
    provisioningNote:
      'University Registrar & COE accounts are provisioned via the UGC / AICTE Affiliating University Registry.',
  },
  student: {
    id: 'student',
    role: 'STUDENT',
    title: 'Student APAAR Portal',
    authority: 'One Nation, One Student ID · Ministry of Education',
    subtitle: 'Access your 12-digit APAAR academic identity, verify your college seat approval status, and manage DPDP consent passes.',
    defaultPath: `${langPrefix}/student`,
    gradientClass: 'bg-gradient-to-br from-[#047857] to-[#064E3B]',
    accentBgClass: 'bg-[#047857]',
    accentHoverClass: 'hover:bg-[#059669]',
    accentRingClass: 'focus:ring-[#047857]',
    accentTextClass: 'text-[#047857]',
    usernameLabel: '12-Digit APAAR ID or Username',
    usernamePlaceholder: '739284019283 or student.rahul',
    demoUsername: 'student.rahul',
    demoOfficerName: 'Rahul Sharma',
    demoSubtitle: 'B.Tech CSE · APAAR: 739284019283',
    bullets: [
      'Check that your college admission is within AICTE approved seats',
      'View your 12-digit APAAR card, ABC credits, and digital degree',
      'Create single-use DPDP Act 2023 consent passes for verifiers',
    ],
    provisioningNote:
      'Students can sign in with an existing 12-digit APAAR ID or register a new APAAR account using the New Registration tab.',
  },
};

const meta = PORTAL_META[portal];

const portalSwitcherItems = [
  { id: 'college', label: 'Colleges', href: `${langPrefix}/login/college` },
  { id: 'aicte', label: 'AICTE', href: `${langPrefix}/login/aicte` },
  { id: 'university', label: 'Universities', href: `${langPrefix}/login/university` },
  { id: 'student', label: 'Students', href: `${langPrefix}/login/student` },
] as const;

const defaultRedirect = rawRedirect
  ? langPrefix && !isSupportedLang(firstRedirectSeg)
    ? rawRedirect === '/'
      ? langPrefix
      : `${langPrefix}${rawRedirect}`
    : rawRedirect
  : meta.defaultPath;
---

<div class="max-w-4xl mx-auto py-3">
  <!-- Compact Role Switcher Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div class="inline-flex items-center p-1 rounded-xl bg-slate-200/75 border border-slate-200">
      {portalSwitcherItems.map((item) => {
        const isActive = item.id === portal;
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all ${
              isActive
                ? 'bg-white text-[#040E29] shadow-2xs'
                : 'text-slate-600 hover:text-[#040E29]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <a
      href={`${langPrefix}/verifier`}
      class="inline-flex items-center gap-1.5 text-xs font-bold text-[#047857] hover:underline"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{t.navVerifier} (No Login Needed)</span>
    </a>
  </div>

  <!-- Status & Error Banners -->
  {reason === 'unauthorized' && (
    <div class="mb-4 p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-950 text-xs flex items-center gap-3">
      <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>
        <strong>Sign-In Required:</strong> Please sign in with your {meta.title} credentials or use the 1-click demo button below.
      </span>
    </div>
  )}

  {reason === 'logged_out' && (
    <div class="mb-4 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-950 text-xs flex items-center gap-3">
      <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span>
        <strong>Signed Out:</strong> Your session has ended safely. Sign in below to continue.
      </span>
    </div>
  )}

  {errorParam && (
    <div class="mb-4 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-950 text-xs flex items-center gap-3">
      <svg class="w-5 h-5 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
      <span>{decodeURIComponent(errorParam)}</span>
    </div>
  )}

  {user && (
    <div class="mb-4 p-3.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-950 text-xs flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
        <span>
          Signed in as <strong class="font-mono text-[#0F2942]">{user.username}</strong> ({user.full_name})
        </span>
      </div>
      <div class="flex items-center gap-2">
        <a
          href={meta.defaultPath}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#0F2942] hover:bg-[#1E3A8A] text-white font-bold transition-colors text-xs"
        >
          <span>Open Portal</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" />
          </svg>
        </a>
        <a
          href="/api/auth/logout"
          class="px-3 py-1.5 rounded-lg bg-white hover:bg-red-50 text-red-700 border border-red-200 font-bold transition-colors text-xs"
        >
          {t.signOut}
        </a>
      </div>
    </div>
  )}

  <!-- Unified Split-Surface Civic Authentication Card -->
  <div class="rounded-2xl bg-white shadow-[0_18px_45px_-15px_rgba(4,14,41,0.14)] overflow-hidden grid grid-cols-1 lg:grid-cols-12">
    <!-- Left 5 Columns: Portal Brand Panel -->
    <div class={`lg:col-span-5 ${meta.gradientClass} text-white p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden`}>
      <svg class="absolute -right-10 -bottom-10 w-44 h-44 text-white/[0.05] pointer-events-none" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
        <circle cx="50" cy="50" r="50" />
      </svg>

      <div class="relative z-10">
        <!-- Official Emblem & Authority Header -->
        <div class="flex items-center gap-3 mb-6">
          <div class="w-11 h-11 rounded-xl bg-white text-[#040E29] flex items-center justify-center shadow-xs shrink-0">
            {portal === 'college' && (
              <svg class="w-5 h-5 text-[#1E40AF]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            )}
            {portal === 'aicte' && (
              <svg class="w-5 h-5 text-[#B45309]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            )}
            {portal === 'university' && (
              <svg class="w-5 h-5 text-[#4338CA]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {portal === 'student' && (
              <svg class="w-5 h-5 text-[#047857]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            )}
          </div>
          <div class="text-xs font-semibold text-white/85 leading-tight">
            {meta.authority}
          </div>
        </div>

        <h1 class="text-2xl sm:text-[26px] font-extrabold tracking-tight text-white leading-tight">
          {meta.title}
        </h1>
        <p class="mt-2.5 text-xs sm:text-[13px] text-white/85 leading-relaxed">
          {meta.subtitle}
        </p>

        <!-- Key Capabilities List -->
        <ul class="mt-6 space-y-3 text-xs sm:text-[13px] text-white/95">
          {meta.bullets.map((bullet) => (
            <li class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-[#FFAE19] text-[#040E29] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="leading-snug">{bullet}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Bottom: Official APAAR / AICTE Attribution Strip -->
      <div class="relative z-10 mt-8 pt-5 border-t border-white/15 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="bg-white rounded-md px-2 py-1 shrink-0 flex items-center">
            <img src="/apaar_logo.svg" alt="APAAR" class="h-5 w-auto object-contain" width="52" height="20" />
          </div>
          <span class="text-[11px] text-white/80 font-medium">
            National Academic Depository
          </span>
        </div>
        <span class="text-[11px] font-mono text-white/70">
          SIH26263
        </span>
      </div>
    </div>

    <!-- Right 7 Columns: Clean Sign-In / Student Registration Form -->
    <div class="lg:col-span-7 p-7 sm:p-9 flex flex-col justify-between">
      <div>
        <!-- Form Header OR Student Sign-In / Sign-Up Tabs -->
        {portal === 'student' ? (
          <div class="mb-6">
            <div class="grid grid-cols-2 gap-1.5 p-1 bg-slate-100 rounded-xl" role="tablist" aria-label="Student Authentication Mode">
              <button
                type="button"
                id="tabSignInBtn"
                role="tab"
                aria-selected="true"
                aria-controls="panelSignIn"
                class="py-2.5 px-4 rounded-lg text-xs sm:text-sm font-extrabold transition-all bg-white text-[#047857] shadow-2xs cursor-pointer flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
                <span>Sign In</span>
              </button>
              <button
                type="button"
                id="tabSignUpBtn"
                role="tab"
                aria-selected="false"
                aria-controls="panelSignUp"
                class="py-2.5 px-4 rounded-lg text-xs sm:text-sm font-extrabold transition-all text-slate-600 hover:text-slate-900 cursor-pointer flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
                <span>New APAAR Sign Up</span>
              </button>
            </div>
          </div>
        ) : (
          <div class="mb-6 pb-4 border-b border-slate-100 flex items-center justify-between gap-3">
            <div>
              <h2 class="text-lg sm:text-xl font-extrabold text-[#040E29] tracking-tight">
                Sign In to {meta.title}
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                Enter your official credentials below to access the portal.
              </p>
            </div>
            <img
              src="/emblem.svg"
              alt="State Emblem of India"
              class="h-8 w-auto object-contain opacity-80 shrink-0"
              width="24"
              height="32"
            />
          </div>
        )}

        <!-- SIGN IN PANEL -->
        <div id="panelSignIn" role="tabpanel">
          <!-- Compact 1-Click Evaluator Demo Strip -->
          <div class="mb-5 p-3 rounded-xl bg-[#F8FAFC] border border-slate-200/90 flex flex-wrap items-center justify-between gap-2.5">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="w-7 h-7 rounded-lg bg-[#FFAE19]/20 text-[#92400E] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </span>
              <div class="min-w-0">
                <div class="text-xs font-bold text-[#040E29] truncate">
                  Demo: {meta.demoOfficerName}
                </div>
                <div class="text-[11px] text-slate-500 truncate">
                  <code class="font-mono font-semibold text-slate-700">{meta.demoUsername}</code> · {meta.demoSubtitle}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-1.5 shrink-0">
              <button
                type="button"
                id="btnDemoFill"
                data-username={meta.demoUsername}
                class="px-2.5 py-1.5 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs font-bold transition-colors cursor-pointer"
              >
                Fill ID
              </button>
              <button
                type="button"
                id="btnDemoQuickLogin"
                data-portal={meta.id}
                data-role={meta.role}
                data-username={meta.demoUsername}
                data-redirect={defaultRedirect}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#FFAE19] hover:bg-[#f59e0b] text-[#040E29] text-xs font-extrabold transition-all cursor-pointer"
              >
                <span>1-Click Demo Sign In</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
                </svg>
              </button>
            </div>
          </div>

          <form
            id="portalLoginForm"
            action="/api/auth/login"
            method="POST"
            class="space-y-4"
            data-default-redirect={defaultRedirect}
          >
            <input type="hidden" name="portal" value={meta.id} />
            <input type="hidden" name="role" value={meta.role} />
            <input type="hidden" name="redirect" value={defaultRedirect} />

            <div>
              <label for="loginUsernameInput" class="block text-xs sm:text-sm font-bold text-slate-800 mb-1.5">
                {meta.usernameLabel}
              </label>
              <input
                type="text"
                id="loginUsernameInput"
                name="username"
                required
                autocomplete="username"
                placeholder={meta.usernamePlaceholder}
                class={`w-full h-11 bg-slate-50 border border-slate-300 rounded-xl px-3.5 font-mono text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 ${meta.accentRingClass} focus:border-transparent transition-all`}
              />
            </div>

            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="loginPasswordInput" class="block text-xs sm:text-sm font-bold text-slate-800">
                  {t.login_password || 'Password'}
                </label>
                <button
                  type="button"
                  id="toggleLoginPassBtn"
                  aria-pressed="false"
                  class={`text-xs font-bold ${meta.accentTextClass} hover:underline cursor-pointer`}
                >
                  Show Password
                </button>
              </div>
              <input
                type="password"
                id="loginPasswordInput"
                name="password"
                required
                autocomplete="current-password"
                placeholder="Enter your password"
                class={`w-full h-11 bg-slate-50 border border-slate-300 rounded-xl px-3.5 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 ${meta.accentRingClass} focus:border-transparent transition-all`}
              />
            </div>

            <div id="portalLoginFeedback" role="alert" aria-live="polite" class="hidden p-3.5 rounded-xl text-xs"></div>

            <button
              type="submit"
              id="portalLoginSubmitBtn"
              data-default-label={`Sign In to ${meta.title}`}
              class={`w-full h-11 ${meta.accentBgClass} ${meta.accentHoverClass} text-white rounded-xl font-extrabold text-sm shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer mt-2`}
            >
              <span id="portalLoginBtnText">Sign In to {meta.title}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </button>
          </form>
        </div>

        <!-- SIGN UP PANEL (Rendered ONLY when portal === 'student') -->
        {portal === 'student' && (
          <div id="panelSignUp" role="tabpanel" class="hidden">
            <form
              id="studentSignupForm"
              action="/api/auth/signup"
              method="POST"
              class="space-y-3.5"
              data-default-redirect={defaultRedirect}
            >
              <input type="hidden" name="redirect" value={defaultRedirect} />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label for="signupFullName" class="block text-xs font-bold text-slate-800 mb-1">
                    Full Name (as per Aadhaar)
                  </label>
                  <input
                    type="text"
                    id="signupFullName"
                    name="full_name"
                    required
                    placeholder="Ananya Deshmukh"
                    class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-slate-900 text-xs sm:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#047857]"
                  />
                </div>

                <div>
                  <label for="signupUsername" class="block text-xs font-bold text-slate-800 mb-1">
                    Username
                  </label>
                  <input
                    type="text"
                    id="signupUsername"
                    name="username"
                    required
                    placeholder="student.ananya"
                    class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 font-mono text-slate-900 text-xs sm:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#047857]"
                  />
                </div>
              </div>

              <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                  <label for="signupApaarId" class="block text-xs font-bold text-slate-800">
                    12-Digit APAAR / ABC ID
                  </label>
                  <button
                    type="button"
                    id="btnGenerateApaar"
                    class="inline-flex items-center gap-1 text-[11px] font-extrabold text-[#047857] hover:underline cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span>Auto-Fill Sample 12-Digit ID</span>
                  </button>
                </div>
                <input
                  type="text"
                  id="signupApaarId"
                  name="apaar_id"
                  required
                  pattern="\d{12}"
                  maxlength="12"
                  inputmode="numeric"
                  placeholder="482910384756"
                  class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 font-mono text-slate-900 text-xs sm:text-sm tracking-wider focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#047857]"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label for="signupInstitution" class="block text-xs font-bold text-slate-800 mb-1">
                    Admitted College
                  </label>
                  <select
                    id="signupInstitution"
                    name="institution_id"
                    required
                    class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-slate-900 text-xs sm:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#047857]"
                  >
                    <option value="INST-001">Technical College A (Pune)</option>
                    <option value="INST-002">Technical College B (Bengaluru)</option>
                    <option value="INST-003">State University College (Delhi)</option>
                  </select>
                </div>

                <div>
                  <label for="signupProgram" class="block text-xs font-bold text-slate-800 mb-1">
                    Degree Program
                  </label>
                  <select
                    id="signupProgram"
                    name="program"
                    required
                    class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-slate-900 text-xs sm:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#047857]"
                  >
                    <option value="B.Tech Computer Science & Engineering">B.Tech Computer Science</option>
                    <option value="B.Tech Information Technology">B.Tech Information Tech</option>
                    <option value="B.Tech Electronics & Comm.">B.Tech Electronics & Comm.</option>
                    <option value="B.Tech Data Science & AI">B.Tech Data Science & AI</option>
                    <option value="B.Tech Mechanical Engineering">B.Tech Mechanical Engg</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label for="signupEmail" class="block text-xs font-bold text-slate-800 mb-1">
                    Email Address
                  </label>
                  <input
                    type="email"
                    id="signupEmail"
                    name="email"
                    required
                    placeholder="student@college.edu.in"
                    class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-slate-900 text-xs sm:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#047857]"
                  />
                </div>

                <div>
                  <label for="signupPassword" class="block text-xs font-bold text-slate-800 mb-1">
                    Create Password
                  </label>
                  <input
                    type="password"
                    id="signupPassword"
                    name="password"
                    required
                    minlength="6"
                    autocomplete="new-password"
                    placeholder="Min. 6 characters"
                    class="w-full h-10 bg-slate-50 border border-slate-300 rounded-xl px-3 text-slate-900 text-xs sm:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#047857]"
                  />
                </div>
              </div>

              <div id="studentSignupFeedback" role="alert" aria-live="polite" class="hidden p-3.5 rounded-xl text-xs"></div>

              <button
                type="submit"
                id="studentSignupSubmitBtn"
                class="w-full h-11 bg-[#047857] hover:bg-[#059669] text-white rounded-xl font-extrabold text-sm shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <span id="studentSignupBtnText">Create APAAR Account & Sign In</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14m-6-6l6 6-6 6" />
                </svg>
              </button>
            </form>
          </div>
        )}
      </div>

      <!-- Clean Footer Note -->
      <div class="mt-6 pt-4 border-t border-slate-100 flex items-start gap-2.5 text-[11px] text-slate-500">
        <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <p class="leading-relaxed">
          {meta.provisioningNote}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  // 1. Show / Hide Password Toggle
  const togglePassBtn = document.getElementById('toggleLoginPassBtn');
  const loginPassInput = document.getElementById('loginPasswordInput') as HTMLInputElement | null;
  const loginUserInput = document.getElementById('loginUsernameInput') as HTMLInputElement | null;

  if (togglePassBtn && loginPassInput) {
    togglePassBtn.addEventListener('click', () => {
      const isPass = loginPassInput.type === 'password';
      loginPassInput.type = isPass ? 'text' : 'password';
      togglePassBtn.textContent = isPass ? 'Hide Password' : 'Show Password';
      togglePassBtn.setAttribute('aria-pressed', isPass ? 'true' : 'false');
    });
  }

  // 2. Student Sign-In / Sign-Up Tab Switcher
  const tabSignInBtn = document.getElementById('tabSignInBtn');
  const tabSignUpBtn = document.getElementById('tabSignUpBtn');
  const panelSignIn = document.getElementById('panelSignIn');
  const panelSignUp = document.getElementById('panelSignUp');

  function activateTab(mode: 'signin' | 'signup') {
    if (!tabSignInBtn || !tabSignUpBtn || !panelSignIn || !panelSignUp) return;
    if (mode === 'signin') {
      tabSignInBtn.setAttribute('aria-selected', 'true');
      tabSignUpBtn.setAttribute('aria-selected', 'false');
      tabSignInBtn.className = 'py-2.5 px-4 rounded-lg text-xs sm:text-sm font-extrabold transition-all bg-white text-[#047857] shadow-2xs cursor-pointer flex items-center justify-center gap-2';
      tabSignUpBtn.className = 'py-2.5 px-4 rounded-lg text-xs sm:text-sm font-extrabold transition-all text-slate-600 hover:text-slate-900 cursor-pointer flex items-center justify-center gap-2';
      panelSignIn.classList.remove('hidden');
      panelSignUp.classList.add('hidden');
    } else {
      tabSignInBtn.setAttribute('aria-selected', 'false');
      tabSignUpBtn.setAttribute('aria-selected', 'true');
      tabSignUpBtn.className = 'py-2.5 px-4 rounded-lg text-xs sm:text-sm font-extrabold transition-all bg-white text-[#047857] shadow-2xs cursor-pointer flex items-center justify-center gap-2';
      tabSignInBtn.className = 'py-2.5 px-4 rounded-lg text-xs sm:text-sm font-extrabold transition-all text-slate-600 hover:text-slate-900 cursor-pointer flex items-center justify-center gap-2';
      panelSignUp.classList.remove('hidden');
      panelSignIn.classList.add('hidden');
    }
  }

  tabSignInBtn?.addEventListener('click', () => activateTab('signin'));
  tabSignUpBtn?.addEventListener('click', () => activateTab('signup'));

  if (new URLSearchParams(window.location.search).get('tab') === 'signup') {
    activateTab('signup');
  }

  // 3. Auto-Fill Sample 12-Digit APAAR ID helper for Student Sign-Up
  const btnGenerateApaar = document.getElementById('btnGenerateApaar');
  const signupApaarInput = document.getElementById('signupApaarId') as HTMLInputElement | null;
  const signupFullNameInput = document.getElementById('signupFullName') as HTMLInputElement | null;
  const signupUsernameInput = document.getElementById('signupUsername') as HTMLInputElement | null;
  const signupEmailInput = document.getElementById('signupEmail') as HTMLInputElement | null;

  btnGenerateApaar?.addEventListener('click', () => {
    const randomDigits = Array.from({ length: 12 }, (_, idx) =>
      idx === 0 ? String(Math.floor(2 + Math.random() * 7)) : String(Math.floor(Math.random() * 10))
    ).join('');
    if (signupApaarInput) {
      signupApaarInput.value = randomDigits;
    }
    const suffix = randomDigits.slice(-4);
    if (signupFullNameInput && !signupFullNameInput.value) {
      signupFullNameInput.value = `Ananya Deshmukh`;
    }
    if (signupUsernameInput && !signupUsernameInput.value) {
      signupUsernameInput.value = `student.${suffix}`;
    }
    if (signupEmailInput && !signupEmailInput.value) {
      signupEmailInput.value = `student.${suffix}@college.edu.in`;
    }
    (window as any).showToast?.(`Generated sample 12-digit APAAR ID: ${randomDigits}`, 'info');
  });

  // 4. Demo Fill ID Button
  const btnDemoFill = document.getElementById('btnDemoFill');
  btnDemoFill?.addEventListener('click', () => {
    activateTab('signin');
    const u = btnDemoFill.getAttribute('data-username') || '';
    if (loginUserInput && loginPassInput) {
      loginUserInput.value = u;
      loginPassInput.focus();
      (window as any).showToast?.(`Filled demo ID: ${u}`, 'info');
    }
  });

  // 5. 1-Click Demo Quick Sign-In Button
  const btnDemoQuickLogin = document.getElementById('btnDemoQuickLogin') as HTMLButtonElement | null;
  btnDemoQuickLogin?.addEventListener('click', async () => {
    const portal = btnDemoQuickLogin.getAttribute('data-portal') || '';
    const role = btnDemoQuickLogin.getAttribute('data-role') || '';
    const username = btnDemoQuickLogin.getAttribute('data-username') || '';
    const redirect = btnDemoQuickLogin.getAttribute('data-redirect') || '/';

    const originalHtml = btnDemoQuickLogin.innerHTML;
    btnDemoQuickLogin.disabled = true;
    btnDemoQuickLogin.innerHTML = `<span>Signing In...</span>`;

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          portal,
          role,
          username,
          demo_quick_switch: true,
          redirect,
        }),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.href = data.redirect || redirect;
      } else {
        (window as any).showToast?.('Demo sign-in failed: ' + (data.error || 'Unknown error'), 'error');
        btnDemoQuickLogin.disabled = false;
        btnDemoQuickLogin.innerHTML = originalHtml;
      }
    } catch (err: any) {
      (window as any).showToast?.('Network error: ' + err.message, 'error');
      btnDemoQuickLogin.disabled = false;
      btnDemoQuickLogin.innerHTML = originalHtml;
    }
  });

  // 6. Formal Sign-In Form Submission
  const portalLoginForm = document.getElementById('portalLoginForm') as HTMLFormElement | null;
  const portalLoginFeedback = document.getElementById('portalLoginFeedback');
  const portalLoginSubmitBtn = document.getElementById('portalLoginSubmitBtn') as HTMLButtonElement | null;
  const portalLoginBtnText = document.getElementById('portalLoginBtnText');

  if (portalLoginForm && portalLoginFeedback && portalLoginSubmitBtn && portalLoginBtnText) {
    const defaultLabel = portalLoginSubmitBtn.getAttribute('data-default-label') || 'Sign In';
    const fallbackRedirect = portalLoginForm.getAttribute('data-default-redirect') || '/';

    portalLoginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      portalLoginFeedback.className = 'hidden';
      portalLoginSubmitBtn.disabled = true;
      portalLoginBtnText.textContent = 'Signing in...';

      const formData = new FormData(portalLoginForm);
      const payload: Record<string, any> = {};
      formData.forEach((val, key) => {
        payload[key] = val;
      });

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          portalLoginFeedback.className = 'p-3.5 rounded-xl text-xs bg-emerald-50 border border-emerald-200 text-emerald-900 font-semibold';
          portalLoginFeedback.textContent = 'Signed in! Redirecting to your portal...';
          portalLoginBtnText.textContent = 'Redirecting...';
          window.location.href = data.redirect || fallbackRedirect;
        } else {
          portalLoginFeedback.className = 'p-3.5 rounded-xl text-xs bg-red-50 border border-red-200 text-red-900 font-semibold';
          portalLoginFeedback.textContent = data.error || 'Invalid credentials.';
          portalLoginSubmitBtn.disabled = false;
          portalLoginBtnText.textContent = defaultLabel;
        }
      } catch (err: any) {
        portalLoginFeedback.className = 'p-3.5 rounded-xl text-xs bg-red-50 border border-red-200 text-red-900 font-semibold';
        portalLoginFeedback.textContent = 'Network error: ' + err.message;
        portalLoginSubmitBtn.disabled = false;
        portalLoginBtnText.textContent = defaultLabel;
      }
    });
  }

  // 7. Student APAAR Sign-Up Form Submission
  const studentSignupForm = document.getElementById('studentSignupForm') as HTMLFormElement | null;
  const studentSignupFeedback = document.getElementById('studentSignupFeedback');
  const studentSignupSubmitBtn = document.getElementById('studentSignupSubmitBtn') as HTMLButtonElement | null;
  const studentSignupBtnText = document.getElementById('studentSignupBtnText');

  if (studentSignupForm && studentSignupFeedback && studentSignupSubmitBtn && studentSignupBtnText) {
    const fallbackRedirect = studentSignupForm.getAttribute('data-default-redirect') || '/student';

    studentSignupForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      studentSignupFeedback.className = 'hidden';
      studentSignupSubmitBtn.disabled = true;
      studentSignupBtnText.textContent = 'Creating APAAR Account...';

      const formData = new FormData(studentSignupForm);
      const payload: Record<string, any> = {};
      formData.forEach((val, key) => {
        payload[key] = val;
      });

      try {
        const res = await fetch('/api/auth/signup', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          studentSignupFeedback.className = 'p-3.5 rounded-xl text-xs bg-emerald-50 border border-emerald-200 text-emerald-900 font-semibold';
          studentSignupFeedback.textContent = 'APAAR account created! Redirecting to Student Portal...';
          studentSignupBtnText.textContent = 'Redirecting...';
          window.location.href = data.redirect || fallbackRedirect;
        } else {
          studentSignupFeedback.className = 'p-3.5 rounded-xl text-xs bg-red-50 border border-red-200 text-red-900 font-semibold';
          studentSignupFeedback.textContent = data.error || 'Could not register APAAR account.';
          studentSignupSubmitBtn.disabled = false;
          studentSignupBtnText.textContent = 'Create APAAR Account & Sign In';
        }
      } catch (err: any) {
        studentSignupFeedback.className = 'p-3.5 rounded-xl text-xs bg-red-50 border border-red-200 text-red-900 font-semibold';
        studentSignupFeedback.textContent = 'Network error: ' + err.message;
        studentSignupSubmitBtn.disabled = false;
        studentSignupBtnText.textContent = 'Create APAAR Account & Sign In';
      }
    });
  }
</script>
