                    <option value="2026" selected>2026–27 (1st Year Regular)</option>
                    <option value="2025">2026–27 (2nd Year Lateral)</option>
                  </select>
                </div>
              </div>

              <!-- Step 3: Lock Seat & Commit Admission -->
              <div class="pt-1">
                <button
                  type="submit"
