---
import Layout from '../../layouts/Layout.astro';

const portals = [
  { title: '1. संस्थान पोर्टल', desc: 'संस्थान अपने छात्रों की सूची जमा करते हैं। अपलोड से पहले फ़ाइल आपके ब्राउज़र में जाँची जाती है ताकि गलत या अधूरी 12 अंकों की अपार आईडी पहचानी जा सके।', path: '/institution' },
  { title: '2. एआईसीटीई नियामक निगरानी', desc: 'स्वीकृत प्रवेश सीमा से अधिक नामांकन वाले संस्थानों और एक से अधिक परिसरों में दोहरे नामांकन को चिह्नित करता है।', path: '/aicte' },
  { title: '3. संबद्धता विश्वविद्यालय', desc: 'विश्वविद्यालय संबद्ध कॉलेजों की सूची सत्यापित करते हैं, छात्र की अपार आईडी से जुड़ी डिग्री जारी करते हैं और आवश्यकता पड़ने पर डिग्री रद्द करते हैं।', path: '/university' },
  { title: '4. छात्र सहमति (डीपीडीपी)', desc: 'छात्र तय करते हैं कि कौन-सा सत्यापनकर्ता उनकी डिग्री देख सकता है और कितने समय तक। सहमति कभी भी वापस ली जा सकती है।', path: '/student' },
  { title: '5. सार्वजनिक सत्यापन', desc: 'नियोक्ता और नागरिक छात्र की सहमति से डिग्री की प्रामाणिकता जाँच सकते हैं। इसके लिए साइन इन आवश्यक नहीं है।', path: '/verifier' },
];
---

<Layout title="SIH 2026 | राष्ट्रीय छात्र रजिस्ट्री एवं सत्यापन पोर्टल" lang="hi">
  <section class="bg-white rounded border border-slate-200 p-6 sm:p-10 shadow-sm mb-6">
    <h1 class="text-2xl font-bold text-[#0F2942] mb-3">राष्ट्रीय छात्र रजिस्ट्री एवं सत्यापन पोर्टल</h1>
    <p class="text-sm leading-relaxed text-slate-700 mb-4">
      यह पोर्टल एआईसीटीई अनुमोदित संस्थानों के छात्रों का एक सही और सुरक्षित रिकॉर्ड रखता है। यह अपार (APAAR) आईडी, अकादमिक बैंक ऑफ़ क्रेडिट्स और डिजिलॉकर के साथ काम करने के लिए बनाया गया है, और डिजिटल व्यक्तिगत डेटा संरक्षण अधिनियम, 2023 का पालन करता है।
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/verifier" class="px-4 py-2 bg-[#0F2942] text-white font-bold rounded text-sm">डिग्री सत्यापित करें</a>
      <a href="/login" class="px-4 py-2 bg-[#FF9933] text-black font-bold rounded text-sm">अधिकारी साइन इन</a>
    </div>
  </section>

  <section aria-labelledby="portals-heading">
    <h2 id="portals-heading" class="text-lg font-bold text-[#0F2942] mb-4">पोर्टल</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {portals.map((p) => (
        <a href={p.path} class="block bg-white rounded border border-slate-200 p-5 shadow-sm hover:border-[#0F2942]">
          <h3 class="font-bold text-[#0F2942] mb-2">{p.title}</h3>
          <p class="text-sm text-slate-700 leading-relaxed">{p.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-white rounded border border-slate-200 p-6 shadow-sm mt-6" id="aicte-mandate">
    <h2 class="text-lg font-bold text-[#0F2942] mb-2">एआईसीटीई अनुमोदन प्रक्रिया पुस्तिका (2024–2027)</h2>
    <p class="text-sm text-slate-700 leading-relaxed">
      डेटाबेस प्रत्येक कार्यक्रम के लिए स्वीकृत प्रवेश सीमा (60/120/180/240) लागू करता है और सीमा से अधिक नामांकन तुरंत चिह्नित करता है। अधिकारी पोर्टल पासवर्ड, सत्र और संस्थान-स्तरीय पृथक्करण से सुरक्षित हैं।
    </p>
  </section>
</Layout>
