                          <span class="text-xs text-slate-500 whitespace-nowrap">0 Duplicates</span>
                        )}
                      </td>
                      <td class="py-4 px-4 text-right">
                        <div class="inline-flex items-center justify-end gap-2">
                          {i.status === 'SHOW_CAUSE_ISSUED' ? (
                            <span class="bg-red-900 text-white font-bold px-2.5 py-1 rounded-full text-xs whitespace-nowrap">
                              NOTICE ISSUED
                            </span>
                          ) : isOverrun ? (
                            <span class="bg-red-100 text-red-800 font-bold px-2.5 py-1 rounded-full text-xs border border-red-200 whitespace-nowrap">
                              OVER LIMIT (+{diff})
